<Defs>

    <ThingDef ParentName="Milira_OnSkinBase_Neiyu">
        <defName>MX_Mingyuan_InfernoArmor</defName>
        <label>Molten Inferno Armor</label>
        <description>Mingyuan's full-coverage inferno armor. Texture paths temporarily reuse Neiyu assets.</description>
        <recipeMaker Inherit="False" IsNull="True" />

        <graphicData>
            <!-- TODO: Replace with MiliraXianMingyuan/Apparel/InfernoArmor. -->
            <texPath>MiliraXianNeiyu/ApparelNeiyu/Neiyu</texPath>
        </graphicData>
        <statBases>
            <Mass>2.0</Mass>
            <MarketValue>18000</MarketValue>
            <MaxHitPoints>40000</MaxHitPoints>
            <WorkToMake>600000</WorkToMake>
            <ArmorRating_Sharp>4.0</ArmorRating_Sharp>
            <ArmorRating_Blunt>4.0</ArmorRating_Blunt>
            <ArmorRating_Heat>4.0</ArmorRating_Heat>
