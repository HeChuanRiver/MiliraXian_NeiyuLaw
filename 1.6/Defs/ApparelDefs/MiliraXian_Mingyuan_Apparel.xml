<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef ParentName="Milira_OnSkinBase_Neiyu">
        <defName>MX_Mingyuan_InfernoArmor</defName>
        <label>霞焰羽裳</label>
        <description>明渊以淡色异界火与燃羽织成的常服，羽摆间流淌着如霞光般的金赤辉彩。看似轻薄，却能覆护身体与羽翼，抵御常见伤害，提供极强的冷热隔绝，并提升承载、移速与闪避。装备时使普通承伤倍率降低25个百分点，且永不损坏。</description>
        <recipeMaker Inherit="False" IsNull="True" />

        <graphicData>
            <texPath>MiliraXianMingyuan/Apparel/Mingyuan/Naked</texPath>
        </graphicData>
        <statBases>
            <Mass>2.0</Mass>
            <MarketValue>18000</MarketValue>
            <MaxHitPoints>40000</MaxHitPoints>
            <WorkToMake>600000</WorkToMake>
            <ArmorRating_Sharp>1.5</ArmorRating_Sharp>
            <ArmorRating_Blunt>1.5</ArmorRating_Blunt>
            <ArmorRating_Heat>4.0</ArmorRating_Heat>
            <Insulation_Cold>1000</Insulation_Cold>
            <Insulation_Heat>1000</Insulation_Heat>
            <Flammability>0</Flammability>
            <DeteriorationRate>0</DeteriorationRate>
        </statBases>
        <apparel>
            <useWornGraphicMask>false</useWornGraphicMask>
            <developmentalStageFilter>Adult</developmentalStageFilter>
            <bodyPartGroups Inherit="False">
                <li>Torso</li>
                <li>Legs</li>
                <li>Arms</li>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Feet</li>
                <li>Hands</li>
                <li>Milira_Wings</li>
            </bodyPartGroups>
            <wornGraphicPath>MiliraXianMingyuan/Apparel/Mingyuan/Naked</wornGraphicPath>
            <tags Inherit="False">
                <li>MX_MingyuanArmor</li>
            </tags>
            <layers Inherit="False">
                <li>Shell</li>
            </layers>
            <shellRenderedBehindHead>true</shellRenderedBehindHead>
        </apparel>
        <tickerType>Normal</tickerType>
        <comps>
            <li Class="MiliraXian.Characters.CompProperties_UnbreakableEquipment" />
        </comps>
        <equippedStatOffsets>
            <CarryingCapacity>+100</CarryingCapacity>
            <MeleeDodgeChance>0.20</MeleeDodgeChance>
            <MoveSpeed>1.00</MoveSpeed>
            <IncomingDamageFactor>-0.25</IncomingDamageFactor>
        </equippedStatOffsets>
    </ThingDef>

    <ThingDef ParentName="Milira_OverheadBase">
