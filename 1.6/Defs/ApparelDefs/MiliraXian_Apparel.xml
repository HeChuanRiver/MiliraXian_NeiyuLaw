    <!-- 昭离兜帽 -->
    <ThingDef ParentName="Milira_OverheadBase">
        <defName>MX_ZhaoliHood</defName>
        <label>昭离·兜帽</label>
        <description>昭离外出时披戴的深色兜帽。兜帽边缘带有紫色纹饰，能够遮住昭离头顶的光环，使她在地面行动时不那么显眼。</description>
        <smeltable>false</smeltable>
        <burnableByRecipe>false</burnableByRecipe>
