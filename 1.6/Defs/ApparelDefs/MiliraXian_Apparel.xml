                <li>Milira_Halo</li>
                <li>Ancot_HairAhoge</li>
            </renderSkipFlags>
            <wornGraphicPath>MiliraXianZhaoli/Apparel/Hood/ZhaoliHood</wornGraphicPath>
            <tags>
                <li>MX_ZhaoliHood</li>
            </tags>
            <renderNodeProperties>
                <li>
                    <debugLabel>MX_ZhaoliHood BG</debugLabel>
                    <nodeClass>AncotLibrary.PawnRenderNode_ApparelAddition</nodeClass>
                    <workerClass>PawnRenderNodeWorker_Apparel_Head</workerClass>
                    <pawnType>Any</pawnType>
                    <texPath>MiliraXianZhaoli/Apparel/ApparelBackGround/Hood/ZhaoliHoodBG</texPath>
                    <baseLayer>-10</baseLayer>
                    <parentTagDef>ApparelHead</parentTagDef>
