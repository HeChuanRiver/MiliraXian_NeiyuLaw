    <!-- 常服 -->
    <ThingDef ParentName="Milira_OnSkinBase_Neiyu">
        <defName>MiliraXian_NeiyuNormal</defName>
        <label>霓羽·常服</label>
        <description>霓羽最常穿的一身衣装。她向来爱惜这套常服，也在漫长经历中不断为其添入稀有而精巧的材料；即使如今显现于此界的只是投影，它依旧兼具轻盈外观与不俗防护。</description>
        <recipeMaker Inherit="False" IsNull="True" />
    
        <graphicData>
            <texPath>MiliraXianNeiyu/ApparelNeiyu/Neiyu</texPath>
        </graphicData>
        <statBases>
            <Mass>1.2</Mass>
            <WorkToMake>600000</WorkToMake>
            <ArmorRating_Sharp>2.0</ArmorRating_Sharp>
            <ArmorRating_Blunt>2.0</ArmorRating_Blunt>
            <ArmorRating_Heat>2.0</ArmorRating_Heat>
            <Insulation_Cold>1200</Insulation_Cold>
            <Insulation_Heat>1200</Insulation_Heat>
        </statBases>
        <apparel>
            <useWornGraphicMask>true</useWornGraphicMask>
            <developmentalStageFilter>Adult</developmentalStageFilter>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Legs</li>
                <li>Arms</li>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Feet</li>
                <li>Hands</li>
                <li>Milira_Wings</li>
            </bodyPartGroups>
            <wornGraphicPath>MiliraXianNeiyu/ApparelNeiyu/Neiyu</wornGraphicPath>
            <tags>
                <li>MiliraXian_NeiyuNormal</li>
            </tags>
            <layers>
                <li>Shell</li>
            </layers>
            <shellRenderedBehindHead>true</shellRenderedBehindHead>
        </apparel>
        <tickerType>Normal</tickerType>
        <comps>
            <li Class="MiliraXian.Characters.CompProperties_UnbreakableEquipment" />
        </comps>
        <equippedStatOffsets>
            <CarryingCapacity>+65</CarryingCapacity>
            <MeleeDodgeChance>20.0</MeleeDodgeChance>
            <MoveSpeed>1.50</MoveSpeed>
        </equippedStatOffsets>
    </ThingDef>

