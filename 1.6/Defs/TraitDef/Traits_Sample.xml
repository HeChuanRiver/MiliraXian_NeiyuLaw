<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <TraitDef>
    <defName>MiliraXianNeiyu_Love</defName>
    <commonality>0.000001</commonality>
    <degreeDatas>
      <li>
        <label>霓羽仙</label>
        <description>"她爱着世人，她愿世间飘落霓裳花。"</description>
        <statOffsets></statOffsets>
        <statFactors>
          <IncomingDamageFactor>0.99</IncomingDamageFactor>
        </statFactors>
      </li>
    </degreeDatas>
    <modExtensions>
      <!-- Same function as "Perfect memory". 挂上后，这个特质包含博闻强识的效果，完全无技能遗忘。 -->
      <li Class="AriandelLibrary.AL_NoSkillDecay_Extension" />
      <!-- Ignore gene penalty on skills. 突破基因对技能的减益限制（忽略基因惩罚）。 -->
      <li Class="AriandelLibrary.AL_IgnoreGenePenalty_Extension">
        <skill>Cooking</skill>
      </li>
      <!-- Set skill level and this skill won't decay. 设置生成时技能等级，并单独阻止该技能等级遗忘 -->
      <li Class="AriandelLibrary.AL_LockSkill_Extension">
        <skill>Cooking</skill>
        <level>20</level>
        <preventDecay>true</preventDecay>
      </li>
      <!-- Reflect psychic shock lance 反弹心灵冲击枪 -->
      <li Class="AriandelLibrary.AL_PsychicShockReflect_Extension" />
    </modExtensions>
  </TraitDef>
  <TraitDef>
    <defName>MX_QH_Trait_SpringFall</defName>
    <commonality>0.000001</commonality>
    <degreeDatas>
      <li>
        <label>&lt;color=#99CCFF&gt;春雨&lt;/color&gt;</label>
        <description>"梨花带雨，润物无声。"</description>
        <statFactors>
          <FoodPoisonChance>0</FoodPoisonChance>
          <MedicalSurgerySuccessChance>1.5</MedicalSurgerySuccessChance>
          <MedicalTendQuality>1.5</MedicalTendQuality>
        </statFactors>
      </li>
    </degreeDatas>
  </TraitDef>
  <TraitDef>
    <defName>MX_QH_Trait_WaterFairy</defName>
    <commonality>0.000001</commonality>
    <degreeDatas>
      <li>
        <label>&lt;color=#FFCDE1&gt;霓羽仙&lt;/color&gt;</label>
        <description>"出淤泥而不染，濯清涟而不妖。"\n\n免疫在水中或雨中的心情惩罚。</description>
        <statFactors>
          <IncomingDamageFactor>0.99</IncomingDamageFactor>
          <PlantWorkSpeed>1.25</PlantWorkSpeed>
        </statFactors>
        <statOffsets>
          <ToxicResistance>1</ToxicResistance>
          <ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
        </statOffsets>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="AriandelLibrary.AL_NoSkillDecay_Extension" />
      <li Class="AriandelLibrary.AL_IgnoreGenePenalty_Extension">
        <skill>Cooking</skill>
      </li>
      <li Class="AriandelLibrary.AL_LockSkill_Extension">
        <skill>Artistic</skill>
        <level>20</level>
        <preventDecay>true</preventDecay>
      </li>
      <li Class="AriandelLibrary.AL_PsychicShockReflect_Extension" />
    </modExtensions>
  </TraitDef>
</Defs>
