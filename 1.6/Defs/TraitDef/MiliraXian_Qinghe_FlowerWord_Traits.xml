<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <TraitDef>
        <defName>MX_QH_FlowerWord_Peony</defName>
        <commonality>0.000001</commonality>
        <degreeDatas>
            <li>
                <label>flower word: peony</label>
                <description>A spring flower word. When Qinghe resonates with peony, she is better at soothing wounds and hearts, improving medicine, social ability, beauty, and social impact.</description>
                <skillGains>
                    <Medicine>4</Medicine>
                    <Social>4</Social>
                </skillGains>
                <statOffsets>
                    <PawnBeauty>1</PawnBeauty>
                </statOffsets>
                <statFactors>
                    <MedicalTendQuality>1.12</MedicalTendQuality>
                    <MedicalTendSpeed>1.15</MedicalTendSpeed>
                    <SocialImpact>1.15</SocialImpact>
                </statFactors>
            </li>
        </degreeDatas>
    </TraitDef>

    <TraitDef>
        <defName>MX_QH_FlowerWord_JadeHairpin</defName>
        <commonality>0.000001</commonality>
        <degreeDatas>
            <li>
                <label>flower word: jade hairpin</label>
                <description>A summer flower word. When Qinghe resonates with jade hairpin, crafting and artistic ability improve, and focused work more easily sparks work frenzy or artistic inspiration.</description>
                <skillGains>
                    <Crafting>4</Crafting>
                    <Artistic>4</Artistic>
                </skillGains>
                <statFactors>
                    <GeneralLaborSpeed>1.1</GeneralLaborSpeed>
                    <WorkSpeedGlobal>1.08</WorkSpeedGlobal>
                </statFactors>
            </li>
        </degreeDatas>
    </TraitDef>

    <TraitDef>
        <defName>MX_QH_FlowerWord_Osmanthus</defName>
        <commonality>0.000001</commonality>
        <degreeDatas>
            <li>
                <label>flower word: osmanthus</label>
                <description>An autumn flower word. When Qinghe resonates with osmanthus, intellectual and shooting ability improve, dark study becomes more efficient, and shots become more precise.</description>
                <skillGains>
                    <Intellectual>4</Intellectual>
                    <Shooting>4</Shooting>
                </skillGains>
                <statFactors>
                    <EntityStudyRate MayRequire="Ludeon.RimWorld.Anomaly">1.2</EntityStudyRate>
                    <StudyEfficiency MayRequire="Ludeon.RimWorld.Anomaly">1.15</StudyEfficiency>
                    <ShootingAccuracyPawn>1.12</ShootingAccuracyPawn>
                    <AimingDelayFactor>0.92</AimingDelayFactor>
                </statFactors>
            </li>
        </degreeDatas>
    </TraitDef>

    <TraitDef>
        <defName>MX_QH_FlowerWord_Narcissus</defName>
        <commonality>0.000001</commonality>
        <degreeDatas>
            <li>
                <label>flower word: narcissus</label>
                <description>A winter flower word. When Qinghe resonates with narcissus, cooking and construction improve; she will not produce toxic meals while cooking and will not be upset by being soaking wet.</description>
                <skillGains>
                    <Cooking>4</Cooking>
                    <Construction>4</Construction>
                </skillGains>
                <statFactors>
                    <CookSpeed>1.12</CookSpeed>
                    <ConstructionSpeed>1.12</ConstructionSpeed>
                    <FoodPoisonChance>0</FoodPoisonChance>
                </statFactors>
            </li>
        </degreeDatas>
    </TraitDef>

</Defs>
