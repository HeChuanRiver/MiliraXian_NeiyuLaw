    <AbilityDef>
        <defName>MX_Neiyu_WarpFeather</defName>
        <label>&lt;color=#79CBFF&gt;折跃引羽&lt;/color&gt;</label>
        <description>短暂蓄力后在脚下闪光，并直接生成84~128个&lt;color=#79CBFF&gt;米莉拉之羽&lt;/color&gt;。 \n米莉拉之羽的来源霓羽念叨着什么物质法则的呈现、什么你知道现在的羽毛都得五十万白银了吗之类的。令人忍俊不禁。</description>
        <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_WarpFeather</iconPath>

        <category>MX_NeiyuSkill</category>
        <displayOrder>100</displayOrder>
        <cooldownTicksRange>3000</cooldownTicksRange>

        <targetRequired>false</targetRequired>
        <hostile>false</hostile>
        <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
        <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>

        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <targetable>false</targetable>
            <range>0</range>
            <warmupTime>0.3</warmupTime>
            <targetParams>
                <canTargetSelf>true</canTargetSelf>
                <canTargetPawns>false</canTargetPawns>
                <canTargetLocations>false</canTargetLocations>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetItems>false</canTargetItems>
            </targetParams>
        </verbProperties>

        <comps>
            <li Class="MiliraXian.Characters.Neiyu.CompProperties_AbilityNeiyuWarpFeather">
                <finishFlashFleckDefName>PsycastSkipFlashExit</finishFlashFleckDefName>
                <featherThingDef>Milira_Feather</featherThingDef>
                <featherCountRange>84~128</featherCountRange>
            </li>
        </comps>
    </AbilityDef>

    <AbilityDef>
        <defName>MX_Neiyu_ThunderMarkedStorm</defName>
        <label>&lt;color=#8BD5FF&gt;雷锁印域&lt;/color&gt;</label>
        <description>选定半径3格区域，标记其中敌对目标。数秒后每个被&lt;color=#8BD5FF&gt;雷锁印记&lt;/color&gt;标记者将承受3~5次高伤&lt;color=#C7B8FF&gt;雷击&lt;/color&gt;，并附加&lt;color=#79CBFF&gt;EMP&lt;/color&gt;伤害。\n "这招其实是有一天发现了一个奇特的种族，他们身上蕴含着满满的死亡的气息，生机活力却不比我曾经修行生命的小辈要差，然后曾经有些古书写着什么雷克邪祟什么的，我就搓了这招"</description>
        <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_ThunderMarkedStorm</iconPath>

        <category>MX_NeiyuSkill</category>
        <displayOrder>120</displayOrder>
        <cooldownTicksRange>4800</cooldownTicksRange>

        <targetRequired>true</targetRequired>
        <hostile>true</hostile>
        <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>

        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <targetable>true</targetable>
            <range>30</range>
            <warmupTime>1.2</warmupTime>
            <targetParams>
                <canTargetSelf>false</canTargetSelf>
                <canTargetPawns>false</canTargetPawns>
                <canTargetLocations>true</canTargetLocations>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetItems>false</canTargetItems>
            </targetParams>
        </verbProperties>

        <comps>
            <li Class="MiliraXian.Characters.Neiyu.CompProperties_AbilityNeiyuThunderSigil">
                <radius>3</radius>
                <strikeCountRange>3~5</strikeCountRange>
                <firstDelayTicksRange>120~180</firstDelayTicksRange>
                <strikeIntervalTicksRange>45~75</strikeIntervalTicksRange>
                <damageAmount>60</damageAmount>
                <empDamageAmount>20</empDamageAmount>
                <markerHediff>MX_Neiyu_ThunderMark</markerHediff>
            </li>
        </comps>
    </AbilityDef>

