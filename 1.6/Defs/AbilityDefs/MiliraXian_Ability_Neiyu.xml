    <AbilityDef>
        <defName>MX_Neiyu_Sword_Skyfall</defName>
        <label>&lt;color=#8BD5FF&gt;剑势·天坠&lt;/color&gt;</label>
        <description>Requires sword form. Rises and marks the landing zone, dealing 120 armor-ignoring damage to enemies within 3 cells. They take 25% more damage for 25 seconds. Cooldown: 150 seconds.</description>
        <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_Sword_Skyfall</iconPath>

        <category>MX_NeiyuSkill</category>
        <displayOrder>160</displayOrder>
        <cooldownTicksRange>9000</cooldownTicksRange>

        <targetRequired>true</targetRequired>
        <hostile>true</hostile>
        <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>

        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <targetable>true</targetable>
            <range>35</range>
            <warmupTime>1.0</warmupTime>
            <targetParams>
                <canTargetSelf>false</canTargetSelf>
                <canTargetPawns>false</canTargetPawns>
                <canTargetLocations>true</canTargetLocations>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetItems>false</canTargetItems>
            </targetParams>
        </verbProperties>

        <comps>
            <li Class="MiliraXian.Characters.Neiyu.CompProperties_AbilityNeiyuSwordSkyfall">
                <requiredWeapon>MX_Neiyu_Form_Weapon</requiredWeapon>
                <ascendFlyerDef>MX_Neiyu_SwordSkyfallAscendFlyer</ascendFlyerDef>
                <descendFlyerDef>MX_Neiyu_SwordSkyfallFlyer</descendFlyerDef>
                <impactDamageDef>Bomb</impactDamageDef>
                <impactRadius>3</impactRadius>
                <impactDamage>120</impactDamage>
                <impactArmorPen>999</impactArmorPen>
                <vulnerabilityHediff>MX_Neiyu_SwordVulnerability</vulnerabilityHediff>
                <vulnerabilityDurationTicks>1500</vulnerabilityDurationTicks>
                <ascendVisualTicks>8</ascendVisualTicks>
                <warningDelayTicks>36</warningDelayTicks>
                <descendVisualTicks>16</descendVisualTicks>
                <warningPulseIntervalTicks>2</warningPulseIntervalTicks>
                <warningEffectDefName>Skip_EntryNoDelay</warningEffectDefName>
                <warningFleckDefName>PsycastAreaEffect</warningFleckDefName>
                <warningFleckScale>1.45</warningFleckScale>
                <effectBDefName>ImpactSmallDustCloud</effectBDefName>
                <effectCDefName>Skip_ExitNoDelay</effectCDefName>
                <launchFleckDefName>PsycastSkipFlashEntry</launchFleckDefName>
                <landFleckDefName>ExplosionFlash</landFleckDefName>
                <!-- TODO: weapon draw interface tuning -->
                <launchWeaponScale>2.0</launchWeaponScale>
                <landWeaponScale>2.6</landWeaponScale>
                <launchWeaponAngle>90</launchWeaponAngle>
                <landWeaponAngle>-90</landWeaponAngle>
                <takeoffGroundEffectDefName>MXNL_Effecter_Skyfall_FlyBeginGround</takeoffGroundEffectDefName>
                <ascentTrailFleckDefName>MXNL_Skyfall_FlyBegin_F</ascentTrailFleckDefName>
                <ascentTrailFleckScale>1.15</ascentTrailFleckScale>
                <ascentTrailOffsetX>0</ascentTrailOffsetX>
                <ascentTrailOffsetZ>8</ascentTrailOffsetZ>
                <impactSoundDefName>Thunder_OnMap</impactSoundDefName>
                <landingScreenShake>0.16</landingScreenShake>
                <landingScreenShakeTicks>20</landingScreenShakeTicks>
                <landingDustBurstCount>16</landingDustBurstCount>
                <landingDustRadius>2.8</landingDustRadius>
                <landingDustScale>2.2</landingDustScale>
            </li>
        </comps>
    </AbilityDef>

    <AbilityDef>
        <defName>MX_Neiyu_Sword_ExecuteHead</defName>
        <label>&lt;color=#C7A2F8&gt;剑势·断首&lt;/color&gt;</label>
        <description>Requires sword form. Retreats briefly, then dashes to the target. Decapitates a target that is downed or at no more than 25% overall health. If decapitation is not possible, deals 75 armor-ignoring cut damage. Cooldown: 75 seconds.</description>
        <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_Sword_ExecuteHead</iconPath>

        <category>MX_NeiyuSkill</category>
        <displayOrder>170</displayOrder>
        <cooldownTicksRange>4500</cooldownTicksRange>

        <targetRequired>true</targetRequired>
        <hostile>true</hostile>
        <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>

        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <targetable>true</targetable>
            <range>28</range>
            <warmupTime>0.6</warmupTime>
            <targetParams>
                <canTargetSelf>false</canTargetSelf>
                <canTargetPawns>true</canTargetPawns>
                <canTargetLocations>false</canTargetLocations>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetItems>false</canTargetItems>
            </targetParams>
        </verbProperties>

        <comps>
            <li Class="MiliraXian.Characters.Neiyu.CompProperties_AbilityNeiyuSwordExecution">
                <requiredWeapon>MX_Neiyu_Form_Weapon</requiredWeapon>
                <flyerDef>MX_Neiyu_SwordDashFlyer</flyerDef>
                <backstepCells>2</backstepCells>
                <dashDamage>75</dashDamage>
                <!-- TODO: effect A/B/C placeholders -->
                <effectADefName>Skip_EntryNoDelay</effectADefName>
                <effectBDefName>ImpactSmallDustCloud</effectBDefName>
                <effectCDefName>Skip_ExitNoDelay</effectCDefName>
                <launchFleckDefName>PsycastSkipFlashEntry</launchFleckDefName>
                <hitFleckDefName>ExplosionFlash</hitFleckDefName>
                <!-- TODO: weapon draw interface tuning -->
                <backstepWeaponScale>1.8</backstepWeaponScale>
                <backstepWeaponAngle>180</backstepWeaponAngle>
                <dashWeaponScale>2.4</dashWeaponScale>
                <dashWeaponAngle>0</dashWeaponAngle>
                <uppercutWeaponScale>2.6</uppercutWeaponScale>
                <uppercutWeaponAngle>25</uppercutWeaponAngle>
            </li>
        </comps>
    </AbilityDef>

</Defs>
