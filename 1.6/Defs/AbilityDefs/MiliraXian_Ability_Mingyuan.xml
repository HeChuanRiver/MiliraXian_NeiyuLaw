                <fieldDef>MX_Mingyuan_BurningPillarField</fieldDef>
            </li>
        </comps>
    </AbilityDef>

    <AbilityDef>
        <defName>MX_Mingyuan_TimeBurn</defName>
        <label>&lt;color=#C95CFF&gt;Time Burn&lt;/color&gt;</label>
        <description>Charges for 3 seconds, then burns away the target's biological age over 20 seconds to execute it. Mechanoids dissolve into steel and plasteel; buildings return raw materials. Cooldown: 300 seconds.</description>
        <iconPath>MiliraXianMingyuan/UI/Ability_TimeBurn</iconPath>
