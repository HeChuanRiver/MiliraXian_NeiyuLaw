                <fieldDurationTicks>900</fieldDurationTicks>
                <resourceCostDef>MX_QH_FlowerDecree</resourceCostDef>
                <resourceCost>1</resourceCost>
                <missingResourceMessage>MX_QH_SpringFlowMissingResource</missingResourceMessage>
            </li>
        </comps>
    </AbilityDef>

