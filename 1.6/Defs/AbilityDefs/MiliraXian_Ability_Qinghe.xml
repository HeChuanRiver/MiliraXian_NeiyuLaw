<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <AbilityCategoryDef>
        <defName>MX_QingheSkill</defName>
    </AbilityCategoryDef>
    <!-- 清荷 —— 基础技能 -->
    <AbilityDef>
        <defName>MX_Qinghe_SpringFlow</defName>
        <label>涌泉</label>
        <description>在目标地点创造一股清泉，对6格范围内的己方目标附加*近战伤害系数提升*、*远程伤害系数提升*、*承受伤害降低*和减轻疼痛的效果。\n该技能的*标示效果*可被雅乐的效果强化。\n需要持续引导，引导期间持续积累激流，泉水持续15秒</description>
        <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_ThunderMarkedStorm</iconPath><!--TODO: Draw a unique icon-->
        <jobDef>CastSpringFlow</jobDef>

        <category>MX_QingheSkill</category>
        <displayOrder>120</displayOrder>
        <cooldownTicksRange>480</cooldownTicksRange>

        <targetRequired>true</targetRequired>
        <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
        <waitForJobEnd>true</waitForJobEnd>

        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <targetable>true</targetable>
            <range>30</range>
            <warmupTime>1.2</warmupTime>
            <targetParams>
                <canTargetSelf>false</canTargetSelf>
                <canTargetPawns>false</canTargetPawns>
                <canTargetLocations>true</canTargetLocations>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetItems>false</canTargetItems>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="MiliraXian.Characters.QingHe.CompProperties_AbilitySpringFlow">
                <fieldDef>SpringFlowField</fieldDef>
                <fieldDurationTicks>900</fieldDurationTicks>
                <previewRadius>6.0</previewRadius>
            </li>
            <li Class="MiliraXian.Characters.CompProperties_ChannelResource">
                <perTick>
                    <li>
                        <resourceDef>MX_QH_Tempest</resourceDef>
                        <amount>0.04</amount>
                    </li>
                </perTick>
            </li>
        </comps>
    </AbilityDef>

    <AbilityDef>
        <defName>MX_Qinghe_AquaMirror</defName>
        <label>水镜</label>
        <description>为目标地点附近4格内的己方目标附上持续10秒的水镜，水镜可以抵挡一部分伤害。受到攻击耗尽或持续时间结束后消失时，*瞬间治疗目标*，恢复目标所有非永久伤口和缺失身体部件并*对小范围内敌方目标造成伤害*。\n该技能的*标示效果*可被雅乐的效果强化。\n水镜消失时，积累少量激流。</description>
        <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_ThunderMarkedStorm</iconPath><!--TODO: Draw a unique icon-->

        <category>MX_QingheSkill</category>
        <displayOrder>120</displayOrder>
        <cooldownTicksRange>480</cooldownTicksRange>

        <targetRequired>true</targetRequired>
        <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>

        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <targetable>true</targetable>
            <range>30</range>
            <warmupTime>1.2</warmupTime>
            <targetParams>
                <canTargetSelf>false</canTargetSelf>
                <canTargetPawns>false</canTargetPawns>
                <canTargetLocations>true</canTargetLocations>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetItems>false</canTargetItems>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="MiliraXian.Characters.Qinghe.CompProperties_AbilityAquaMirror">
                <previewRadius>4.0</previewRadius>
            </li>
        </comps>
    </AbilityDef>

    <!-- 清荷 —— 激流技能 -->
    <AbilityDef>
        <defName>MX_Qinghe_TempestDrain</defName>
        <label>扼流</label>
        <description>在目标地点引导一个大范围扼流力场，使进入其中的敌对目标*持续积累水循环断流状态*，附加大量负面效果且积累到最大值时立刻死亡。\n该技能的*标示效果*可被雅乐的效果强化。\n需要至少50点激流，引导时持续消耗激流直到剩余不足10点时自动关闭，该技能不可手动打断。\n目标越靠近力场中心，断流积累的速度越快。</description>
        <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_ThunderMarkedStorm</iconPath><!--TODO: Draw a unique icon-->
        <jobDef>CastTempestDrain</jobDef>

        <category>MX_QingheSkill</category>
        <displayOrder>120</displayOrder>
        <cooldownTicksRange>480</cooldownTicksRange>

        <targetRequired>true</targetRequired>
        <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
        <waitForJobEnd>true</waitForJobEnd>

        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <targetable>true</targetable>
            <range>30</range>
            <warmupTime>1.2</warmupTime>
            <targetParams>
                <canTargetSelf>false</canTargetSelf>
                <canTargetPawns>false</canTargetPawns>
                <canTargetLocations>true</canTargetLocations>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetItems>false</canTargetItems>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="MiliraXian.Characters.QingHe.CompProperties_AbilityTempestDrain">
                <fieldDef>TempestDrainField</fieldDef>
                <minResourceToCast>50</minResourceToCast>
                <minResourceToMaintain>10</minResourceToMaintain>
                <channelDurationTicks>999999</channelDurationTicks>
                <previewRadius>12.0</previewRadius>
            </li>
            <li Class="MiliraXian.Characters.CompProperties_ChannelResource">
                <perTick>
                    <li>
                        <resourceDef>MX_QH_Tempest</resourceDef>
                        <amount>-0.1</amount>
                    </li>
                </perTick>
                <failConditions>
                    <li>
                        <resourceDef>MX_QH_Tempest</resourceDef>
                        <minAmount>10</minAmount>
                    </li>
                </failConditions>
            </li>
        </comps>
    </AbilityDef>

<!-- =========================
       QingHe Elegance 武器技能示例
       资源：MX_QH_Elegance
       ========================= -->

  <!-- 横指（琵琶形态）：同一施法 Job 内结算范围冲击+击退 -->
  <AbilityDef>
    <defName>MX_Qinghe_Elegance_HengZhi</defName>
    <label>横指</label>
    <description>仅琵琶形态可用。对自身周围敌人造成高额冲击并击退，命中目标越多，雅乐（Elegance）增长越快。</description>
    <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_ThunderMarkedStorm</iconPath>
    <category>MX_QingheSkill</category>
    <displayOrder>130</displayOrder>
    <cooldownTicksRange>240</cooldownTicksRange>

    <!-- 关键：改用自定义施法 JobDef（driver 继承 JobDriver_CastAbility） -->
    <jobDef>MX_Qinghe_Elegance_CastAbility_HengZhi</jobDef>

    <targetRequired>false</targetRequired>
    <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>

    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <targetable>false</targetable>
      <range>1.9</range>
      <warmupTime>0.25</warmupTime>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>

    <comps>
      <li Class="MiliraXian.Characters.QingHe.CompProperties_AbilityHengZhi">
        <!-- 绑定到当前已存在的近战形态 Def -->
        <requiredWeapon>MX_Qinghe_Form_Pipa</requiredWeapon>

        <!-- 在同一施法 Job 内，施法完成后额外等待几 tick 再结算（0=立即） -->
        <postCastDelayTicks>0</postCastDelayTicks>

        <radius>3.9</radius>
        <damageDef>MX_Dehydrate</damageDef>
        <damageAmount>24</damageAmount>
        <armorPenetration>0.55</armorPenetration>
        <bluntDamageAmount>10</bluntDamageAmount>
        <bluntArmorPenetration>0.15</bluntArmorPenetration>
        <knockbackDistance>4</knockbackDistance>
        <damageFactorMax>1</damageFactorMax>
        <knockbackFactorMax>0.5</knockbackFactorMax>
        <eleganceGainPerTarget>3</eleganceGainPerTarget>
        <eleganceGainMax>24</eleganceGainMax>
      </li>
    </comps>
  </AbilityDef>

  <!-- 断魂（竹笛形态）：同一施法 Job 内结算目标区控制与破坏 -->
  <AbilityDef>
    <defName>MX_Qinghe_Elegance_DuanHun</defName>
    <label>断魂</label>
    <description>仅竹笛形态可用。对远处小范围施加断魂音律，造成伤害、眩晕、流血与长时减速，并有低概率直接摧毁大脑。</description>
    <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_ThunderMarkedStorm</iconPath>
    <category>MX_QingheSkill</category>
    <displayOrder>131</displayOrder>
    <cooldownTicksRange>720</cooldownTicksRange>

    <!-- 关键：改用自定义施法 JobDef（driver 继承 JobDriver_CastAbility） -->
    <jobDef>MX_Qinghe_Elegance_CastAbility_DuanHun</jobDef>

    <targetRequired>true</targetRequired>
    <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>

    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <targetable>true</targetable>
      <range>55</range>
      <warmupTime>1.2</warmupTime>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>true</canTargetLocations>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetItems>false</canTargetItems>
      </targetParams>
    </verbProperties>

    <comps>
      <li Class="MiliraXian.Characters.QingHe.CompProperties_AbilityDuanHun">
        <!-- 绑定到当前已存在的远程形态 Def -->
        <requiredWeapon>MX_Qinghe_Form_Zhudi</requiredWeapon>

        <!-- 在同一施法 Job 内，施法完成后额外等待几 tick 再结算（0=立即） -->
        <postCastDelayTicks>0</postCastDelayTicks>

        <radius>2.5</radius>
        <damageDef>MX_Desynced</damageDef>
        <damageAmount>16</damageAmount>
        <armorPenetration>0.25</armorPenetration>
        <stunDamageAmount>8</stunDamageAmount>
        <bleedDamageAmount>5</bleedDamageAmount>
        <slowHediff>MX_QH_Elegance_DuanHunSlow</slowHediff>
        <slowSeverity>1</slowSeverity>
        <slowDurationTicks>1800</slowDurationTicks>
        <damageFactorMax>0.75</damageFactorMax>
        <slowDurationFactorMax>1</slowDurationFactorMax>
        <brainDestroyChance>0.08</brainDestroyChance>
        <eleganceGainOnCast>8</eleganceGainOnCast>
        <eleganceGainPerTarget>2</eleganceGainPerTarget>
        <curveMote>MX_QH_Mote_DuanHunCurvedTrail</curveMote>
        <curveDistortWidth>4.2</curveDistortWidth>
        <curveDistortAlpha>0.68</curveDistortAlpha>
        <curveWidth>3.1</curveWidth>
        <curveDensity>8.8</curveDensity>
        <curveWaveLen>4.8</curveWaveLen>
        <curveAlpha>2.1</curveAlpha>
        <curveAfterLayers>9</curveAfterLayers>
        <curveAfterGap>1</curveAfterGap>
        <curveAfterAlpha>0.62</curveAfterAlpha>
        <curveMinSegs>28</curveMinSegs>
        <curveMaxSegs>96</curveMaxSegs>
        <curveDistortStep>3</curveDistortStep>
      </li>
    </comps>
  </AbilityDef>

