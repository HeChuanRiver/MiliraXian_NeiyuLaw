                <dashDurationMinTicks>8</dashDurationMinTicks>
                <dashCollisionRadius>1.35</dashCollisionRadius>
                <dashImpactRadius>1.8</dashImpactRadius>
                <dashDamageAmount>10</dashDamageAmount>
                <takeoffDelayTicks>18</takeoffDelayTicks>
