                <hoverTicks>22</hoverTicks>
                <descentTicks>14</descentTicks>
                <ascentDecelerationPower>2.2</ascentDecelerationPower>
                <descentAccelerationPower>2.4</descentAccelerationPower>
                <secondStageTrackingRange>4</secondStageTrackingRange>
