    <AbilityDef>
        <defName>MX_Zhaoli_DeathField</defName>
        <label>&lt;color=#E85A7A&gt;告死流场&lt;/color&gt;</label>
        <description>Creates a radius-9 Death Sentence field for 9 seconds. Non-immune units other than the caster are slowed by 20%, receive cuts and gain 1 accumulation each second. At 9 points they are executed; a successful execution grants 1 Karma and 5 Deathward counters. Accumulation rapidly decays outside the field. Cooldown: 40 seconds.
Neiyu, Qinghe, Zhaoli and Mingyuan are immune to its accumulation, slow, cuts and execution.</description>
        <iconPath>MiliraXianZhaoli/UI/Zhaoli_DeathField</iconPath>

        <category>MX_ZhaoliSkill</category>
        <displayOrder>100</displayOrder>
        <cooldownTicksRange>2400</cooldownTicksRange>
        <jobDef>MX_Zhaoli_CastAbility_Uninterruptible</jobDef>

        <targetRequired>true</targetRequired>
        <hostile>true</hostile>
        <aiCanUse>true</aiCanUse>
        <ai_IsOffensive>true</ai_IsOffensive>
        <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>

        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <targetable>true</targetable>
            <range>30</range>
            <requireLineOfSight>false</requireLineOfSight>
            <warmupTime>1.0</warmupTime>
            <targetParams>
                <canTargetSelf>false</canTargetSelf>
                <canTargetPawns>false</canTargetPawns>
                <canTargetLocations>true</canTargetLocations>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetItems>false</canTargetItems>
            </targetParams>
        </verbProperties>

        <comps>
            <li Class="MiliraXian.Characters.Zhaoli.CompProperties_AbilityZhaoliDeathField">
                <fieldHediff>MXZL_ZhaoliDeathFieldActive</fieldHediff>
                <radius>9</radius>
            </li>
        </comps>
    </AbilityDef>

