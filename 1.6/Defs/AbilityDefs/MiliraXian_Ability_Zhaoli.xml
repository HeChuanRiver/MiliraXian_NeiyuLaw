    <AbilityDef>
        <defName>MX_Zhaoli_DeathField</defName>
        <label>&lt;color=#A11228&gt;告死流场&lt;/color&gt;</label>
        <description>创造一个直径18格的圆形&lt;color=#2C0F18&gt;立场&lt;/color&gt;。立场内所有单位除&lt;color=#A11228&gt;昭离&lt;/color&gt;自身外均受到&lt;color=#5E1335&gt;20%减速&lt;/color&gt;；每3秒形成一次&lt;color=#A11228&gt;流血&lt;/color&gt;；若目标连续15秒未离开立场，则被直接&lt;color=#A11228&gt;告死&lt;/color&gt;并彻底消失。</description>
        <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_ThunderMarkedStorm</iconPath>

        <category>MX_ZhaoliSkill</category>
        <displayOrder>100</displayOrder>
        <cooldownTicksRange>1200</cooldownTicksRange>

        <targetRequired>true</targetRequired>
        <hostile>true</hostile>
        <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>

        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <targetable>true</targetable>
            <range>30</range>
            <requireLineOfSight>false</requireLineOfSight>
            <warmupTime>1.0</warmupTime>
            <targetParams>
                <canTargetSelf>false</canTargetSelf>
                <canTargetPawns>false</canTargetPawns>
                <canTargetLocations>true</canTargetLocations>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetItems>false</canTargetItems>
            </targetParams>
        </verbProperties>

        <comps>
            <li Class="MiliraXian.Characters.Zhaoli.CompProperties_AbilityZhaoliDeathField">
                <fieldHediff>MXZL_ZhaoliDeathFieldActive</fieldHediff>
                <radius>9</radius>
            </li>
        </comps>
    </AbilityDef>

    <AbilityDef>
        <defName>MX_Zhaoli_Guiyi</defName>
        <label>&lt;color=#6A214A&gt;诡医&lt;/color&gt;</label>
        <description>消耗&lt;color=#A11228&gt;1点因果&lt;/color&gt;，治愈目标一切疾病与损伤。该效果会恢复缺失肢体，清除成瘾、机械损伤、永久旧伤与其他负面健康状态。&lt;color=#6A214A&gt;诡医&lt;/color&gt;无法对昭离自己或敌对目标使用，并会在目标身上建立持续30天的&lt;color=#7A2956&gt;因果链接&lt;/color&gt;。</description>
        <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_Flower_BlessingField</iconPath>

        <category>MX_ZhaoliSkill</category>
        <displayOrder>101</displayOrder>

