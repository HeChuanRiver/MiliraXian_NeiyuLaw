        </showIfHediffsPresent>
        <neverDisabled>true</neverDisabled>
    </StatDef>

    <StatDef>
        <defName>MX_QH_SpecialAbilityEffectFactor</defName>
        <label>法术效果系数</label>
        <description>特殊法术效果的倍率修正。影响清荷的技能伤害、通过技能和共鸣附加异常状态的效率和技能增益产生的效果量。</description>
        <workerClass>MiliraXian.Characters.StatWorker_Mutable</workerClass>
        <category>PawnCombat</category>
        <defaultBaseValue>1</defaultBaseValue>
        <toStringStyle>PercentZero</toStringStyle>
        <showIfHediffsPresent>
            <li>MX_QH_AuraMastery</li>
        </showIfHediffsPresent>
        <neverDisabled>true</neverDisabled>
    </StatDef>

