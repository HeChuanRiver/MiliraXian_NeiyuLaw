<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <StatDef>
        <defName>MX_QH_LotusShieldMaxEnergyFactor</defName>
        <label>灵气容量乘数</label>
        <description>灵气加护最大容量的倍率修正。</description>
        <workerClass>MiliraXian.Characters.StatWorker_Mutable</workerClass>
        <category>PawnCombat</category>
        <defaultBaseValue>1</defaultBaseValue>
        <toStringStyle>PercentZero</toStringStyle>
        <showIfHediffsPresent>
            <li>MX_QH_DivineProtection</li>
        </showIfHediffsPresent>
        <neverDisabled>true</neverDisabled>
    </StatDef>

    <StatDef>
        <defName>MX_QH_LotusShieldRegenPerSecondFactor</defName>
        <label>灵气回复乘数</label>
        <description>灵气每秒回复量的倍率修正。</description>
        <workerClass>MiliraXian.Characters.StatWorker_Mutable</workerClass>
        <category>PawnCombat</category>
        <defaultBaseValue>1</defaultBaseValue>
        <toStringStyle>PercentZero</toStringStyle>
        <showIfHediffsPresent>
            <li>MX_QH_DivineProtection</li>
        </showIfHediffsPresent>
        <neverDisabled>true</neverDisabled>
    </StatDef>

    <StatDef>
        <defName>MX_QH_LotusShieldHitRegenDelayFactor</defName>
        <label>灵气回复延迟乘数</label>
        <description>受击后灵气回复延迟的倍率修正。</description>
        <workerClass>MiliraXian.Characters.StatWorker_Mutable</workerClass>
        <category>PawnCombat</category>
        <defaultBaseValue>1</defaultBaseValue>
        <toStringStyle>PercentZero</toStringStyle>
        <showIfHediffsPresent>
            <li>MX_QH_DivineProtection</li>
        </showIfHediffsPresent>
        <neverDisabled>true</neverDisabled>
    </StatDef>

    <StatDef>
        <defName>MX_QH_LotusShieldBreakDelayOffset</defName>
        <label>灵气加护重启延迟偏移</label>
        <description>灵气耗尽后重新开始恢复的延迟加值修正。</description>
        <workerClass>MiliraXian.Characters.StatWorker_TicksToSeconds</workerClass>
        <category>PawnCombat</category>
        <defaultBaseValue>0</defaultBaseValue>
        <toStringStyle>FloatMaxOne</toStringStyle>
        <showIfHediffsPresent>
            <li>MX_QH_DivineProtection</li>
        </showIfHediffsPresent>
        <neverDisabled>true</neverDisabled>
    </StatDef>

    <StatDef>
        <defName>MX_QH_LotusShieldDamageCapFactor</defName>
        <label>灵气最大单次消耗乘数</label>
        <description>灵气单次消耗上限的倍率修正。此数值越大，单次消耗上限越高。</description>
        <workerClass>MiliraXian.Characters.StatWorker_Mutable</workerClass>
        <category>PawnCombat</category>
        <defaultBaseValue>0</defaultBaseValue>
        <minValue>0</minValue>
        <toStringStyle>PercentZero</toStringStyle>
        <showIfHediffsPresent>
            <li>MX_QH_DivineProtection</li>
        </showIfHediffsPresent>
        <neverDisabled>true</neverDisabled>
    </StatDef>

    <StatDef>
        <defName>MX_QH_LotusShieldDamageCapOffset</defName>
        <label>灵气最大单次消耗偏移</label>
        <description>灵气单次消耗上限的加值修正，基础值为20。此属性先于倍率应用；消耗上限乘数为0%时该特性不生效。</description>
        <workerClass>MiliraXian.Characters.StatWorker_Mutable</workerClass>
        <category>PawnCombat</category>
        <defaultBaseValue>20</defaultBaseValue>
        <toStringStyle>FloatOne</toStringStyle>
        <showIfHediffsPresent>
            <li>MX_QH_DivineProtection</li>
        </showIfHediffsPresent>
        <neverDisabled>true</neverDisabled>
    </StatDef>

    <StatDef>
        <defName>MX_QH_LotusShieldHardening</defName>
        <label>灵气硬化</label>
        <description>灵气硬化提供的额外护甲值，护盾受到的伤害会先减去护甲值，若原始伤害值小于护甲值，则伤害完全无效。</description>
        <workerClass>MiliraXian.Characters.StatWorker_Mutable</workerClass>
        <category>PawnCombat</category>
        <defaultBaseValue>0</defaultBaseValue>
        <minValue>0</minValue>
        <toStringStyle>FloatOne</toStringStyle>
        <showIfHediffsPresent>
            <li>MX_QH_DivineProtection</li>
        </showIfHediffsPresent>
        <neverDisabled>true</neverDisabled>
    </StatDef>

    <StatDef>
        <defName>MX_QH_LotusShieldHardeningFactor</defName>
        <label>灵气硬化乘数</label>
        <description>灵气硬化护甲值的倍率修正，该数值为0时护甲不会生效。</description>
        <workerClass>MiliraXian.Characters.StatWorker_Mutable</workerClass>
        <category>PawnCombat</category>
        <defaultBaseValue>0</defaultBaseValue>
        <minValue>0</minValue>
        <toStringStyle>PercentZero</toStringStyle>
        <showIfHediffsPresent>
            <li>MX_QH_DivineProtection</li>
        </showIfHediffsPresent>
        <neverDisabled>true</neverDisabled>
    </StatDef>

