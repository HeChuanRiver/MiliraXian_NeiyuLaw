    </StatDef>

    <StatDef ParentName="MX_AbnormalFactorBase">
        <defName>MX_AbnormalColdLimitFactor</defName>
        <label>寒冷积累上限乘数</label>
        <description>触发冻结效果所需异常积累量的乘数。数值为0时，寒冷异常无效。</description>
        <parts>
            <li Class="MiliraXian.Characters.ComfyTemperatureFactor">
                <scaleStart>0</scaleStart>
                <scaleZero>-100</scaleZero>
            </li>
            <li Class="MiliraXian.Characters.FactorIfMechanoid"><factor>3.3333333</factor></li>
            <li Class="MiliraXian.Characters.MechanoidBodySizeFactor">
                <resistanceCurve>
                    <points>
                        <li>(1.0, 0.0)</li>
                        <li>(2.0, 0.20)</li>
                        <li>(4.0, 0.55)</li>
                    </points>
                </resistanceCurve>
                <maxResistance>0.90</maxResistance>
            </li>
        </parts>
    </StatDef>

    <StatDef ParentName="MX_AbnormalFactorBase">
        <defName>MX_AbnormalColdEfficiencyFactor</defName>
        <label>寒冷附加效率乘数</label>
        <description>该角色施加寒冷异常积累量时使用的效率乘数。</description>
    </StatDef>

    <StatDef ParentName="MX_AbnormalFactorBase">
        <defName>MX_AbnormalDeathSentenceLimitFactor</defName>
        <label>告死积累上限乘数</label>
        <description>触发告死效果所需异常积累量的乘数。数值为0时，告死异常无效。</description>
    </StatDef>

    <StatDef ParentName="MX_AbnormalFactorBase">
        <defName>MX_AbnormalDeathSentenceEfficiencyFactor</defName>
