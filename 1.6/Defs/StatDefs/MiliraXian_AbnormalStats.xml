<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <StatDef Name="MX_AbnormalFactorBase" Abstract="True">
        <workerClass>MiliraXian.Characters.StatWorker_Mutable</workerClass>
        <category>PawnCombat</category>
        <defaultBaseValue>1</defaultBaseValue>
        <minValue>0</minValue>
        <hideAtValue>1</hideAtValue>
        <toStringStyle>PercentZero</toStringStyle>
        <showOnPawns>true</showOnPawns>
        <showIfUndefined>true</showIfUndefined>
        <neverDisabled>true</neverDisabled>
    </StatDef>

    <StatDef ParentName="MX_AbnormalFactorBase">
        <defName>MX_AbnormalBleedLimitFactor</defName>
        <label>流血积累上限乘数</label>
        <description>触发流血效果所需异常积累量的乘数。数值为0时，流血异常无效。</description>
        <parts>
            <li Class="MiliraXian.Characters.FactorIfMechanoid"><factor>0</factor></li>
            <li Class="MiliraXian.Characters.FactorIfNotFlesh"><factor>0</factor></li>
            <li Class="MiliraXian.Characters.FactorIfCannotBleed"><factor>0</factor></li>
            <li Class="MiliraXian.Characters.NaturalSharpArmorFactor">
                <resistanceCurve>
                    <points>
                        <li>(0.00, 0.00)</li>
                        <li>(0.30, 0.10)</li>
                        <li>(0.60, 0.25)</li>
                        <li>(1.00, 0.45)</li>
                        <li>(1.50, 0.65)</li>
                        <li>(2.00, 0.80)</li>
                        <li>(10.00, 0.80)</li>
                    </points>
                </resistanceCurve>
            </li>
            <li Class="MiliraXian.Characters.BodySizeFactor">
                <multiplierCurve>
                    <points>
                        <li>(0.20, 0.55)</li>
                        <li>(0.50, 0.80)</li>
                        <li>(1.00, 1.00)</li>
                    </points>
                </multiplierCurve>
            </li>
        </parts>
    </StatDef>

    <StatDef ParentName="MX_AbnormalFactorBase">
        <defName>MX_AbnormalBleedEfficiencyFactor</defName>
        <label>流血附加效率乘数</label>
        <description>该角色施加流血异常积累量时使用的效率乘数。</description>
    </StatDef>

    <StatDef ParentName="MX_AbnormalFactorBase">
        <defName>MX_AbnormalElectricLeakLimitFactor</defName>
        <label>电漏积累上限乘数</label>
        <description>触发短路效果所需异常积累量的乘数。数值为0时，电漏异常无效。</description>
        <parts>
            <li Class="MiliraXian.Characters.FactorIfNotMechanoid"><factor>0</factor></li>
            <li Class="MiliraXian.Characters.FactorIfMilian"><factor>3.3333333</factor></li>
            <li Class="MiliraXian.Characters.BodySizeFactor">
                <skipMilian>true</skipMilian>
                <multiplierCurve>
                    <points>
                        <li>(1.0, 1.0)</li>
                        <li>(2.0, 0.65)</li>
                        <li>(4.0, 0.10)</li>
                    </points>
                </multiplierCurve>
            </li>
        </parts>
    </StatDef>

    <StatDef ParentName="MX_AbnormalFactorBase">
        <defName>MX_AbnormalElectricLeakEfficiencyFactor</defName>
        <label>电漏附加效率乘数</label>
        <description>该角色施加电漏异常积累量时使用的效率乘数。</description>
    </StatDef>

    <StatDef ParentName="MX_AbnormalFactorBase">
        <defName>MX_AbnormalToxinLimitFactor</defName>
        <label>毒素积累上限乘数</label>
        <description>触发剧毒效果所需异常积累量的乘数。数值为0时，毒素异常无效。</description>
        <parts>
            <li Class="MiliraXian.Characters.FactorIfMechanoid"><factor>0</factor></li>
            <li Class="MiliraXian.Characters.ResistanceStatFactor"><stat>ToxicResistance</stat></li>
            <li Class="MiliraXian.Characters.ResistanceStatFactor"><stat>ToxicEnvironmentResistance</stat></li>
        </parts>
    </StatDef>

    <StatDef ParentName="MX_AbnormalFactorBase">
        <defName>MX_AbnormalToxinEfficiencyFactor</defName>
        <label>毒素附加效率乘数</label>
        <description>该角色施加毒素异常积累量时使用的效率乘数。</description>
    </StatDef>

    <StatDef ParentName="MX_AbnormalFactorBase">
        <defName>MX_AbnormalCorrosionLimitFactor</defName>
        <label>腐蚀积累上限乘数</label>
        <description>触发腐蚀效果所需异常积累量的乘数。数值为0时，腐蚀异常无效。</description>
        <parts>
            <li Class="MiliraXian.Characters.FactorIfNotMechanoid"><factor>0</factor></li>
            <li Class="MiliraXian.Characters.BodySizeFactor">
                <multiplierCurve>
                    <points>
                        <li>(1.0, 1.0)</li>
                        <li>(2.0, 0.80)</li>
                        <li>(4.0, 0.45)</li>
                    </points>
                </multiplierCurve>
            </li>
            <li Class="MiliraXian.Characters.FactorIfHasApparel"><factor>1.25</factor></li>
        </parts>
    </StatDef>

    <StatDef ParentName="MX_AbnormalFactorBase">
        <defName>MX_AbnormalCorrosionEfficiencyFactor</defName>
        <label>腐蚀附加效率乘数</label>
        <description>该角色施加腐蚀异常积累量时使用的效率乘数。</description>
    </StatDef>

    <StatDef ParentName="MX_AbnormalFactorBase">
