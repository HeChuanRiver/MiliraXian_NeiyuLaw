        <parts>
            <li Class="MiliraXian.Characters.FactorIfMechanoid"><factor>0</factor></li>
            <li Class="MiliraXian.Characters.PawnStatFactor">
                <stat>PsychicSensitivity</stat>
                <multiplierCurve>
                    <points>
                        <li>(0.0, 0.0)</li>
                        <li>(1.0, 1.0)</li>
                        <li>(2.0, 1.5)</li>
                        <li>(3.0, 2.0)</li>
                    </points>
                </multiplierCurve>
            </li>
        </parts>
    </StatDef>

    <StatDef ParentName="MX_AbnormalFactorBase">
        <defName>MX_AbnormalFearEfficiencyFactor</defName>
        <label>恐惧附加效率乘数</label>
        <description>该角色施加恐惧异常积累量时使用的效率乘数。</description>
    </StatDef>

