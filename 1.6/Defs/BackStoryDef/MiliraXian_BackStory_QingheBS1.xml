    <AlienRace.AlienBackstoryDef>
        <defName>MiliraXian_BackStoryChild_Qinghe_BS1</defName>
        <title>霓羽仙的门生</title>
        <titleShort>霓羽仙的门生</titleShort>
        <description>[PAWN_nameDef] 自幼与各种花卉为伴，在“霁”的六大派系中她与“生命”共鸣最深。从她第一次聆听花语开始，它们就成为了她生命中的一部分。出于对霁能的高度亲和和自幼就表现出的天赋，她成了霓羽的第一批学生之一，并取得了相当优秀的修行成果。\n\n“哎呀……说到我跟随老师学习时候的事……那可以写一整本书呢。”</description>
        <slot>Childhood</slot>
        <skillGains>
            <Cooking>12</Cooking>
            <Plants>8</Plants>
            <Crafting>2</Crafting>
            <Artistic>8</Artistic>
            <Medicine>2</Medicine>
            <Social>2</Social>
            <Intellectual>4</Intellectual>
        </skillGains>
        <spawnCategories>
            <li>MiliraXian_BackStoryChild_Qinghe_Tag</li>
        </spawnCategories>
        <workDisables>
        </workDisables>
        <bodyTypeFemale>Female</bodyTypeFemale>
        <bodyTypeMale>Female</bodyTypeMale>
    </AlienRace.AlienBackstoryDef>

