<Defs>

    <!-- 仙米BS1 -->
    <AlienRace.AlienBackstoryDef>
        <defName>MiliraXian_BackStoryChild_Neiyu_BS1</defName>
        <title>高位投影</title>
        <titleShort>高位投影</titleShort>
        <description>[PAWN_nameDef] 来自何处我们无法考究，但是按照她所说，她是更高层次在这个宇宙的众多投影之一，但是毫无疑问的是，她是一位纯正的米莉拉。&#10;“诶，你在看我的童年经历嘛，这可是个秘密，这样叭，如果你是想要这个的话~”&#10;“这下你应该满意了吧~可不要太贪心喔。”</description>
        <slot>Childhood</slot>
        <skillGains>
            <Shooting>6</Shooting>
            <Melee>6</Melee>
            <Construction>6</Construction>
            <Mining>6</Mining>
            <Cooking>-6</Cooking>
            <Plants>6</Plants>
            <Animals>6</Animals>
            <Crafting>6</Crafting>
            <Artistic>6</Artistic>
            <Medicine>6</Medicine>
            <Social>6</Social>
            <Intellectual>6</Intellectual>
        </skillGains>
        <spawnCategories>
            <li>MiliraXian_BackStoryChild_Neiyu_Tag</li>
        </spawnCategories>
        <workDisables>
        </workDisables>
        <bodyTypeFemale>Female</bodyTypeFemale>
        <bodyTypeMale>Female</bodyTypeMale>
    </AlienRace.AlienBackstoryDef>

    <AlienRace.AlienBackstoryDef>
        <defName>MiliraXian_BackStoryAdult_Neiyu_BS1</defName>
        <title>观测者</title>
        <titleShort>观测者</titleShort>
        <description>[PAWN_nameDef] 总是喜欢在各种视线开阔的地方注视着某个方向静静地发呆。虽然按她所说，整个行星乃至恒星系的一举一动都在她的感知下，但是她还是喜欢这种静静观测世界发展的感觉。&#10;“你怎么还在看！！好吧好吧，我不介意，欸嘿。”</description>
        <slot>Adulthood</slot>
        <skillGains>
            <Shooting>14</Shooting>
            <Melee>14</Melee>
            <Construction>14</Construction>
            <Mining>14</Mining>
            <Cooking>2147483640</Cooking>
            <Plants>14</Plants>
            <Animals>14</Animals>
            <Crafting>14</Crafting>
            <Artistic>14</Artistic>
            <Medicine>14</Medicine>
            <Social>14</Social>
            <Intellectual>14</Intellectual>
        </skillGains>

