<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>MX_QH_LongBreath</defName>
        <label>长息</label>
        <description>受到致命伤害或摧毁身体部件的伤害时，若长息不在冷却中，抵消此次伤害、修复自身所有损伤，同时获得3秒无敌和10秒心灵隐形（若可用）。</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(0.6, 1.0, 0.8)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
        <comps>
            <li Class="MiliraXian.Characters.QingHe.Hediffs.HediffCompProperties_LongBreathWard">
                <lethalTriggerHealthPercent>0.12</lethalTriggerHealthPercent>
                <minimumDamageForLethalCheck>8</minimumDamageForLethalCheck>
                <invisibilityDurationTicks>600</invisibilityDurationTicks>
                <damageImmunityDurationTicks>180</damageImmunityDurationTicks>
                <damageImmunityHediffDef>MX_QH_LongBreathDamageImmunity</damageImmunityHediffDef>
                <retriggerCooldownTicks>3600</retriggerCooldownTicks>
                <cooldownWarningCooldownTicks>600</cooldownWarningCooldownTicks>
            </li>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>MX_QH_LongBreathDamageImmunity</defName>
        <label>长息涌流</label>
        <description>长息触发后获得的短暂免疫伤害效果。</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(0.6, 1.0, 1.0)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>180</disappearsAfterTicks>
            </li>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>MX_QH_LotusShield</defName>
        <label>花神护体</label>
        <description>清荷受到十二花神的眷顾，能在身边自然产生护盾。\n\n护盾被击碎时会失效20秒。</description>
        <hediffClass>MiliraXian.Characters.QingHe.Hediffs.Hediff_LotusShield</hediffClass>
        <defaultLabelColor>(1.0, 0.75, 1.0)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
        <comps>
            <li Class="MiliraXian.Characters.QingHe.Hediffs.HediffCompProperties_LotusShield">
                <shieldCompProperties>
                    <maxEnergy>100</maxEnergy>
                    <baseDamagePerShieldPoint>1</baseDamagePerShieldPoint>
                    <baseRegenPerSecond>2</baseRegenPerSecond>
                    <breakDisabledTicks>1200</breakDisabledTicks>
                    <breakOnEmp>false</breakOnEmp>
                    <absorbFleckDefName>MXNL_Fleck_NeiyuShield_Hurt_A</absorbFleckDefName>
                    <absorbFleckScale>0.6</absorbFleckScale>
                    <fullEnergyFadeOutTicks>90</fullEnergyFadeOutTicks>
                    <activeShieldTexPath>MiliraXianNeiyu/Effect/Neiyu_Shield/Shield</activeShieldTexPath>
                    <activeShieldDrawSize>(1.9,1.9)</activeShieldDrawSize>
                    <activeShieldAlpha>0.45</activeShieldAlpha>
                    <activeShieldAltitudeOffset>0</activeShieldAltitudeOffset>
                    <minDrawScale>1.0</minDrawScale>
                    <maxDrawScale>1.0</maxDrawScale>
                </shieldCompProperties>
            </li>
        </comps>
    </HediffDef>

</Defs>

