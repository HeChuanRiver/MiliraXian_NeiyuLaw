<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>MX_QH_LuoshenContract</defName>
        <label>洛神契</label>
        <description>隐藏状态：记录清荷与配偶之间的洛神契绑定。</description>
        <hediffClass>Verse.HediffWithTarget</hediffClass>
        <defaultLabelColor>(0.72, 0.90, 0.80)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
        <initialSeverity>1.0</initialSeverity>
        <minSeverity>1.0</minSeverity>
        <maxSeverity>1.0</maxSeverity>
        <comps>
            <li Class="MiliraXian.Characters.QingHe.Hediffs.HediffCompProperties_LuoshenContract" />
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>MX_QH_SpringFlow</defName>
        <label>春泉洗礼</label>
        <description>沐浴在春泉之中，&lt;color=#FF69B4&gt;近战与远程伤害提升、受到的伤害降低、疼痛感减轻&lt;/color&gt;。</description>
        <isBad>false</isBad>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(1.0, 0.8, 1.0)</defaultLabelColor>
        <initialSeverity>1.0</initialSeverity>
        <minSeverity>1.0</minSeverity>
        <maxSeverity>1.0</maxSeverity>
        <stages>
            <li>
                <minSeverity>0.0</minSeverity>
                <painFactor>0.8</painFactor>
                <statFactors>
                    <MeleeDamageFactor>1.3</MeleeDamageFactor>
                    <RangedWeapon_DamageMultiplier>1.3</RangedWeapon_DamageMultiplier>
                    <IncomingDamageFactor>0.6</IncomingDamageFactor>
                </statFactors>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>120</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
            <li Class="MiliraXian.Characters.QingHe.Hediffs.HediffCompProperties_SpringRegen">
                <healIntervalTicks>60</healIntervalTicks>
                <healAmountPerTrigger>1.0</healAmountPerTrigger>
                <healPermanentInjuries>false</healPermanentInjuries>
            </li>
            <li Class="HediffCompProperties_Effecter">
                <stateEffecter>MX_QH_Effecter_SpringFlowHediff</stateEffecter>
            </li>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>MX_QH_FlowerDance</defName>
        <label>花舞</label>
        <description>清荷进入花舞状态，移动速度、闪避与花令回复提升，花神之眷顾在受击后立即开始回充。</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(1.0, 0.72, 0.92)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
        <initialSeverity>1.0</initialSeverity>
        <minSeverity>1.0</minSeverity>
        <maxSeverity>1.0</maxSeverity>
        <stages>
            <li>
                <statOffsets>
                    <MoveSpeed>0.35</MoveSpeed>
                    <MeleeDodgeChance>0.20</MeleeDodgeChance>
                </statOffsets>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>900</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
            <li Class="MiliraXian.Characters.QingHe.Hediffs.HediffCompProperties_FlowerDance">
                <activeEffecter>MX_QH_Effecter_FlowerDivinationActive</activeEffecter>
                <afterimageIntervalTicks>6</afterimageIntervalTicks>
                <afterimageFadeTicks>60</afterimageFadeTicks>
                <afterimageStartAlpha>0.44</afterimageStartAlpha>
                <afterimageMinDistance>0.55</afterimageMinDistance>
            </li>
        </comps>
    </HediffDef>
</Defs>
