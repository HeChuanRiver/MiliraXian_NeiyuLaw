<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>MX_QH_SeasonResonance</defName>
        <label>四时共鸣</label>
        <description>隐藏 Hediff：保存清荷当前调谐的四时共鸣与总调谐度。</description>
        <hediffClass>MiliraXian.Characters.QingHe.Hediffs.Hediff_SeasonResonance</hediffClass>
        <defaultLabelColor>(0.72, 0.90, 0.80)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
        <initialSeverity>1.0</initialSeverity>
        <minSeverity>1.0</minSeverity>
        <maxSeverity>1.0</maxSeverity>
        <comps>
            <li Class="MiliraXian.Characters.QingHe.Hediffs.HediffCompProperties_SeasonResonance">
                <initialAttunedSeason>None</initialAttunedSeason>
                <initialAttunement>0</initialAttunement>
                <maxAttunement>100</maxAttunement>
                <onlyWhenSelected>true</onlyWhenSelected>
                <defaultFlowerMandateLabel>飞花令</defaultFlowerMandateLabel>
                <defaultFlowerMandateDesc>清荷尚未调谐四时共鸣，暂时无法回应花神。</defaultFlowerMandateDesc>
                <defaultFlowerMandateDisabledReason>尚未调谐四时共鸣。</defaultFlowerMandateDisabledReason>
