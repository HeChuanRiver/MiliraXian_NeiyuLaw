<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>MX_QH_SeasonResonance</defName>
        <label>四时共鸣</label>
        <description>隐藏 Hediff：保存清荷当前调谐的四时共鸣与各时节调谐度。</description>
        <hediffClass>MiliraXian.Characters.QingHe.Hediffs.Hediff_SeasonResonance</hediffClass>
        <defaultLabelColor>(0.72, 0.90, 0.80)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
        <comps>
            <li Class="MiliraXian.Characters.QingHe.Hediffs.HediffCompProperties_SeasonResonance">
                <initialAttunedSeason>None</initialAttunedSeason>
                <initialSpringAttunement>0</initialSpringAttunement>
                <initialSummerAttunement>0</initialSummerAttunement>
                <initialAutumnAttunement>0</initialAutumnAttunement>
                <initialWinterAttunement>0</initialWinterAttunement>
                <maxAttunement>100</maxAttunement>
                <onlyWhenSelected>true</onlyWhenSelected>
                <defaultFlowerMandateLabel>飞花令</defaultFlowerMandateLabel>
                <defaultFlowerMandateDesc>清荷尚未调谐四时共鸣，暂时无法回应花神。</defaultFlowerMandateDesc>
                <defaultFlowerMandateDisabledReason>尚未调谐四时共鸣。</defaultFlowerMandateDisabledReason>
            </li>
            <li Class="MiliraXian.Characters.QingHe.Hediffs.HediffCompProperties_FlowerGodDescent">
                <activeDurationTicks>600</activeDurationTicks>
                <cooldownTicks>3600</cooldownTicks>
                <startReady>true</startReady>
                <activeLabel>花神降临</activeLabel>
                <noResonanceReason>尚未调谐四时共鸣。</noResonanceReason>
                <alreadyActiveReason>花神已经降临。</alreadyActiveReason>
                <cooldownReason>花神降临仍在冷却中。</cooldownReason>
                <activatedMessage>花神降临。</activatedMessage>
            </li>
        </comps>
    </HediffDef>
</Defs>
