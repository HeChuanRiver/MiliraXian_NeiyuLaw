<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- 技能相关 -->
    <!-- 涌泉 -->
    <HediffDef>
        <defName>MX_SpringFlow</defName>
        <label>春泉洗礼</label>
        <description>沐浴在春泉之中，&lt;color=#FF69B4&gt;近战与远程伤害提升、受到的伤害降低、疼痛感减轻&lt;/color&gt;。效果强度受&lt;color=#EB6BFF&gt;雅乐&lt;/color&gt;影响。</description>
        <isBad>false</isBad>
        <hediffClass>MiliraXian.Characters.QingHe.Hediff_SpringFlow</hediffClass>
        <defaultLabelColor>(1.0, 0.8, 1.0)</defaultLabelColor>
        <initialSeverity>1.0</initialSeverity>
        <minSeverity>1.0</minSeverity>
        <maxSeverity>1.0</maxSeverity>
        <stages>
            <li>
                <minSeverity>0.0</minSeverity>
                <painFactor>0.8</painFactor>
                <statFactors>
                    <MeleeDamageFactor>1.3</MeleeDamageFactor>
                    <RangedWeapon_DamageMultiplier>1.3</RangedWeapon_DamageMultiplier>
                    <IncomingDamageFactor>0.6</IncomingDamageFactor>
                </statFactors>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>120</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
            <li Class="MiliraXian.Characters.HediffCompProperties_PawnResourceScaling">
                <statFactorMultiplier>
                    <baseValue>1</baseValue>
                    <min>1.0</min>
                    <max>2.0</max>
                    <resourceDef>MX_QH_Elegance</resourceDef>
                    <method>linear</method>
                </statFactorMultiplier>
                <painFactor>
                    <baseValue>1</baseValue>
                    <min>0.8</min>
                    <max>0.5</max>
                    <resourceDef>MX_QH_Elegance</resourceDef>
                    <method>linear</method>
                </painFactor>
            </li>
            <li Class="HediffCompProperties_Effecter">
                <stateEffecter>MX_QH_Effecter_SpringFlowHediff</stateEffecter>
            </li>
        </comps>
    </HediffDef>
    
    <!-- 水镜 -->
    <HediffDef>
        <defName>MX_AquaMirror</defName>
        <label>镜华</label>
        <description>水镜护体，可抵挡伤害。护盾破碎或持续时间结束时，&lt;color=#FF69B4&gt;治疗自身伤口并对周围敌方造成伤害&lt;/color&gt;，同时积累&lt;color=#6B61FF&gt;激流&lt;/color&gt;。护盾强度、治疗量和伤害受&lt;color=#EB6BFF&gt;雅乐&lt;/color&gt;影响。</description>
        <isBad>false</isBad>
        <hediffClass>MiliraXian.Characters.QingHe.Hediff_AquaMirror</hediffClass>
        <defaultLabelColor>(0.4, 0.4, 1.0)</defaultLabelColor>
        <initialSeverity>1.0</initialSeverity>
        <minSeverity>1.0</minSeverity>
        <maxSeverity>1.0</maxSeverity>
        <stages>
            <li>
                <minSeverity>0.0</minSeverity>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>600</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
            <li Class="MiliraXian.Characters.QingHe.HediffCompProperties_AquaMirror">
                <explosionRadius>3</explosionRadius>
                <tempestPerMirror>5</tempestPerMirror>
                <shieldCompProperties>
                    <startingEnergy>100.0</startingEnergy>
                    <energyLossPerDamage>1.0</energyLossPerDamage>
                    <breakOnEmp>false</breakOnEmp>
                    <playBreakEffects>true</playBreakEffects>
                    <absorbFleckDefName>ExplosionFlash</absorbFleckDefName>
                    <hurtFleckDefNames>
                        <li>MXNL_Fleck_NeiyuShield_Hurt_A</li>
                        <li>MXNL_Fleck_NeiyuShield_Hurt_B</li>
                        <li>MXNL_Fleck_NeiyuShield_Hurt_C</li>
                        <li>MXNL_Fleck_NeiyuShield_Hurt_D</li>
                    </hurtFleckDefNames>
                    <absorbFleckScale>1.2</absorbFleckScale>
                    <drawActiveShield>true</drawActiveShield>
                    <activeShieldTexPath>MiliraXianNeiyu/Effect/Neiyu_Shield/Shield</activeShieldTexPath>
                    <activeShieldDrawSize>(1.8,1.8)</activeShieldDrawSize>
                    <activeShieldAlpha>0.35</activeShieldAlpha>
                    <activeShieldAltitudeOffset>0.0</activeShieldAltitudeOffset>
                    <activeShieldPulseMin>0.96</activeShieldPulseMin>
                    <activeShieldPulseMax>1.06</activeShieldPulseMax>
                    <activeShieldPulseTicks>75</activeShieldPulseTicks>
                    <minDrawSize>1.0</minDrawSize>
                    <maxDrawSize>1.15</maxDrawSize>
                </shieldCompProperties>
            </li>
            <li Class="MiliraXian.Characters.HediffCompProperties_PawnResourceScaling">
                <shieldValue>
                    <baseValue>100</baseValue>
                    <min>1.0</min>
                    <max>2.0</max>
                    <resourceDef>MX_QH_Elegance</resourceDef>
                    <method>linear</method>
                </shieldValue>
                <healAmount>
                    <baseValue>10</baseValue>
                    <min>1.0</min>
                    <max>2.0</max>
                    <resourceDef>MX_QH_Elegance</resourceDef>
                    <method>linear</method>
                </healAmount>
                <damageAmount>
                    <baseValue>10</baseValue>
                    <min>1.0</min>
                    <max>2.0</max>
                    <resourceDef>MX_QH_Elegance</resourceDef>
                    <method>linear</method>
                </damageAmount>
            </li>
        </comps>
    </HediffDef>

    <!-- 扼流——基础效果 -->
    <HediffDef>
        <defName>MX_Draining</defName>
        <label>水循环断流</label>
        <description>内部的液体被强制抽出，意识逐渐模糊，行动迟缓。积累至最大值时，受到的伤害将大幅增加。</description>
        <isBad>true</isBad>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.8, 0.6, 1.0)</defaultLabelColor>
        <initialSeverity>0.01</initialSeverity>
        <minSeverity>0.0</minSeverity>
        <maxSeverity>1.0</maxSeverity>
        <alwaysShowSeverity>true</alwaysShowSeverity>
        <stages>
            <li>
                <minSeverity>0.0</minSeverity>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.9</postFactor>
                    </li>
                </capMods>
                <statFactors>
                    <MoveSpeed>0.8</MoveSpeed>
                </statFactors>
            </li>
            <li>
                <minSeverity>0.2</minSeverity>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.7</postFactor>
                    </li>
                </capMods>
                <statFactors>
                    <MoveSpeed>0.6</MoveSpeed>
                </statFactors>
            </li>
            <li>
                <minSeverity>0.4</minSeverity>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.5</postFactor>
                    </li>
                </capMods>
            </li>
            <li>
                <minSeverity>0.6</minSeverity>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.3</postFactor>
                    </li>
                </capMods>
                <statFactors>
                    <MoveSpeed>0.4</MoveSpeed>
                </statFactors>
            </li>
            <li>
                <minSeverity>0.8</minSeverity>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.1</postFactor>
                    </li>
                </capMods>
            </li>
            <li>
                <minSeverity>0.99</minSeverity>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.1</postFactor>
                    </li>
                </capMods>
                <statFactors>
                    <IncomingDamageFactor>2.5</IncomingDamageFactor>
                </statFactors>
            </li>
        </stages>
        <comps>
            <li Class="MiliraXian.Characters.HediffCompProperties_SeverityPerSecondPausable">
                <severityPerSecond>-0.05</severityPerSecond>
            </li>
            <li Class="MiliraXian.Characters.QingHe.HediffCompProperties_DrainAccumulate">
                <maxTicksToFilth>400</maxTicksToFilth>
                <minTicksToFilth>200</minTicksToFilth>
                <filthRadius>1</filthRadius>
            </li>
        
            <li Class="HediffCompProperties_Effecter">
                <stateEffecter>MX_QH_Effecter_DrainHediff</stateEffecter>
            </li>
        </comps>
    </HediffDef>

    <!-- 扼流——尸体效果 -->
    <HediffDef>
        <defName>MX_DryCorpse</defName>
        <label>脱水</label>
        <description>一具水分被抽干的尸体，永远不会腐烂或风干。似乎受到了什么超自然力量的影响。</description>
        <isBad>true</isBad>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.6, 0.2, 0.8)</defaultLabelColor>
        <initialSeverity>1.0</initialSeverity>
        <minSeverity>0.0</minSeverity>
        <maxSeverity>1.0</maxSeverity>
        <stages>
            <li>
                <minSeverity>0.0</minSeverity>
            </li>
        </stages>
        <comps>
            <li Class="MiliraXian.Characters.QingHe.HediffCompProperties_DryCorpseEffect">
                <corpseColor>(255, 0, 255)</corpseColor>
            </li>
        </comps>
    </HediffDef>
</Defs>
