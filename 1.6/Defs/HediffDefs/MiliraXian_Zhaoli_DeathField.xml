<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <HediffDef>
        <defName>MXZL_ZhaoliDeathFieldActive</defName>
        <label>&lt;color=#A11228&gt;告死流场&lt;/color&gt;</label>
        <description>&lt;color=#A11228&gt;昭离&lt;/color&gt;维持中的&lt;color=#A11228&gt;告死流场&lt;/color&gt;，会持续压制范围内除自身外的一切单位。</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(0.72, 0.06, 0.12)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <initialSeverity>1</initialSeverity>
        <minSeverity>1</minSeverity>
        <maxSeverity>1</maxSeverity>
        <comps>
            <li Class="Verse.HediffCompProperties_Disappears">
                <disappearsAfterTicks>900</disappearsAfterTicks>
                <showRemainingTime>false</showRemainingTime>
            </li>
            <li Class="MiliraXian.Characters.Zhaoli.HediffCompProperties_ZhaoliDeathField">
                <radius>9</radius>
                <fieldDurationTicks>900</fieldDurationTicks>
                <bleedIntervalTicks>180</bleedIntervalTicks>
                <bleedDamage>3</bleedDamage>
                <bleedDamageDef>Cut</bleedDamageDef>
                <executeStayTicks>900</executeStayTicks>
                <slowHediff>MXZL_ZhaoliDeathFieldSlow</slowHediff>
                <slowRefreshTicks>90</slowRefreshTicks>
                <karmaPerExecution>1</karmaPerExecution>
            </li>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>MXZL_ZhaoliDeathFieldSlow</defName>
        <label>&lt;color=#5E1335&gt;告死滞压&lt;/color&gt;</label>
        <description>身处&lt;color=#5E1335&gt;告死流场&lt;/color&gt;之中，行动会被明显压制，难以脱离这片&lt;color=#2C0F18&gt;黑红领域&lt;/color&gt;。</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(0.58, 0.08, 0.16)</defaultLabelColor>
        <isBad>true</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <initialSeverity>1</initialSeverity>
        <minSeverity>1</minSeverity>
        <maxSeverity>1</maxSeverity>
        <stages>
            <li>
                <minSeverity>0</minSeverity>
                <statFactors>
                    <MoveSpeed>0.80</MoveSpeed>
                </statFactors>
            </li>
        </stages>
        <comps>
            <li Class="Verse.HediffCompProperties_Disappears">
                <disappearsAfterTicks>90</disappearsAfterTicks>
                <showRemainingTime>false</showRemainingTime>
            </li>
        </comps>
    </HediffDef>

</Defs>
