<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThoughtDef>
        <defName>MX_Neiyu_FlowerBlessedThought</defName>
        <durationDays>0.5</durationDays>
        <stackLimit>1</stackLimit>
        <thoughtClass>Thought_Memory</thoughtClass>
        <stages>
            <li>
                <label>花祝福</label>
                <description>沐浴在&lt;color=#79CBFF&gt;霓羽&lt;/color&gt;的&lt;color=#F39AD9&gt;花祝福&lt;/color&gt;之中。</description>
                <baseMoodEffect>12</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <HediffDef>
        <defName>MX_Neiyu_FlowerBlessed</defName>
        <label>花祝福</label>
        <description>来自&lt;color=#79CBFF&gt;霓羽&lt;/color&gt;花形态技能的&lt;color=#F39AD9&gt;花祝福&lt;/color&gt;，会短时间强化自身状态。</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.96, 0.60, 0.92)</defaultLabelColor>
        <isBad>false</isBad>
        <initialSeverity>1</initialSeverity>
        <minSeverity>1</minSeverity>
        <maxSeverity>1</maxSeverity>
        <stages>
            <li>
                <minSeverity>0</minSeverity>
                <label>花祝福</label>
                <statFactors>
                    <MoveSpeed>1.20</MoveSpeed>
                    <IncomingDamageFactor>0.90</IncomingDamageFactor>
                    <ImmunityGainSpeed>1.70</ImmunityGainSpeed>
                </statFactors>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>18000</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>MX_Neiyu_SwordVulnerability</defName>
        <label>剑坠易伤</label>
        <description>受到&lt;color=#8BD5FF&gt;剑落冲击&lt;/color&gt;后，短时间内会承受更高伤害。</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.86, 0.52, 0.88)</defaultLabelColor>
        <isBad>true</isBad>
        <initialSeverity>1</initialSeverity>
        <minSeverity>1</minSeverity>
        <maxSeverity>1</maxSeverity>
        <stages>
            <li>
                <minSeverity>0</minSeverity>
                <label>易伤</label>
                <statFactors>
                    <IncomingDamageFactor>1.25</IncomingDamageFactor>
                </statFactors>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>9000</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
    </HediffDef>

</Defs>
