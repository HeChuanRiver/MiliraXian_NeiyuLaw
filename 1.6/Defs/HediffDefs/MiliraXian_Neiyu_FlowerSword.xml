<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThoughtDef>
        <defName>MX_Neiyu_FlowerBlessedThought</defName>
        <durationDays>0.5</durationDays>
        <stackLimit>1</stackLimit>
        <thoughtClass>Thought_Memory</thoughtClass>
        <stages>
            <li>
                <label>&lt;color=#F39AD9&gt;花祝福&lt;/color&gt;</label>
                <description>沐浴在&lt;color=#79CBFF&gt;霓羽&lt;/color&gt;的&lt;color=#F39AD9&gt;花祝福&lt;/color&gt;之中。</description>
                <baseMoodEffect>12</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <HediffDef>
        <defName>MX_Neiyu_FlowerBlessed</defName>
        <label>&lt;color=#F39AD9&gt;花祝福&lt;/color&gt;</label>
        <description>Blessing lasts 60 seconds, improving movement and immunity gain while reducing incoming damage.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.96, 0.60, 0.92)</defaultLabelColor>
        <isBad>false</isBad>
        <initialSeverity>1</initialSeverity>
        <minSeverity>1</minSeverity>
        <maxSeverity>1</maxSeverity>
        <stages>
            <li>
                <minSeverity>0</minSeverity>
                <label>&lt;color=#F39AD9&gt;花祝福&lt;/color&gt;</label>
                <statFactors>
                    <MoveSpeed>1.20</MoveSpeed>
                    <IncomingDamageFactor>0.90</IncomingDamageFactor>
                    <ImmunityGainSpeed>1.70</ImmunityGainSpeed>
                </statFactors>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>3600</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>MX_Neiyu_SwordVulnerability</defName>
        <label>&lt;color=#C7A2F8&gt;剑坠易伤&lt;/color&gt;</label>
        <description>Skyfall increases damage taken for 25 seconds.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.86, 0.52, 0.88)</defaultLabelColor>
        <isBad>true</isBad>
        <initialSeverity>1</initialSeverity>
        <minSeverity>1</minSeverity>
        <maxSeverity>1</maxSeverity>
        <stages>
            <li>
                <minSeverity>0</minSeverity>
                <label>&lt;color=#C7A2F8&gt;易伤&lt;/color&gt;</label>
                <statFactors>
                    <IncomingDamageFactor>1.25</IncomingDamageFactor>
                </statFactors>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>1500</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
    </HediffDef>

</Defs>
