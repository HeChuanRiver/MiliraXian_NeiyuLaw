<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <HediffDef>
        <defName>MXZL_ZhaoliShieldLayers</defName>
        <label>&lt;color=#D66BFF&gt;讳亡护盾&lt;/color&gt;</label>
        <description>每通过告死吸纳一个单位，获得5层讳亡护盾。
护盾抵挡伤害，每36点消耗1层，向上取整，至少消耗1层。剩余层数不足时，耗尽护盾并抵挡本次伤害。持续伤害每次生效时单独计算。</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(0.66, 0.10, 0.20)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <initialSeverity>1</initialSeverity>
        <minSeverity>1</minSeverity>
        <maxSeverity>1</maxSeverity>
        <comps>
            <li Class="MiliraXian.Characters.Zhaoli.HediffCompProperties_ZhaoliShieldLayers">
                <damagePerLayer>36</damagePerLayer>
                <showGizmo>false</showGizmo>
                <drawActiveShield>true</drawActiveShield>
                <activeShieldTexPath>MiliraXianZhaoli/Effect/Zhaoli_Shield/Shield</activeShieldTexPath>
                <activeShieldDrawSize>(1.55,1.55)</activeShieldDrawSize>
                <activeShieldAlpha>0.62</activeShieldAlpha>
                <activeShieldAltitudeOffset>0.5</activeShieldAltitudeOffset>
                <activeShieldPulseMin>0.98</activeShieldPulseMin>
                <activeShieldPulseMax>1.03</activeShieldPulseMax>
                <activeShieldPulseTicks>90</activeShieldPulseTicks>
                <activeShieldRotationDegreesPerTick>0.15</activeShieldRotationDegreesPerTick>
            </li>
        </comps>
    </HediffDef>

</Defs>
