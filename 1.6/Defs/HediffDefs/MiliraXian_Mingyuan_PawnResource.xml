<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <HediffDef>
        <defName>MX_Mingyuan_LifeBurn</defName>
        <label>&lt;color=#FF7A45&gt;Life Burn&lt;/color&gt;</label>
        <description>A foreign flame fastened to the target's life. It drains needs and age, weakens combat and work, deals true burning damage, and gives nearby enemies 10% of their own burst threshold when the host dies.</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(1.00, 0.38, 0.20)</defaultLabelColor>
        <isBad>true</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <initialSeverity>1</initialSeverity>
        <maxSeverity>999999</maxSeverity>
        <stages>
            <li>
                <minSeverity>0</minSeverity>
                <label></label>
                <statFactorsBySeverity>
                    <li><stat>MoveSpeed</stat><valueBySeverity><points><li>(0,1)</li><li>(9500,0.05)</li><li>(999999,0.05)</li></points></valueBySeverity></li>
                    <li><stat>MeleeHitChance</stat><valueBySeverity><points><li>(0,1)</li><li>(9500,0.05)</li><li>(999999,0.05)</li></points></valueBySeverity></li>
                    <li><stat>ShootingAccuracyPawn</stat><valueBySeverity><points><li>(0,1)</li><li>(9500,0.05)</li><li>(999999,0.05)</li></points></valueBySeverity></li>
                    <li><stat>WorkSpeedGlobal</stat><valueBySeverity><points><li>(0,1)</li><li>(9500,0.05)</li><li>(999999,0.05)</li></points></valueBySeverity></li>
                    <li><stat>MeleeDamageFactor</stat><valueBySeverity><points><li>(0,1)</li><li>(9500,0.05)</li><li>(999999,0.05)</li></points></valueBySeverity></li>
                    <li><stat>IncomingDamageFactor</stat><valueBySeverity><points><li>(0,1)</li><li>(9500,1.95)</li><li>(999999,1.95)</li></points></valueBySeverity></li>
                    <li><stat>MeleeCooldownFactor</stat><valueBySeverity><points><li>(0,1)</li><li>(9500,1.95)</li><li>(999999,1.95)</li></points></valueBySeverity></li>
                    <li><stat>RangedCooldownFactor</stat><valueBySeverity><points><li>(0,1)</li><li>(9500,1.95)</li><li>(999999,1.95)</li></points></valueBySeverity></li>
                </statFactorsBySeverity>
            </li>
        </stages>
        <renderNodeProperties>
            <li>
                <debugLabel>MX_Mingyuan_LifeBurnMark</debugLabel>
                <workerClass>PawnRenderNodeWorker_Hediff</workerClass>
                <texPath>MiliraXianMingyuan/Effect/LifeBurnMark</texPath>
                <shaderTypeDef>MoteGlow</shaderTypeDef>
                <overrideMeshSize>(1.42,1.42)</overrideMeshSize>
                <color>(1.00,0.88,0.54,0.70)</color>
                <parentTagDef>Root</parentTagDef>
                <pawnType>Any</pawnType>
                <rotDrawMode>Fresh, Rotting</rotDrawMode>
                <baseLayer>75</baseLayer>
            </li>
        </renderNodeProperties>
        <comps>
            <li Class="MiliraXian.Characters.Mingyuan.HediffCompProperties_MingyuanLifeBurn">
                <tickInterval>120</tickInterval>
                <baseDamage>0.5</baseDamage>
                <damagePer100Layers>0.25</damagePer100Layers>
                <needDrainPer100Layers>0.01</needDrainPer100Layers>
                <ageTicksPerLayer>60</ageTicksPerLayer>
                <transferRadius>30</transferRadius>
                <deathTransferProgressFraction>0.10</deathTransferProgressFraction>
                <executeHealthScaleMultiplier>10</executeHealthScaleMultiplier>
                <burstDamageMultiplier>1</burstDamageMultiplier>
                <burnSelfStackFraction>0.05</burnSelfStackFraction>
                <decayDelayTicks>1800</decayDelayTicks>
                <decayFraction>0.1</decayFraction>
                <removeBelowLayers>0.5</removeBelowLayers>
                <transferVisualLimit>3</transferVisualLimit>
                <maxTransferTargets>8</maxTransferTargets>
                <maxBurstExecutionsPerTick>4</maxBurstExecutionsPerTick>
                <burstRetryTicks>15</burstRetryTicks>
                <burstRetryJitterTicks>45</burstRetryJitterTicks>
                <maxDeathTransfersPerTick>4</maxDeathTransfersPerTick>
                <deathTransferTargetCooldownTicks>300</deathTransferTargetCooldownTicks>
            </li>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>MX_Mingyuan_SelfBurn</defName>
        <label>&lt;color=#FFB25C&gt;Self Burn&lt;/color&gt;</label>
        <description>Mingyuan turns the burning inside herself into momentum. Layers from 0 to 300 improve melee and skill damage, give a capped bonus to ranged weapon damage, improve movement, attack speed, work speed, and Life Burn output. Layers above 300 become Overburn: direct damage and active Life Burn stacking are doubled, but her protective flame reserve starts draining.</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(1.00, 0.70, 0.36)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <initialSeverity>1</initialSeverity>
        <maxSeverity>500</maxSeverity>
        <stages>
            <li>
                <minSeverity>0</minSeverity>
                <label></label>
                <statFactorsBySeverity>
                    <li><stat>MoveSpeed</stat><valueBySeverity><points><li>(0,1)</li><li>(300,2.5)</li></points></valueBySeverity></li>
                    <li><stat>WorkSpeedGlobal</stat><valueBySeverity><points><li>(0,1)</li><li>(300,4)</li></points></valueBySeverity></li>
                    <li><stat>MeleeDamageFactor</stat><valueBySeverity><points><li>(0,1)</li><li>(300,4)</li></points></valueBySeverity></li>
                    <li><stat>MeleeCooldownFactor</stat><valueBySeverity><points><li>(0,1)</li><li>(50,0.6667)</li><li>(100,0.5)</li><li>(150,0.4)</li><li>(200,0.3333)</li><li>(250,0.2857)</li><li>(300,0.25)</li></points></valueBySeverity></li>
                    <li><stat>RangedCooldownFactor</stat><valueBySeverity><points><li>(0,1)</li><li>(50,0.6667)</li><li>(100,0.5)</li><li>(150,0.4)</li><li>(200,0.3333)</li><li>(250,0.2857)</li><li>(300,0.25)</li></points></valueBySeverity></li>
                </statFactorsBySeverity>
            </li>
            <li>
                <minSeverity>300.0001</minSeverity>
                <label></label>
                <statFactors>
                    <MoveSpeed>2.5</MoveSpeed>
                    <WorkSpeedGlobal>4</WorkSpeedGlobal>
                    <MeleeDamageFactor>8</MeleeDamageFactor>
                    <MeleeCooldownFactor>0.25</MeleeCooldownFactor>
                    <RangedCooldownFactor>0.25</RangedCooldownFactor>
                </statFactors>
            </li>
        </stages>
        <comps>
            <li Class="MiliraXian.Characters.Mingyuan.HediffCompProperties_MingyuanSelfBurn">
                <gainMoteDef>MX_Mingyuan_Mote_SelfBurnGain</gainMoteDef>
                <gainMoteScale>1</gainMoteScale>
                <gainMoteCooldownTicks>60</gainMoteCooldownTicks>
                <effectiveBonusCap>300</effectiveBonusCap>
                <overburnThreshold>300</overburnThreshold>
                <overburnDamageFactor>2</overburnDamageFactor>
                <overburnLifeBurnFactor>2</overburnLifeBurnFactor>
                <rangedWeaponDamagePerLayer>0.002</rangedWeaponDamagePerLayer>
                <rangedWeaponDamageBonusCap>0.6</rangedWeaponDamageBonusCap>
                <combatRegenIntervalTicks>60</combatRegenIntervalTicks>
                <combatRegenLayers>1</combatRegenLayers>
                <nonCombatDecayIntervalTicks>60</nonCombatDecayIntervalTicks>
                <nonCombatDecayLayers>1</nonCombatDecayLayers>
                <overburnDecayLayers>1</overburnDecayLayers>
                <overburnMoteDef>MX_Mingyuan_Mote_SelfBurnOverburn</overburnMoteDef>
                <overburnMoteScale>1.35</overburnMoteScale>
            </li>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>MX_Mingyuan_BurningBody</defName>
        <label>&lt;color=#FFD37A&gt;Burning Body&lt;/color&gt;</label>
        <description>A body remade by pale extradimensional fire. Incoming damage is reduced to 1%, consciousness rises, heat and explosions are converted into recovery, attackers are burned in return, control states are cleared, and real wounds feed 5 Self Burn.</description>
        <hediffClass>MiliraXian.Characters.Mingyuan.Hediff_MingyuanBurningBody</hediffClass>
        <defaultLabelColor>(1.00, 0.82, 0.48)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
        <initialSeverity>1</initialSeverity>
        <minSeverity>1</minSeverity>
        <maxSeverity>1</maxSeverity>
        <stages>
            <li>
                <minSeverity>0</minSeverity>
                <label></label>
                <statFactors>
                    <IncomingDamageFactor>0.01</IncomingDamageFactor>
                </statFactors>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>1.0</offset>
                    </li>
                </capMods>
                <disablesNeeds>
                    <li>Food</li>
                    <li>Rest</li>
                    <li>Joy</li>
                    <li>Beauty</li>
                    <li>Comfort</li>
                    <li>Indoors</li>
                    <li>Outdoors</li>
                    <li>RoomSize</li>
                </disablesNeeds>
            </li>
        </stages>
        <comps>
            <li Class="MiliraXian.Characters.Mingyuan.HediffCompProperties_MingyuanBurningBody">
                <restoreIntervalTicks>1800</restoreIntervalTicks>
                <invulnerableTicks>90</invulnerableTicks>
                <reflectLifeBurnLayers>20</reflectLifeBurnLayers>
                <selfBurnOnHit>5</selfBurnOnHit>
                <meleeLifeBurnLayers>10</meleeLifeBurnLayers>
                <rangedLifeBurnLayers>2</rangedLifeBurnLayers>
                <meleeSelfBurnBonusPer100>10</meleeSelfBurnBonusPer100>
                <rangedSelfBurnBonusPer100>2</rangedSelfBurnBonusPer100>
            </li>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>MX_Mingyuan_ProtectiveFlameShield</defName>
        <label>&lt;color=#FFE0A3&gt;Protective Flame Shield&lt;/color&gt;</label>
        <description>A 100-point pale flame reserve. Each second, 1 point restores one missing body part or heals all wounds and scars on one part. Stable Self Burn can replenish the reserve; Overburn drains it. The reserve does not absorb damage.</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(1.00, 0.88, 0.64)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
        <initialSeverity>1</initialSeverity>
        <minSeverity>1</minSeverity>
        <maxSeverity>1</maxSeverity>
        <comps>
            <li Class="MiliraXian.Characters.Mingyuan.HediffCompProperties_MingyuanProtectiveFlameShield">
                <maxEnergy>100</maxEnergy>
                <repairIntervalTicks>60</repairIntervalTicks>
                <selfBurnRefillIntervalTicks>300</selfBurnRefillIntervalTicks>
                <selfBurnRefillCooldownTicks>1800</selfBurnRefillCooldownTicks>
                <selfBurnPerEnergy>3</selfBurnPerEnergy>
                <selfBurnRefillMaxFractionOfCap>0.3</selfBurnRefillMaxFractionOfCap>
                <overburnDrainIntervalTicks>300</overburnDrainIntervalTicks>
                <overburnDrainEnergy>1</overburnDrainEnergy>
                <shieldSelfBurnMoteDef>MX_Mingyuan_Mote_ShieldSelfBurnLink</shieldSelfBurnMoteDef>
                <shieldSelfBurnMoteScale>1</shieldSelfBurnMoteScale>
                <shieldSelfBurnMoteCooldownTicks>60</shieldSelfBurnMoteCooldownTicks>
            </li>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>MX_Mingyuan_RebirthFlame</defName>
        <label>&lt;color=#FF5C3A&gt;Rebirth Flame&lt;/color&gt;</label>
        <description>When Mingyuan falls, the flame buried in her body detonates, leaves a rebirth flame, and restores her after 30 seconds.</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(1.00, 0.36, 0.24)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
        <initialSeverity>1</initialSeverity>
        <minSeverity>1</minSeverity>
        <maxSeverity>1</maxSeverity>
        <comps>
            <li Class="MiliraXian.Characters.Mingyuan.HediffCompProperties_MingyuanRebirthFlame"/>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>MX_Mingyuan_EternalBurning</defName>
        <label>&lt;color=#FF2E1F&gt;Eternal Burning&lt;/color&gt;</label>
        <description>Mingyuan is enclosed in the fire that rebuilds her. While this flame lasts, outside blows cannot decide her death.</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(1.00, 0.18, 0.12)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
    </HediffDef>

    <HediffDef>
        <defName>MX_Mingyuan_TimeBurnFrozen</defName>
        <label>&lt;color=#C95CFF&gt;Time Burn&lt;/color&gt;</label>
        <description>The target's lifetime is being burned away. When the remaining biological age reaches zero, the flame claims the body.</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(0.79, 0.36, 1.00)</defaultLabelColor>
        <isBad>true</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
        <renderNodeProperties>
            <li>
                <debugLabel>MX_Mingyuan_TimeBurnMark</debugLabel>
                <workerClass>PawnRenderNodeWorker_Hediff</workerClass>
                <texPath>MiliraXianMingyuan/Effect/TimeBurnMark</texPath>
                <shaderTypeDef>MoteGlow</shaderTypeDef>
                <overrideMeshSize>(1.58,1.58)</overrideMeshSize>
                <color>(0.92,0.70,1.00,0.64)</color>
                <parentTagDef>Root</parentTagDef>
                <pawnType>Any</pawnType>
                <rotDrawMode>Fresh, Rotting</rotDrawMode>
                <baseLayer>76</baseLayer>
            </li>
        </renderNodeProperties>
    </HediffDef>

</Defs>
