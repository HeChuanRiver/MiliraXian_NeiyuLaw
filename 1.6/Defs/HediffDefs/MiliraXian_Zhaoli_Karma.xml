<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <HediffDef>
        <defName>MXZL_ZhaoliKarma</defName>
        <label>&lt;color=#E85A7A&gt;因果&lt;/color&gt;</label>
        <description>&lt;color=#E85A7A&gt;昭离&lt;/color&gt;专属资源。通过&lt;color=#C77DFF&gt;告死&lt;/color&gt;处决积累，并由后续主动技能进行消耗。该 Hediff 还会记录当前已经建立的&lt;color=#D66BFF&gt;因果链接&lt;/color&gt;名单。</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(0.74, 0.10, 0.18)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <initialSeverity>1</initialSeverity>
        <minSeverity>1</minSeverity>
        <maxSeverity>1</maxSeverity>
        <comps>
            <li Class="MiliraXian.Characters.HediffCompProperties_PawnSpecialResource">
                <resourceLabel>&lt;color=#E85A7A&gt;因果&lt;/color&gt;</resourceLabel>
                <resourceDescription>&lt;color=#E85A7A&gt;昭离&lt;/color&gt;专属资源。每次成功&lt;color=#C77DFF&gt;告死&lt;/color&gt;都会增加因果，后续主动技能会消耗因果。该资源超过&lt;color=#E85A7A&gt;100点&lt;/color&gt;时，会优先尝试把溢出的因果分摊给已链接者。</resourceDescription>
                <initialValue>0</initialValue>
                <maxValue>100</maxValue>
                <clampToMax>false</clampToMax>
                <showGizmo>true</showGizmo>
                <hideOnHealthTab>false</hideOnHealthTab>
                <barColor>(0.78, 0.10, 0.12, 1)</barColor>
                <barHighlightColor>(1.00, 0.22, 0.24, 1)</barHighlightColor>
            </li>
            <li Class="MiliraXian.Characters.Zhaoli.HediffCompProperties_ZhaoliKarmaLinks">
                <maxLinks>20</maxLinks>
                <linkDurationTicks>1800000</linkDurationTicks>
            </li>
        </comps>
    </HediffDef>

</Defs>
