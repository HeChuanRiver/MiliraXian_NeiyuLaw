<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- 伤害类型相关 -->
    <!-- 脱水 - 技能伤害 -->
    <HediffDef>
        <defName>MX_DehydrateDamage</defName>
        <label>水循环紊乱</label>
        <description>内部的部分流体行为被干扰，导致循环系统异常或机械故障。</description>
        <isBad>true</isBad>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.6, 0.8, 1.0)</defaultLabelColor>
        <initialSeverity>0.01</initialSeverity>
        <minSeverity>0.0</minSeverity>
        <maxSeverity>1.0</maxSeverity>
        <alwaysShowSeverity>true</alwaysShowSeverity>
        <stages>
            <li>
                <minSeverity>0.0</minSeverity>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.9</postFactor>
                    </li>
                </capMods>
            </li>
            <li>
                <minSeverity>0.2</minSeverity>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.8</postFactor>
                    </li>
                </capMods>
            </li>
            <li>
                <minSeverity>0.4</minSeverity>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.7</postFactor>
                    </li>
                </capMods>
            </li>
            <li>
                <minSeverity>0.6</minSeverity>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.6</postFactor>
                    </li>
                </capMods>
            </li>
            <li>
                <minSeverity>0.8</minSeverity>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.5</postFactor>
                    </li>
                </capMods>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-0.5</severityPerDay>
                <showHoursToRecover>true</showHoursToRecover>
            </li>
        </comps>
    </HediffDef>
    
    <!-- 离弦 - 乐器伤害 -->
    <HediffDef>
        <defName>MX_QH_Desynced</defName>
        <label>离弦</label>
        <description>受到清荷所持乐器产生的共振扰乱，行动节奏与瞄准节奏被打乱，移动速度和射击精准度显著下降。</description>
        <isBad>true</isBad>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.85, 0.35, 0.95)</defaultLabelColor>
        <initialSeverity>1.0</initialSeverity>
        <minSeverity>0.0</minSeverity>
        <maxSeverity>1.0</maxSeverity>
        <alwaysShowSeverity>true</alwaysShowSeverity>
        <stages>
            <li>
                <minSeverity>0.0</minSeverity>
                <multiplyStatChangesBySeverity>true</multiplyStatChangesBySeverity>
                <statFactors>
                    <MoveSpeed>0.65</MoveSpeed>
                    <ShootingAccuracyPawn>0.72</ShootingAccuracyPawn>
                </statFactors>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_SeverityPerSecond">
                <severityPerSecond>-0.02</severityPerSecond>
            </li>
            <li Class="MiliraXian.Characters.QingHe.HediffCompProperties_SeverityPercent" />
        </comps>
    </HediffDef>
</Defs>



