        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
        <initialSeverity>1</initialSeverity>
        <minSeverity>1</minSeverity>
        <maxSeverity>1</maxSeverity>
        <comps>
            <li Class="MiliraXian.Characters.QingHe.Hediffs.HediffCompProperties_MeditativeStillness">
                <resourceLabel>stillness</resourceLabel>
                <resourceDescription>The calm stillness Qinghe accumulates while meditating at a lotus pond.</resourceDescription>
                <initialValue>0</initialValue>
                <maxValue>100</maxValue>
