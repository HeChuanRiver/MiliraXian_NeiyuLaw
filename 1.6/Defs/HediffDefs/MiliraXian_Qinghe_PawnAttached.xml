        <hediffClass>MiliraXian.Characters.QingHe.Hediffs.Hediff_MeditativeStillness</hediffClass>
        <defaultLabelColor>(0.48, 0.90, 0.58)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
        <initialSeverity>1</initialSeverity>
        <minSeverity>1</minSeverity>
        <maxSeverity>1</maxSeverity>
        <comps>
            <li Class="MiliraXian.Characters.QingHe.Hediffs.HediffCompProperties_MeditativeStillness">
                <resourceLabel>静思</resourceLabel>
                <resourceDescription>清荷在荷池处冥想时积累的静心沉淀。</resourceDescription>
                <initialValue>0</initialValue>
                <maxValue>100</maxValue>
                <baseGainPerDay>100</baseGainPerDay>
                <partialQualityConsumeFactor>0.3</partialQualityConsumeFactor>
                <fullQualityConsumeFactor>0.8</fullQualityConsumeFactor>
