    <HediffDef>
        <defName>MX_QH_DivineBlessing</defName>
        <label>花神之垂怜</label>
        <description>受到致命伤害或可能摧毁身体部件的伤害时，抵消此次伤害、修复自身所有损伤，同时获得短暂无敌和持续10秒的心灵隐形。此效果每120秒只可触发一次。</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(0.6, 1.0, 0.8)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
        <comps>
            <li Class="MiliraXian.Characters.QingHe.Hediffs.HediffCompProperties_DivineBlessing">
                <lethalTriggerHealthPercent>0.12</lethalTriggerHealthPercent>
                <minimumDamageForLethalCheck>8</minimumDamageForLethalCheck>
                <invisibilityDurationTicks>600</invisibilityDurationTicks>
                <damageImmunityDurationTicks>180</damageImmunityDurationTicks>
                <retriggerCooldownTicks>7200</retriggerCooldownTicks>
                <cooldownWarningCooldownTicks>600</cooldownWarningCooldownTicks>
            </li>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>MX_QH_DivineBlessingImmunity</defName>
        <label>神应</label>
        <description>受到花神的垂怜，暂时免疫所有伤害。</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(0.6, 1.0, 1.0)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>180</disappearsAfterTicks>
            </li>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>MX_QH_DivineFortune</defName>
        <label>花神之恩泽</label>
        <description>隐藏 Hediff：统一数值代理层</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(0.8, 0.95, 0.8)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
        <initialSeverity>1</initialSeverity>
        <minSeverity>1</minSeverity>
        <maxSeverity>1</maxSeverity>
        <comps>
            <li Class="MiliraXian.Characters.QingHe.Hediffs.HediffCompProperties_DivineFortune">
                <shieldCapacityMultiplier>2.5</shieldCapacityMultiplier>
                <shieldRegenMultiplier>3</shieldRegenMultiplier>
                <shieldRegenDelayTicks>600</shieldRegenDelayTicks>
                <shieldBreakDelayTicks>600</shieldBreakDelayTicks>
                <acceleratedShieldRegenDelayTicks>180</acceleratedShieldRegenDelayTicks>
                <acceleratedShieldBreakDelayTicks>180</acceleratedShieldBreakDelayTicks>
                <immediateShieldRegenDelayTicks>0</immediateShieldRegenDelayTicks>
                <shieldDamageCap>20</shieldDamageCap>
                <flowerDecreeMaxBonusPerMandateNode>1</flowerDecreeMaxBonusPerMandateNode>
                <flowerDecreeRegenMultiplier>1</flowerDecreeRegenMultiplier>
                <activeStateFlowerDecreeRegenMultiplier>2</activeStateFlowerDecreeRegenMultiplier>
                <masteryShieldCapacityMultiplierPerLevel>0.03</masteryShieldCapacityMultiplierPerLevel>
                <masteryShieldRegenMultiplierPerLevel>0.03</masteryShieldRegenMultiplierPerLevel>
                <masteryFlowerDecreeRegenMultiplierPerLevel>0.01</masteryFlowerDecreeRegenMultiplierPerLevel>
                <masteryDivineBlessingRechargeFactorPerLevel>0.02</masteryDivineBlessingRechargeFactorPerLevel>
                <minDivineBlessingRechargeFactor>0.25</minDivineBlessingRechargeFactor>
            </li>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>MX_QH_DivineProtection</defName>
        <label>花神之眷顾</label>
        <description>清荷受到十二花神的保护，能自然产生一面抵挡伤害的护盾。\n\n护盾被击碎时会失效10秒。</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(1.0, 0.75, 1.0)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
        <comps>
            <li Class="MiliraXian.Characters.QingHe.Hediffs.HediffCompProperties_DivineProtection">
                <shieldCompProperties>
                    <maxEnergy>200</maxEnergy>
                    <baseRegenPerSecond>5</baseRegenPerSecond>
                    <hitRegenDelayTicks>120</hitRegenDelayTicks>
                    <breakDisabledTicks>600</breakDisabledTicks>
                    <breakOnEmp>false</breakOnEmp>
                    <visual>
                        <fullEnergyFadeOutTicks>90</fullEnergyFadeOutTicks>
                        <texPath>MiliraXianQinghe/Effect/lotus_shield</texPath>
                        <shaderType>MX_QH_LotusShieldDistortion</shaderType>
                        <shaderParameters>
                            <_FlowMap>/MiliraXianQinghe/Effect/lotus_shield_flowmap</_FlowMap>
                            <_BaseLayerAlpha>1.0</_BaseLayerAlpha>
                            <_AdditiveGlowColor>(1,0.45,0.43,1)</_AdditiveGlowColor>
                            <_AdditiveGlowAlpha>1.0</_AdditiveGlowAlpha>
                            <_AdditiveGlowBreathAmplitude>0.9</_AdditiveGlowBreathAmplitude>
                            <_AdditiveGlowBreathSpeed>0.21</_AdditiveGlowBreathSpeed>
                            <_AdditiveGlowMinMask>0</_AdditiveGlowMinMask>
                            <_SwayStrength>0.015</_SwayStrength>
                            <_SwaySpeed>1.13</_SwaySpeed>
                        </shaderParameters>
                        <drawSize>(2.5,2.5)</drawSize>
                        <alpha>0.8</alpha>
                        <drawOffset>(0,0,-0.23)</drawOffset>
                        <breakScale>(1.3,1.3)</breakScale>
                        <absorbFleckDefName>MXNL_Fleck_NeiyuShield_Hurt_A</absorbFleckDefName>
                        <absorbFleckScale>0.6</absorbFleckScale>
                        <farGlow>
                            <texPath>Things/Mote/FireGlow</texPath>
                            <color>(1,0.81,0.93,1)</color>
                            <alpha>1.0</alpha>
                            <sizeMultiplier>2.8</sizeMultiplier>
                            <breathAmplitude>0.6</breathAmplitude>
                            <breathSpeed>0.21</breathSpeed>
                        </farGlow>
                        <hitGlow>
                            <texPath>Things/Mote/PsychicDistortionRing</texPath>
                            <color>(1,0.72,0.92,1)</color>
                            <alpha>0.85</alpha>
                            <sizeMultiplier>0.9</sizeMultiplier>
                            <durationTicks>120</durationTicks>
                            <drawOffset>(0,0,0.2)</drawOffset>
                        </hitGlow>
                    </visual>
                </shieldCompProperties>
            </li>
        </comps>
    </HediffDef>

</Defs>

