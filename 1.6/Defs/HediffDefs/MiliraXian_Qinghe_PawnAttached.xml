<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>MX_QH_FlowerDecree</defName>
        <label>花令</label>
        <description>隐藏Hediff：资源计数器</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(0.95, 0.74, 0.84)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
        <initialSeverity>1</initialSeverity>
        <minSeverity>1</minSeverity>
        <maxSeverity>1</maxSeverity>
        <comps>
            <li Class="MiliraXian.Characters.QingHe.Hediffs.HediffCompProperties_FlowerDecree">
                <resourceLabel>花令</resourceLabel>
                <resourceDescription>清荷的充能型层数资源，用于释放四时飞花令。</resourceDescription>
                <initialValue>0</initialValue>
                <maxValue>300</maxValue>
                <baseRecoveryTicksPerDecree>1200</baseRecoveryTicksPerDecree>
                <valuePerDecree>100</valuePerDecree>
                <maxResourceBonusPerSkillNode>1</maxResourceBonusPerSkillNode>
                <flowerDivinationRecoveryFactor>5</flowerDivinationRecoveryFactor>
                <highlightTicks>90</highlightTicks>
                <clampToMax>true</clampToMax>
                <showGizmo>false</showGizmo>
                <hideOnHealthTab>true</hideOnHealthTab>
            </li>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>MX_QH_FlowerResonance</defName>
        <label>和鸣</label>
        <description>隐藏 Hediff：角色技能数据</description>
        <hediffClass>MiliraXian.Characters.QingHe.Hediffs.Hediff_FlowerResonance</hediffClass>
        <defaultLabelColor>(0.72, 0.90, 0.80)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
        <initialSeverity>1.0</initialSeverity>
        <minSeverity>1.0</minSeverity>
        <maxSeverity>1.0</maxSeverity>
        <comps>
            <li Class="MiliraXian.Characters.QingHe.Hediffs.HediffCompProperties_FlowerResonance">
                <initialSkillPoints>1</initialSkillPoints>
            </li>
            <li Class="MiliraXian.Characters.QingHe.Hediffs.HediffCompProperties_FlowerResonanceGizmos" />
            <li Class="MiliraXian.Characters.QingHe.Hediffs.HediffCompProperties_FlowerDivination">
                <activeDurationTicks>3600</activeDurationTicks>
                <cooldownTicks>3600</cooldownTicks>
                <warmupTicks>120</warmupTicks>
                <warmupLightningIntervalTicks>18</warmupLightningIntervalTicks>
                <warmupLightningRadius>1.4</warmupLightningRadius>
                <afterimageIntervalTicks>6</afterimageIntervalTicks>
                <slashAfterimageIntervalTicks>2</slashAfterimageIntervalTicks>
                <afterimageFadeTicks>60</afterimageFadeTicks>
                <afterimageStartAlpha>0.44</afterimageStartAlpha>
                <afterimageMinDistance>0.55</afterimageMinDistance>
                <activeEffecter>MX_QH_Effecter_FlowerDivinationActive</activeEffecter>
                <startReady>true</startReady>
                <activeLabel>花神降临</activeLabel>
                <noResonanceReason>尚未习得花之舞。</noResonanceReason>
                <alreadyActiveReason>花神已经降临。</alreadyActiveReason>
                <cooldownReason>花神降临仍在冷却中。</cooldownReason>
                <activatedMessage>花神降临。</activatedMessage>
            </li>
        </comps>
