                <clampToMax>true</clampToMax>
                <showGizmo>false</showGizmo>
                <hideOnHealthTab>false</hideOnHealthTab>
                <barColor>(0.42, 0.90, 0.55)</barColor>
                <barHighlightColor>(0.68, 1.00, 0.72)</barHighlightColor>
            </li>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>MX_QH_Trickle</defName>
        <label>涓流</label>
        <description>清荷会持续缓慢回复伤口，并逐步修复永久损伤与失去的身体部位。</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(0.54, 0.96, 0.76)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
        <initialSeverity>1</initialSeverity>
        <minSeverity>1</minSeverity>
        <maxSeverity>1</maxSeverity>
        <comps>
            <li Class="MiliraXian.Characters.QingHe.Hediffs.HediffCompProperties_SpringRegen">
                <healIntervalTicks>600</healIntervalTicks>
                <healAmountPerTrigger>1.0</healAmountPerTrigger>
                <healPermanentInjuries>true</healPermanentInjuries>
                <restoreMissingParts>true</restoreMissingParts>
            </li>
        </comps>
