<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>MX_QH_FlowerDecree</defName>
        <label>flower decree</label>
        <description>Hidden hediff: resource counter.</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(0.95, 0.74, 0.84)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
        <initialSeverity>1</initialSeverity>
        <minSeverity>1</minSeverity>
        <maxSeverity>1</maxSeverity>
        <comps>
            <li Class="MiliraXian.Characters.QingHe.Hediffs.HediffCompProperties_FlowerDecree">
                <resourceLabel>flower decree</resourceLabel>
                <resourceDescription>Qinghe's charge-based resource, used to cast four-season Flower Decrees.</resourceDescription>
                <initialValue>0</initialValue>
                <maxValue>300</maxValue>
                <baseRecoveryTicksPerDecree>1200</baseRecoveryTicksPerDecree>
