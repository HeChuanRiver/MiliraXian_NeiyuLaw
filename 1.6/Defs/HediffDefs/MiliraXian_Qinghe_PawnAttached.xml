            </li>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>MX_QH_DivineProtection</defName>
        <label>divine protection</label>
        <description>Qinghe is protected by the twelve flower gods, naturally generating a shield that absorbs damage.\n\nWhen the shield breaks, it is disabled for 10 seconds.</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(1.0, 0.75, 1.0)</defaultLabelColor>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <everCurableByItem>false</everCurableByItem>
        <comps>
            <li Class="MiliraXian.Characters.QingHe.Hediffs.HediffCompProperties_DivineProtection">
                <shieldCompProperties>
                    <maxEnergy>200</maxEnergy>
                    <baseRegenPerSecond>5</baseRegenPerSecond>
                    <hitRegenDelayTicks>120</hitRegenDelayTicks>
                    <breakDisabledTicks>600</breakDisabledTicks>
                    <breakOnEmp>false</breakOnEmp>
                    <visual>
                        <fullEnergyFadeOutTicks>90</fullEnergyFadeOutTicks>
                        <texPath>MiliraXianQinghe/Effect/lotus_shield</texPath>
                        <shaderType>MX_QH_LotusShieldDistortion</shaderType>
                        <shaderParameters>
                            <_FlowMap>/MiliraXianQinghe/Effect/lotus_shield_flowmap</_FlowMap>
                            <_BaseLayerAlpha>1.0</_BaseLayerAlpha>
                            <_AdditiveGlowColor>(1,0.45,0.43,1)</_AdditiveGlowColor>
                            <_AdditiveGlowAlpha>1.0</_AdditiveGlowAlpha>
                            <_AdditiveGlowBreathAmplitude>0.9</_AdditiveGlowBreathAmplitude>
                            <_AdditiveGlowBreathSpeed>0.21</_AdditiveGlowBreathSpeed>
                            <_AdditiveGlowMinMask>0</_AdditiveGlowMinMask>
                            <_SwayStrength>0.015</_SwayStrength>
                            <_SwaySpeed>1.13</_SwaySpeed>
                        </shaderParameters>
                        <drawSize>(2.5,2.5)</drawSize>
                        <alpha>0.8</alpha>
                        <drawOffset>(0,0,-0.23)</drawOffset>
                        <breakScale>(1.3,1.3)</breakScale>
                        <absorbFleckDefName>MXNL_Fleck_NeiyuShield_Hurt_A</absorbFleckDefName>
                        <absorbFleckScale>0.6</absorbFleckScale>
                        <farGlow>
                            <texPath>Things/Mote/FireGlow</texPath>
                            <color>(1,0.81,0.93,1)</color>
                            <alpha>1.0</alpha>
                            <sizeMultiplier>2.8</sizeMultiplier>
                            <breathAmplitude>0.6</breathAmplitude>
                            <breathSpeed>0.21</breathSpeed>
                        </farGlow>
                        <hitGlow>
                            <texPath>Things/Mote/PsychicDistortionRing</texPath>
                            <color>(1,0.72,0.92,1)</color>
                            <alpha>0.85</alpha>
                            <sizeMultiplier>0.9</sizeMultiplier>
                            <durationTicks>120</durationTicks>
                            <drawOffset>(0,0,0.2)</drawOffset>
                        </hitGlow>
                    </visual>
                </shieldCompProperties>
            </li>
        </comps>
    </HediffDef>

</Defs>
