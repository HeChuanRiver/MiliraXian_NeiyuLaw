    <label>bleed buildup</label>
    <description>A blood disturbance left by the Flower Bell's spring resonance. Repeated hits build up bleed, which becomes a bleeding effect at full accumulation.</description>
    <hediffClass>MiliraXian.Characters.Hediff_Accumulation</hediffClass>
    <defaultLabelColor>(1.00, 0.36, 0.42)</defaultLabelColor>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="MiliraXian.Characters.HediffCompProperties_Accumulation">
        <maxSeverity>1</maxSeverity>
        <ticksUntilDecayAfterRefresh>300</ticksUntilDecayAfterRefresh>
        <severityDecayPerTick>0.001</severityDecayPerTick>
        <progressBarMoteDef>MX_Mote_StatusEffectBleedBar</progressBarMoteDef>
