        <fullAccumulationTextColor>(1.00, 0.36, 0.42)</fullAccumulationTextColor>
        <fullAccumulationTextDuration>1.25</fullAccumulationTextDuration>
      </li>
      <li Class="MiliraXian.Characters.HediffCompProperties_OnAccumulated">
        <addHediff>BloodLoss</addHediff>
        <addHediffSeverityPerAccumulation>0.035</addHediffSeverityPerAccumulation>
