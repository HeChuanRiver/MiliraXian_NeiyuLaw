            <li Class="Verse.HediffCompProperties_Disappears">
                <disappearsAfterTicks>1800000</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
            <li Class="MiliraXian.Characters.Zhaoli.HediffCompProperties_ZhaoliKarmaLinkTarget" />
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>MXZL_ZhaoliOverflowKarma</defName>
        <label>&lt;color=#B86CFF&gt;代偿因果&lt;/color&gt;</label>
        <description>该目标正在替&lt;color=#E85A7A&gt;昭离&lt;/color&gt;承担一层溢出的&lt;color=#B86CFF&gt;因果&lt;/color&gt;。在这层因果消失之前，无法再次替昭离承担新的溢出因果。</description>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(0.46, 0.12, 0.26)</defaultLabelColor>
        <isBad>true</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
    </HediffDef>

</Defs>
