<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ScenarioDef ParentName="ScenarioBase">
        <defName>MXNL_QingheFlowerCourtStart</defName>
        <label>Flower Court's First Bloom</label>
        <description><![CDATA[Day after day of secluded cultivation could not answer every question. After hearing that her teacher Neiyu had come to the RimWorld, Qinghe left the familiar court and arrived alone on this isolated ground, hoping to let the flower god's grace take root in an unfamiliar land with her own hands.

This time, there is only Qinghe herself, a small amount of gear, and a piece of land not yet opened.]]></description>
        <scenario>
            <summary><![CDATA[A flower god's envoy arrives on the RimWorld, trying to let the flower god's grace take root in this unfamiliar land.]]></summary>
            <playerFaction Inherit="false">
                <def>PlayerFaction</def>
                <factionDef>Milira_PlayerFaction</factionDef>
            </playerFaction>
            <parts>
                <li Class="ScenPart_GameStartDialog">
                    <def>GameStartDialog</def>
                    <text><![CDATA[Day after day of secluded cultivation could not answer every question.

Following her teacher Neiyu's path, Qinghe left the familiar court and arrived alone on this RimWorld ground. She wants to cultivate a new court with her own hands, letting the flower god's grace take root in an unfamiliar land.

You have only a small amount of gear and a piece of land not yet opened.

Survive first, then find a way to build a new Flower God's Court and awaken your power again.]]></text>
                    <closeSound>GameStartSting</closeSound>
                </li>

                <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_KindDefs">
                    <def>ConfigurePawnsKindDefs</def>
                    <pawnChoiceCount>1</pawnChoiceCount>
                    <leftBehindPawnKind>MiliraXian_Qinghe</leftBehindPawnKind>
                    <kindCounts>
                        <li>
                            <kindDef>MiliraXian_Qinghe</kindDef>
                            <count>1</count>
                            <requiredAtStart>true</requiredAtStart>
                        </li>
                    </kindCounts>
                </li>

                <li Class="ScenPart_PlayerPawnsArriveMethod">
                    <def>PlayerPawnsArriveMethod</def>
                    <method>Standing</method>
                </li>

                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>Silver</thingDef>
                    <count>900</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>Milira_TravellerFood</thingDef>
                    <count>40</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>MedicineIndustrial</thingDef>
                    <count>20</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>ComponentIndustrial</thingDef>
                    <count>20</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>Milira_SunPlateSteel</thingDef>
                    <count>120</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>Milira_SolarCrystal</thingDef>
                    <count>20</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>Bedroll</thingDef>
                    <stuff>Cloth</stuff>
                    <count>1</count>
                </li>

                <li Class="ScenPart_ScatterThingsNearPlayerStart">
                    <def>ScatterThingsNearPlayerStart</def>
                    <thingDef>Steel</thingDef>
                    <count>320</count>
                </li>
                <li Class="ScenPart_ScatterThingsNearPlayerStart">
                    <def>ScatterThingsNearPlayerStart</def>
                    <thingDef>WoodLog</thingDef>
                    <count>500</count>
                </li>
                <li Class="ScenPart_ScatterThingsNearPlayerStart">
                    <def>ScatterThingsNearPlayerStart</def>
                    <thingDef>Plasteel</thingDef>
                    <count>180</count>
                </li>

                <li Class="ScenPart_ScatterThingsAnywhere">
                    <def>ScatterThingsAnywhere</def>
                    <thingDef>ShipChunk</thingDef>
                    <allowRoofed>false</allowRoofed>
                    <count>6</count>
                </li>
                <li Class="ScenPart_ScatterThingsAnywhere">
                    <def>ScatterThingsAnywhere</def>
                    <thingDef>Steel</thingDef>
                    <count>220</count>
                </li>
            </parts>
        </scenario>
    </ScenarioDef>

</Defs>
