<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ScenarioDef ParentName="ScenarioBase">
    <defName>MXNL_NeiyuProjectionStart</defName>
    <label>界外羽痕</label>
    <description>你是仙人米莉拉投向此界的一道羽影，名为霓羽。你带着零散的记忆和一部分力量，也带着对陌生世界的好奇。随身的专属武装是你最可靠的依靠。接下来，找一处落脚之地，搭起住所，再慢慢认识这里的人。&#10;&#10;警告：该剧本会显著降低游戏难度，不建议新玩家首次游玩时选择。</description>
    <scenario>
      <summary><![CDATA[一位异界投影霓羽，独自携带专属武装开局。]]></summary>
      <parts>
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>你是仙人米莉拉投向此界的一道羽影，名为霓羽。你带着零散的记忆和一部分力量，也带着对陌生世界的好奇。随身的专属武装是你最可靠的依靠。接下来，找一处落脚之地，搭起住所，再慢慢认识这里的人。&#10;&#10;警告：该剧本会显著降低游戏难度，不建议新玩家首次游玩时选择。</text>
            
            
          <closeSound>GameStartSting</closeSound>
        </li>

        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_KindDefs">
          <def>ConfigurePawnsKindDefs</def>
          <pawnChoiceCount>1</pawnChoiceCount>
          <leftBehindPawnKind>MiliraXian_Neiyu</leftBehindPawnKind>
          <kindCounts>
            <li>
              <kindDef>MiliraXian_Neiyu</kindDef>
              <count>1</count>
              <requiredAtStart>true</requiredAtStart>
            </li>
          </kindCounts>
        </li>

        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
          <visible>false</visible>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Silver</thingDef>
          <count>900</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MealSurvivalPack</thingDef>
          <count>22</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineIndustrial</thingDef>
          <count>12</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>ComponentIndustrial</thingDef>
          <count>10</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Steel</thingDef>
          <count>300</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>WoodLog</thingDef>
          <count>150</count>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>

</Defs>
