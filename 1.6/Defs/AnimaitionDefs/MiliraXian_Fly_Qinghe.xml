    <AnimationDef>
        <defName>Milira_FlyEast_Qinghe</defName>
        <durationTicks>36</durationTicks>
        <startOnRandomTick>true</startOnRandomTick>
        <keyframeParts>
            <li>
                <key>Milira_WingBinding</key>
                <value>
                    <keyframes>
                        <li><graphicState>Milira_FlyEast_Qinghe_0</graphicState><tick>0</tick></li>
                        <li><graphicState>Milira_FlyEast_Qinghe_1</graphicState><tick>3</tick></li>
                        <li><graphicState>Milira_FlyEast_Qinghe_2</graphicState><tick>9</tick></li>
                        <li><graphicState>Milira_FlyEast_Qinghe_3</graphicState><tick>12</tick></li>
                        <li><graphicState>Milira_FlyEast_Qinghe_4</graphicState><tick>15</tick></li>
                        <li><graphicState>Milira_FlyEast_Qinghe_5</graphicState><tick>21</tick></li>
                        <li><graphicState>Milira_FlyEast_Qinghe_6</graphicState><tick>25</tick></li>
                        <li><graphicState>Milira_FlyEast_Qinghe_7</graphicState><tick>30</tick></li>
                    </keyframes>
                </value>
            </li>
            <li>
                <key>Root</key>
                <value>
                    <workerType>AnimationWorker_Keyframes</workerType>
                    <keyframes>
                        <li>
                            <tick>0</tick>
                            <offset>(0,0,-0.0125)</offset>
                            <angle>8</angle>
                        </li>
                        <li>
                            <tick>10</tick>
                            <offset>(0,0,0.01)</offset>
                            <angle>8</angle>
                        </li>
                        <li>
                            <tick>15</tick>
                            <offset>(0,0,0.0125)</offset>
                            <angle>8</angle>
                        </li>
                        <li>
                            <tick>36</tick>
                            <offset>(0,0,-0.0125)</offset>
                            <angle>8</angle>
                        </li>
                    </keyframes>
                </value>
            </li>
            <li>
                <key>Head</key>
                <value>
                    <workerType>AnimationWorker_Keyframes</workerType>
                    <keyframes>
                        <li>
                            <tick>0</tick>
                            <angle>-8</angle>
                        </li>
                    </keyframes>
                </value>
            </li>
        </keyframeParts>
    </AnimationDef>

