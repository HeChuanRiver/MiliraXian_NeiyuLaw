<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <!-- 清荷 -->
    <PawnKindDef ParentName="Milira_PawnBase">
        <defName>MiliraXian_Qinghe</defName>
        <!-- pawn kind label pawn kind的名字 -->
        <!-- Lotus Rosalia -->
        <label>花神使</label>
        <!-- 设置性别 -->
        <fixedGender>Female</fixedGender>
        <!-- faction you spawn her or her default belonging 生成她时的派系，或者说她的初始归属 -->
        <defaultFactionType>Milira_Faction</defaultFactionType>
        <xenotypeSet Inherit="False">
            <xenotypeChances>
                <MiliraXenotype MayRequire="Ancot.MiliraRaceGenePatch">1.0</MiliraXenotype>
            </xenotypeChances>
        </xenotypeSet>
        <!-- raid point / combat power = number of this pawn could spawn in raid 袭击点数/战斗力=袭击来袭时可以生成多少个这个pawn -->
        <combatPower>0</combatPower>
        <!-- item quality when spawned 生成时她的身上全部的带有品质的thing的品质 -->
        <itemQuality>Excellent</itemQuality>
        <!-- 是否为战斗人员 -->
        <isFighter>true</isFighter>
        <!-- 是否为派系首领 -->
        <factionLeader>false</factionLeader>
        <!-- wealth range for random apparel 随机生成装备时，允许的装备财富值范围 -->
        <apparelMoney>
            <min>99999</min>
            <max>99999</max>
        </apparelMoney>

        <!-- apparel tags for random apparel 用于随机生成装备时，允许的装备tag -->
        <apparelTags>
        <!--    TODO: Apparel Tag for QingHe -->
            <li>MX_QingheNormal</li>
        </apparelTags>

        <!--    TODO: Specific Apparel Req for QingHe-->
        <specificApparelRequirements>
        </specificApparelRequirements>

        <!-- apparel you force to spawn 强制要求生成的装备 -->
        <!--        TODO: Add Apparel for QingHe -->
        <apparelRequired>
            <li>MX_QingheNormal</li>
            <li>MX_QingheHeaddress</li>
        </apparelRequired>
        <!-- Disabled apparel tags if you want to spawn randomly 如果你想要使用随机生成装备，禁用的装备tag -->
        <apparelDisallowTags>
        </apparelDisallowTags>
        <!-- 允许生成头部装备的概率 -->
        <apparelAllowHeadgearChance>1.0</apparelAllowHeadgearChance>

        <!-- 武器的tag -->
        <weaponTags>
          <li>MiliraXian_QingheInstrument</li>
        </weaponTags>

        <!-- wealth range for random weapon 随机生成武器时，允许的武器财富值范围 -->
        <weaponMoney>
            <min>99999</min>
            <max>99999</max>
        </weaponMoney>

        <!-- 生成时装备的耐久度区间，1-1则为100% -->
        <gearHealthRange Inherit="False">
            <min>1</min>
            <max>1</max>
        </gearHealthRange>
        <forceNormalGearQuality>false</forceNormalGearQuality>
        <minApparelQuality>Excellent</minApparelQuality>
        <maxApparelQuality>Excellent</maxApparelQuality>

        <!-- backstory for this pawn, using tags here 为这个pawn选择背景故事，这里使用的是tag -->
        <backstoryFiltersOverride>
            <li>
                <!-- 幼年背景故事 -->
                <categoriesChildhood>
                    <li>MiliraXian_BackStoryChild_Qinghe_Tag</li>
                </categoriesChildhood>

                <!-- 成年背景故事 -->
                <categoriesAdulthood>
                    <li>MiliraXian_BackStoryAdult_Qinghe_Tag</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>

        <!-- work type required, in order to ban some backstory that may disable some kind of works 强制要求的工作类型，用于筛选并且禁止一些可能禁用指定的工作类型的背景故事 -->
        <requiredWorkTags>
            <li>Intellectual</li>
        </requiredWorkTags>

        <!-- use traitdef defname here! 禁止生成的trait，此处使用的是trait defname -->
        <disallowedTraits>
            <li>BodyPurist</li>
        </disallowedTraits>

        <!-- use traitdef defname with degree here! 禁止生成的trait，此处使用的是trait defname，里面填写的degree对应一种trait，比如PsychicSensitivity：-2的意思是心灵失聪 -->
        <disallowedTraitsWithDegree>
            <PsychicSensitivity>-2</PsychicSensitivity>
        </disallowedTraitsWithDegree>

        <!-- 这个角色的头发RGB -->
        <forcedHairColor>(255,255,255)</forcedHairColor>
        <favoriteColor>MX_QH_FlowerPink</favoriteColor>

        <!-- 给予这个角色的技能 -->
        <skills>
            <li>
                <skill>Shooting</skill>
                <range>3~3</range>
            </li>
            <li>
                <skill>Melee</skill>
                <range>2~2</range>
            </li>
            <li>
                <skill>Construction</skill>
                <range>16~16</range>
            </li>
            <li>
                <skill>Mining</skill>
                <range>6~6</range>
            </li>
            <li>
                <skill>Cooking</skill>
                <range>18~18</range>
            </li>
            <li>
                <skill>Plants</skill>
                <range>12~12</range>
            </li>
            <li>
                <skill>Animals</skill>
                <range>10~10</range>
            </li>
            <li>
                <skill>Crafting</skill>
                <range>18~18</range>
            </li>
            <li>
                <skill>Artistic</skill>
                <range>14~14</range>
            </li>
            <li>
                <skill>Medicine</skill>
                <range>8~8</range>
            </li>
            <li>
                <skill>Social</skill>
                <range>8~8</range>
            </li>
            <li>
                <skill>Intellectual</skill>
                <range>17~17</range>
            </li>
        </skills>

        <!-- modExtensions是用来使用的非官方类的地方 -->
        <modExtensions>
            <!-- —————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————— -->
            <!-- The Following classes must be included!!! ↓↓↓ -->
            <!-- 以下class必须全部填写，绝对不能漏任何一个 ↓↓↓ -->

            <!-- "FixedIdentityExtension" is a tool for generating a fixed, non-random pawn. "FixedIdentityExtension"是用来生成一个固定的，绝对非随机的pawn的工具。 -->
            <li Class="AriandelLibrary.FixedIdentityExtension">
                <!-- Here you write “Key”. Then you need to go to the Language folder, find the Simplified Chinese folder, and open the Keyed folder. Use a translation XML file and enter the display name you want to show in the game for this “Key”. For example, the character name: <MI_Name_Ingefrid_First>Ingifríðr</MI_Name_Ingefrid_First>. 
                 你在这里写下的是“Key”,然后你需要前去Language文件夹，找到简体中文文件夹，再打开Keyed文件夹，使用一个翻译xml文件，在里面写下这里的“Key”的实际想在游戏中展示的名称，例如这个角色的名：<MI_Name_Ingefrid_First>英芙莉德</MI_Name_Ingefrid_First>。 -->
                <!-- firstname 姓名中的名，例如：《三体》中的叶文杰，文杰是firstname，叶是lastname。另一个例子：《沙丘》中的保罗厄崔迪，保罗是firstname，厄崔迪是lastname-->
                <firstNameKey>MX_Name_Qinghe_First</firstNameKey>
                <lastNameKey>MX_Name_Qinghe_Last</lastNameKey>
                <!-- Nickname is the name you want to display directly to the player in the game. For example, if your character is called "Tynan Sylvester" and you set the nickname to "Tynan", then after this pawn is generated in the game, the name shown under the pawn will be "Tynan".
                 nickname是你希望在游戏中直接显示给玩家的名称。例如你的角色叫做“泰南·西尔维斯特”，而nickname你写下“泰南”，那么你在游戏中生成这个pawn后，显示在这个pawn下方的名字就是“泰南”。 -->
                <nickNameKey>MX_Name_Qinghe_Nick</nickNameKey>

                <!-- The backstory you want to generate, using defname here.
                 你想要生成的背景故事，这里使用defname。 -->
                <childhoodBackstoryDef>MiliraXian_BackStoryChild_Qinghe_BS1</childhoodBackstoryDef>
                <adulthoodBackstoryDef>MiliraXian_BackStoryAdult_Qinghe_BS1</adulthoodBackstoryDef>

                <!-- Biological age 生物年龄 -->
                <forcedAgeYears>160</forcedAgeYears>
                <!-- Chronological age 历法年龄 -->
                <forcedChronologicalAgeYears>18</forcedChronologicalAgeYears>

                <!-- You can use your own texture if you have your owen HeadTypeDef (Without mod Facial Animation).
                 如果你自己创建了一个HeadTypeDef，那么便可以用来在没有面部动画mod的情况下为头部更换贴图。 -->
                <forcedHeadTypeDef>MiliraQingheHead</forcedHeadTypeDef>

                <!-- Disable random spawned trait, use the trait below only. You may write multiple traits here. 
                 禁用随机生成特质，仅使用以下固定生成的特质，你可以写多个特质。 -->
                <disableRandomTraits>true</disableRandomTraits>
                <extraForcedTraits>
                    <li><def>MX_QH_Trait_LongBreath</def></li>
                    <li><def>MX_QH_Trait_WaterFairy</def></li>
                    <!-- degree: 2 means "beautiful" degree为2代表：沉鱼落雁 -->
                    <li>
                        <def>Beauty</def>
                        <degree>2</degree>  <!-- 1 = optimist；2 = sanguine；-1 = pessimist；-2 = depressive -->
                    </li>
                </extraForcedTraits>

                <!-- Hediffs when spawned, including artificial body part. You may write multiple hediffs here. 
                 生成时带有的hediff，包括仿生物植入物，你可以写多个hediff -->
                <extraForcedHediffs>
                    <li>
                        <def>MX_QH_DivineBlessing</def>
                        <severity>1</severity>
                        <overwriteIfExists>true</overwriteIfExists>
                    </li>
                    <li>
                        <def>MX_QH_DivineProtection</def>
                        <severity>1</severity>
                        <overwriteIfExists>true</overwriteIfExists>
                    </li>
                    <li>
                        <def>MX_QH_FlowerResonance</def>
                        <severity>1</severity>
                        <overwriteIfExists>true</overwriteIfExists>
                    </li>
                    <li>
                        <def>MX_QH_FlowerDecree</def>
                        <severity>1</severity>
                        <overwriteIfExists>true</overwriteIfExists>
                    </li>
                </extraForcedHediffs>
            </li>

            <!-- "npcTag" is used for generating fixed face part for mod "[NL] Facial Animation - Experimentals" 
            “npcTag”是用来给“[NL] Facial Animation - Experimentals”（面部动画）这个mod生成固定面部特征用的。-->
            <li Class="AriandelLibrary.NPCKindTag">
                <npcTag>Qinghe</npcTag>
            </li>

            <!--            &lt;!&ndash; This class is for adding this pawn to randow recruitment in mod "Milira Faction: Milira Imperium" -->
            <!--            这个class是用来把这个角色加入到“米莉拉派系扩展：米莉拉帝国”的随机招募中的。&ndash;&gt;-->
            <!--            <li Class="MiliraImperium.UniqueRecruitExtension" MayRequire="Ariandel.MiliraImperium">-->
            <!--                &lt;!&ndash; Only can be recruited once. 只可以被招募一次。 &ndash;&gt;-->
            <!--                <uniqueOnce>true</uniqueOnce>-->
            <!--                &lt;!&ndash; The higher weight means higher probability to be chose in randow recruitment. 越高的weight代表在随机招募中被抽中的概率越高。 &ndash;&gt;-->
            <!--                <weight>0</weight>-->
            <!--            </li>-->

            <!-- "SpecialPawnExtension" is used to adding this pawn into special character manager(SCM). 
            “SpecialPawnExtension”用于把这个角色加入特殊角色管理器。-->
            <li Class="AriandelLibrary.SpecialPawnExtension">
                <!-- StaticID for this pawn. Never let two pawn share the same StaticID, it must be unique for every special pawn! 
                这是这个角色的StaticID，永远不要让两个角色的StaticID重复！ -->
                <uniqueID>Qinghe</uniqueID>
                <tabDef>MI_Milira_Tab</tabDef>
                <!-- TODO: Replace with QingHe's portrait. -->
                <iconPathRecruited>MiliraXianNeiyu/Icon/NeiyuAG</iconPathRecruited>
                <labelKey>SpecialPawnQinghe.label</labelKey>
                <descKey>SpecialPawnQinghe.desc</descKey>
                <order>16</order>
            </li>

            <!-- The classes upon must be included!!! ↑↑↑ -->
            <!-- 以上class必须全部填写，绝对不能漏任何一个 ↑↑↑ -->
            <!-- —————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————— -->


            <!-- —————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————— -->
            <!-- These classes are tools for special characters. You can add them selectively based on your needs—and it’s completely fine if you don’t add any of them. ↓↓↓ -->
            <!-- 以下的class是一些关于特殊角色的工具，你可以根据你的需求选择性的添加。这些class你就算一个都不添加也完全没问题。 ↓↓↓ -->

            <!-- Using Ariandel Library to handle this pawn's death. When this pawn should be dead, it will not really be dead but be recalled to the SCM.
             将角色转交给角色管理器的死亡管理系统（禁用原版死亡），当该角色被判定应当死亡时，特殊角色管理器将会召回该角色并且进入复活等待。 -->
            <li Class="AriandelLibrary.AL_Kill_Manager_Extension" />

            <!-- Disable all kinds of mental break, including mental break created by Mods.
             禁用一切精神崩溃，包括Mod中新创作的精神崩溃。 -->
            <li Class="AriandelLibrary.AL_RefuseMentalBreak_Extension">
                <blockMentalBreak>true</blockMentalBreak>
            </li>

            <!-- Disable options of float menu. 禁用右键菜单中的选项 -->
            <li Class="AriandelLibrary.AL_FloatMenuBlocker_Extension">
                <!-- Disable rescue button when this pawn is NOT in player faction.  禁用非玩家派系（NPC状态）时的救援按钮。 -->
                <blockRescue>true</blockRescue>
                <!-- Disable capture button.  禁用俘虏按钮。 -->
                <blockCapture>true</blockCapture>
                <!-- Disable arrest button.  禁用拘捕按钮。 -->
                <blockArrest>true</blockArrest>
            </li>

            <!-- Replace this pawn's pregnancy outcome to the PawnKindDef you write. If you are not using this class, your special character will duplicate itself when it get pregnant. 
             替换这个角色的怀孕结果为填写的PawnKindDef，如果你不是使用这个class，使用原版怀孕的此角色将会生出复制人。这个功能摘抄自Azzy的Transpiler。-->
            <li Class="AriandelLibrary.AL_AzzyPregnancy_Extension">
                <replaceWithKind>Milira_Colonist</replaceWithKind>
            </li>

            <!-- Disable subcore scan for this pawn. 禁用次核扫描仪 -->
            <li Class="AriandelLibrary.AL_SubcoreScannerBlocker_Extension" />

            <!-- Disable some surgery from RimWorld Core. 禁用一部分来自环世界原版的手术 -->
            <li Class="AriandelLibrary.AL_SurgeryBlocker_Extension">
                <!-- Disable replace bodypart to worse part. 禁用将身体部件替换为更差的部件。 -->
                <blockLowTech>true</blockLowTech>
                <!-- Disable organ harvest. 禁用噶腰子。 -->
                <blockHarvest>true</blockHarvest>
            </li>

            <!-- Freeze this pawn's biological age. 锁定这个角色的生理年龄，使生理年龄无增长。 -->
            <li Class="AriandelLibrary.AL_AgeFreeze_Extension">
                <freezeBiologicalAge>true</freezeBiologicalAge>
            </li>

            <!-- Make the trait defname you write here unique to this pawn. If any other pawn with wrong pawnkind gains these traits. These traits will be removed on the wrong pawn. You may write multiple traits here.
             填写在下面的特质Defname将会独属于这个特殊角色，如果其他类型的pawn获得了这些专属特质，那么这些特质将会从错误的pawn身上删除。你可以写下多个专属特质。 -->
            <li Class="AriandelLibrary.AL_TraitLock_Extension">
                <requiredTraits>
                    <li>MX_QH_Trait_LongBreath</li>
                    <li>MX_QH_Trait_WaterFairy</li>
                </requiredTraits>
            </li>

            <!-- Disable this special character from being used as a ritual victim.  禁用这个特殊角色作为心灵仪式受害者-->
            <li Class="AriandelLibrary.Anomaly.AL_RitualRoleRestriction_Extension" MayRequire="Ludeon.RimWorld.Anomaly" />

            <!-- Disable obelisk duplication for this pawn. 禁止此角色被方尖碑复制。 -->
            <li Class="AriandelLibrary.Anomaly.AL_ObeliskDuplicationBlocker_Extension" MayRequire="Ludeon.RimWorld.Anomaly" />

            <!-- Reflect flesh beast lance for this pawn. 反弹血肉突变枪。 -->
            <li Class="AriandelLibrary.Anomaly.AL_FleshbeastReflect_Extension" MayRequire="Ludeon.RimWorld.Anomaly" />

            <!-- Reflect psychic slaughter ability for this pawn. 反弹心灵宰杀。 -->
            <li Class="AriandelLibrary.Anomaly.AL_PsychicSlaughterReflect_Extension" MayRequire="Ludeon.RimWorld.Anomaly" />

            <!-- Replace this pawn's pregnancy outcome to the PawnKindDef you write. This is for RJW Menstruation. 
             替换这个角色的怀孕结果为填写的PawnKindDef，这是为RJW月经扩展准备的工具。 -->
            <li Class="AriandelLibrary.rjw.menstruation.AL_RJW_Menstruation_Pregnancy_Extension" MayRequire="rjw.menstruation">
                <replaceWithKind>Milira_Colonist</replaceWithKind>
            </li>

        </modExtensions>

    </PawnKindDef>



</Defs>
