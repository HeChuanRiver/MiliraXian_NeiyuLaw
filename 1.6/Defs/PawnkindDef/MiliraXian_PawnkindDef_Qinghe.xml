<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <!-- 清荷 -->
    <PawnKindDef ParentName="Milira_PawnBase">
        <defName>MiliraXian_Qinghe</defName>
        <!-- pawn kind label pawn kind的名字 -->
        <!-- Lotaris Ryselia -->
        <label>仙域米莉拉</label>
        <!-- 设置性别 -->
        <fixedGender>Female</fixedGender>
        <!-- faction you spawn her or her default belonging 生成她时的派系，或者说她的初始归属 -->
        <defaultFactionType>Milira_Faction</defaultFactionType>
        <xenotypeSet Inherit="False">
            <xenotypeChances>
                <MiliraXenotype MayRequire="Ancot.MiliraRaceGenePatch">1.0</MiliraXenotype>
            </xenotypeChances>
        </xenotypeSet>
        <!-- raid point / combat power = number of this pawn could spawn in raid 袭击点数/战斗力=袭击来袭时可以生成多少个这个pawn -->
        <combatPower>0</combatPower>
        <!-- item quality when spawned 生成时她的身上全部的带有品质的thing的品质 -->
        <itemQuality>Excellent</itemQuality>
        <!-- 是否为战斗人员 -->
        <isFighter>true</isFighter>
        <!-- 是否为派系首领 -->
        <factionLeader>false</factionLeader>
        <!-- wealth range for random apparel 随机生成装备时，允许的装备财富值范围 -->
        <apparelMoney>
            <min>99999</min>
            <max>99999</max>
        </apparelMoney>

        <!-- apparel tags for random apparel 用于随机生成装备时，允许的装备tag -->
        <apparelTags>
        <!--    TODO: Apparel Tag for QingHe -->
            <li>MX_QingheNormal</li>
        </apparelTags>

        <!--    TODO: Specific Apparel Req for QingHe-->
        <specificApparelRequirements>
        </specificApparelRequirements>

        <!-- apparel you force to spawn 强制要求生成的装备 -->
        <!--        TODO: Add Apparel for QingHe -->
        <apparelRequired>
            <li>MX_QingheNormal</li>
            <li>MX_QingheHeaddress</li>
        </apparelRequired>
        <!-- Disabled apparel tags if you want to spawn randomly 如果你想要使用随机生成装备，禁用的装备tag -->
        <apparelDisallowTags>
        </apparelDisallowTags>
        <!-- 允许生成头部装备的概率 -->
        <apparelAllowHeadgearChance>1.0</apparelAllowHeadgearChance>

        <!-- 武器的tag -->
        <weaponTags>
          <li>MiliraXian_QingheInstrument</li>
        </weaponTags>

        <!-- wealth range for random weapon 随机生成武器时，允许的武器财富值范围 -->
        <weaponMoney>
            <min>99999</min>
            <max>99999</max>
        </weaponMoney>

        <inventoryOptions>
            <thingDef>MX_QH_Weapon_Sword</thingDef>
            <countRange>1</countRange>
        </inventoryOptions>

        <!-- 生成时装备的耐久度区间，1-1则为100% -->
        <gearHealthRange Inherit="False">
            <min>1</min>
            <max>1</max>
        </gearHealthRange>
        <forceNormalGearQuality>false</forceNormalGearQuality>
        <minApparelQuality>Excellent</minApparelQuality>
        <maxApparelQuality>Excellent</maxApparelQuality>

        <!-- backstory for this pawn, using tags here 为这个pawn选择背景故事，这里使用的是tag -->
        <backstoryFiltersOverride>
            <li>
                <!-- 幼年背景故事 -->
                <categoriesChildhood>
                    <li>MiliraXian_BackStoryChild_Qinghe_Tag</li>
                </categoriesChildhood>

                <!-- 成年背景故事 -->
                <categoriesAdulthood>
                    <li>MiliraXian_BackStoryAdult_Qinghe_Tag</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>

        <!-- work type required, in order to ban some backstory that may disable some kind of works 强制要求的工作类型，用于筛选并且禁止一些可能禁用指定的工作类型的背景故事 -->
        <requiredWorkTags>
            <li>Intellectual</li>
        </requiredWorkTags>

        <!-- use traitdef defname here! 禁止生成的trait，此处使用的是trait defname -->
        <disallowedTraits>
            <li>BodyPurist</li>
            <li>Gay</li>
            <li>Bisexual</li>
            <li>Asexual</li>
        </disallowedTraits>

        <!-- use traitdef defname with degree here! 禁止生成的trait，此处使用的是trait defname，里面填写的degree对应一种trait，比如PsychicSensitivity：-2的意思是心灵失聪 -->
        <disallowedTraitsWithDegree>
            <PsychicSensitivity>-2</PsychicSensitivity>
        </disallowedTraitsWithDegree>

        <!-- 这个角色的头发RGB -->
        <forcedHairColor>(255,255,255)</forcedHairColor>
        <favoriteColor>MX_QH_FlowerPink</favoriteColor>

        <!-- 给予这个角色的技能 -->
        <skills>
            <li>
                <skill>Shooting</skill>
                <range>5~5</range>
            </li>
            <li>
                <skill>Melee</skill>
                <range>11~11</range>
            </li>
            <li>
                <skill>Construction</skill>
                <range>16~16</range>
            </li>
            <li>
                <skill>Mining</skill>
                <range>6~6</range>
            </li>
            <li>
                <skill>Cooking</skill>
                <range>18~18</range>
            </li>
            <li>
                <skill>Plants</skill>
                <range>12~12</range>
            </li>
            <li>
                <skill>Animals</skill>
                <range>10~10</range>
            </li>
            <li>
                <skill>Crafting</skill>
                <range>18~18</range>
            </li>
            <li>
                <skill>Artistic</skill>
                <range>14~14</range>
            </li>
            <li>
                <skill>Medicine</skill>
                <range>18~18</range>
            </li>
            <li>
                <skill>Social</skill>
                <range>1~1</range>
            </li>
            <li>
                <skill>Intellectual</skill>
                <range>14~14</range>
            </li>
        </skills>

        <!-- modExtensions是用来使用的非官方类的地方 -->
        <fixedChildBackstories Inherit="False"><li>MiliraXian_BackStoryChild_Qinghe_BS1</li></fixedChildBackstories>
        <fixedAdultBackstories Inherit="False"><li>MiliraXian_BackStoryAdult_Qinghe_BS1</li></fixedAdultBackstories>
        <minGenerationAge>160</minGenerationAge>
        <maxGenerationAge>160</maxGenerationAge>
        <chronologicalAgeRange>160~160</chronologicalAgeRange>
        <forcedTraits>
            <li>MX_QH_Trait_SpringFall</li>
            <li>MX_QH_Trait_WaterFairy</li>
            <Beauty>2</Beauty>
        </forcedTraits>
        <startingHediffs><li><def>MX_QH_FlowingForm</def><severity>1</severity></li><li><def>MX_QH_AuraShield</def><severity>1</severity></li><li><def>MX_QH_FlowerResonance</def><severity>1</severity></li><li><def>MX_QH_FlowerDecree</def><severity>1</severity></li></startingHediffs>

        <modExtensions>
            <li Class="MiliraXian.Characters.Common.Biography.BiographyExtension">
                <stories>
                    <li>
                        <storyName>SpringWaterTune</storyName>
                        <label>春水调</label>
                        <storyText>清荷记下荷雨初歇时的水声与轻拍。读到此卷时，仿佛能听见春水漫过石阶，细碎花影随声摇动。</storyText>
                        <unlockCondition Class="MiliraXian.Characters.Common.Biography.BiographyCondition_PlayerFaction" />
                        <rewards />
                        <notifyOnUnlock>false</notifyOnUnlock>
                    </li>
                    <li>
                        <storyName>FlowerShadowNotes</storyName>
                        <label>花影记</label>
                        <storyText>这卷手稿写的是花影、步法与短曲之间的呼应。句子不求铺张，却处处留下清荷对庭中草木的细致观察。</storyText>
                        <unlockCondition Class="MiliraXian.Characters.Common.Biography.BiographyCondition_PlayerFaction" />
                        <rewards />
                        <notifyOnUnlock>false</notifyOnUnlock>
                    </li>
                    <li>
                        <storyName>ListeningToRain</storyName>
                        <label>听雨小谱</label>
                        <storyText>清荷把雨落荷叶的节拍拆成数段短谱，又在页边附上演奏时的心得。文字安静，读来却有微雨入亭的回响。</storyText>
                        <unlockCondition Class="MiliraXian.Characters.Common.Biography.BiographyCondition_PlayerFaction" />
                        <rewards />
                        <notifyOnUnlock>false</notifyOnUnlock>
                    </li>
                    <li>
                        <storyName>LotusSteps</storyName>
                        <label>莲步散声</label>
                        <storyText>这是一篇兼记舞步与曲调的书卷。清荷以很轻的笔触描摹衣袂、铃音和水面涟漪，使寻常曲艺多了几分雅致。</storyText>
                        <unlockCondition Class="MiliraXian.Characters.Common.Biography.BiographyCondition_PlayerFaction" />
                        <rewards />
                        <notifyOnUnlock>false</notifyOnUnlock>
                    </li>
                    <li>
                        <storyName>FeatherRobeByTheLotus</storyName>
                        <label>羽衣听荷</label>
                        <storyText>清荷把荷雨亭中的水声写成底韵，又在页边记下霓羽起势时衣袂掠风的轻响。整卷读来像一场隔水相和的短曲。</storyText>
                        <unlockCondition Class="MiliraXian.Characters.Common.Biography.BiographyCondition_PlayerFaction" />
                        <rewards />
                        <notifyOnUnlock>false</notifyOnUnlock>
                    </li>
                    <li>
                        <storyName>FlameThroughRain</storyName>
                        <label>离火照雨</label>
                        <storyText>这卷手稿写雨夜灯火与弦声相映。清荷将昭离谈及的余烬、命火与回声化作曲中转折，使荷亭旧调多了一分明亮锋芒。</storyText>
                        <unlockCondition Class="MiliraXian.Characters.Common.Biography.BiographyCondition_PlayerFaction" />
                        <rewards />
                        <notifyOnUnlock>false</notifyOnUnlock>
                    </li>
                </stories>
            </li>

            <!-- —————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————— -->
            <!-- The Following classes must be included!!! ↓↓↓ -->
            <!-- 以下class必须全部填写，绝对不能漏任何一个 ↓↓↓ -->

            <!-- "FixedIdentityExtension" is a tool for generating a fixed, non-random pawn. "FixedIdentityExtension"是用来生成一个固定的，绝对非随机的pawn的工具。 -->
            <li Class="MiliraXian.CharacterLib.CharacterAppearanceExtension">
                <firstNameKey>MX_Name_Qinghe_First</firstNameKey>
                <lastNameKey>MX_Name_Qinghe_Last</lastNameKey>
                <nickNameKey>MX_Name_Qinghe_Nick</nickNameKey>
                <headType>MiliraQingheHead</headType>
            </li>

            <!--            &lt;!&ndash; This class is for adding this pawn to randow recruitment in mod "Milira Faction: Milira Imperium" -->
            <!--            这个class是用来把这个角色加入到“米莉拉派系扩展：米莉拉帝国”的随机招募中的。&ndash;&gt;-->
            <!--            <li Class="MiliraImperium.UniqueRecruitExtension" MayRequire="Ariandel.MiliraImperium">-->
            <!--                &lt;!&ndash; Only can be recruited once. 只可以被招募一次。 &ndash;&gt;-->
            <!--                <uniqueOnce>true</uniqueOnce>-->
            <!--                &lt;!&ndash; The higher weight means higher probability to be chose in randow recruitment. 越高的weight代表在随机招募中被抽中的概率越高。 &ndash;&gt;-->
            <!--                <weight>0</weight>-->
            <!--            </li>-->

            <!-- "SpecialPawnExtension" is used to adding this pawn into special character manager(SCM). 
            “SpecialPawnExtension”用于把这个角色加入特殊角色管理器。-->
            <li Class="MiliraXian.CharacterLib.CharacterRegistrationExtension">
                <characterId>Qinghe</characterId>
            </li>
            <li Class="AriandelLibrary.SpecialPawnExtension" MayRequire="Ariandel.AriandelLibrary">
                <!-- StaticID for this pawn. Never let two pawn share the same StaticID, it must be unique for every special pawn! 
                这是这个角色的StaticID，永远不要让两个角色的StaticID重复！ -->
                <uniqueID>Qinghe</uniqueID>
                <tabDef>MI_Milira_Tab</tabDef>
                <!-- TODO: Replace with QingHe's portrait. -->
                <iconPathRecruited>MiliraXianNeiyu/Icon/NeiyuAG</iconPathRecruited>
                <labelKey>SpecialPawnQinghe.label</labelKey>
                <descKey>SpecialPawnQinghe.desc</descKey>
                <order>16</order>
            </li>

            <li Class="MiliraXian.CharacterLib.CharacterProtectionExtension">
                <recoverOnDeath>true</recoverOnDeath>
                <childKind>Milira_Colonist</childKind>
                <requiredTraits>
                    <li>MX_QH_Trait_SpringFall</li><li>MX_QH_Trait_WaterFairy</li>
                </requiredTraits>
            </li>

        </modExtensions>

    </PawnKindDef>



</Defs>
