<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <!-- 清荷 -->
    <PawnKindDef ParentName="Milira_PawnBase">
        <defName>MiliraXian_Qinghe</defName>
        <!-- pawn kind label pawn kind的名字 -->
        <!-- Lotaris Ryselia -->
        <label>仙域米莉拉</label>
        <!-- 设置性别 -->
        <fixedGender>Female</fixedGender>
        <!-- faction you spawn her or her default belonging 生成她时的派系，或者说她的初始归属 -->
        <defaultFactionType>MiliraXian_Faction</defaultFactionType>
        <xenotypeSet Inherit="False">
            <xenotypeChances>
                <MiliraXenotype MayRequire="Ancot.MiliraRaceGenePatch">1.0</MiliraXenotype>
            </xenotypeChances>
        </xenotypeSet>
        <!-- raid point / combat power = number of this pawn could spawn in raid 袭击点数/战斗力=袭击来袭时可以生成多少个这个pawn -->
        <combatPower>0</combatPower>
        <!-- item quality when spawned 生成时她的身上全部的带有品质的thing的品质 -->
        <itemQuality>Excellent</itemQuality>
        <!-- 是否为战斗人员 -->
        <isFighter>true</isFighter>
        <!-- 是否为派系首领 -->
        <factionLeader>false</factionLeader>
        <!-- 设为 0 以关闭随机装备补充，详见霓羽 PawnkindDef 的注释。 -->
        <apparelMoney>
            <min>0</min>
            <max>0</max>
        </apparelMoney>

        <!-- 关闭生成时随机携带食物，详见霓羽 PawnkindDef 的注释。 -->
        <invNutrition>0</invNutrition>

        <!-- 仅作用于随机补充，对 apparelRequired 无影响。 -->
        <apparelTags>
            <li>MX_QingheNormal</li>
        </apparelTags>

        <!--    TODO: Specific Apparel Req for QingHe-->
        <specificApparelRequirements>
        </specificApparelRequirements>

        <!-- apparel you force to spawn 强制要求生成的装备 -->
        <!--        TODO: Add Apparel for QingHe -->
        <apparelRequired>
            <li>MX_QingheNormal</li>
            <li>MX_QingheHeaddress</li>
        </apparelRequired>
        <!-- Disabled apparel tags if you want to spawn randomly 如果你想要使用随机生成装备，禁用的装备tag -->
        <apparelDisallowTags>
        </apparelDisallowTags>
        <!-- 允许生成头部装备的概率 -->
        <apparelAllowHeadgearChance>1.0</apparelAllowHeadgearChance>

        <!-- 武器的tag -->
        <weaponTags>
          <li>MX_QH_StartUpWeapon</li>
        </weaponTags>

        <!-- wealth range for random weapon 随机生成武器时，允许的武器财富值范围。必须调最大99999才能允许刷出任意想要的武器，范围用Tag限制 -->
        <weaponMoney>
            <min>99999</min>
            <max>99999</max>
        </weaponMoney>

        <inventoryOptions>
            <thingDef>MX_QH_Weapon_Sword</thingDef>
            <countRange>1</countRange>
        </inventoryOptions>

        <!-- 生成时装备的耐久度区间，1-1则为100% -->
        <gearHealthRange Inherit="False">
            <min>1</min>
            <max>1</max>
        </gearHealthRange>
        <forceNormalGearQuality>false</forceNormalGearQuality>
        <minApparelQuality>Excellent</minApparelQuality>
        <maxApparelQuality>Excellent</maxApparelQuality>

        <!-- backstory for this pawn, using tags here 为这个pawn选择背景故事，这里使用的是tag
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>MiliraXian_BackStoryChild_Qinghe_Tag</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>MiliraXian_BackStoryAdult_Qinghe_Tag</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride> 目前已被覆盖，应该暂时没用了-->

        <!-- work type required, in order to ban some backstory that may disable some kind of works 强制要求的工作类型，用于筛选并且禁止一些可能禁用指定的工作类型的背景故事 -->
        <requiredWorkTags>
            <li>Intellectual</li>
        </requiredWorkTags>

        <!-- use traitdef defname here! 禁止生成的trait，此处使用的是trait defname 是否有用得打个问号
        <disallowedTraits>
            <li>BodyPurist</li>
            <li>Gay</li>
            <li>Bisexual</li>
            <li>Asexual</li>
        </disallowedTraits> -->

        <!-- use traitdef defname with degree here! 禁止生成的trait，此处使用的是trait defname，里面填写的degree对应一种trait，比如PsychicSensitivity：-2的意思是心灵失聪
        <disallowedTraitsWithDegree>
            <PsychicSensitivity>-2</PsychicSensitivity>
        </disallowedTraitsWithDegree> -->

        <!-- 这个角色的头发与发色 米莉拉头发是专门的种族部件，空发型使用种族自带的 Milira_Null -->
        <forcedHair>Milira_Null</forcedHair>
        <forcedHairColor>(255,255,255)</forcedHairColor>
        <!-- 角色的偏好颜色 -->
        <favoriteColor>MX_QH_FlowerPink</favoriteColor>

        <!-- 技能等级。FinalLevelOfSkill 的第 ⑤ 步会把算出的值夹进本区间，写成单点即完全确定。
             必须列全 12 项，缺项仍走背景故事与年龄的随机路径。
             注意：背景故事的 skillGains 在第 ⑤ 步之后被覆盖，仅作叙事装饰，不生效。 -->
        <skills>
            <li>
                <skill>Shooting</skill>
                <range>5~5</range>
            </li>
            <li>
                <skill>Melee</skill>
                <range>11~11</range>
            </li>
            <li>
                <skill>Construction</skill>
                <range>16~16</range>
            </li>
            <li>
                <skill>Mining</skill>
                <range>6~6</range>
            </li>
            <li>
                <skill>Cooking</skill>
                <range>18~18</range>
            </li>
            <li>
                <skill>Plants</skill>
                <range>12~12</range>
            </li>
            <li>
                <skill>Animals</skill>
                <range>10~10</range>
            </li>
            <li>
                <skill>Crafting</skill>
                <range>18~18</range>
            </li>
            <li>
                <skill>Artistic</skill>
                <range>14~14</range>
            </li>
            <li>
                <skill>Medicine</skill>
                <range>18~18</range>
            </li>
            <li>
                <skill>Social</skill>
                <range>1~1</range>
            </li>
            <li>
                <skill>Intellectual</skill>
                <range>14~14</range>
            </li>
        </skills>
        <fixedChildBackstories Inherit="False"><li>MiliraXian_BackStoryChild_Qinghe_BS1</li></fixedChildBackstories>
        <fixedAdultBackstories Inherit="False"><li>MiliraXian_BackStoryAdult_Qinghe_BS1</li></fixedAdultBackstories>
        <!-- 年龄设置。大概应该是没用的，在这里设置还会导致原版尝试生成失败
        <minGenerationAge>160</minGenerationAge>
        <maxGenerationAge>160</maxGenerationAge>
        <chronologicalAgeRange>160~160</chronologicalAgeRange>-->
         <!-- C# 字段默认值为 0.03，米莉拉继承链上无人覆盖，故必须显式归零，
             否则每次生成约 3% 概率带孕。 -->
        <humanPregnancyChance>0</humanPregnancyChance>
        <allowOldAgeInjuries>false</allowOldAgeInjuries>
        <!--生成时自带的Hediff。-->
        <startingHediffs>
            <li>
                <def>MX_QH_FlowingForm</def>
                <severity>1</severity>
            </li>
            <li>
                <def>MX_QH_AuraShield</def>
                <severity>1</severity>
            </li>
            <li>
                <def>MX_QH_FlowerResonance</def>
                <severity>1</severity>
            </li>
            <li>
                <def>MX_QH_AuraMastery</def>
            </li>
            <li>
                <def>MX_QH_FlowerDecree</def>
                <severity>1</severity>
            </li>
            <!-- 未写 severity 的三项保持 MakeHediff 默认值，与 Def 声明一致 -->
            <li>
                <def>MX_QH_CombatState</def>
            </li>
            <li>
                <def>MX_QH_CombatStance</def>
            </li>
            <li>
                <def>MX_QH_SwordPressure</def>
            </li>
            <li>
                <def>MX_QH_MeditativeStillness</def>
                <severity>1</severity>
            </li>
            <li>
                <def>MX_QH_Trickle</def>
                <severity>1</severity>
            </li>
        </startingHediffs>
        <!-- modExtensions是用来使用的非官方类的地方 -->
        <modExtensions>
            <li Class="MiliraXian.CharacterLib.CharacterIdentityExtension">
                <!-- 角色名，分别是名字、姓氏和昵称。 昵称会在大部分情况下显示。 -->
                <firstNameKey>MX_Name_Qinghe_First</firstNameKey>
                <lastNameKey>MX_Name_Qinghe_Last</lastNameKey>
                <nickNameKey>MX_Name_Qinghe_Nick</nickNameKey>
                <!-- 角色的头型。-->
                <headType>MiliraQingheHead</headType>
                <!-- 体型，默认为Female，会影响贴图选择 -->
                <bodyType>Female</bodyType>
                <!-- 设置背景故事 -->
                <childhoodBackstory>MiliraXian_BackStoryChild_Qinghe_BS1</childhoodBackstory>
                <adulthoodBackstory>MiliraXian_BackStoryAdult_Qinghe_BS1</adulthoodBackstory>
                <!-- 锁定生成时的年龄 -->
                <biologicalAgeYears>160</biologicalAgeYears>
                <chronologicalAgeYears>160</chronologicalAgeYears>

                <!-- 完整特质表。除基因附加的特质外，只有这里列出的特质会被应用 -->
                <traits>
                    <li>
                        <def>MX_QH_Trait_SpringFall</def>
                    </li>
                    <li>
                        <def>MX_QH_Trait_WaterFairy</def>
                    </li>
                    <li>
                        <def>Beauty</def>
                        <degree>2</degree>
                    </li>
                </traits>

                <!-- 生成期随机施加的污染项。怀孕与绝育源自 PawnKindDef 字段默认值，
                     米莉拉继承链上无人覆盖；疤痕与失明来自意识形态。 -->
                <forbiddenHediffs>
                    <li>PregnantHuman</li>
                    <li>Sterilized</li>
                    <li>ImplantedIUD</li>
                    <li>Scarification</li>
                    <li>Blindness</li>
                </forbiddenHediffs>
            </li>
            <!-- 角色身份 ID。特殊角色管理器（SCM）的显示数据挂在条件目录的载体 kindDef 上
                 （1.6/Mods/Ariandel.AriandelLibrary/Defs/SpecialPawnCarriers.xml），二者靠此 ID 接合。 -->
            <li Class="MiliraXian.CharacterLib.CharacterRegistrationExtension">
                <characterId>Qinghe</characterId>
            </li>

            <!-- 种族硬编码部件的替换，说明见霓羽的 PawnkindDef。 -->
            <li Class="MiliraXian.CharacterLib.CharacterRacePartExtension">
                <parts>
                    <li source="Milira/Pawn/BodyAddon/LeftWingNew/" prefix="true">MiliraXianQinghe/Pawn/LeftWingNew_Qinghe/</li>
                    <li source="Milira/Pawn/BodyAddon/RightWingNew/" prefix="true">MiliraXianQinghe/Pawn/RightWingNew_Qinghe/</li>
                    <li source="Milira/Pawn/Wings/" prefix="true">MiliraXianQinghe/Pawn/Wings_Qinghe/</li>
                </parts>
            </li>

            <!-- 本角色怀孕时生下的是普通米莉拉，不会再生出一个清荷。 -->
            <li Class="MiliraXian.CharacterLib.CharacterProtectionExtension">
                <childKind>Milira_Colonist</childKind>
            </li>

        </modExtensions>
    </PawnKindDef>
</Defs>
