<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- 霓羽 -->
    <PawnKindDef ParentName="Milira_PawnBase">
        <defName>MiliraXian_Neiyu</defName>
        <!-- pawnkind label pawnkind的名字 -->
        <label>霓羽·安吉莉特</label>
        <!-- 设置性别 -->
        <fixedGender>Female</fixedGender>
        <!-- faction you spawn her or her default belonging 生成她时的派系，或者说她的初始归属 -->
        <defaultFactionType>Ancients</defaultFactionType>
        <xenotypeSet Inherit="False">
            <xenotypeChances>
                <MiliraXenotype MayRequire="Ancot.MiliraRaceGenePatch">1.0</MiliraXenotype>
            </xenotypeChances>
        </xenotypeSet>
        <!-- raid point / combatpower = number of this pawn could spawn in raid 袭击点数/战斗力=袭击来袭时可以生成多少个这个pawn -->
        <combatPower>0</combatPower>
        <!-- item quality when spawnd 生成时她的身上全部的带有品质的thing的品质 -->
        <itemQuality>Excellent</itemQuality>
        <!-- 是否为战斗人员 -->
        <isFighter>true</isFighter>
        <!-- 是否为派系首领 -->
        <factionLeader>false</factionLeader>
        <!-- 随机装备的预算。设为 0 则 CanUsePair 拒绝一切候选（PawnApparelGenerator 第 1042 行
             pair.Price > moneyLeft），随机补充池必为空；apparelRequired 不受预算限制，照常穿上。
             这是让装备完全确定的手段，不要改回非零值。 -->
        <apparelMoney>
            <min>0</min>
            <max>0</max>
        </apparelMoney>

        <!-- 随机装备池的白名单，仅作用于随机补充，对 apparelRequired 无影响。
             apparelMoney 为 0 时本段已无实际作用，保留作第二道防线。 -->
        <apparelTags>
            <li>MiliraXian_NeiyuNormal</li>
        </apparelTags>

        <specificApparelRequirements>
<!--            <li>-->
<!--                <bodyPartGroup>FullHead</bodyPartGroup>-->
<!--                <requiredTag>Milira_ValkyrHelmet</requiredTag>-->
<!--                <apparelLayer>Overhead</apparelLayer>-->
<!--                <stuff>Milira_SunPlateSteel</stuff>-->
<!--            </li>-->
        </specificApparelRequirements>

        <!-- apparel you force to spawn 强制要求生成的装备 -->
        <apparelRequired>
            <li>MiliraXian_NeiyuInner</li>
            <li>MiliraXian_NeiyuNormal</li>
            <li>MX_Apparel_EarringsZhenzhu</li>
<!--            <li>MX_Neiyu_Form_Flower</li>-->
        </apparelRequired>
        <!-- Disabled apparel tags if you want to spawn randomly 如果你想要使用随机生成装备，禁用的装备tag -->
        <apparelDisallowTags>
        </apparelDisallowTags>
        <!-- 允许生成头部装备的概率 -->
        <apparelAllowHeadgearChance>1.0</apparelAllowHeadgearChance>

        <!-- 武器的tag -->
        <weaponTags>
            <li>MiliraXian_NeiyuFlower</li>
        </weaponTags>

        <!-- wealth range for random weapon 随机生成武器时，允许的武器财富值范围 -->
        <weaponMoney>
            <min>99999</min>
            <max>99999</max>
        </weaponMoney>

        <!-- 生成时装备的耐久度区间，1-1则为100% -->
        <gearHealthRange Inherit="False">
            <min>1</min>
            <max>1</max>
        </gearHealthRange>
        <forceNormalGearQuality>false</forceNormalGearQuality>
        <minApparelQuality>Excellent</minApparelQuality>
        <maxApparelQuality>Excellent</maxApparelQuality>

        <!-- backstory for this pawn, using tags here 为这个pawn选择背景故事，这里使用的是tag -->
        <backstoryFiltersOverride>
            <li>
                <!-- 幼年背景故事 -->
                <categoriesChildhood>
                    <li>MiliraXian_BackStoryChild_Neiyu_Tag</li>
                </categoriesChildhood>

                <!-- 成年背景故事 -->
                <categoriesAdulthood>
                    <li>MiliraXian_BackStoryAdult_Neiyu_Tag</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>

        <!-- work type required, in order to ban some backstory that may disable some kind of works 强制要求的工作类型，用于筛选并且禁止一些可能禁用指定的工作类型的背景故事 -->
        <requiredWorkTags>
            <li>Intellectual</li>
        </requiredWorkTags>

        <!-- use traitdef defname here! 禁止生成的trait，此处使用的是trait defname -->
        <disallowedTraits>
            <li>BodyPurist</li>
            <li>Gay</li>
            <li>Bisexual</li>
            <li>Asexual</li>
        </disallowedTraits>

        <!-- use traitdef defname with degree here! 禁止生成的trait，此处使用的是trait defname，里面填写的degree对应一种trait，比如PsychicSensitivity：-2的意思是心灵失聪 -->
        <disallowedTraitsWithDegree>
            <PsychicSensitivity>-2</PsychicSensitivity>
        </disallowedTraitsWithDegree>

        <!-- 这个角色的头发与发色 -->
        <forcedHair>Bald</forcedHair>
        <forcedHairColor>(255,255,255)</forcedHairColor>

        <!-- 技能等级。FinalLevelOfSkill 的第 ⑤ 步会把算出的值夹进本区间，写成单点即完全确定。
             必须列全 12 项，缺项仍走背景故事与年龄的随机路径。
             注意：背景故事的 skillGains 在第 ⑤ 步之后被覆盖，仅作叙事装饰，不生效。 -->
        <skills>
            <li><skill>Shooting</skill><range>20~20</range></li>
            <li><skill>Melee</skill><range>20~20</range></li>
            <li><skill>Construction</skill><range>8~8</range></li>
            <li><skill>Mining</skill><range>6~6</range></li>
            <li><skill>Cooking</skill><range>20~20</range></li>
            <li><skill>Plants</skill><range>10~10</range></li>
            <li><skill>Animals</skill><range>8~8</range></li>
            <li><skill>Crafting</skill><range>12~12</range></li>
            <li><skill>Artistic</skill><range>14~14</range></li>
            <li><skill>Medicine</skill><range>12~12</range></li>
            <li><skill>Social</skill><range>10~10</range></li>
            <li><skill>Intellectual</skill><range>16~16</range></li>
        </skills>

        <!-- 给予这个角色的技能 -->
        <abilities>
            <!-- This is an ability from "Milira Faction: Milira Imperium", so I commented out it. ↓↓↓ 这个技能来自“米莉拉派系扩展：米莉拉帝国”所以我把它注释掉了。↓↓↓-->
            <li>MX_Neiyu_WarpFeather</li>
            <li>MX_Neiyu_ThunderMarkedStorm</li>
            <li>MX_Neiyu_Bow_ArrowBarrage</li>
            <li>MX_Neiyu_Flower_BlessingField</li>
            <li>MX_Neiyu_Flower_ToxinGarden</li>
            <li>MX_Neiyu_Sword_Skyfall</li>
            <li>MX_Neiyu_Sword_ExecuteHead</li>
            <!-- <li>MI_ShroudPower_Skip</li> -->
        </abilities>

        <!-- modExtensions是用来使用的非官方类的地方 -->
        <fixedChildBackstories Inherit="False"><li>MiliraXian_BackStoryChild_Neiyu_BS1</li></fixedChildBackstories>
        <fixedAdultBackstories Inherit="False"><li>MiliraXian_BackStoryAdult_Neiyu_BS1</li></fixedAdultBackstories>
        <!-- 年龄由 CharacterIdentityExtension 的 biologicalAgeYears/chronologicalAgeYears 声明，
             生成期经 PawnGenerationRequest.FixedBiologicalAge 直接赋值。
             不要在此写 min/maxGenerationAge：生理年龄是从种族曲线连续抽样后用 AgeAllowed 筛选的，
             把上下限压成同一年几乎永不命中，原版重试 300 次后报错并沿用最后抽到的随机年龄。 -->
        <chronologicalAgeRange>180~180</chronologicalAgeRange>

        <!-- 特质由 CharacterIdentityExtension 的 traits 全量声明，不在此处重复维护。 -->

        <!-- C# 字段默认值为 0.03，米莉拉继承链上无人覆盖，故必须显式归零，
             否则每次生成约 3% 概率带孕。 -->
        <humanPregnancyChance>0</humanPregnancyChance>
        <!-- 默认 true，且老年伤病随年龄加重；本角色 180 岁，不关闭必然一身伤残。 -->
        <allowOldAgeInjuries>false</allowOldAgeInjuries>

        <startingHediffs><li><def>MXNL_NeiyuShield</def><severity>1</severity></li></startingHediffs>

        <modExtensions>
            <!-- —————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————— -->
            <!-- The Following classes must be included!!! ↓↓↓ -->
            <!-- 以下class必须全部填写，绝对不能漏任何一个 ↓↓↓ -->

            <!-- "FixedIdentityExtension" is a tool for generating a fixed, non-random pawn. "FixedIdentityExtension"是用来生成一个固定的，绝对非随机的pawn的工具。 -->
            <li Class="MiliraXian.CharacterLib.CharacterIdentityExtension">
                <firstNameKey>MX_Name_Neiyu_First</firstNameKey>
                <lastNameKey>MX_Name_Neiyu_Last</lastNameKey>
                <nickNameKey>MX_Name_Neiyu_Nick</nickNameKey>
                <headType>MiliraNeiyuHead</headType>
                <bodyType>Female</bodyType>
                <childhoodBackstory>MiliraXian_BackStoryChild_Neiyu_BS1</childhoodBackstory>
                <adulthoodBackstory>MiliraXian_BackStoryAdult_Neiyu_BS1</adulthoodBackstory>
                <biologicalAgeYears>180</biologicalAgeYears>
                <chronologicalAgeYears>180</chronologicalAgeYears>

                <!-- 完整特质表。生成期原版会从七处追加特质，其中性取向一项无 XML 开关，
                     故按本表全量重建：未列出的一律移除。 -->
                <traits>
                    <li><def>MiliraXianNeiyu_Love</def></li>
                    <li><def>Beauty</def><degree>2</degree></li>
                </traits>

                <!-- 生成期随机施加的污染项。怀孕与绝育源自 PawnKindDef 字段默认值，
                     米莉拉继承链上无人覆盖；疤痕与失明来自意识形态。 -->
                <forbiddenHediffs>
                    <li>PregnantHuman</li>
                    <li>Sterilized</li>
                    <li>ImplantedIUD</li>
                    <li>Scarification</li>
                    <li>Blindness</li>
                </forbiddenHediffs>
            </li>

<!--            &lt;!&ndash; This class is for adding this pawn to randow recruitment in mod "Milira Faction: Milira Imperium" -->
<!--            这个class是用来把这个角色加入到“米莉拉派系扩展：米莉拉帝国”的随机招募中的。&ndash;&gt;-->
<!--            <li Class="MiliraImperium.UniqueRecruitExtension" MayRequire="Ariandel.MiliraImperium">-->
<!--                &lt;!&ndash; Only can be recruited once. 只可以被招募一次。 &ndash;&gt;-->
<!--                <uniqueOnce>true</uniqueOnce>-->
<!--                &lt;!&ndash; The higher weight means higher probability to be chose in randow recruitment. 越高的weight代表在随机招募中被抽中的概率越高。 &ndash;&gt;-->
<!--                <weight>0</weight>-->
<!--            </li>-->

            <!-- 角色身份 ID。特殊角色管理器（SCM）的显示数据挂在条件目录的载体 kindDef 上
                 （1.6/Mods/Ariandel.AriandelLibrary/Defs/SpecialPawnCarriers.xml），二者靠此 ID 接合。 -->
            <li Class="MiliraXian.CharacterLib.CharacterRegistrationExtension">
                <characterId>Neiyu</characterId>
            </li>
            <!-- 本角色怀孕时生下的是普通米莉拉，不会再生出一个霓羽。 -->
            <li Class="MiliraXian.CharacterLib.CharacterProtectionExtension">
                <childKind>Milira_Colonist</childKind>
            </li>


            <li Class="MiliraXian.Characters.Common.Biography.BiographyExtension">
                <stories>
                    <li>
                        <storyName>StableStoryId</storyName>
                        <label>故事测试</label>
                        <storyText>gpt是个傻逼我是个傻逼大家都是煞笔，嘻嘻嘻嘻嘻</storyText>
                        <unlockCondition Class="MiliraXian.Characters.Common.Biography.BiographyCondition_RecordValue">
                            <record>DamageDealt</record>
                            <minimumValue>100</minimumValue>
                        </unlockCondition>
                        <rewards />
                    </li>
                </stories>
            </li>
            
            
        </modExtensions>

    </PawnKindDef>



</Defs>
