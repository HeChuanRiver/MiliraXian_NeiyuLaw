  <ThingDef>
    <defName>MX_Mingyuan_Mote_QuestLandingSigil</defName>
    <label>white flame landing sigil</label>
    <thingClass>MoteThrown</thingClass>
    <category>Mote</category>
    <graphicData>
      <graphicClass>Graphic_MoteWithAgeSecs</graphicClass>
      <shaderType>MoteGlowPulse</shaderType>
      <texPath>MiliraXianMingyuan/Effect/LifeBurnMark</texPath>
      <color>(1.00, 0.93, 0.72, 0.88)</color>
      <drawSize>(7.5,7.5)</drawSize>
      <shaderParameters>
        <_Interval>0.16</_Interval>
      </shaderParameters>
    </graphicData>
    <altitudeLayer>MoteOverheadLow</altitudeLayer>
    <tickerType>Normal</tickerType>
    <useHitPoints>false</useHitPoints>
    <isSaveable>false</isSaveable>
    <drawOffscreen>true</drawOffscreen>
    <mote>
      <fadeInTime>0.15</fadeInTime>
      <solidTime>5.4</solidTime>
      <fadeOutTime>1.2</fadeOutTime>
      <growthRate>0.10</growthRate>
    </mote>
  </ThingDef>

