<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="EtherealThingBase">
    <defName>MX_Mingyuan_BowVisual</defName>
    <label>Mingyuan bow visual controller</label>
    <thingClass>MiliraXian.Characters.Mingyuan.Thing_MingyuanBowVisual</thingClass>
    <drawerType>RealtimeOnly</drawerType>
    <selectable>false</selectable>
    <tickerType>Normal</tickerType>
    <passability>Standable</passability>
    <isSaveable>true</isSaveable>
    <drawOffscreen>false</drawOffscreen>
  </ThingDef>

  <ThingDef>
    <defName>MX_Mingyuan_Mote_BowFocusTarget</defName>
    <label>Mingyuan bow focus target</label>
    <thingClass>MoteAttached</thingClass>
    <category>Mote</category>
    <graphicData>
      <graphicClass>Graphic_MoteWithAgeSecs</graphicClass>
      <shaderType>MoteGlowPulse</shaderType>
      <texPath>MiliraXianMingyuan/Effect/InstantCombustionMark</texPath>
      <color>(1.00, 0.42, 0.12, 0.94)</color>
      <drawSize>(1.55, 1.55)</drawSize>
      <shaderParameters>
        <_Interval>0.14</_Interval>
      </shaderParameters>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <tickerType>Normal</tickerType>
    <useHitPoints>false</useHitPoints>
    <isSaveable>false</isSaveable>
    <rotatable>false</rotatable>
    <drawOffscreen>false</drawOffscreen>
    <mote>
      <fadeInTime>0.08</fadeInTime>
      <solidTime>999999</solidTime>
      <fadeOutTime>0.18</fadeOutTime>
      <needsMaintenance>true</needsMaintenance>
      <fadeOutUnmaintained>true</fadeOutUnmaintained>
    </mote>
  </ThingDef>

</Defs>
