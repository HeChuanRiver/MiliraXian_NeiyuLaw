<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThoughtDef>
        <defName>MX_QH_LuoshenContractMaintained</defName>
        <workerClass>MiliraXian.Characters.QingHe.Thoughts.ThoughtWorker_LuoshenContractMaintained</workerClass>
        <thoughtClass>Thought_Situational</thoughtClass>
        <stages>
            <li>
                <label>洛神契：相守</label>
                <description>与{PAWN_nameDef}在洛神的见证下结下了契约，和{PAWN_nameDef}在一起的感觉令我感到安心。</description>
                <baseMoodEffect>16</baseMoodEffect>
            </li>
            <li>
                <label>洛水之仪</label>
                <description>——“髣髴兮若轻云之蔽月，飘飖兮若流风之回雪”</description>
                <baseMoodEffect>8</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>MX_QH_LuoshenContractBroken</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>10</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>洛神契破碎 ({0})</label>
                <description>我与{OTHERPAWN_nameDef}维系的契约已经破碎，曾经共鸣的声音只余空响。</description>
                <baseMoodEffect>-24</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>MX_QH_QingheInstrumentPerformance</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.2</durationDays>
        <stackLimit>1</stackLimit>
        <showBubble>false</showBubble>
        <stages>
            <li>
                <label>倾听清荷的演奏</label>
                <description>清荷婉转的乐声在屋内缓缓流转，令人心绪安宁。</description>
                <baseMoodEffect>5</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>MX_QH_NoLotusPond</defName>
        <workerClass>MiliraXian.Characters.QingHe.Thoughts.ThoughtWorker_QingheNoLotusPond</workerClass>
        <thoughtClass>Thought_Situational</thoughtClass>
        <stages>
            <li>
                <label>缺少荷池</label>
                <description>我需要一个合适的修行之所。</description>
                <baseMoodEffect>-6</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>MX_QH_LotusPavilionBeautyLow</defName>
        <workerClass>MiliraXian.Characters.QingHe.Thoughts.ThoughtWorker_QingheLotusPavilionBeautyLow</workerClass>
        <thoughtClass>Thought_Situational</thoughtClass>
        <stages>
            <li>
                <label>荷雨亭不够美观</label>
                <description>我的修行地点环境非常糟糕，这让我很难过。</description>
                <baseMoodEffect>-4</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

</Defs>
