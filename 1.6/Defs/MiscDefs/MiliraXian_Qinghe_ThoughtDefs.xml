<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThoughtDef>
        <defName>MX_QH_LuoshenContractMaintained</defName>
        <workerClass>MiliraXian.Characters.QingHe.ThoughtWorker_QingheLuoshenContractMaintained</workerClass>
        <thoughtClass>Thought_Situational</thoughtClass>
        <stages>
            <li>
                <label>Luoshen contract: together</label>
                <description>I formed a contract with {PAWN_nameDef} under Luoshen's witness. Being with {PAWN_nameDef} makes me feel at peace.</description>
                <baseMoodEffect>16</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>MX_QH_LuoshenContractBroken</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>10</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>Luoshen contract broken ({0})</label>
                <description>The contract I maintained with {OTHERPAWN_nameDef} has broken. The flower words that once resonated now echo hollowly.</description>
                <baseMoodEffect>-24</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>MX_QH_LuoshenRibbonGrace</defName>
        <thoughtClass>Thought_MemorySocial</thoughtClass>
        <durationDays>30</durationDays>
        <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
        <lerpOpinionToZeroAfterDurationPct>0.75</lerpOpinionToZeroAfterDurationPct>
        <stages>
            <li>
                <label>Luoshen's ribbon ({0})</label>
                <description>Luoshen's ribbon once drew my heart toward {OTHERPAWN_nameDef}. That gentleness still echoes within me.</description>
                <baseOpinionOffset>50</baseOpinionOffset>
            </li>
        </stages>
    </ThoughtDef>
</Defs>
