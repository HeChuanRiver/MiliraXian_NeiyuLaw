    <MiliraXian.Characters.SkillNodeDef>
        <defName>MX_QH_Trait_LotusShield</defName>
        <label>莲华护盾</label>
        <description>清荷受到十二花神的庇护，能自然产生一面莲华护盾（容量500，每秒回充15，破碎后失效3秒）。护盾单次承伤最多消耗20点，超出的伤害会被直接拦下。</description>
        <category>MX_QH_Category_Qinghe</category>
        <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_ThunderMarkedStorm</iconPath>
        <displayOrder>100</displayOrder>
        <requiredGraceLevel>0</requiredGraceLevel>
        <traitNode>true</traitNode>
    </MiliraXian.Characters.SkillNodeDef>

    <MiliraXian.Characters.SkillNodeDef>
        <defName>MX_QH_Trait_DivineBlessing</defName>
        <label>花神之垂怜</label>
        <description>受到致命或可能摧毁身体部位的伤害时自动触发：抵消此次伤害、修复全部损伤，并短暂获得心灵隐形与无敌。基础可积累1次充能，恩典节点可提升至3次。</description>
        <category>MX_QH_Category_Qinghe</category>
        <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_ThunderMarkedStorm</iconPath>
        <displayOrder>101</displayOrder>
        <requiredGraceLevel>0</requiredGraceLevel>
        <traitNode>true</traitNode>
    </MiliraXian.Characters.SkillNodeDef>

    <MiliraXian.Characters.SkillNodeDef>
        <defName>MX_QH_Trait_Trickle</defName>
        <label>涓流</label>
        <description>清荷会持续缓慢恢复伤口，并逐步修复永久损伤与缺失的身体部位。</description>
        <category>MX_QH_Category_Qinghe</category>
        <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_ThunderMarkedStorm</iconPath>
        <displayOrder>102</displayOrder>
        <requiredGraceLevel>0</requiredGraceLevel>
        <traitNode>true</traitNode>
    </MiliraXian.Characters.SkillNodeDef>

    <MiliraXian.Characters.SkillNodeDef>
        <defName>MX_QH_Trait_FlowerDecree</defName>
        <label>花令</label>
        <description>释放飞花令技能所需的层数资源，会随时间恢复。恩典节点可将上限提升至5层。</description>
        <category>MX_QH_Category_Qinghe</category>
        <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_ThunderMarkedStorm</iconPath>
        <displayOrder>103</displayOrder>
        <requiredGraceLevel>0</requiredGraceLevel>
        <traitNode>true</traitNode>
    </MiliraXian.Characters.SkillNodeDef>

    <MiliraXian.Characters.SkillNodeDef>
        <defName>MX_QH_Trait_SwordPressure</defName>
        <label>剑压</label>
        <description>装备散华后挥剑命中敌人时积累的资源，可用于强化镜花水月与必杀剑：落樱。</description>
        <category>MX_QH_Category_Qinghe</category>
        <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_ThunderMarkedStorm</iconPath>
        <displayOrder>104</displayOrder>
        <requiredGraceLevel>0</requiredGraceLevel>
        <traitNode>true</traitNode>
    </MiliraXian.Characters.SkillNodeDef>

    <MiliraXian.Characters.SkillNodeDef>
        <defName>MX_QH_Trait_Stillness</defName>
        <label>静思</label>
        <description>冥想、读书与睡眠都会积累静思。清荷进行需要品质的工作时：静思未满则不消耗，并有概率使品质+1；静思蓄满则消耗全部并使品质+2。</description>
        <category>MX_QH_Category_Qinghe</category>
        <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_ThunderMarkedStorm</iconPath>
        <displayOrder>105</displayOrder>
        <requiredGraceLevel>0</requiredGraceLevel>
        <traitNode>true</traitNode>
    </MiliraXian.Characters.SkillNodeDef>

    <MiliraXian.Characters.SkillNodeDef>
        <defName>MX_QH_Trait_DivineGrace</defName>
        <label>花神之恩典</label>
        <description>清荷制作出大师级或传奇级物品时，恩典等级+1（上限24级）。恩典会逐步提升清荷的基础属性，并按下方时间轴自动解锁节点。</description>
        <category>MX_QH_Category_Qinghe</category>
        <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_ThunderMarkedStorm</iconPath>
        <displayOrder>106</displayOrder>
        <requiredGraceLevel>0</requiredGraceLevel>
        <traitNode>true</traitNode>
    </MiliraXian.Characters.SkillNodeDef>

    <MiliraXian.Characters.SkillNodeDef>
        <defName>MX_QH_Trait_QixiRitual</defName>
        <label>乞巧仪式</label>
        <description>每年可在荷池举行一次乞巧仪式，参与者有机会获得灵感，清荷还会得到一本《荷雨亭曲艺》。</description>
        <category>MX_QH_Category_Qinghe</category>
        <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_ThunderMarkedStorm</iconPath>
        <displayOrder>107</displayOrder>
        <requiredGraceLevel>0</requiredGraceLevel>
        <traitNode>true</traitNode>
    </MiliraXian.Characters.SkillNodeDef>
