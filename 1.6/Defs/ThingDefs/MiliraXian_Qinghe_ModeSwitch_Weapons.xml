<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 清荷三形态武器（先复用现有贴图路径，后续可替换为 MiliraXianQinghe/Items/*） -->

  <!-- 1) 琵琶形：远程 -->
  <ThingDef ParentName="BaseWeapon">
    <defName>MX_Qinghe_Form_Pipa</defName>
    <label>荷乐·琵琶</label>
    <description>清荷的琵琶，擅长中距离连发压制。</description>
    <recipeMaker Inherit="False" IsNull="True" />

    <techLevel>Archotech</techLevel>
    <smeltable>false</smeltable>

    <graphicData>
      <texPath>MiliraXianNeiyu/Items/FlowerStick</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.6,1.6)</drawSize>
    </graphicData>
    <uiIconPath>MiliraXianNeiyu/Items/FlowerStick</uiIconPath>

    <generateCommonality>0</generateCommonality>
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <tradeability>Sellable</tradeability>

    <weaponTags>
      <li>MiliraXian_QingheInstrument</li>
    </weaponTags>

    <weaponClasses>
      <li>Ranged</li>
    </weaponClasses>

    <statBases>
      <MarketValue>2600</MarketValue>
      <Mass>1.0</Mass>
      <AccuracyTouch>1.0</AccuracyTouch>
      <AccuracyShort>1.0</AccuracyShort>
      <AccuracyMedium>1.0</AccuracyMedium>
      <AccuracyLong>1.0</AccuracyLong>
    </statBases>

    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>MX_Bullet_Qinghe_PipaNote</defaultProjectile>
        <warmupTime>0.90</warmupTime>
        <range>29.9</range>
        <burstShotCount>4</burstShotCount>
        <ticksBetweenBurstShots>9</ticksBetweenBurstShots>
      </li>
    </verbs>

    <comps>
      <li Class="MiliraXian.Characters.QingHe.CompProperties_WeaponAbility">
        <abilityDef>MX_Qinghe_Elegance_HengZhi</abilityDef>
      </li>

      <li Class="MiliraXian.Characters.Neiyu.CompProperties_ModeSwitchWeapon">
        <formWeaponDefs>
          <li>MX_Qinghe_Form_Pipa</li>
          <li>MX_Qinghe_Form_Zhudi</li>
          <li>MX_Qinghe_Form_Qin</li>
        </formWeaponDefs>

        <formLabels>
          <li>琵琶</li>
          <li>竹笛</li>
          <li>琴</li>
        </formLabels>

        <formIconPaths>
          <li>MiliraXianNeiyu/Items/FlowerStick</li>
          <li>MiliraXianNeiyu/Items/BowForNeiyu</li>
          <li>MiliraXianNeiyu/Items/SwordForNeiyu</li>
        </formIconPaths>

        <commandLabel>切换形态</commandLabel>
        <commandDesc>点击切换：</commandDesc>

        <destroyOldWeapon>true</destroyOldWeapon>
        <requirePrimary>true</requirePrimary>
        <cooldownTicks>0</cooldownTicks>
      </li>
    </comps>
  </ThingDef>

  <!-- 2) 竹笛形：远程 -->
  <ThingDef ParentName="BaseWeapon">
    <defName>MX_Qinghe_Form_Zhudi</defName>
    <label>荷乐·竹笛</label>
    <description>清荷的竹笛形兵装，擅长远距离精准点射。</description>
    <recipeMaker Inherit="False" IsNull="True" />

    <techLevel>Archotech</techLevel>
    <smeltable>false</smeltable>

    <graphicData>
      <texPath>MiliraXianNeiyu/Items/BowForNeiyu</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.6,1.6)</drawSize>
    </graphicData>
    <uiIconPath>MiliraXianNeiyu/Items/BowForNeiyu</uiIconPath>

    <generateCommonality>0</generateCommonality>
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <tradeability>Sellable</tradeability>

    <weaponTags>
      <li>MiliraXian_QingheInstrument</li>
    </weaponTags>

    <weaponClasses>
      <li>Ranged</li>
    </weaponClasses>

    <statBases>
      <MarketValue>2800</MarketValue>
      <Mass>0.9</Mass>
      <AccuracyTouch>0.70</AccuracyTouch>
      <AccuracyShort>0.78</AccuracyShort>
      <AccuracyMedium>0.66</AccuracyMedium>
      <AccuracyLong>0.44</AccuracyLong>
    </statBases>

    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>MX_Bullet_Qinghe_ZhudiNote</defaultProjectile>
        <warmupTime>1.45</warmupTime>
        <range>38.9</range>
        <burstShotCount>1</burstShotCount>
      </li>
    </verbs>

    <comps>
      <li Class="MiliraXian.Characters.QingHe.CompProperties_WeaponAbility">
        <abilityDef>MX_Qinghe_Elegance_DuanHun</abilityDef>
      </li>

      <li Class="MiliraXian.Characters.Neiyu.CompProperties_ModeSwitchWeapon">
        <formWeaponDefs>
          <li>MX_Qinghe_Form_Pipa</li>
          <li>MX_Qinghe_Form_Zhudi</li>
          <li>MX_Qinghe_Form_Qin</li>
        </formWeaponDefs>

        <formLabels>
          <li>琵琶</li>
          <li>竹笛</li>
          <li>琴</li>
        </formLabels>

        <formIconPaths>
          <li>MiliraXianNeiyu/Items/FlowerStick</li>
          <li>MiliraXianNeiyu/Items/BowForNeiyu</li>
          <li>MiliraXianNeiyu/Items/SwordForNeiyu</li>
        </formIconPaths>

        <commandLabel>切换形态</commandLabel>
        <commandDesc>点击切换：琵琶 → 竹笛 → 琴。</commandDesc>

        <destroyOldWeapon>true</destroyOldWeapon>
        <requirePrimary>true</requirePrimary>
        <cooldownTicks>0</cooldownTicks>
      </li>
    </comps>
  </ThingDef>

  <!-- 3) 琴形：近战 -->
  <ThingDef ParentName="BaseMeleeWeapon">
    <defName>MX_Qinghe_Form_Qin</defName>
    <label>清荷·琴形</label>
    <description>清荷的琴形兵装，擅长近身斩击。</description>
    <recipeMaker Inherit="False" IsNull="True" />

    <techLevel>Archotech</techLevel>
    <smeltable>false</smeltable>

    <graphicData>
      <texPath>MiliraXianNeiyu/Items/SwordForNeiyu</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.8,1.8)</drawSize>
    </graphicData>
    <uiIconPath>MiliraXianNeiyu/Items/SwordForNeiyu</uiIconPath>

    <generateCommonality>0</generateCommonality>
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <tradeability>Sellable</tradeability>

    <weaponTags>
      <li>MiliraXian_QingheInstrument</li>
    </weaponTags>

    <weaponClasses>
      <li>Melee</li>
    </weaponClasses>

    <statBases>
      <MarketValue>3000</MarketValue>
      <Mass>1.2</Mass>
      <MeleeWeapon_CooldownMultiplier>1.15</MeleeWeapon_CooldownMultiplier>
      <AccuracyTouch>0.85</AccuracyTouch>
      <AccuracyShort>0.68</AccuracyShort>
      <AccuracyMedium>0.40</AccuracyMedium>
      <AccuracyLong>0.20</AccuracyLong>
    </statBases>

    <tools>
      <li>
        <label>弦刃</label>
        <capacities>
          <li>Cut</li>
          <li>Blunt</li>
        </capacities>
        <power>36</power>
        <armorPenetration>0.25</armorPenetration>
        <cooldownTime>2.0</cooldownTime>
      </li>
    </tools>

    <comps>
      <li Class="MiliraXian.Characters.QingHe.CompProperties_WeaponAbility">
        <abilityDef>MX_Qinghe_Elegance_YangChun</abilityDef>
      </li>

      <li Class="MiliraXian.Characters.Neiyu.CompProperties_ModeSwitchWeapon">
        <formWeaponDefs>
          <li>MX_Qinghe_Form_Pipa</li>
          <li>MX_Qinghe_Form_Zhudi</li>
          <li>MX_Qinghe_Form_Qin</li>
        </formWeaponDefs>

        <formLabels>
          <li>琵琶</li>
          <li>竹笛</li>
          <li>琴</li>
        </formLabels>

        <formIconPaths>
          <li>MiliraXianNeiyu/Items/FlowerStick</li>
          <li>MiliraXianNeiyu/Items/BowForNeiyu</li>
          <li>MiliraXianNeiyu/Items/SwordForNeiyu</li>
        </formIconPaths>

        <commandLabel>切换形态</commandLabel>
        <commandDesc>点击切换：琵琶 → 竹笛 → 琴。</commandDesc>

        <destroyOldWeapon>true</destroyOldWeapon>
        <requirePrimary>true</requirePrimary>
        <cooldownTicks>0</cooldownTicks>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>MX_Bullet_Qinghe_PipaNote</defName>
    <label>清荷·琵琶音符</label>
    <thingClass>MiliraXian.Characters.QingHe.Projectile_Pipa</thingClass>
    <graphicData>
      <texPath>MiliraXianNeiyu/Projectile/Shard</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.36,1.05)</drawSize>
      <shaderType>TransparentPostLight</shaderType>
      <color>(230,195,255)</color>
    </graphicData>
    <projectile>
      <damageDef>MX_Desynced</damageDef>
      <damageAmountBase>6</damageAmountBase>
      <armorPenetrationBase>2.10</armorPenetrationBase>
      <speed>30</speed>
      <arcHeightFactor>0.10</arcHeightFactor>
    </projectile>
    <comps>
      <li Class="MiliraXian.Characters.CompProperties_ProjectileContinuousTrail">
        <trailTexPath>UI/Overlays/ThingLine</trailTexPath>
        <trailMaxPoints>22</trailMaxPoints>
        <trailMinPointDistance>0.10</trailMinPointDistance>
        <trailSmoothSubdivisions>4</trailSmoothSubdivisions>
        <trailWidthStart>0.18</trailWidthStart>
        <trailWidthEnd>0.05</trailWidthEnd>
        <trailAlpha>1.00</trailAlpha>
        <trailAltitudeOffset>0.70</trailAltitudeOffset>
        <useProjectileGraphicColor>true</useProjectileGraphicColor>
      </li>
      <li Class="MiliraXian.Characters.CompProperties_ProjectileHomingCurve">
        <homingStartDelayTicks>5</homingStartDelayTicks>
        <minHomingTicksToImpact>10</minHomingTicksToImpact>
        <homingTurnLerp>0.13</homingTurnLerp>
        <curveAmplitudeMin>0.60</curveAmplitudeMin>
        <curveAmplitudeMax>0.80</curveAmplitudeMax>
        <curveFrequency>0.12</curveFrequency>
      </li>
      <li Class="CompProperties_ProjectileEffecter">
        <effecterDef>MX_QH_ProjectileScatterTrail</effecterDef>
      </li>
      <li Class="MiliraXian.Characters.CompProperties_ProjectileResourceOnHit">
        <entries>
          <li>
            <resourceDef>MX_QH_Elegance</resourceDef>
            <amount>1.4</amount>
            <requireHostileTarget>true</requireHostileTarget>
          </li>
        </entries>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>MX_Bullet_Qinghe_ZhudiNote</defName>
    <label>清荷·竹笛音束</label>
    <thingClass>MiliraXian.Characters.QingHe.Projectile_Zhudi</thingClass>
    <graphicData>
      <texPath>MiliraXianNeiyu/Projectile/BigArrow</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.32,1.42)</drawSize>
      <shaderType>TransparentPostLight</shaderType>
      <color>(170,240,255)</color>
    </graphicData>
    <projectile>
      <damageDef>MX_Desynced</damageDef>
      <damageAmountBase>24</damageAmountBase>
      <armorPenetrationBase>0.40</armorPenetrationBase>
      <speed>60</speed>
      <arcHeightFactor>0.04</arcHeightFactor>
    </projectile>
    <comps>
      <li Class="MiliraXian.Characters.CompProperties_ProjectileContinuousTrail">
        <trailTexPath>UI/Overlays/ThingLine</trailTexPath>
        <trailMaxPoints>20</trailMaxPoints>
        <trailMinPointDistance>0.12</trailMinPointDistance>
        <trailSmoothSubdivisions>4</trailSmoothSubdivisions>
        <trailWidthStart>0.16</trailWidthStart>
        <trailWidthEnd>0.04</trailWidthEnd>
        <trailAlpha>0.54</trailAlpha>
        <trailAltitudeOffset>0.80</trailAltitudeOffset>
        <useProjectileGraphicColor>true</useProjectileGraphicColor>
      </li>
      <li Class="MiliraXian.Characters.CompProperties_ProjectileHomingCurve">
        <homingStartDelayTicks>4</homingStartDelayTicks>
        <minHomingTicksToImpact>9</minHomingTicksToImpact>
        <homingTurnLerp>0.17</homingTurnLerp>
        <curveAmplitudeMin>0.22</curveAmplitudeMin>
        <curveAmplitudeMax>0.60</curveAmplitudeMax>
        <curveFrequency>0.24</curveFrequency>
      </li>
      <li Class="CompProperties_ProjectileEffecter">
        <effecterDef>MX_QH_ProjectileScatterTrail</effecterDef>
      </li>
      <li Class="MiliraXian.Characters.CompProperties_ProjectileResourceOnHit">
        <entries>
          <li>
            <resourceDef>MX_QH_Elegance</resourceDef>
            <amount>1.0</amount>
            <requireHostileTarget>true</requireHostileTarget>
          </li>
        </entries>
      </li>
    </comps>
  </ThingDef>

</Defs>
