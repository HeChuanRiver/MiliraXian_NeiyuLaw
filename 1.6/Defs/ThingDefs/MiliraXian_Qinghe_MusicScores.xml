<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <RulePackDef>
        <defName>Namer_MX_QH_SkillBook</defName>
        <rulePack>
            <rulesStrings>
                <li>title->失传的曲谱</li>
                <li>title->古旧曲谱</li>
                <li>title->残篇曲谱</li>
            </rulesStrings>
        </rulePack>
    </RulePackDef>

    <RulePackDef>
        <defName>Description_MX_QH_SkillBook</defName>
        <rulePack>
            <rulesStrings>
                <li>desc->[mx_skillbook_paragraphs]&#10;&#10;[mx_skillbook_quality_summary]</li>
            </rulesStrings>
        </rulePack>
    </RulePackDef>

    <RulePackDef>
        <defName>Namer_MX_QH_CustomBook</defName>
        <rulePack>
            <rulesStrings>
                <li>title->旧书卷</li>
                <li>title->批注书卷</li>
                <li>title->誊抄手稿</li>
            </rulesStrings>
        </rulePack>
    </RulePackDef>

    <RulePackDef>
        <defName>Description_MX_QH_CustomBook</defName>
        <rulePack>
            <rulesStrings>
                <li>desc->一本仍可阅读的书卷，后来的持有者在页边补了些批注。</li>
                <li>desc->一本翻阅痕迹明显的旧书，扉页曾被小心修补。</li>
                <li>desc->一本保存整齐的誊抄手稿，纸页被细心整理过。</li>
            </rulesStrings>
        </rulePack>
    </RulePackDef>

    <ThingDef>
        <defName>MX_QH_LostMusicScoreFragment</defName>
        <label>失传的曲谱残片</label>
        <description>残缺而难辨的清荷曲谱碎片。可在艺创台拼合成一本随机的清荷技能书。</description>
        <thingClass>ThingWithComps</thingClass>
        <category>Item</category>
        <tradeability>All</tradeability>
        <selectable>true</selectable>
        <rotatable>false</rotatable>
        <drawerType>MapMeshOnly</drawerType>
        <altitudeLayer>Item</altitudeLayer>
        <alwaysHaulable>true</alwaysHaulable>
        <useHitPoints>true</useHitPoints>
        <healthAffectsPrice>true</healthAffectsPrice>
        <drawGUIOverlay>true</drawGUIOverlay>
        <stackLimit>75</stackLimit>
        <graphicData>
            <texPath>Things/Item/Book/Textbook/Textbook</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>0.45</drawSize>
        </graphicData>
        <uiIconPath>Things/Item/Book/Textbook/Textbook</uiIconPath>
        <thingCategories>
            <li>Books</li>
        </thingCategories>
        <tradeTags>
            <li>ExoticMisc</li>
        </tradeTags>
        <thingSetMakerTags>
            <li>RewardStandardMidFreq</li>
        </thingSetMakerTags>
        <statBases>
            <MaxHitPoints>40</MaxHitPoints>
            <DeteriorationRate>3</DeteriorationRate>
            <Mass>0.05</Mass>
            <Flammability>1</Flammability>
            <MarketValue>80</MarketValue>
        </statBases>
    </ThingDef>

    <ThingDef>
        <defName>MX_QH_SkillBook</defName>
        <label>清荷技能书</label>
        <description>记录旧曲谱的书。拥有清荷技能类别的小人阅读时可推进对应清荷技能节点；其他读者也可以像普通书一样阅读。</description>
        <thingClass>MiliraXian.Characters.Thing_MX_SkillBook</thingClass>
        <category>Item</category>
        <selectable>true</selectable>
        <rotatable>false</rotatable>
        <drawerType>MapMeshOnly</drawerType>
        <altitudeLayer>Item</altitudeLayer>
        <alwaysHaulable>true</alwaysHaulable>
        <burnableByRecipe>false</burnableByRecipe>
        <useHitPoints>true</useHitPoints>
        <healthAffectsPrice>true</healthAffectsPrice>
        <drawGUIOverlay>true</drawGUIOverlay>
        <tradeNeverStack>true</tradeNeverStack>
        <tradeNeverGenerateStacked>true</tradeNeverGenerateStacked>
        <neverMultiSelect>true</neverMultiSelect>
        <stackLimit>1</stackLimit>
        <graphicData>
            <texPath>Things/Item/Book/Textbook/Textbook</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>0.8</drawSize>
        </graphicData>
        <uiIconPath>Things/Item/Book/Textbook/Textbook</uiIconPath>
        <thingCategories>
            <li>Books</li>
        </thingCategories>
        <comps>
            <li Class="CompProperties_Forbiddable" />
            <li>
                <compClass>CompQuality</compClass>
            </li>
            <li Class="CompProperties_Book">
                <nameMaker>Namer_MX_QH_SkillBook</nameMaker>
                <descriptionMaker>Description_MX_QH_SkillBook</descriptionMaker>
                <ageYearsRange>100~200</ageYearsRange>
                <openGraphic>
                    <texPath>Things/Item/Book/Textbook/Textbook_Open</texPath>
                    <graphicClass>Graphic_Multi</graphicClass>
                    <drawSize>0.7</drawSize>
                </openGraphic>
                <verticalGraphic>
                    <texPath>Things/Item/Book/Textbook/Textbook_Vertical</texPath>
                    <graphicClass>Graphic_Multi</graphicClass>
                    <addTopAltitudeBias>true</addTopAltitudeBias>
                </verticalGraphic>
                <doers>
                    <li Class="MiliraXian.Characters.BookOutcomeProperties_SkillTreeUnlock">
                        <skillCategory>MX_QH_Category_Qinghe</skillCategory>
                        <learningSpeed>1</learningSpeed>
                        <extraNodeChance>0.15</extraNodeChance>
                        <combinedBookName>MX_QH_Book_LostScore_Label</combinedBookName>
                    </li>
                    <li Class="MiliraXian.Characters.BookOutcomeProperties_SkillTreeUnlock">
                        <skillCategory>MX_QH_Category_Qinghe</skillCategory>
                        <learningSpeed>1</learningSpeed>
                    </li>
                    <li Class="BookOutcomeProperties_GainSkillExp" />
                    <li Class="BookOutcomeProperties_GiveQuest">
                        <questChance>0.01</questChance>
                    </li>
                </doers>
            </li>
        </comps>
        <statBases>
            <MaxHitPoints>60</MaxHitPoints>
            <DeteriorationRate>5</DeteriorationRate>
            <Mass>0.50</Mass>
            <Flammability>1</Flammability>
            <Beauty>1</Beauty>
            <MarketValue>600</MarketValue>
        </statBases>
        <inspectorTabs>
            <li>ITab_Book</li>
        </inspectorTabs>
    </ThingDef>

    <ThingDef>
        <defName>MX_QH_Book</defName>
        <label>清荷书卷</label>
        <description>清荷相关书卷。</description>
        <thingClass>MiliraXian.Characters.Thing_MX_CustomBook</thingClass>
        <category>Item</category>
        <selectable>true</selectable>
        <rotatable>true</rotatable>
        <altitudeLayer>Item</altitudeLayer>
        <tickerType>Rare</tickerType>
        <alwaysHaulable>true</alwaysHaulable>
        <burnableByRecipe>true</burnableByRecipe>
        <useHitPoints>true</useHitPoints>
        <healthAffectsPrice>true</healthAffectsPrice>
        <drawGUIOverlay>true</drawGUIOverlay>
        <tradeNeverStack>true</tradeNeverStack>
        <neverMultiSelect>true</neverMultiSelect>
        <stackLimit>1</stackLimit>
        <tradeNeverGenerateStacked>true</tradeNeverGenerateStacked>
        <comps>
            <li Class="CompProperties_Forbiddable" />
            <li>
                <compClass>CompQuality</compClass>
            </li>
            <li Class="CompProperties_Book">
                <nameMaker>Namer_MX_QH_CustomBook</nameMaker>
                <descriptionMaker>Description_MX_QH_CustomBook</descriptionMaker>
                <ageYearsRange>100~200</ageYearsRange>
                <openGraphic>
                    <texPath>Things/Item/Book/Textbook/Textbook_Open</texPath>
                    <graphicClass>Graphic_Multi</graphicClass>
                    <drawSize>0.7</drawSize>
                </openGraphic>
                <verticalGraphic>
                    <texPath>Things/Item/Book/Textbook/Textbook_Vertical</texPath>
                    <graphicClass>Graphic_Multi</graphicClass>
                    <addTopAltitudeBias>true</addTopAltitudeBias>
                </verticalGraphic>
                <doers>
                    <li Class="BookOutcomeProperties_GainSkillExp" />
                    <li Class="BookOutcomeProperties_GiveQuest">
                        <questChance>0.01</questChance>
                    </li>
                </doers>
            </li>
        </comps>
        <thingCategories>
            <li>Books</li>
        </thingCategories>
        <inspectorTabs>
            <li>ITab_Book</li>
        </inspectorTabs>
        <statBases>
            <MaxHitPoints>60</MaxHitPoints>
            <DeteriorationRate>5</DeteriorationRate>
            <Mass>0.50</Mass>
            <Flammability>1</Flammability>
            <Beauty>1</Beauty>
            <MarketValue>160</MarketValue>
        </statBases>
        <thingSetMakerTags>
            <li>RewardStandardMidFreq</li>
        </thingSetMakerTags>
        <possessionCount>1</possessionCount>
        <graphicData>
            <texPath>Things/Item/Book/Textbook/Textbook</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>0.8</drawSize>
        </graphicData>
        <uiIconPath>Things/Item/Book/Textbook/Textbook</uiIconPath>
    </ThingDef>

    <RecipeDef>
        <defName>MX_QH_AssembleLostMusicScore</defName>
        <label>拼合清荷曲谱</label>
        <description>将失传的曲谱残片拼合成书卷。成功时得到随机清荷技能书，失败时只得到普通书。</description>
        <workerClass>MiliraXian.Characters.QingHe.Things.RecipeWorker_MX_InterpretLostScorebook</workerClass>
        <jobString>正在拼合清荷曲谱。</jobString>
        <workAmount>300</workAmount>
        <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
        <workSkill>Artistic</workSkill>
        <effectWorking>Sculpt</effectWorking>
        <soundWorking>Recipe_Sculpt</soundWorking>
        <recipeUsers>
            <li>TableSculpting</li>
        </recipeUsers>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>MX_QH_LostMusicScoreFragment</li>
                    </thingDefs>
                </filter>
                <count>3</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <thingDefs>
                <li>MX_QH_LostMusicScoreFragment</li>
            </thingDefs>
        </fixedIngredientFilter>
        <modExtensions>
            <li Class="MiliraXian.Characters.QingHe.Things.MX_InterpretLostScorebookExtension">
                <skillBookChance>0.9</skillBookChance>
                <plainBookDef>TextBook</plainBookDef>
            </li>
        </modExtensions>
        <displayPriority>1200</displayPriority>
    </RecipeDef>
</Defs>
