<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef ParentName="BaseMeleeWeapon">
        <defName>MX_Mingyuan_CinderSword</defName>
        <label>Cinder Ash</label>
        <description>Mingyuan's pale cinder blade. It strikes for 44 cut damage with 150% armor penetration, attacks twice in roughly 3 seconds through a 0.5 melee cooldown multiplier, and Mingyuan's flame adds Life Burn on each hit.</description>
        <recipeMaker Inherit="False" IsNull="True" />

        <graphicData>
            <texPath>MiliraXianMingyuan/Items/CinderSword</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,2)</drawSize>
        </graphicData>
        <uiIconPath>MiliraXianMingyuan/Items/CinderSword</uiIconPath>
        <generateCommonality>0</generateCommonality>
        <scatterableOnMapGen>false</scatterableOnMapGen>
        <tradeability>Sellable</tradeability>

        <techLevel>Archotech</techLevel>
        <smeltable>false</smeltable>

        <weaponTags>
            <li>MX_Mingyuan_CinderSword</li>
        </weaponTags>

        <thingCategories>
        </thingCategories>
        <weaponClasses>
            <li>Melee</li>
        </weaponClasses>

        <costList>
            <Steel>300</Steel>
            <Jade>80</Jade>
            <Plasteel>160</Plasteel>
        </costList>

        <statBases>
            <Mass>1.5</Mass>
            <MarketValue>12000</MarketValue>
            <MaxHitPoints>40000</MaxHitPoints>
            <MeleeWeapon_CooldownMultiplier>0.50</MeleeWeapon_CooldownMultiplier>
            <AccuracyTouch>1.00</AccuracyTouch>
            <AccuracyShort>1.00</AccuracyShort>
            <AccuracyMedium>1.00</AccuracyMedium>
            <AccuracyLong>1.00</AccuracyLong>
        </statBases>
        <equippedStatOffsets>
            <MeleeDodgeChance>0.20</MeleeDodgeChance>
            <MeleeWeapon_DamageMultiplier>1.00</MeleeWeapon_DamageMultiplier>
        </equippedStatOffsets>

        <tools>
            <li>
                <label>Cinder Ash</label>
                <capacities>
                    <li>Cut</li>
                    <li>Stab</li>
                </capacities>
                <power>44</power>
                <armorPenetration>1.50</armorPenetration>
                <cooldownTime>3.0</cooldownTime>
            </li>
        </tools>

        <comps>
            <li Class="MiliraXian.Characters.CompProperties_UnbreakableEquipment" />
        </comps>
    </ThingDef>

    <ThingDef ParentName="BaseWeapon">
        <defName>MX_Mingyuan_RainbowBow</defName>
        <label>Long Rainbow</label>
        <description>Mingyuan's longbow of pale gold and red fire. It aims for 4 seconds, fires 4 high-arc arrows at any map-range target, and each arrow deals 25 damage with a 2-cell burst. Mingyuan's flame adds Life Burn on hit.</description>
        <recipeMaker Inherit="False" IsNull="True" />

        <techLevel>Archotech</techLevel>
        <smeltable>false</smeltable>

        <graphicData>
            <texPath>MiliraXianMingyuan/Items/RainbowBow</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,2)</drawSize>
        </graphicData>
        <uiIconPath>MiliraXianMingyuan/Items/RainbowBow</uiIconPath>
        <generateCommonality>0</generateCommonality>
        <scatterableOnMapGen>false</scatterableOnMapGen>
        <tradeability>Sellable</tradeability>

        <weaponTags>
            <li>MX_Mingyuan_RainbowBow</li>
        </weaponTags>

        <thingCategories>
        </thingCategories>
        <weaponClasses>
            <li>Ranged</li>
        </weaponClasses>

        <costList>
            <Steel>260</Steel>
            <Jade>80</Jade>
            <Plasteel>160</Plasteel>
        </costList>

        <statBases>
            <Mass>1.3</Mass>
            <MarketValue>12000</MarketValue>
            <MaxHitPoints>40000</MaxHitPoints>
            <AccuracyTouch>1.00</AccuracyTouch>
            <AccuracyShort>1.00</AccuracyShort>
            <AccuracyMedium>1.00</AccuracyMedium>
            <AccuracyLong>1.00</AccuracyLong>
            <RangedWeapon_Cooldown>2.00</RangedWeapon_Cooldown>
        </statBases>

        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>MX_Bullet_Mingyuan_RainbowArrow</defaultProjectile>
                <warmupTime>4.0</warmupTime>
                <range>999</range>
                <burstShotCount>4</burstShotCount>
                <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
                <soundCast>Bow_Small</soundCast>
            </li>
        </verbs>

        <comps>
            <li Class="MiliraXian.Characters.CompProperties_UnbreakableEquipment" />
        </comps>
    </ThingDef>

    <ThingDef ParentName="BaseBullet">
        <defName>MX_Bullet_Mingyuan_RainbowArrow</defName>
        <label>Long Rainbow Arrow</label>
        <graphicData>
            <texPath>MiliraXianMingyuan/Projectile/RainbowArrow</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(0.45,1.8)</drawSize>
            <shaderType>TransparentPostLight</shaderType>
            <color>(255,215,130)</color>
        </graphicData>
        <projectile>
            <damageDef>Arrow</damageDef>
            <damageAmountBase>25</damageAmountBase>
            <armorPenetrationBase>1.00</armorPenetrationBase>
            <explosionRadius>2</explosionRadius>
            <speed>45</speed>
            <arcHeightFactor>0.90</arcHeightFactor>
        </projectile>
    </ThingDef>

</Defs>
