<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef ParentName="BaseMeleeWeapon">
        <defName>MX_Mingyuan_CinderSword</defName>
        <label>Cinder Ash</label>
        <description>Mingyuan's pale cinder blade. It strikes for 44 cut damage with 150% armor penetration, attacks twice in roughly 3 seconds through a 0.5 melee cooldown multiplier, and Mingyuan's flame adds Life Burn on each hit.</description>
        <recipeMaker Inherit="False" IsNull="True" />

        <graphicData>
            <texPath>MiliraXianMingyuan/Items/CinderSword</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,2)</drawSize>
        </graphicData>
        <uiIconPath>MiliraXianMingyuan/Items/CinderSword</uiIconPath>
        <generateCommonality>0</generateCommonality>
        <scatterableOnMapGen>false</scatterableOnMapGen>
        <tradeability>Sellable</tradeability>

        <techLevel>Archotech</techLevel>
        <smeltable>false</smeltable>

        <weaponTags>
            <li>MX_Mingyuan_CinderSword</li>
        </weaponTags>

        <thingCategories>
        </thingCategories>
        <weaponClasses>
            <li>Melee</li>
        </weaponClasses>

        <costList>
            <Steel>300</Steel>
            <Jade>80</Jade>
            <Plasteel>160</Plasteel>
        </costList>

        <statBases>
            <Mass>1.5</Mass>
            <MarketValue>12000</MarketValue>
            <MaxHitPoints>40000</MaxHitPoints>
            <MeleeWeapon_CooldownMultiplier>0.50</MeleeWeapon_CooldownMultiplier>
            <AccuracyTouch>1.00</AccuracyTouch>
            <AccuracyShort>1.00</AccuracyShort>
            <AccuracyMedium>1.00</AccuracyMedium>
            <AccuracyLong>1.00</AccuracyLong>
        </statBases>
        <equippedStatOffsets>
            <MeleeDodgeChance>0.20</MeleeDodgeChance>
            <MeleeWeapon_DamageMultiplier>1.00</MeleeWeapon_DamageMultiplier>
        </equippedStatOffsets>

        <tools>
            <li>
                <label>Cinder Ash</label>
                <capacities>
                    <li>Cut</li>
                    <li>Stab</li>
                </capacities>
                <power>44</power>
                <armorPenetration>1.50</armorPenetration>
                <cooldownTime>3.0</cooldownTime>
            </li>
        </tools>

        <comps>
            <li Class="MiliraXian.Characters.CompProperties_UnbreakableEquipment" />
        </comps>
    </ThingDef>

    <ThingDef ParentName="BaseWeapon">
        <defName>MX_Mingyuan_RainbowBow</defName>
        <label>Long Rainbow</label>
        <description>Mingyuan's pale-gold and scarlet longbow. Focus form charges for 5 seconds, then instantly bursts one visible enemy's Life Burn without ordinary weapon damage. Radiation form sweeps a 10-cell, 108-degree sector once per second, dealing 1 burn damage and adding 23% of each target's own Life Burn threshold.</description>
        <recipeMaker Inherit="False" IsNull="True" />

        <techLevel>Archotech</techLevel>
        <smeltable>false</smeltable>

        <graphicData>
            <texPath>MiliraXianMingyuan/Items/RainbowBow</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,2)</drawSize>
        </graphicData>
        <uiIconPath>MiliraXianMingyuan/Items/RainbowBow</uiIconPath>
        <generateCommonality>0</generateCommonality>
        <scatterableOnMapGen>false</scatterableOnMapGen>
        <tradeability>Sellable</tradeability>

        <weaponTags>
            <li>MX_Mingyuan_RainbowBow</li>
        </weaponTags>

        <thingCategories>
        </thingCategories>
        <weaponClasses>
            <li>Ranged</li>
        </weaponClasses>

        <costList>
            <Steel>260</Steel>
            <Jade>80</Jade>
            <Plasteel>160</Plasteel>
        </costList>

        <statBases>
            <Mass>1.3</Mass>
            <MarketValue>12000</MarketValue>
            <MaxHitPoints>40000</MaxHitPoints>
            <AccuracyTouch>1.00</AccuracyTouch>
            <AccuracyShort>1.00</AccuracyShort>
            <AccuracyMedium>1.00</AccuracyMedium>
            <AccuracyLong>1.00</AccuracyLong>
            <RangedWeapon_Cooldown>1.00</RangedWeapon_Cooldown>
        </statBases>

        <verbs>
            <li>
                <verbClass>MiliraXian.Characters.Mingyuan.Verb_MingyuanRainbowBow</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <isPrimary>true</isPrimary>
                <violent>true</violent>
                <ai_IsWeapon>true</ai_IsWeapon>
                <targetable>true</targetable>
                <warmupTime>5.0</warmupTime>
                <range>999</range>
                <burstShotCount>1</burstShotCount>
                <ticksBetweenBurstShots>1</ticksBetweenBurstShots>
                <requireLineOfSight>false</requireLineOfSight>
                <targetParams>
                    <canTargetLocations>true</canTargetLocations>
                    <canTargetPawns>true</canTargetPawns>
                    <canTargetBuildings>false</canTargetBuildings>
                    <canTargetItems>false</canTargetItems>
                </targetParams>
            </li>
        </verbs>

        <comps Inherit="False">
            <li Class="CompProperties_Forbiddable" />
            <li Class="MiliraXian.Characters.Mingyuan.CompProperties_MingyuanRainbowBow">
                <modeIconPath>MiliraXianMingyuan/Items/RainbowBow</modeIconPath>

                <focusWarmupSeconds>5</focusWarmupSeconds>
                <focusRange>999</focusRange>
                <focusChargeSound>Psycast_Skip_Entry</focusChargeSound>
                <focusFireSound>ChargeLance_Fire</focusFireSound>
                <focusBeamFleck>MX_Mingyuan_Fleck_LifeBurnTransferLine</focusBeamFleck>
                <focusMuzzleFlashMote>MX_Mingyuan_Mote_InstantCombustionFlash</focusMuzzleFlashMote>
                <focusMuzzleFlashScale>0.24</focusMuzzleFlashScale>
                <focusTargetMote>MX_Mingyuan_Mote_BowFocusTarget</focusTargetMote>
                <focusTargetMoteScale>0.92</focusTargetMoteScale>

                <radiationWarmupSeconds>0.35</radiationWarmupSeconds>
                <radiationRange>10</radiationRange>
                <radiationArcDegrees>108</radiationArcDegrees>
                <radiationMinIntervalTicks>60</radiationMinIntervalTicks>
                <radiationDamage>1</radiationDamage>
                <radiationLayerFraction>0.23</radiationLayerFraction>
                <radiationWarmupSound>FireSpew_Warmup</radiationWarmupSound>
                <radiationFireSound>FireSpew_Resolve</radiationFireSound>
                <radiationHitMote>MX_Mingyuan_Mote_InstantCombustionMark</radiationHitMote>
                <radiationHitMoteScale>0.42</radiationHitMoteScale>
                <radiationHitVisualLimit>8</radiationHitVisualLimit>
                <radiationBlastTicks>30</radiationBlastTicks>

                <visualControllerDef>MX_Mingyuan_BowVisual</visualControllerDef>
            </li>
            <li Class="CompProperties_Styleable" />
            <li Class="MiliraXian.Characters.CompProperties_UnbreakableEquipment" />
        </comps>
    </ThingDef>

    <ThingDef ParentName="BaseBullet">
        <defName>MX_Bullet_Mingyuan_RainbowArrow</defName>
        <label>Long Rainbow Arrow</label>
        <thingClass>MiliraXian.Characters.Mingyuan.Projectile_MingyuanRainbowArrow</thingClass>
        <graphicData>
            <texPath>MiliraXianMingyuan/Projectile/RainbowArrow</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(0.45,1.8)</drawSize>
            <shaderType>TransparentPostLight</shaderType>
            <color>(255,215,130)</color>
        </graphicData>
        <projectile>
            <damageDef>Arrow</damageDef>
            <damageAmountBase>10</damageAmountBase>
            <armorPenetrationBase>0.65</armorPenetrationBase>
            <speed>45</speed>
            <arcHeightFactor>0</arcHeightFactor>
        </projectile>
        <comps>
            <li Class="MiliraXian.Characters.CompProperties_ProjectileContinuousTrail">
                <trailTexPath>UI/Overlays/ThingLine</trailTexPath>
                <trailMaxPoints>10</trailMaxPoints>
                <trailMinPointDistance>0.18</trailMinPointDistance>
                <trailSmoothSubdivisions>1</trailSmoothSubdivisions>
                <trailWidthStart>0.03</trailWidthStart>
                <trailWidthEnd>0.14</trailWidthEnd>
                <trailAlpha>0.70</trailAlpha>
                <trailAltitudeOffset>0.80</trailAltitudeOffset>
                <useProjectileGraphicColor>true</useProjectileGraphicColor>
                <useGlowShader>true</useGlowShader>
            </li>
            <li Class="MiliraXian.Characters.CompProperties_ProjectileHomingCurve">
                <homingStartDelayTicks>2</homingStartDelayTicks>
                <minHomingTicksToImpact>8</minHomingTicksToImpact>
                <homingLifetimeFactor>1.15</homingLifetimeFactor>
                <useIntendedTargetDistanceForHomingLifetime>true</useIntendedTargetDistanceForHomingLifetime>
                <forceUsedTargetToIntended>true</forceUsedTargetToIntended>
                <extraHomingTicks>2</extraHomingTicks>
                <intendedHitMaxDistance>0.55</intendedHitMaxDistance>
                <enableIntendedTargetSegmentHitCheck>true</enableIntendedTargetSegmentHitCheck>
                <segmentHitRadiusMargin>0.10</segmentHitRadiusMargin>
                <enableIntendedTargetOvershootFuse>true</enableIntendedTargetOvershootFuse>
                <overshootFuseExtraRadius>0.24</overshootFuseExtraRadius>
                <homingTurnLerp>0.12</homingTurnLerp>
                <terminalSnapDistance>3.0</terminalSnapDistance>
                <terminalSnapTurnLerp>0.90</terminalSnapTurnLerp>
                <curveAmplitudeMin>0.08</curveAmplitudeMin>
                <curveAmplitudeMax>0.22</curveAmplitudeMax>
                <curveFrequency>0.16</curveFrequency>
                <curveGuideDistanceFactor>0.35</curveGuideDistanceFactor>
                <curveGuideDistanceMin>3.0</curveGuideDistanceMin>
                <curveGuideDistanceMax>7.0</curveGuideDistanceMax>
                <terminalLockDistance>1.05</terminalLockDistance>
                <curveWobbleFadeDistance>4.2</curveWobbleFadeDistance>
                <enableTurnStopWhenLikelyHit>true</enableTurnStopWhenLikelyHit>
                <turnStopMinTargetRadius>0.42</turnStopMinTargetRadius>
                <turnStopMargin>0.10</turnStopMargin>
                <turnStopPredictTicks>3</turnStopPredictTicks>
                <enableRetargetOnTargetLost>true</enableRetargetOnTargetLost>
                <retargetMaxCount>2</retargetMaxCount>
                <retargetRetryIntervalTicks>8</retargetRetryIntervalTicks>
                <retargetSearchRadius>12</retargetSearchRadius>
                <retargetPawnWeight>4.0</retargetPawnWeight>
                <retargetNonPawnWeight>0.5</retargetNonPawnWeight>
            </li>
        </comps>
        <modExtensions>
            <li Class="MiliraXian.Characters.Mingyuan.MingyuanRainbowArrowExtension">
                <bounceCount>6</bounceCount>
                <bounceRadius>5</bounceRadius>
                <maxHitsPerPawn>3</maxHitsPerPawn>
                <lifeBurnLayers>300</lifeBurnLayers>
                <scaleLifeBurnWithOverburn>true</scaleLifeBurnWithOverburn>
                <requireBounceLineOfSight>true</requireBounceLineOfSight>
                <skipDownedBounceTargets>true</skipDownedBounceTargets>
                <bounceForwardWeight>10</bounceForwardWeight>
                <bounceDistanceWeight>0.45</bounceDistanceWeight>
                <bounceRepeatPenalty>18</bounceRepeatPenalty>
                <visualArcHeight>0.90</visualArcHeight>
                <glowScale>1.28</glowScale>
                <glowColor>(1.00,0.62,0.24,0.58)</glowColor>
            </li>
        </modExtensions>
    </ThingDef>

</Defs>
