<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef>
        <defName>SpringFlowField</defName>
        <label>涌泉力场</label>
        <thingClass>ThingWithComps</thingClass>
        <tickerType>Normal</tickerType>
        <drawerType>RealtimeOnly</drawerType>
        <altitudeLayer>MoteLow</altitudeLayer>
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>MoteGlowDistorted</shaderType>
            <shaderParameters>
                <_DistortionTex>/Other/Ripples</_DistortionTex>
                <_ScrollSpeed>-0.35</_ScrollSpeed>
            </shaderParameters>
            <color>(1,0.6,0.8,0.4)</color>
            <texPath>Things/Mote/PsycastCast</texPath>
            <drawSize>12.0</drawSize>
        </graphicData>
        <drawOffscreen>true</drawOffscreen>
        <useHitPoints>false</useHitPoints>
        <comps>
            <li Class="MiliraXian.Characters.QingHe.Things.CompProperties_SpringFlowField">
                <radius>6.0</radius>
                <pulseIntervalTicks>10</pulseIntervalTicks>
                <fadeInTicks>30</fadeInTicks>
                <fadeOutTicks>45</fadeOutTicks>
                <ambientVisualIntervalTicks>45</ambientVisualIntervalTicks>
                <ambientVisualFlecksPerBurst>2</ambientVisualFlecksPerBurst>
                <enhancedBleedDamageDef>MX_StatusEffectBleedAccumulation</enhancedBleedDamageDef>
                <enhancedBleedDamageAmount>0.08</enhancedBleedDamageAmount>
                <enhancedBleedArmorPenetration>2.10</enhancedBleedArmorPenetration>
                <enhancedToxinDamageDef>MX_StatusEffectToxinAccumulation</enhancedToxinDamageDef>
                <enhancedToxinDamageAmount>0.08</enhancedToxinDamageAmount>
                <enhancedToxinArmorPenetration>2.10</enhancedToxinArmorPenetration>
                <fieldMoteDef>Mote_QH_SpringFlowField</fieldMoteDef>
                <ambientSplashFleckDef>MX_QH_GroundWaterSplash_Pink</ambientSplashFleckDef>
            </li>
        </comps>
    </ThingDef>

    <FleckDef>
        <defName>MX_QH_GroundWaterSplash_Pink</defName>
        <fleckSystemClass>FleckSystemThrown</fleckSystemClass>
        <altitudeLayer>MoteOverhead</altitudeLayer>
        <randomGraphics>
            <li>
                <graphicClass>Graphic_FleckPulse</graphicClass>
                <shaderType>Mote</shaderType>
                <texPath>Things/Mote/GroundSplash/GroundSplashA</texPath>
                <drawSize>(1,1)</drawSize>
                <color>(1.0, 0.62, 0.78, 0.34)</color>
            </li>
            <li>
                <graphicClass>Graphic_FleckPulse</graphicClass>
                <shaderType>Mote</shaderType>
                <texPath>Things/Mote/GroundSplash/GroundSplashB</texPath>
                <drawSize>(1,1)</drawSize>
                <color>(1.0, 0.62, 0.78, 0.34)</color>
            </li>
        </randomGraphics>
        <unattachedDrawOffset>(0, 0, 0)</unattachedDrawOffset>
        <fadeInTime>0</fadeInTime>
        <solidTime>.3</solidTime>
        <fadeOutTime>.35</fadeOutTime>
        <archHeight>0</archHeight>
        <growthRate>1</growthRate>
        <scalingAnchor>(.5, .2, 0)</scalingAnchor>
        <scalers>
            <li>
                <scaleAmt>1</scaleAmt>
                <scaleTime>.65</scaleTime>
                <axisMask>(1, 0, 0)</axisMask>
                <curve>
                    <points>
                        <li>(0,0.5)</li>
                        <li>(0.16,0.2971286)</li>
                        <li>(0.32,0.2082831)</li>
                        <li>(0.48,0.3066487)</li>
                        <li>(0.64,0.4985328)</li>
                        <li>(0.8,0.7313842)</li>
                        <li>(1,1)</li>
                    </points>
                </curve>
            </li>
            <li>
                <scaleAmt>1</scaleAmt>
                <scaleTime>.65</scaleTime>
                <axisMask>(0, 0, 1)</axisMask>
                <curve>
                    <points>
                        <li>(0,0)</li>
                        <li>(0.16,0.3361711)</li>
                        <li>(0.32,0.5945203)</li>
                        <li>(0.48,0.7089323)</li>
                        <li>(0.64,0.683339)</li>
                        <li>(0.8,0.5272376)</li>
                        <li>(1,0)</li>
                    </points>
                </curve>
            </li>
        </scalers>
    </FleckDef>

    <ThingDef ParentName="MoteGlowDistorted">
        <defName>Mote_QH_SpringFlowField</defName>
        <thingClass>MoteAttached</thingClass>
        <altitudeLayer>MoteLow</altitudeLayer>
        <drawOffscreen>true</drawOffscreen>
        <mote>
            <fadeInTime>0.5</fadeInTime>
            <solidTime>9999</solidTime>
            <fadeOutTime>0.75</fadeOutTime>
            <needsMaintenance>true</needsMaintenance>
            <fadeOutUnmaintained>true</fadeOutUnmaintained>
        </mote>
        <graphicData>
            <graphicClass>Graphic_Mote</graphicClass>
            <shaderType>MoteGlowDistorted</shaderType>
            <shaderParameters>
                <_DistortionTex>/Other/Ripples</_DistortionTex>
            </shaderParameters>
            <color>(1,0.6,0.8,0.4)</color>
            <texPath>Things/Mote/PsycastCast</texPath>
            <drawSize>12.0</drawSize>
        </graphicData>
    </ThingDef>

    <ThingDef ParentName="BaseBullet">
        <defName>MX_Bullet_QH_LunarMirrorRetaliation</defName>
        <label>腊梅反击铃音</label>
        <thingClass>MiliraXian.Characters.QingHe.Things.Projectiles.Projectile_LunarMirrorRetaliation</thingClass>
        <graphicData>
            <texPath>MiliraXianNeiyu/Projectile/Shard</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(0.30,0.86)</drawSize>
            <shaderType>TransparentPostLight</shaderType>
            <color>(170,225,255)</color>
        </graphicData>
        <projectile>
            <damageDef>MX_QH_NoteImpact</damageDef>
            <damageAmountBase>8</damageAmountBase>
            <armorPenetrationBase>1.50</armorPenetrationBase>
            <speed>36</speed>
            <arcHeightFactor>0.05</arcHeightFactor>
        </projectile>
        <comps>
            <li Class="MiliraXian.Characters.CompProperties_ProjectileContinuousTrail">
                <trailTexPath>UI/Overlays/ThingLine</trailTexPath>
                <trailMaxPoints>18</trailMaxPoints>
                <trailMinPointDistance>0.10</trailMinPointDistance>
                <trailSmoothSubdivisions>4</trailSmoothSubdivisions>
                <trailWidthStart>0.14</trailWidthStart>
                <trailWidthEnd>0.04</trailWidthEnd>
                <trailAlpha>0.75</trailAlpha>
                <trailAltitudeOffset>0.65</trailAltitudeOffset>
                <useProjectileGraphicColor>true</useProjectileGraphicColor>
            </li>
            <li Class="MiliraXian.Characters.QingHe.Things.Weapons.CompProperties_FlowerBellStatusOnHit">
                <damageDef>MX_StatusEffectColdAccumulation</damageDef>
                <amount>0.08</amount>
                <armorPenetration>2.10</armorPenetration>
                <requireHostileTarget>false</requireHostileTarget>
            </li>
        </comps>
    </ThingDef>

    <ThingDef>
        <defName>MX_QH_LunarMirror</defName>
        <label>腊梅护盾</label>
        <thingClass>ThingWithComps</thingClass>
        <category>None</category>
        <tickerType>Normal</tickerType>
        <drawerType>RealtimeOnly</drawerType>
        <altitudeLayer>MoteLow</altitudeLayer>
        <passability>Standable</passability>
        <fillPercent>0</fillPercent>
        <size>(1,1)</size>
        <selectable>false</selectable>
        <useHitPoints>false</useHitPoints>
        <hasTooltip>false</hasTooltip>
        <drawOffscreen>true</drawOffscreen>
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>Transparent</shaderType>
            <color>(0.70,0.90,1.00,0.18)</color>
            <texPath>Things/Mote/PsycastCast</texPath>
            <drawSize>1.6</drawSize>
        </graphicData>
        <comps>
            <li Class="MiliraXian.Characters.QingHe.Things.CompProperties_LunarMirrorShield">
                <radius>4.0</radius>
                <startingEnergy>300</startingEnergy>
                <energyLossPerDamage>1.0</energyLossPerDamage>
                <durationTicks>1200</durationTicks>
                <fadeInTicks>30</fadeInTicks>
                <fadeOutTicks>45</fadeOutTicks>
                <breakOnEmp>false</breakOnEmp>
                <interceptGroundProjectiles>true</interceptGroundProjectiles>
                <interceptAirProjectiles>true</interceptAirProjectiles>
                <interceptOutgoingProjectiles>false</interceptOutgoingProjectiles>
                <shieldTexPath>MiliraXianNeiyu/Effect/Neiyu_Shield/Shield</shieldTexPath>
                <shieldDrawSizeFactor>1.1601562</shieldDrawSizeFactor>
                <shieldAlpha>0.34</shieldAlpha>
                <shieldColor>(0.70,0.90,1.00,1.00)</shieldColor>
                <absorbFleckDefName>ExplosionFlash</absorbFleckDefName>
                <absorbFleckScale>1.0</absorbFleckScale>
                <breakEffectScale>3.6</breakEffectScale>
                <breakFlashScale>8.0</breakFlashScale>
                <enhancedRetaliationProjectileDef>MX_Bullet_QH_LunarMirrorRetaliation</enhancedRetaliationProjectileDef>
            </li>
        </comps>
    </ThingDef>

</Defs>
