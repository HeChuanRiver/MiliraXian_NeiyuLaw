    <techLevel>Archotech</techLevel>
    <smeltable>false</smeltable>
    <graphicData>
      <texPath>MiliraXianNeiyu/Items/FlowerStick</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.6,1.6)</drawSize>
