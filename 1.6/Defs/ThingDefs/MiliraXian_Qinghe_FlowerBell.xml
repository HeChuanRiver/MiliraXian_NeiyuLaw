<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BaseWeapon">
    <defName>MX_QH_Weapon_FlowerBell</defName>
    <label>花信风铃</label>
    <description>自幼时一直陪伴清荷的乐器。能敲出穿透心灵的声音，注入花语后还可附加特殊的魔力。\n\n只可由清荷使用。带有特殊的追踪效果，无视射击精度和掩体效果。</description>
    <recipeMaker Inherit="False">
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <recipeUsers>
        <li>ElectricSmithy</li>
        <li>FueledSmithy</li>
      </recipeUsers>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
      <skillRequirements>
        <Crafting>16</Crafting>
        <Artistic>16</Artistic>
      </skillRequirements>
    </recipeMaker>
    <techLevel>Archotech</techLevel>
    <smeltable>false</smeltable>
    <graphicData>
      <texPath>MiliraXianNeiyu/Items/FlowerStick</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.6,1.6)</drawSize>
    </graphicData>
    <uiIconPath>MiliraXianNeiyu/Items/FlowerStick</uiIconPath>
    <generateCommonality>0</generateCommonality>
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <tradeability>Sellable</tradeability>
    <weaponTags>
      <li>MiliraXian_QingheInstrument</li>
    </weaponTags>
    <weaponClasses>
      <li>Ranged</li>
    </weaponClasses>
    <costList>
      <WoodLog>40</WoodLog>
      <Steel>40</Steel>
    </costList>
    <statBases>
      <WorkToMake>120000</WorkToMake>
      <MarketValue>260</MarketValue>
      <Mass>1.0</Mass>
      <AccuracyTouch>1.0</AccuracyTouch>
      <AccuracyShort>1.0</AccuracyShort>
      <AccuracyMedium>1.0</AccuracyMedium>
      <AccuracyLong>1.0</AccuracyLong>
      <RangedWeapon_Cooldown>5.5</RangedWeapon_Cooldown>
    </statBases>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable" />
      <li Class="MiliraXian.Characters.QingHe.Things.Weapons.CompProperties_QingheResonantWeaponLabel">
        <resonanceLabels>
          <li>MX_QH_FlowerBellResonanceSpring</li>
          <li>MX_QH_FlowerBellResonanceSummer</li>
          <li>MX_QH_FlowerBellResonanceAutumn</li>
          <li>MX_QH_FlowerBellResonanceWinter</li>
        </resonanceLabels>
        <resonanceDescriptions>
          <li>MX_QH_FlowerBellResonanceDescriptionSpring</li>
          <li>MX_QH_FlowerBellResonanceDescriptionSummer</li>
          <li>MX_QH_FlowerBellResonanceDescriptionAutumn</li>
          <li>MX_QH_FlowerBellResonanceDescriptionWinter</li>
        </resonanceDescriptions>
      </li>
      <li>
        <compClass>CompEquippable</compClass>
      </li>
      <li Class="CompProperties_Styleable" />
      <li Class="MiliraXian.Characters.QingHe.Things.Weapons.CompProperties_FlowerBellResonance">
        <settings>
          <li>
            <resonance>Spring</resonance>
            <projectile>MX_Bullet_Qinghe_FlowerBell_Spring</projectile>
          </li>
          <li>
            <resonance>Summer</resonance>
            <projectile>MX_Bullet_Qinghe_FlowerBell_Summer</projectile>
          </li>
          <li>
            <resonance>Autumn</resonance>
            <projectile>MX_Bullet_Qinghe_FlowerBell_Autumn</projectile>
          </li>
          <li>
            <resonance>Winter</resonance>
            <projectile>MX_Bullet_Qinghe_FlowerBell_Winter</projectile>
          </li>
        </settings>
      </li>
      <li Class="MiliraXian.Characters.CompProperties_UnbreakableEquipment" />
      <li Class="MiliraXian.Characters.CompProperties_PawnKindRestrictedWeapon">
        <allowedPawnKinds>
          <li>MiliraXian_Qinghe</li>
        </allowedPawnKinds>
      </li>
    </comps>
    <verbs>
      <li>
        <verbClass>MiliraXian.Characters.QingHe.Verbs.Verb_ShootFlowerBell</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>MX_Bullet_Qinghe_FlowerBell_None</defaultProjectile>
        <warmupTime>1.80</warmupTime>
        <range>16</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>9</ticksBetweenBurstShots>
        <defaultCooldownTime>2.5</defaultCooldownTime>
      </li>
    </verbs>
  </ThingDef>

  <ThingDef ParentName="BaseBullet" Name="MX_QH_BaseFlowerBellBullet" Abstract="True">
    <thingClass>MiliraXian.Characters.QingHe.Things.Projectiles.Projectile_FlowerBell</thingClass>
    <graphicData>
      <texPath>MiliraXianNeiyu/Projectile/Shard</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.36,1.05)</drawSize>
      <shaderType>TransparentPostLight</shaderType>
    </graphicData>
    <projectile>
      <damageDef>MX_QH_NoteImpact</damageDef>
      <damageAmountBase>6</damageAmountBase>
      <armorPenetrationBase>2.00</armorPenetrationBase>
      <speed>30</speed>
      <arcHeightFactor>0.10</arcHeightFactor>
    </projectile>
    <comps>
      <li Class="MiliraXian.Characters.CompProperties_ProjectileContinuousTrail">
        <trailTexPath>UI/Overlays/ThingLine</trailTexPath>
        <trailMaxPoints>22</trailMaxPoints>
        <trailMinPointDistance>0.10</trailMinPointDistance>
        <trailSmoothSubdivisions>4</trailSmoothSubdivisions>
        <trailWidthStart>0.18</trailWidthStart>
        <trailWidthEnd>0.05</trailWidthEnd>
        <trailAlpha>1.00</trailAlpha>
        <trailAltitudeOffset>0.70</trailAltitudeOffset>
        <useProjectileGraphicColor>true</useProjectileGraphicColor>
      </li>
      <li Class="MiliraXian.Characters.CompProperties_ProjectileHomingCurve">
        <homingStartDelayTicks>5</homingStartDelayTicks>
        <minHomingTicksToImpact>10</minHomingTicksToImpact>
        <homingTurnLerp>0.13</homingTurnLerp>
        <curveAmplitudeMin>0.60</curveAmplitudeMin>
        <curveAmplitudeMax>0.80</curveAmplitudeMax>
        <curveFrequency>0.12</curveFrequency>
      </li>
      <li Class="CompProperties_ProjectileEffecter">
        <effecterDef>MX_QH_ProjectileScatterTrail</effecterDef>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="MX_QH_BaseFlowerBellBullet">
