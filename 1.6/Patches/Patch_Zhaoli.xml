<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- Zhaoli -->
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName='Milira_Race']/alienRace/generalSettings/alienPartGenerator/bodyAddons</xpath>
        <value>
            <li>
                <!-- 改 -->
                <name>milira halo Zhaoli</name>
                <userCustomizable>false</userCustomizable>
                <!-- 改 -->
                <path>MiliraXianZhaoli/Pawn/Halo/MiliraXianHaloZhaoli</path>
                <inFrontOfBody>true</inFrontOfBody>
                <layerInvert>true</layerInvert>
                <shaderType>MoteGlow</shaderType>
                <!-- 改 -->
                <colorChannel>haloZhaoli</colorChannel>
                <defaultOffset>Center</defaultOffset>
                <drawSize>1</drawSize>
                <alignWithHead>true</alignWithHead>
                <scaleWithPawnDrawsize>true</scaleWithPawnDrawsize>
                <useSkipFlags>
                    <li>Milira_Halo</li>
                </useSkipFlags>
                <conditions>
                    <BodyPart>
                        <bodyPart>Milira_Halo</bodyPart>
                    </BodyPart>
                    <Posture>
                        <drawnStanding>true</drawnStanding>
                        <drawnInBed>true</drawnInBed>
                        <drawnLaying>true</drawnLaying>
                    </Posture>
                    <RotStage>Fresh</RotStage>
                    <!-- 改 -->
                    <Backstory>
                        <backstory>MiliraXian_BackStoryAdult_Zhaoli_BS1</backstory>
                    </Backstory>
                </conditions>
                <extendedGraphics>
                    <Age For="HumanlikeBaby">Milira/Pawn/BodyAddon/HaloChild/MiliraHalo</Age>
                    <Age For="Milira_HumanlikeChild">Milira/Pawn/BodyAddon/HaloChild/MiliraHalo</Age>
                    <Age For="Milira_HumanlikePreTeenager">Milira/Pawn/BodyAddon/HaloChild/MiliraHalo</Age>
                </extendedGraphics>
                <offsets>
                    <west>
                        <bodyTypes>
                            <Female>(0,-0.06)</Female>
                            <Baby MayRequire="Ludeon.RimWorld.Biotech">(0,-0.04)</Baby>
                            <Child MayRequire="Ludeon.RimWorld.Biotech">(0,-0.025)</Child>
                        </bodyTypes>
                        <layerOffset>-0.24</layerOffset>
                    </west>
                    <south>
                        <bodyTypes>
                            <Female>(0,-0.06)</Female>
                            <Baby MayRequire="Ludeon.RimWorld.Biotech">(0,-0.04)</Baby>
                            <Child MayRequire="Ludeon.RimWorld.Biotech">(0,-0.025)</Child>
                        </bodyTypes>
                        <layerOffset>-0.24</layerOffset>
                    </south>
                    <north>
                        <bodyTypes>
                            <Female>(0,-0.06)</Female>
                            <Baby MayRequire="Ludeon.RimWorld.Biotech">(0,-0.04)</Baby>
                            <Child MayRequire="Ludeon.RimWorld.Biotech">(0,-0.025)</Child>
                        </bodyTypes>
                        <layerOffset>-0.24</layerOffset>
                    </north>
                    <east>
                        <bodyTypes>
                            <Female>(0,-0.06)</Female>
                            <Baby MayRequire="Ludeon.RimWorld.Biotech">(0,-0.04)</Baby>
                            <Child MayRequire="Ludeon.RimWorld.Biotech">(0,-0.025)</Child>
                        </bodyTypes>
                        <layerOffset>-0.24</layerOffset>
                    </east>
                </offsets>
            </li>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
