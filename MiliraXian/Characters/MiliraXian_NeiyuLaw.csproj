<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>MiliraXian.Characters</RootNamespace>
    <AssemblyName>MiliraXian_NeiyuLaw</AssemblyName>
    <FileAlignment>512</FileAlignment>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>..\..\1.7\Assemblies</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- Both assemblies ship in 1.7\Assemblies, so the library is not copied as a private dependency. -->
    <ProjectReference Include="..\CharacterLib\MiliraXian_CharacterLib.csproj">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AlienRace">
      <HintPath>$(AlienRaceDll)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Milira">
      <HintPath>$(MiliraDll)</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- The screen bloom records its own Vulkan passes through Waylith's render feature pipeline. -->
    <Reference Include="Brutal.Vulkan" HintPath="$(RimWorldInstallDir)\Brutal.Vulkan.dll" Private="false" />
    <Reference Include="Brutal.Vulkan.Abstractions" HintPath="$(RimWorldInstallDir)\Brutal.Vulkan.Abstractions.dll" Private="false" />
    <Reference Include="Brutal.Core.Numerics" HintPath="$(RimWorldInstallDir)\Brutal.Core.Numerics.dll" Private="false" />
    <Reference Include="Brutal.Core.Common" HintPath="$(RimWorldInstallDir)\Brutal.Core.Common.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="*.cs" />
    <Compile Include="Common\**\*.cs" />
    <Compile Include="Mingyuan\**\*.cs" />
    <Compile Include="Neiyu\**\*.cs" />
    <Compile Include="QingHe\**\*.cs" />
    <Compile Include="Zhaoli\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\1.7\**\*.*" Exclude="..\..\1.7\Assemblies\**\*.*" />
    <Content Include="..\..\About\**\*.*" />
    <Content Include="..\..\Content\**\*.*" />
    <Content Include="..\..\LoadFolders.xml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\*.md" />
  </ItemGroup>
</Project>
