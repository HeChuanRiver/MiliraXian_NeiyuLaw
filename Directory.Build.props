<Project>
  <PropertyGroup>
    <MxIntermediateRoot Condition="'$(MxIntermediateRoot)' == ''">$(MSBuildThisFileDirectory)obj/</MxIntermediateRoot>
    <BaseIntermediateOutputPath>$(MxIntermediateRoot)$(MSBuildProjectName)/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />

  <PropertyGroup>
    <RimWorldInstallDir Condition="'$(RimWorldInstallDir)' == ''">$(MSBuildThisFileDirectory)..\..</RimWorldInstallDir>
    <RimWorldWorkshopDir Condition="'$(RimWorldWorkshopDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\workshop\content\294100</RimWorldWorkshopDir>
    <AriandelLibraryDll Condition="'$(AriandelLibraryDll)' == ''">$(RimWorldWorkshopDir)\3665997350\1.6\Assemblies\AriandelLibrary.dll</AriandelLibraryDll>
    <AlienRaceDll Condition="'$(AlienRaceDll)' == ''">$(RimWorldWorkshopDir)\839005762\1.6\Assemblies\AlienRace.dll</AlienRaceDll>
    <MiliraDll Condition="'$(MiliraDll)' == ''">$(RimWorldWorkshopDir)\3256974620\1.6\Assemblies\Milira.dll</MiliraDll>
    <FacialAnimationDll Condition="'$(FacialAnimationDll)' == ''">$(RimWorldWorkshopDir)\1635901197\1.6\Assemblies\FacialAnimation.dll</FacialAnimationDll>
  </PropertyGroup>
</Project>
