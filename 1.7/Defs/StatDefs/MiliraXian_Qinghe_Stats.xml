<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <StatDef>
        <defName>MX_QH_AuraShieldMaxEnergy</defName>
        <label>灵气容量</label>
        <description>灵气加护的最大容量。</description>
        <workerClass>MiliraXian.Characters.Common.Stats.StatWorker_Mutable</workerClass>
        <category>PawnCombat</category>
        <defaultBaseValue>100</defaultBaseValue>
        <minValue>0</minValue>
        <toStringStyle>FloatMaxOne</toStringStyle>
        <showIfHediffsPresent>
            <li>MX_QH_AuraShield</li>
        </showIfHediffsPresent>
        <neverDisabled>true</neverDisabled>
    </StatDef>

    <StatDef>
        <defName>MX_QH_AuraShieldRegenPerSecond</defName>
        <label>灵气回复</label>
        <description>灵气每秒回复量。</description>
        <workerClass>MiliraXian.Characters.Common.Stats.StatWorker_Mutable</workerClass>
        <category>PawnCombat</category>
        <defaultBaseValue>7.5</defaultBaseValue>
        <minValue>0</minValue>
        <toStringStyle>FloatMaxOne</toStringStyle>
        <showIfHediffsPresent>
            <li>MX_QH_AuraShield</li>
        </showIfHediffsPresent>
        <neverDisabled>true</neverDisabled>
    </StatDef>

    <StatDef>
        <defName>MX_QH_AuraShieldHitRegenDelay</defName>
        <label>灵气回复延迟</label>
        <description>受击后灵气回复的延迟。</description>
        <workerClass>MiliraXian.Characters.Common.Stats.StatWorker_TicksToSeconds</workerClass>
        <category>PawnCombat</category>
        <defaultBaseValue>120</defaultBaseValue>
        <minValue>0</minValue>
        <toStringStyle>FloatMaxOne</toStringStyle>
        <showIfHediffsPresent>
            <li>MX_QH_AuraShield</li>
        </showIfHediffsPresent>
        <neverDisabled>true</neverDisabled>
    </StatDef>

    <StatDef>
        <defName>MX_QH_AuraShieldBreakDelay</defName>
        <label>灵气加护重启延迟</label>
        <description>灵气耗尽后重新开始恢复的延迟。</description>
        <workerClass>MiliraXian.Characters.Common.Stats.StatWorker_TicksToSeconds</workerClass>
        <category>PawnCombat</category>
        <defaultBaseValue>1200</defaultBaseValue>
        <minValue>0</minValue>
        <toStringStyle>FloatMaxOne</toStringStyle>
        <showIfHediffsPresent>
            <li>MX_QH_AuraShield</li>
        </showIfHediffsPresent>
        <neverDisabled>true</neverDisabled>
    </StatDef>

    <StatDef>
        <defName>MX_QH_AuraShieldDamageCap</defName>
        <label>灵气最大单次消耗</label>
        <description>灵气单次消耗的上限。此数值为0时该特性不生效。</description>
        <workerClass>MiliraXian.Characters.Common.Stats.StatWorker_Mutable</workerClass>
        <category>PawnCombat</category>
        <defaultBaseValue>0</defaultBaseValue>
        <minValue>0</minValue>
        <toStringStyle>FloatOne</toStringStyle>
        <showIfHediffsPresent>
            <li>MX_QH_AuraShield</li>
        </showIfHediffsPresent>
        <neverDisabled>true</neverDisabled>
    </StatDef>

    <StatDef>
        <defName>MX_QH_AuraShieldHardening</defName>
        <label>灵气硬化</label>
        <description>灵气硬化提供的额外护甲值，护盾受到的伤害会先减去护甲值，若原始伤害值小于护甲值，则伤害完全无效。</description>
        <workerClass>MiliraXian.Characters.Common.Stats.StatWorker_Mutable</workerClass>
        <category>PawnCombat</category>
        <defaultBaseValue>0</defaultBaseValue>
        <minValue>0</minValue>
        <toStringStyle>FloatOne</toStringStyle>
        <showIfHediffsPresent>
            <li>MX_QH_AuraShield</li>
        </showIfHediffsPresent>
        <neverDisabled>true</neverDisabled>
    </StatDef>

    <StatDef>
        <defName>MX_QH_FlowingFormRechargeSpeed</defName>
        <label>流水之形充能速度</label>
        <description>流水之形的充能速度，单位为次/秒。</description>
        <workerClass>MiliraXian.Characters.Common.Stats.StatWorker_Mutable</workerClass>
        <category>PawnCombat</category>
        <defaultBaseValue>0.001</defaultBaseValue>
        <minValue>0</minValue>
        <toStringStyle>FloatMaxThree</toStringStyle>
        <showIfHediffsPresent>
            <li>MX_QH_FlowingForm</li>
        </showIfHediffsPresent>
        <neverDisabled>true</neverDisabled>
    </StatDef>

    <StatDef>
        <defName>MX_QH_SpellEffectFactor</defName>
        <label>法术效果系数</label>
        <description>特殊法术效果的倍率修正。影响清荷的技能伤害、通过技能和共鸣附加异常状态的效率和技能增益产生的效果量。</description>
        <workerClass>MiliraXian.Characters.Common.Stats.StatWorker_Mutable</workerClass>
        <category>PawnCombat</category>
        <defaultBaseValue>1</defaultBaseValue>
        <toStringStyle>PercentZero</toStringStyle>
        <showIfHediffsPresent>
            <li>MX_QH_AuraMastery</li>
        </showIfHediffsPresent>
        <neverDisabled>true</neverDisabled>
    </StatDef>

</Defs>
