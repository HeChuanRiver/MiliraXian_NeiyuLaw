<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <QuestScriptDef>
    <defName>MXNL_NeiyuProjectionRecruitQuest</defName>
    <autoAccept>false</autoAccept>
    <defaultHidden>false</defaultHidden>
    <expireDaysRange>-1~-1</expireDaysRange>
    <isRootSpecial>true</isRootSpecial>
    <sendAvailableLetter>true</sendAvailableLetter>
    <defaultCharity>true</defaultCharity>
    <endOnColonyMove>false</endOnColonyMove>
    <questNameRules>
      <rulesStrings>
        <li>questName-&gt;无终旅人</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription-&gt;殖民地附近出现了一位旅人米莉拉，她拥有着蓝色带有桃红色挑染的头发。头上顶着似乎是她自己点缀上去的花环状态的光环。一身的服饰与大家常见的天空精灵有着明显的差异。她自称自己的名字叫做：霓羽。她说明自己是一个旅人，在四处游荡居住，这次想要在你的殖民地度过一个较长的时间。如果你愿意接纳她的话，霓羽承诺将会一直为你提供超出常人的力量。如果不愿意的话她便会继续寻找下一个聚落，继续不知终点的旅途。</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="MiliraXian.Characters.Neiyu.QuestNode_Root_NeiyuProjectionRecruit_AvailableQuest" />
  </QuestScriptDef>

</Defs>
