<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <QuestScriptDef>
    <defName>MX_QH_FlowerCourtQuestScript</defName>
    <autoAccept>false</autoAccept>
    <defaultHidden>false</defaultHidden>
    <expireDaysRange>-1~-1</expireDaysRange>
    <isRootSpecial>true</isRootSpecial>
    <sendAvailableLetter>true</sendAvailableLetter>
    <defaultCharity>true</defaultCharity>
    <endOnColonyMove>false</endOnColonyMove>
    <questNameRules>
      <rulesStrings>
        <li>questName->来自百花的呼唤</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->一封带着幽香的神秘信件飘到了殖民地。信纸上画着一位美丽女性米莉拉的背影，另附了一根素雅的图签，夹在题着“莲花种植图解”的画册里。\n\n特殊角色【清荷】支线：\n - 接取后解锁建造个人建筑“荷雨池”，继续推进任务即可招募清荷并开启后续的角色养成支线。\n - Mod: 米莉拉角色拓展</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="MiliraXian.Characters.QingHe.QuestNode_Root_QingheFlowerCourt_AvailableQuest" />
  </QuestScriptDef>

  <QuestScriptDef>
    <defName>MX_QH_FlowerCourtStartQuestScript</defName>
    <autoAccept>true</autoAccept>
    <defaultHidden>false</defaultHidden>
    <expireDaysRange>-1~-1</expireDaysRange>
    <isRootSpecial>true</isRootSpecial>
    <sendAvailableLetter>true</sendAvailableLetter>
    <endOnColonyMove>false</endOnColonyMove>
    <questNameRules>
      <rulesStrings>
        <li>questName->花庭初绽</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->现在可以建造“荷雨池”了。虽然荷花只能观赏，但是多种一些也许会有好事发生吧。\n\n完成后开启后续任务：整理荷雨亭、初探灵力</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="MiliraXian.Characters.QingHe.QuestNode_Root_QingheFlowerCourt_AvailableQuest">
      <qingheStart>true</qingheStart>
    </root>
  </QuestScriptDef>

  <QuestScriptDef>
    <defName>MX_QH_LotusPavilionQuestScript</defName>
    <autoAccept>true</autoAccept>
    <defaultHidden>false</defaultHidden>
    <expireDaysRange>-1~-1</expireDaysRange>
    <isRootSpecial>true</isRootSpecial>
    <sendAvailableLetter>true</sendAvailableLetter>
    <endOnColonyMove>false</endOnColonyMove>
    <questNameRules>
      <rulesStrings>
        <li>questName->整理荷雨亭</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->将荷池所在房间的印象值提高到40。</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="MiliraXian.Characters.QingHe.Quests.QuestNode_Root_QingheFlowerCourtGuide" />
  </QuestScriptDef>

  <QuestScriptDef>
    <defName>MX_QH_MasteryGuideQuestScript</defName>
    <autoAccept>true</autoAccept>
    <defaultHidden>false</defaultHidden>
    <expireDaysRange>-1~-1</expireDaysRange>
    <isRootSpecial>true</isRootSpecial>
    <sendAvailableLetter>true</sendAvailableLetter>
    <endOnColonyMove>false</endOnColonyMove>
    <questNameRules>
      <rulesStrings>
        <li>questName->初探灵力</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->通过制作物品、读书或对敌人造成伤害，令清荷的精通等级达到1级。</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="MiliraXian.Characters.QingHe.Quests.QuestNode_Root_QingheFlowerCourtGuide">
      <masteryGuide>true</masteryGuide>
    </root>
  </QuestScriptDef>

</Defs>
