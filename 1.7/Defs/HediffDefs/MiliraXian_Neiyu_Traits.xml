<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>MX_Neiyu_SoulRemnantState</defName>
    <label>残魂化身</label>
    <description>多余营养逐渐完善肉体。每日最多存储5点营养，于当地零点刷新；死亡后累计营养清空。</description>
    <hediffClass>MiliraXian.Characters.Neiyu.Hediff_NeiyuSoulRemnant</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>300</maxSeverity>
    <!-- Each stage includes all preceding milestone bonuses. Vanilla StatDef caps
         PainShockThreshold at 0.99 and both toxin resistances at 1. -->
    <stages>
      <li><minSeverity>0</minSeverity></li>
      <li>
        <minSeverity>30</minSeverity>
        <statOffsets>
          <CarryingCapacity>75</CarryingCapacity>
          <EatingSpeed>0.2</EatingSpeed>
          <InjuryHealingFactor>0.2</InjuryHealingFactor>
          <MoveSpeed>1</MoveSpeed>
          <PainShockThreshold>0.03</PainShockThreshold>
          <RestRateMultiplier>0.2</RestRateMultiplier>
          <ToxicEnvironmentResistance>0.2</ToxicEnvironmentResistance>
          <ToxicResistance>0.2</ToxicResistance>
        </statOffsets>
      </li>
      <li>
        <minSeverity>60</minSeverity>
        <statOffsets>
          <CarryingCapacity>225</CarryingCapacity>
          <EatingSpeed>0.6</EatingSpeed>
          <InjuryHealingFactor>0.7</InjuryHealingFactor>
          <MoveSpeed>2</MoveSpeed>
          <PainShockThreshold>0.08</PainShockThreshold>
          <RestRateMultiplier>0.5</RestRateMultiplier>
          <ToxicEnvironmentResistance>0.5</ToxicEnvironmentResistance>
          <ToxicResistance>0.5</ToxicResistance>
        </statOffsets>
      </li>
      <li>
        <minSeverity>120</minSeverity>
        <statOffsets>
          <CarryingCapacity>375</CarryingCapacity>
          <EatingSpeed>1.4</EatingSpeed>
          <InjuryHealingFactor>1.5</InjuryHealingFactor>
          <MoveSpeed>4</MoveSpeed>
          <PainShockThreshold>0.15</PainShockThreshold>
          <RestRateMultiplier>1</RestRateMultiplier>
          <ToxicEnvironmentResistance>0.9</ToxicEnvironmentResistance>
          <ToxicResistance>0.9</ToxicResistance>
        </statOffsets>
      </li>
      <li>
        <minSeverity>300</minSeverity>
        <statOffsets>
          <CarryingCapacity>625</CarryingCapacity>
          <EatingSpeed>2.4</EatingSpeed>
          <InjuryHealingFactor>2.5</InjuryHealingFactor>
          <MoveSpeed>6</MoveSpeed>
          <PainShockThreshold>0.19</PainShockThreshold>
          <RestRateMultiplier>2</RestRateMultiplier>
          <ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
          <ToxicResistance>1</ToxicResistance>
        </statOffsets>
      </li>
    </stages>
    <modExtensions>
      <li Class="MiliraXian.Characters.Neiyu.NeiyuSoulRemnantExtension">
        <dailyStorageLimit>5</dailyStorageLimit>
        <dailyAutomaticNutrition>2</dailyAutomaticNutrition>
        <extraNutritionLabel>额外进食</extraNutritionLabel>
        <extraNutritionDescription>允许在日常饮食之外额外进食，每日自动存储至2点营养。每日总存储量最多5点，于当地零点刷新。</extraNutritionDescription>
        <nutritionStatusFormat>累计营养：{0}/{1}&#10;今日存储：{2}/{3}</nutritionStatusFormat>
      </li>
    </modExtensions>
  </HediffDef>
  <HediffDef>
    <defName>MX_Neiyu_SoulRecovery</defName>
    <label>残魂休眠</label>
    <description>肉体正在重塑，强制睡眠12小时。休眠期间无需进食。</description>
    <hediffClass>MiliraXian.Characters.Neiyu.Hediff_NeiyuSoulRecovery</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <minSeverity>1</minSeverity>
    <maxSeverity>1</maxSeverity>
    <preventsDeath>true</preventsDeath>
    <stages>
      <li>
        <hungerRateFactor>0</hungerRateFactor>
        <blocksMentalBreaks>true</blocksMentalBreaks>
        <capMods>
          <li><capacity>Consciousness</capacity><setMax>0.1</setMax></li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>30000</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>
</Defs>
