<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThoughtDef>
        <defName>MX_Neiyu_FlowerBlessedThought</defName>
        <durationDays>0.5</durationDays>
        <stackLimit>1</stackLimit>
        <thoughtClass>Thought_Memory</thoughtClass>
        <stages>
            <li>
                <label>花祝福</label>
                <description>沐浴在霓羽的花祝福之中。</description>
                <baseMoodEffect>12</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <HediffDef>
        <defName>MX_Neiyu_FlowerBlessed</defName>
        <label>花祝福</label>
        <description>祈生祝福提高移动速度、免疫增长速度并降低受到的伤害。</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.96, 0.60, 0.92)</defaultLabelColor>
        <isBad>false</isBad>
        <initialSeverity>1</initialSeverity>
        <minSeverity>1</minSeverity>
        <maxSeverity>1</maxSeverity>
        <stages>
            <li>
                <minSeverity>0</minSeverity>
                <label>花祝福</label>
                <statFactors>
                    <MoveSpeed>1.20</MoveSpeed>
                    <IncomingDamageFactor>0.90</IncomingDamageFactor>
                    <ImmunityGainSpeed>1.70</ImmunityGainSpeed>
                </statFactors>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>3600</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>MX_Neiyu_SwordVulnerability</defName>
        <label>剑坠易伤</label>
        <description>受到天坠影响，承受的伤害提高。</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.86, 0.52, 0.88)</defaultLabelColor>
        <isBad>true</isBad>
        <initialSeverity>1</initialSeverity>
        <minSeverity>1</minSeverity>
        <maxSeverity>1</maxSeverity>
        <stages>
            <li>
                <minSeverity>0</minSeverity>
                <label>易伤</label>
                <statFactors>
                    <IncomingDamageFactor>1.25</IncomingDamageFactor>
                </statFactors>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>1500</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
    </HediffDef>

</Defs>
