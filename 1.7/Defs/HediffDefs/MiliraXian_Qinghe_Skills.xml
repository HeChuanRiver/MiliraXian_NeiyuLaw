<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>MX_QH_SpringFlow</defName>
        <label>春泉洗礼</label>
        <description>沐浴在春泉之中，&lt;color=#FF69B4&gt;近战与远程伤害提升、受到的伤害降低、疼痛感减轻，并免疫告死积累&lt;/color&gt;。</description>
        <isBad>false</isBad>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(1.0, 0.8, 1.0)</defaultLabelColor>
        <initialSeverity>1.0</initialSeverity>
        <minSeverity>1.0</minSeverity>
        <maxSeverity>10.0</maxSeverity>
        <stages>
            <li>
                <minSeverity>0.0</minSeverity>
                <painFactor>0.8</painFactor>
                <statFactors>
                    <MX_AbnormalDeathSentenceLimitFactor>0</MX_AbnormalDeathSentenceLimitFactor>
                </statFactors>
                <statFactorsBySeverity>
                    <li>
                        <stat>MeleeDamageFactor</stat>
                        <valueBySeverity>
                            <points>
                                <li>(0,1)</li>
                                <li>(1,1.3)</li>
                                <li>(10,4)</li>
                            </points>
                        </valueBySeverity>
                    </li>
                    <li>
                        <stat>RangedWeapon_DamageMultiplier</stat>
                        <valueBySeverity>
                            <points>
                                <li>(0,1)</li>
                                <li>(1,1.3)</li>
                                <li>(10,4)</li>
                            </points>
                        </valueBySeverity>
                    </li>
                    <li>
                        <stat>IncomingDamageFactor</stat>
                        <valueBySeverity>
                            <points>
                                <li>(0,1)</li>
                                <li>(1,0.6)</li>
                                <li>(10,0.1)</li>
                            </points>
                        </valueBySeverity>
                    </li>
                </statFactorsBySeverity>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>120</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
            <li Class="MiliraXian.Characters.QingHe.Hediffs.HediffCompProperties_SpringRegen">
                <healIntervalTicks>60</healIntervalTicks>
                <healAmountPerTrigger>1.0</healAmountPerTrigger>
                <healPermanentInjuries>false</healPermanentInjuries>
            </li>
            <li Class="HediffCompProperties_Effecter">
                <stateEffecter>MX_QH_Effecter_SpringFlowHediff</stateEffecter>
            </li>
        </comps>
    </HediffDef>

    <!-- 荷雨的淋雨：墙内每 10 tick 刷新，离墙后 6 秒才消失（360 tick）。
         残留时长是设计支点：铃音要站定蓄力 10 秒，靠这 6 秒半速把敌人拖住才够满档。 -->
    <HediffDef>
        <defName>MX_QH_RainDrenched</defName>
        <label>淋雨</label>
        <description>被荷雨的雨水浇透，&lt;color=#7ADA9E&gt;移动速度减半&lt;/color&gt;。离开雨幕片刻后才会干透。</description>
        <isBad>true</isBad>
        <hediffClass>Verse.HediffWithComps</hediffClass>
        <defaultLabelColor>(0.60, 0.95, 0.50)</defaultLabelColor>
        <initialSeverity>1.0</initialSeverity>
        <maxSeverity>1.0</maxSeverity>
        <stages>
            <li>
                <statFactors>
                    <MoveSpeed>0.2</MoveSpeed>
                </statFactors>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>360</disappearsAfterTicks>
                <showRemainingTime>false</showRemainingTime>
            </li>
        </comps>
    </HediffDef>

</Defs>
