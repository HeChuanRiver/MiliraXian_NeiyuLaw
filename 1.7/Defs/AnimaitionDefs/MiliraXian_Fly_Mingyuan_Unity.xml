<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- Transform-only Unity wing driver. The original Milira_Fly*_Mingyuan defs remain the fault fallback. -->
    <AnimationDef>
        <defName>Milira_FlyEast_Mingyuan_Unity</defName>
        <durationTicks>36</durationTicks>
        <startOnRandomTick>true</startOnRandomTick>
        <keyframeParts>
            <li>
                <key>Root</key>
                <value>
                    <workerType>AnimationWorker_Keyframes</workerType>
                    <keyframes>
                        <li><tick>0</tick><offset>(0,0,-0.0125)</offset><angle>8</angle></li>
                        <li><tick>10</tick><offset>(0,0,0.01)</offset><angle>8</angle></li>
                        <li><tick>15</tick><offset>(0,0,0.0125)</offset><angle>8</angle></li>
                        <li><tick>36</tick><offset>(0,0,-0.0125)</offset><angle>8</angle></li>
                    </keyframes>
                </value>
            </li>
            <li>
                <key>Head</key>
                <value>
                    <workerType>AnimationWorker_Keyframes</workerType>
                    <keyframes>
                        <li><tick>0</tick><angle>-8</angle></li>
                    </keyframes>
                </value>
            </li>
        </keyframeParts>
    </AnimationDef>

