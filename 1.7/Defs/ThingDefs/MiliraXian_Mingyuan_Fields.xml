<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef>
        <defName>MX_Mingyuan_BurningPillarField</defName>
        <label>燃烧之柱核心</label>
        <thingClass>MiliraXian.Characters.Mingyuan.Thing_MingyuanBurningPillarField</thingClass>
        <category>Building</category>
        <selectable>true</selectable>
        <tickerType>Normal</tickerType>
        <drawerType>RealtimeOnly</drawerType>
        <altitudeLayer>MoteLow</altitudeLayer>
        <passability>Standable</passability>
        <fillPercent>0</fillPercent>
        <rotatable>false</rotatable>
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
            <texPath>MiliraXianMingyuan/Effect/BurningPillarCore</texPath>
        </graphicData>
        <drawOffscreen>true</drawOffscreen>
        <useHitPoints>true</useHitPoints>
        <statBases>
            <MaxHitPoints>2000</MaxHitPoints>
            <Flammability>0</Flammability>
        </statBases>
        <building>
            <isEdifice>false</isEdifice>
            <canBeDamagedByAttacks>true</canBeDamagedByAttacks>
            <quickTargetable>true</quickTargetable>
            <isTargetable>true</isTargetable>
            <neverBuildable>true</neverBuildable>
            <combatPower>100</combatPower>
            <displayAttackToDestroyOnInspectPane>false</displayAttackToDestroyOnInspectPane>
        </building>
        <comps>
            <li Class="MiliraXian.Characters.Mingyuan.CompProperties_MingyuanBurningPillarTornado">
                <startRadius>1</startRadius>
                <maxRadius>10</maxRadius>
                <durationTicks>2400</durationTicks>
                <radiusGrowTicks>600</radiusGrowTicks>
                <controlUnlockTicks>600</controlUnlockTicks>
                <buildingMaxHealthDamagePerSecond>0.30</buildingMaxHealthDamagePerSecond>
                <smallPawnBodySizeThreshold>1.2</smallPawnBodySizeThreshold>
                <pawnLifeDamageFractionPerSecond>0.15</pawnLifeDamageFractionPerSecond>
                <killBonusDurationTicks>300</killBonusDurationTicks>
                <obeyMovementBlockers>true</obeyMovementBlockers>
                <!-- 移动、牵引、生命燃烧与装备损耗采用暂定参数。 -->
                <tornadoMoveSpeedCellsPerSecond>4</tornadoMoveSpeedCellsPerSecond>
                <tornadoPullSpeedCellsPerSecond>2.5</tornadoPullSpeedCellsPerSecond>
                <lifeBurnFractionPerSecond>0.05</lifeBurnFractionPerSecond>
                <furEquipmentDurabilityLossFractionPerSecond>0.20</furEquipmentDurabilityLossFractionPerSecond>
                <controlGestureTicks>22</controlGestureTicks>
                <initialHitPoints>300</initialHitPoints>
                <targetPriorityFactor>0.65</targetPriorityFactor>
                <visualFadeTicks>36</visualFadeTicks>
                <particleLimit>28</particleLimit>
                <impactSound>MX_Neiyu_WarpFeather_Chime</impactSound>
                <snapSound>MX_Mingyuan_PillarSnap</snapSound>
                <loopSound>MX_Mingyuan_PillarWindFire</loopSound>
            </li>
        </comps>
    </ThingDef>

    <ThingDef>
        <defName>MX_Mingyuan_AshesField</defName>
        <label>焚我余烬领域</label>
        <thingClass>MiliraXian.Characters.Mingyuan.Thing_MingyuanAshesField</thingClass>
        <tickerType>Normal</tickerType>
        <drawerType>RealtimeOnly</drawerType>
        <altitudeLayer>MoteLow</altitudeLayer>
        <drawOffscreen>true</drawOffscreen>
        <useHitPoints>false</useHitPoints>
        <comps>
            <li Class="MiliraXian.Characters.Mingyuan.CompProperties_MingyuanBurningField">
                <radius>4</radius>
                <durationTicks>1800</durationTicks>
                <!-- 伤害和结算间隔暂沿用旧配置。 -->
                <pulseIntervalTicks>30</pulseIntervalTicks>
                <damageAmount>1</damageAmount>
                <lifeBurnLayers>150</lifeBurnLayers>
                <bloodLossRecovery>0.03</bloodLossRecovery>
                <previewRingColor>(1.00,0.75,0.34,0.64)</previewRingColor>
            </li>
        </comps>
    </ThingDef>

</Defs>
