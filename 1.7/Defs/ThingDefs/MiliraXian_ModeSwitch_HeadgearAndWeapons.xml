<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- ==A. == -->
    <ThingDef ParentName="BaseMeleeWeapon">
        <defName>MX_Neiyu_Form_Flower</defName>
        <label>[霓羽]霓裳花</label>
        <description>一枝常年盛放的霓裳花，是霓羽常常捏在手中的一枝。在霓羽手中它不仅仅是一枝花，还可以转化成其他的形态来协助作战。&#10;&#10;“人工培育的品种，可以随着我的心意来逐步的塑造我想要的样子。除此之外，这枝是母枝，我愿以我的精力逐步塑炼使其成为我的兵装”&#10;“友人的植物工程与生命法则的极致体现之物，手上持有的时候我一直一直会有ta们还在我身边的感觉。”</description>
        <recipeMaker Inherit="False" IsNull="True" />
        
        <graphicData>
            <texPath>MiliraXianNeiyu/Items/FlowerStick</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(1,1)</drawSize>
        </graphicData>
        <uiIconPath>MiliraXianNeiyu/Items/FlowerStick</uiIconPath>
        <generateCommonality>0</generateCommonality>
        <scatterableOnMapGen>false</scatterableOnMapGen>
        <tradeability>Sellable</tradeability>

        <techLevel>Archotech</techLevel>        <!--科技时代-->
        <smeltable>false</smeltable>    <!--是否可熔炼-->

        <weaponTags>
            <li>MiliraXian_NeiyuFlower</li>
        </weaponTags>

        <thingCategories>
        </thingCategories>
        <weaponClasses>            <!--武器类别-->
            <li>Melee</li>
        </weaponClasses>

        <costList>
            <Steel>160</Steel>
            <Jade>25</Jade>
        </costList>
        
        <statBases>
            <Mass>0.5</Mass>
            <MarketValue>1400</MarketValue>
            <MaxHitPoints>120</MaxHitPoints>
            <!--花低伤害-->
            <MeleeWeapon_CooldownMultiplier>3.2</MeleeWeapon_CooldownMultiplier>
            <AccuracyTouch>0.60</AccuracyTouch>
            <AccuracyShort>0.45</AccuracyShort>
            <AccuracyMedium>0.30</AccuracyMedium>
            <AccuracyLong>0.20</AccuracyLong>
        </statBases>
        <tools>
            <li>
                <label>拂花</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>6</power>
                <armorPenetration>0.15</armorPenetration>
                <cooldownTime>2.4</cooldownTime>
            </li>
        </tools>
        <comps>
            <li Class="MiliraXian.Characters.Neiyu.CompProperties_ModeSwitchWeapon">
                <formWeaponDefs>
                    <li>MX_Neiyu_Form_Flower</li>
                    <li>MX_Neiyu_Form_Weapon</li>
                    <li>MX_Neiyu_Form_Bow</li>
                </formWeaponDefs>

                <formLabels>
                    <li>花</li>
                    <li>剑</li>
                    <li>弓</li>
                </formLabels>

                <formIconPaths>
                    <li>MiliraXianNeiyu/Items/SwordForNeiyu</li>
                    <li>MiliraXianNeiyu/Items/FlowerStick</li>
                    <li>MiliraXianNeiyu/Items/BowForNeiyu</li>
                </formIconPaths>

                <commandLabel>切换形态</commandLabel>
                <commandDesc>点击切换</commandDesc>

                <destroyOldWeapon>true</destroyOldWeapon>
                <requirePrimary>true</requirePrimary>
                <cooldownTicks>0</cooldownTicks>
            </li>
            <li Class="MiliraXian.Characters.Common.CompProperties_UnbreakableEquipment" />
            <li Class="MiliraXian.Characters.Common.CompProperties_WeaponDropProtection" />
            <li Class="MiliraXian.Characters.Neiyu.Cultivation.CompProperties_NeiyuCultivatedEquipment" />
        </comps>
    </ThingDef>
    
    <ThingDef ParentName="BaseMeleeWeapon">
        <defName>MX_Neiyu_Form_Weapon</defName>
        <label>[霓羽]天使之石</label>
        <description>天使石（Angelite）是一种非常温柔且充满疗愈气息的矿石，也被称为“蓝天使石”。它通常呈现宁静的灰蓝色或柔和的天蓝色，质地细腻，带有一种沉静的能量感。&#10;在霓羽的润养下，天使石逐渐的沾染了一丝丝其他的颜色，一颗巨大的天使石被霓羽雕刻为这样一柄剑。通体又一颗石头雕刻而成，浑然一体的同时蕴含着别样的能量。&#10;“倘若————师傅她老人家也能看着这柄剑的话也会爱不释手吧，如果有机会找到她的埋骨地的话，我一定会......”</description>
        <recipeMaker Inherit="False" IsNull="True" />

        <graphicData>
            <texPath>MiliraXianNeiyu/Items/SwordForNeiyu</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,2)</drawSize>
        </graphicData>
        <uiIconPath>MiliraXianNeiyu/Items/SwordForNeiyu</uiIconPath>
        <generateCommonality>0</generateCommonality>
        <scatterableOnMapGen>false</scatterableOnMapGen>
        <tradeability>Sellable</tradeability>

        <techLevel>Archotech</techLevel>        <!--科技时代-->
        <smeltable>false</smeltable>    <!--是否可熔炼-->

        <thingCategories>
        </thingCategories>
        <weaponClasses>            <!--武器类别-->
            <li>Melee</li>
        </weaponClasses>


        <costList>
            <Steel>160</Steel>
            <Jade>25</Jade>
        </costList>

        <statBases>
            <MarketValue>3200</MarketValue>
            <Mass>0.9</Mass>
            <MeleeWeapon_CooldownMultiplier>0.8</MeleeWeapon_CooldownMultiplier>
            <AccuracyTouch>0.85</AccuracyTouch>
            <AccuracyShort>0.70</AccuracyShort>
            <AccuracyMedium>0.50</AccuracyMedium>
            <AccuracyLong>0.35</AccuracyLong>
        </statBases>
        <tools>
            <li>
                <label>霓刃</label>
                <capacities>
                    <li>Cut</li>
                    <li>Stab</li>
                </capacities>
                <power>40</power>
                <armorPenetration>0.6</armorPenetration>
                <cooldownTime>1.8</cooldownTime>
            </li>
        </tools>
        <comps>
            <li Class="MiliraXian.Characters.Neiyu.CompProperties_ModeSwitchWeapon">
                <formWeaponDefs>
                    <li>MX_Neiyu_Form_Flower</li>
                    <li>MX_Neiyu_Form_Weapon</li>
                    <li>MX_Neiyu_Form_Bow</li>
                </formWeaponDefs>

                <formLabels>
                    <li>花</li>
                    <li>剑</li>
                    <li>弓</li>
                </formLabels>

                <formIconPaths>
                    <li>MiliraXianNeiyu/Items/FlowerStick</li>
                    <li>MiliraXianNeiyu/Items/SwordForNeiyu</li>
                    <li>MiliraXianNeiyu/Items/BowForNeiyu</li>
                </formIconPaths>

                <commandLabel>切换形态</commandLabel>
                <commandDesc>点击切换</commandDesc>

                <destroyOldWeapon>true</destroyOldWeapon>
                <requirePrimary>true</requirePrimary>
                <cooldownTicks>0</cooldownTicks>
            </li>

            <li Class="MiliraXian.Characters.Common.CompProperties_UnbreakableEquipment" />
            <li Class="MiliraXian.Characters.Common.CompProperties_WeaponDropProtection" />
            <li Class="MiliraXian.Characters.Neiyu.Cultivation.CompProperties_NeiyuCultivatedEquipment" />
        </comps>
        <modExtensions>
            <li Class="MiliraXian.Characters.Neiyu.MXMeleeSlashGhostExtension">
                <fallbackFleckDefName>ExplosionFlash</fallbackFleckDefName>
                <scaleRange>4.6~6.2</scaleRange>
                <minIntervalTicks>0</minIntervalTicks>
                <playOnMiss>true</playOnMiss>
                <cycleFleckDefNames>
                    <li>MXNL_Fleck_BladeLight_Neiyu_A</li>
                    <li>MXNL_Fleck_BladeLight_Neiyu_B</li>
                    <li>MXNL_Fleck_BladeLight_Neiyu_C</li>
                    <li>MXNL_Fleck_BladeLight_Neiyu_D</li>
                    <li>MXNL_Fleck_BladeLight_Neiyu_E</li>
                    <li>MXNL_Fleck_BladeLight_Neiyu_F</li>
                </cycleFleckDefNames>
            </li>
            <li Class="AncotLibrary.ExtraGraphicData_Extension">
                <graphicData>
                    <texPath>MiliraXianNeiyu/Items/MX_Neiyu_Form_Weapon_OnHand</texPath>
                    <graphicClass>Graphic_Single</graphicClass>
                    <drawSize>(1.5,4.5)</drawSize>
                </graphicData>
            </li>
            <li Class="MiliraXian.Characters.Common.Vfx.BladeBody.BladeGraphicExtension">
                <texPath>MiliraXianNeiyu/Items/MX_Neiyu_Form_Weapon_OnHand</texPath>
                <pommelUV>(0.500,0.033)</pommelUV>
                <gripUV>(0.490,0.122)</gripUV>
                <tipUV>(0.453,0.936)</tipUV>
                <uvMin>(0.40,0.03)</uvMin>
                <uvMax>(0.55,0.94)</uvMax>
                <length>2.28</length>
            </li>
        </modExtensions>
    </ThingDef>
    
    <ThingDef ParentName="BaseWeapon">
        <defName>MX_Neiyu_Form_Bow</defName>
        <label>[霓羽]天使之角</label>
        <description>天使石（Angelite）是一种非常温柔且充满疗愈气息的矿石，也被称为“蓝天使石”。它通常呈现宁静的灰蓝色或柔和的天蓝色，质地细腻，带有一种沉静的能量感。&#10;同样由此石雕刻而成的弓身，在霓羽的影响下居然拥有了超越常规的柔韧度。随心而动的弓弦可以凭空上弦续航能量箭矢，并且发射的箭矢也会随心而动对敌人进行持续的打击。&#10;&#10;“一柄远程武器在这颗星球是必要的，我们还太过弱小，我们做不到与那些猛兽近身作战。”&#10;“那让我为你打造一张弓吧，就用你雕下的这些碎屑。”&#10;“那......谢谢你，⬛⬛”</description>
        <recipeMaker Inherit="False" IsNull="True" />

        <techLevel>Archotech</techLevel>        <!--科技时代-->
        <smeltable>false</smeltable>    <!--是否可熔炼-->

        <thingCategories>
        </thingCategories>
        <weaponClasses>            <!--武器类别-->
            <li>Ranged</li>
        </weaponClasses>


        <graphicData>
            <texPath>MiliraXianNeiyu/Items/BowForNeiyu</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,2)</drawSize>
        </graphicData>
        <uiIconPath>MiliraXianNeiyu/Items/BowForNeiyu</uiIconPath>
        <generateCommonality>0</generateCommonality>
        <scatterableOnMapGen>false</scatterableOnMapGen>
        <tradeability>Sellable</tradeability>

        <costList>
            <Steel>160</Steel>
            <Jade>25</Jade>
        </costList>
        
        <statBases>
            <MarketValue>2400</MarketValue>
            <Mass>0.9</Mass>
            <AccuracyTouch>0.75</AccuracyTouch>
            <AccuracyShort>0.70</AccuracyShort>
            <AccuracyMedium>0.55</AccuracyMedium>
            <AccuracyLong>0.35</AccuracyLong>
        </statBases>

        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>MX_Bullet_BigSplitArrow</defaultProjectile>
                <warmupTime>1.2</warmupTime>
                <range>30.9</range>
                <soundCast>Bow_Small</soundCast>
            </li>
        </verbs>
        <comps>
            <li Class="MiliraXian.Characters.Neiyu.CompProperties_ModeSwitchWeapon">
                <formWeaponDefs>
                    <li>MX_Neiyu_Form_Flower</li>
                    <li>MX_Neiyu_Form_Weapon</li>
                    <li>MX_Neiyu_Form_Bow</li>
                </formWeaponDefs>

                <formLabels>
                    <li>花</li>
                    <li>剑</li>
                    <li>弓</li>
                </formLabels>

                <formIconPaths>
                    <li>MiliraXianNeiyu/Items/FlowerStick</li>
                    <li>MiliraXianNeiyu/Items/SwordForNeiyu</li>
                    <li>MiliraXianNeiyu/Items/BowForNeiyu</li>
                </formIconPaths>

                <commandLabel>切换形态</commandLabel>
                <commandDesc>点击切换</commandDesc>

                <destroyOldWeapon>true</destroyOldWeapon>
                <requirePrimary>true</requirePrimary>
                <cooldownTicks>0</cooldownTicks>
            </li>
            <li Class="MiliraXian.Characters.Common.CompProperties_UnbreakableEquipment" />
            <li Class="MiliraXian.Characters.Common.CompProperties_WeaponDropProtection" />
            <li Class="MiliraXian.Characters.Neiyu.Cultivation.CompProperties_NeiyuCultivatedEquipment" />
        </comps>
    </ThingDef>

    <!-- 1) 主箭：飞行后分裂 -->
    <ThingDef ParentName="BaseBullet">
        <defName>MX_Bullet_BigSplitArrow</defName>
        <label>霓羽·裂羽主矢</label>
        <thingClass>MiliraXian.Characters.Neiyu.Projectile_BigArrowSplit</thingClass>
        <graphicData>
            <texPath>MiliraXianNeiyu/Projectile/BigArrow</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(0.45,1.8)</drawSize>

            <shaderType>TransparentPostLight</shaderType>
            <color>(255,220,160)</color>

        </graphicData>
        <projectile>
            <damageDef>Arrow</damageDef>
            <damageAmountBase>36</damageAmountBase>
            <armorPenetrationBase>0.90</armorPenetrationBase>
            <speed>45</speed>
            <arcHeightFactor>0.10</arcHeightFactor>
        </projectile>
        <modExtensions>
            <li Class="MiliraXian.Characters.Neiyu.SplitArrowExtension">
                <splitProjectileDef>MX_Bullet_HomingShard</splitProjectileDef>
                <splitCount>8</splitCount>
                <splitDelayTicks>8</splitDelayTicks>
                <scatterAngle>120</scatterAngle>
                <scatterDistance>14</scatterDistance>
                <enableSplitRetarget>true</enableSplitRetarget>
                <splitRetargetChance>0.45</splitRetargetChance>
                <splitRetargetRadius>10</splitRetargetRadius>
                <splitRetargetPawnWeight>3.5</splitRetargetPawnWeight>
                <splitRetargetNonPawnWeight>1.0</splitRetargetNonPawnWeight>
            </li>
        </modExtensions>
    </ThingDef>

    <!-- 2) 子箭：先散开，再追踪 -->
    <ThingDef ParentName="BaseBullet">
        <defName>MX_Bullet_HomingShard</defName>
        <label>霓羽·追羽碎矢</label>
        <thingClass>MiliraXian.Characters.Neiyu.Projectile_HomingShard</thingClass>
        <graphicData>
            <texPath>MiliraXianNeiyu/Projectile/Shard</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(0.45,1.62)</drawSize>
            <shaderType>TransparentPostLight</shaderType>
            <color>(255,255,255)</color>
        </graphicData>
        <projectile>
            <damageDef>Arrow</damageDef>
            <damageAmountBase>10</damageAmountBase>
            <armorPenetrationBase>0.25</armorPenetrationBase>
            <speed>54</speed>
            <arcHeightFactor>0.45</arcHeightFactor>
        </projectile>
        <comps>
            <li Class="MiliraXian.Characters.Common.CompProperties_ProjectileHomingCurve">
                <homingStartDelayTicks>0</homingStartDelayTicks>
                <minHomingTicksToImpact>6</minHomingTicksToImpact>
                <homingLifetimeFactor>1.2</homingLifetimeFactor>
                <forceUsedTargetToIntended>false</forceUsedTargetToIntended>
                <homingTurnLerp>0.14</homingTurnLerp>
                <terminalSnapDistance>3.0</terminalSnapDistance>
                <terminalSnapTurnLerp>0.92</terminalSnapTurnLerp>
                <curveAmplitudeMin>0.00</curveAmplitudeMin>
                <curveAmplitudeMax>0.00</curveAmplitudeMax>
                <curveFrequency>0.20</curveFrequency>
                <curveGuideDistanceFactor>0.35</curveGuideDistanceFactor>
                <curveGuideDistanceMin>3.5</curveGuideDistanceMin>
                <curveGuideDistanceMax>7.5</curveGuideDistanceMax>
                <terminalLockDistance>1.05</terminalLockDistance>
                <curveWobbleFadeDistance>4.5</curveWobbleFadeDistance>
                <enableTurnStopWhenLikelyHit>true</enableTurnStopWhenLikelyHit>
                <turnStopMinTargetRadius>0.42</turnStopMinTargetRadius>
                <turnStopMargin>0.08</turnStopMargin>
                <turnStopPredictTicks>3</turnStopPredictTicks>
                <enableRetargetOnTargetLost>true</enableRetargetOnTargetLost>
                <retargetMaxCount>2</retargetMaxCount>
                <retargetRetryIntervalTicks>8</retargetRetryIntervalTicks>
                <retargetSearchRadius>10</retargetSearchRadius>
                <retargetPawnWeight>3.5</retargetPawnWeight>
                <retargetNonPawnWeight>1.0</retargetNonPawnWeight>
            </li>
        </comps>
    </ThingDef>

