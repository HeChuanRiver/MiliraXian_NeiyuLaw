<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="BaseMeleeWeapon">
        <defName>MX_QH_Weapon_Sword</defName>
        <label>散华</label>
        <description>清荷的随身佩刀。外形优雅，比起武器更像一件精致的艺术品。\n\n只可由清荷使用。\n\n此武器带有特殊战技(替换普通攻击)\n\n十字拔刀斩：\n借收刀之势向前方发动高速二连斩，能同时攻击范围内的所有敌人。攻守兼备的绝技，若在收刀完毕前受到攻击，则可立即拔刀弹开并反击。\n\n拔刀斩化解：\n收刀过程中受到攻击立即拔刀弹开并对攻击者造成硬直，随后发动一次反斩。</description>
        <recipeMaker Inherit="False">
            <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
            <workSkill>Crafting</workSkill>
            <effectWorking>Smith</effectWorking>
            <soundWorking>Recipe_Smith</soundWorking>
            <recipeUsers>
                <li>ElectricSmithy</li>
                <li>FueledSmithy</li>
            </recipeUsers>
            <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
            <skillRequirements>
                <Crafting>16</Crafting>
                <Artistic>16</Artistic>
            </skillRequirements>
        </recipeMaker>

        <graphicData>
            <texPath>MiliraXianQinghe/Things/Weapon_Sanhua_Blade</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,2)</drawSize>
        </graphicData>
        <uiIconPath>MiliraXianQinghe/Things/Weapon_Sanhua_Blade</uiIconPath>
        <generateCommonality>0</generateCommonality>
        <scatterableOnMapGen>false</scatterableOnMapGen>
        <tradeability>Sellable</tradeability>

        <techLevel>Archotech</techLevel>
        <smeltable>false</smeltable>

        <weaponTags>
            <li>MiliraXian_QingheSword</li>
        </weaponTags>
        <thingCategories>
        </thingCategories>
        <weaponClasses>
            <li>Melee</li>
        </weaponClasses>

        <costList>
            <WoodLog>15</WoodLog>
            <Steel>75</Steel>
        </costList>

        <statBases>
            <WorkToMake>120000</WorkToMake>
            <MarketValue>3000</MarketValue>
            <Mass>1.8</Mass>
            <!--
              剑舞架势的十字斩：举刀（收刀入鞘、蓄势）1.45 秒走原版施法预热，之后 1.72 秒的出刀和回正走冷却。
              冷却 1.0 × 1.72 = 1.72 秒，正好按原速播放；攻速加成缩短冷却时动作按比例加速。整套周期 3.17 秒。
            -->
            <MeleeWeapon_CooldownMultiplier>1.72</MeleeWeapon_CooldownMultiplier>
        </statBases>

        <tools>
            <li>
                <label>斩击</label>
                <capacities>
                    <li>MX_QH_SwordCut</li>
                </capacities>
                <power>8</power>
                <armorPenetration>1.2</armorPenetration>
                <cooldownTime>1.0</cooldownTime>
            </li>
        </tools>

        <comps>
            <li Class="MiliraXian.Characters.QingHe.Things.Weapons.CompProperties_QingheResonantWeaponLabel">
                <resonanceLabels>
                    <li>MX_QH_SwordResonanceSpring</li>
                    <li>MX_QH_SwordResonanceSummer</li>
                    <li>MX_QH_SwordResonanceAutumn</li>
                    <li>MX_QH_SwordResonanceWinter</li>
                </resonanceLabels>
                <resonanceDescriptions>
                    <li>MX_QH_SwordResonanceDescriptionSpring</li>
                    <li>MX_QH_SwordResonanceDescriptionSummer</li>
                    <li>MX_QH_SwordResonanceDescriptionAutumn</li>
                    <li>MX_QH_SwordResonanceDescriptionWinter</li>
                </resonanceDescriptions>
            </li>
            <li Class="MiliraXian.Characters.Common.CompProperties_UnbreakableEquipment" />
            <li Class="MiliraXian.Characters.Common.CompProperties_WeaponDropProtection" />
            <li Class="MiliraXian.Characters.Common.CompProperties_PawnKindRestrictedWeapon">
                <allowedPawnKinds>
                    <li>MiliraXian_Qinghe</li>
                </allowedPawnKinds>
            </li>
            <!-- 快速切换：与背包里的花信风铃互换（两件都是原物，不新建也不销毁），冷却 1 秒 -->
            <li Class="MiliraXian.Characters.Common.CompProperties_WeaponQuickSwap">
                <partnerDefs>
                    <li>MX_QH_Weapon_FlowerBell</li>
                </partnerDefs>
                <cooldownTicks>60</cooldownTicks>
            </li>
        </comps>

        <modExtensions>
            <li Class="MiliraXian.Characters.Neiyu.MXMeleeSlashGhostExtension">
                <effecterDefName>MXNL_Effecter_NeiyuSwordSlashGhost</effecterDefName>
                <fallbackFleckDefName>ExplosionFlash</fallbackFleckDefName>
                <scaleRange>4.6~6.2</scaleRange>
                <minIntervalTicks>5</minIntervalTicks>
                <playOnMiss>false</playOnMiss>
                <cycleFleckDefNames>
                    <li>MXNL_Fleck_BladeLight_Neiyu_A</li>
                    <li>MXNL_Fleck_BladeLight_Neiyu_B</li>
                    <li>MXNL_Fleck_BladeLight_Neiyu_C</li>
                    <li>MXNL_Fleck_BladeLight_Neiyu_D</li>
                    <li>MXNL_Fleck_BladeLight_Neiyu_E</li>
                    <li>MXNL_Fleck_BladeLight_Neiyu_F</li>
                </cycleFleckDefNames>
            </li>
            <li Class="AncotLibrary.ExtraGraphicData_Extension">
                <graphicData>
                    <texPath>MiliraXianQinghe/Things/Weapon_Sanhua_Blade</texPath>
                    <graphicClass>Graphic_Single</graphicClass>
                    <drawSize>(1.5,4.5)</drawSize>
                </graphicData>
            </li>
            <!-- 3D 刀身标定（散华新贴图，1024×1024，UV 的 v 向上）：
                 刃口朝右(+u)，edgeSide=1；刀身略往左弯(cx 从尖 0.432 到柄尾 0.528)。
                 锚点按贴图实测：柄尾 pommel、刀尖 tip、柄中握点 grip。 -->
            <li Class="MiliraXian.Characters.Common.Vfx.BladeBody.BladeGraphicExtension">
                <texPath>MiliraXianQinghe/Things/Weapon_Sanhua_Blade</texPath>
                <pommelUV>(0.528, 0.040)</pommelUV>
                <tipUV>(0.432, 0.966)</tipUV>
                <gripUV>(0.516, 0.150)</gripUV>
                <edgeSide>1</edgeSide>
                <length>1.1</length>
                <uvMin>(0.40, 0.03)</uvMin>
                <uvMax>(0.60, 0.98)</uvMax>
                <!-- 刀鞘：持刀时挂在左腰（身体坐标：右、上、前，米）。独立刀鞘贴图（雕金花鞘），
                     鞘口朝下(v小)、鞘尖朝上(v大)，刃口同刀朝右。 -->
                <scabbard>true</scabbard>
                <scabbardRestMouth>(-0.240, 0.020, 0.100)</scabbardRestMouth>
                <scabbardRestEnd>(-0.318, -0.718, -0.133)</scabbardRestEnd>
                <scabbardTexPath>MiliraXianQinghe/Things/Weapon_Sanhua_Scabbard</scabbardTexPath>
                <scabbardMouthUV>(0.538, 0.285)</scabbardMouthUV>
                <scabbardTipUV>(0.438, 0.996)</scabbardTipUV>
                <scabbardUvMin>(0.40, 0.28)</scabbardUvMin>
                <scabbardUvMax>(0.56, 1.00)</scabbardUvMax>
            </li>
            <li Class="MiliraXian.Characters.Common.Vfx.BladeMotion.BladeMotionSetExtension">
                <!-- 投影：高度压到 0.35；原点（骨骼的骨盆）放在贴图实测的骨盆（小人中心下 0.22 格 = 0.63 米 × 0.35）；南北方向缩到 0.55 -->
                <heightToScreen>0.35</heightToScreen>
                <heightOrigin>-0.63</heightOrigin>
                <depthToScreen>0.55</depthToScreen>
                <blendSeconds>0.08</blendSeconds>
                <!-- 动作片段都是 JSON -backed 的 clip def（见 MiscDefs/MiliraXian_Qinghe_BladeMotionClips.xml，
                     注释写在 def 上），游戏内可用 debug 动作 "Reload JSON assets" 热重载 -->
                <!-- 征召静止待机 -->
                <idle>MX_QH_SwordClip_Idle</idle>
                <!-- 防御和防御受击是剑舞的动作，写在 MX_QH_SwordGuard 的 guardMotion 里，任何近战武器通用 -->
                <!-- 化解：收刀途中弹开来招并接到十字斩第二刀起手 -->
                <parry>MX_QH_SwordClip_Parry</parry>
                <attacks>
                    <!-- 十字拔刀斩（8 字斩） -->
                    <li>MX_QH_SwordClip_CrossSlash</li>
                </attacks>
            </li>
            <!--
              十字斩刀光（跟刀身走）和收刀闪光。
              刀光带沿刀身方向展开，radialOffset 从刀身 bandCentre（握点起算的比例）处量，正 = 往刀尖。
              灰白为主；亮丝按花铃共鸣换色（春、夏、秋、冬），没有共鸣为白色。
            -->
            <li Class="MiliraXian.Characters.QingHe.Things.Weapons.QingheBladeTrailExtension">
                <bladeLength>0.976</bladeLength>
                <bandCentre>0.65</bandCentre>
                <!-- 和上面的动作投影一致（heightOrigin、depthToScreen 从动作取） -->
                <heightToScreen>0.35</heightToScreen>
                <distortionNormalTexPath>MiliraXianQinghe/Effect/SakuraDance/SakuraNormal</distortionNormalTexPath>
                <distortionMetresPerUnit>0.04</distortionMetresPerUnit>
                <shadeOpacity>0</shadeOpacity>
                <bloom>
                    <group>MX_ScreenBloom_Glow</group>
                    <tint>(1, 1, 1, 1)</tint>
                    <intensity>0.8</intensity>
                </bloom>
                <resonanceThreadColors>
                    <li>(1, 0.72, 0.84, 1)</li>
                    <li>(0.7, 1, 0.78, 1)</li>
                    <li>(1, 0.8, 0.5, 1)</li>
                    <li>(0.72, 0.88, 1, 1)</li>
                </resonanceThreadColors>
                <layers>
                    <!-- 扭曲带：440071 宽 0.6，扭曲 5 → 0.4，段寿命 2 秒（这里按刀长缩到 0.55） -->
                    <li>
                        <texPath>MiliraXianQinghe/Effect/SakuraDance/SakuraBand</texPath>
                        <distortion>true</distortion>
                        <liveFade>true</liveFade>
                        <radialOffset>-0.05</radialOffset>
                        <width>0.55</width>
                        <segmentDuration>1.5</segmentDuration>
                        <startFade>40</startFade>
                        <endFade>40</endFade>
                        <alphaCurve><points><li>(0, 1)</li><li>(0.375, 0.844)</li><li>(0.75, 0.5)</li><li>(1.125, 0.156)</li><li>(1.5, 0)</li></points></alphaCurve>
                        <shadeDarkness>1</shadeDarkness>
                        <textureFraction>0.01</textureFraction>
                        <attachedUV>true</attachedUV>
                        <flipV>true</flipV>
                        <speedUCurve><points><li>(0, 8)</li><li>(0.367, 4.05)</li><li>(0.733, 0.1)</li></points></speedUCurve>
                        <distortionIntensityCurve><points><li>(0, 5)</li><li>(1.5, 0.4)</li></points></distortionIntensityCurve>
                    </li>
                    <!-- 灰带：0.835 灰，亮度 2 → 1，段寿命 1.33 秒，两端淡出 10/90 -->
                    <li>
                        <texPath>MiliraXianQinghe/Effect/SakuraDance/SakuraBand</texPath>
                        <liveFade>true</liveFade>
                        <clampAlpha>true</clampAlpha>
                        <radialOffset>0.05</radialOffset>
                        <width>0.3</width>
                        <segmentDuration>1.333</segmentDuration>
                        <startFade>10</startFade>
                        <endFade>90</endFade>
                        <alphaCurve><points><li>(0, 1)</li><li>(0.25, 0.5625)</li><li>(0.5, 0.25)</li><li>(0.75, 0.0625)</li><li>(1, 0)</li></points></alphaCurve>
                        <brightnessCurve><points><li>(0, 1.67)</li><li>(1.333, 0.835)</li></points></brightnessCurve>
                        <textureFraction>0.01</textureFraction>
                    </li>
                    <!-- 4 条亮丝（加色，随共鸣换色）：宽 0.4 在 0.133 秒内收到 0.01，亮度 4，段寿命 2 / 1.67 / 1.33 / 1 秒 -->
                    <li>
                        <texPath>MiliraXianQinghe/Effect/SakuraDance/SakuraFilament</texPath>
                        <additive>true</additive>
                        <bloom>true</bloom>
                        <liveFade>true</liveFade>
                        <clampAlpha>true</clampAlpha>
                        <radialOffset>0.24</radialOffset>
                        <widthCurve><points><li>(0, 0.4)</li><li>(0.067, 0.2)</li><li>(0.133, 0.01)</li></points></widthCurve>
                        <segmentDuration>2</segmentDuration>
                        <startFadeCurve><points><li>(0, 0)</li><li>(0.75, 50)</li><li>(1.5, 100)</li></points></startFadeCurve>
                        <endFadeCurve><points><li>(0, 100)</li><li>(0.75, 50)</li><li>(1.5, 0)</li></points></endFadeCurve>
                        <alphaCurve><points><li>(0, 3)</li><li>(0.2, 1.3)</li><li>(0.5, 1)</li><li>(1, 0.25)</li><li>(1.5, 0)</li></points></alphaCurve>
                        <brightnessCurve><points><li>(0, 4)</li><li>(0.5, 4)</li><li>(1.5, 1)</li></points></brightnessCurve>
                        <textureFraction>0.1</textureFraction>
                        <speedU>0.02</speedU>
                    </li>
                    <li>
                        <texPath>MiliraXianQinghe/Effect/SakuraDance/SakuraFilament</texPath>
                        <additive>true</additive>
                        <bloom>true</bloom>
                        <liveFade>true</liveFade>
                        <clampAlpha>true</clampAlpha>
                        <radialOffset>0.24</radialOffset>
                        <widthCurve><points><li>(0, 0.4)</li><li>(0.067, 0.2)</li><li>(0.133, 0.01)</li></points></widthCurve>
                        <segmentDuration>1.667</segmentDuration>
                        <startFadeCurve><points><li>(0, 0)</li><li>(0.625, 50)</li><li>(1.25, 100)</li></points></startFadeCurve>
                        <endFadeCurve><points><li>(0, 100)</li><li>(0.625, 50)</li><li>(1.25, 0)</li></points></endFadeCurve>
                        <alphaCurve><points><li>(0, 3)</li><li>(0.2, 1.26)</li><li>(0.5, 0.9)</li><li>(1, 0.1)</li><li>(1.25, 0)</li></points></alphaCurve>
                        <brightnessCurve><points><li>(0, 4)</li><li>(0.5, 4)</li><li>(1.25, 1)</li></points></brightnessCurve>
                        <textureFraction>0.1</textureFraction>
                        <speedU>0.02</speedU>
                    </li>
                    <li>
                        <texPath>MiliraXianQinghe/Effect/SakuraDance/SakuraFilament</texPath>
                        <additive>true</additive>
                        <bloom>true</bloom>
                        <liveFade>true</liveFade>
                        <clampAlpha>true</clampAlpha>
                        <radialOffset>0.24</radialOffset>
                        <widthCurve><points><li>(0, 0.4)</li><li>(0.067, 0.2)</li><li>(0.133, 0.01)</li></points></widthCurve>
                        <segmentDuration>1.333</segmentDuration>
                        <startFadeCurve><points><li>(0, 0)</li><li>(0.5, 50)</li><li>(1, 100)</li></points></startFadeCurve>
                        <endFadeCurve><points><li>(0, 100)</li><li>(0.5, 50)</li><li>(1, 0)</li></points></endFadeCurve>
                        <alphaCurve><points><li>(0, 3)</li><li>(0.2, 1.2)</li><li>(0.5, 0.75)</li><li>(0.875, 0.047)</li><li>(1, 0)</li></points></alphaCurve>
                        <brightnessCurve><points><li>(0, 4)</li><li>(0.5, 4)</li><li>(1, 1)</li></points></brightnessCurve>
                        <textureFraction>0.1</textureFraction>
                        <speedU>0.02</speedU>
                    </li>
                    <li>
                        <texPath>MiliraXianQinghe/Effect/SakuraDance/SakuraFilament</texPath>
                        <additive>true</additive>
                        <bloom>true</bloom>
                        <liveFade>true</liveFade>
                        <clampAlpha>true</clampAlpha>
                        <radialOffset>0.24</radialOffset>
                        <widthCurve><points><li>(0, 0.4)</li><li>(0.067, 0.2)</li><li>(0.133, 0.01)</li></points></widthCurve>
                        <segmentDuration>1</segmentDuration>
                        <startFadeCurve><points><li>(0, 0)</li><li>(0.375, 50)</li><li>(0.75, 100)</li></points></startFadeCurve>
                        <endFadeCurve><points><li>(0, 100)</li><li>(0.375, 50)</li><li>(0.75, 0)</li></points></endFadeCurve>
                        <alphaCurve><points><li>(0, 3)</li><li>(0.2, 1.1)</li><li>(0.5, 0.5)</li><li>(0.75, 0)</li></points></alphaCurve>
                        <brightnessCurve><points><li>(0, 4)</li><li>(0.5, 4)</li><li>(0.75, 1)</li></points></brightnessCurve>
                        <textureFraction>0.1</textureFraction>
                        <speedU>0.02</speedU>
                    </li>
                </layers>
                <!-- 收刀闪光：刀完全入鞘时在鞘口一闪（星芒 1–2 帧、横向光条 0.2 秒、光晕 0.2 秒） -->
                <sheatheFlash>
                    <texPath>MiliraXianQinghe/Effect/SakuraDance/Glow</texPath>
                    <color>(0.88, 0.93, 0.96, 1)</color>
                    <needleLength>0.9</needleLength>
                    <needleWidth>0.04</needleWidth>
                    <needleSeconds>0.067</needleSeconds>
                    <needleBrightness>4</needleBrightness>
                    <needleAngle>55</needleAngle>
                    <barLength>1.4</barLength>
                    <barWidth>0.08</barWidth>
                    <barSeconds>0.2</barSeconds>
                    <barBrightness>2.5</barBrightness>
                    <haloSize>0.9</haloSize>
                    <haloEndSize>0.5</haloEndSize>
                    <haloSeconds>0.2</haloSeconds>
                    <haloBrightness>1.5</haloBrightness>
                </sheatheFlash>
            </li>
        </modExtensions>
    </ThingDef>
</Defs>
