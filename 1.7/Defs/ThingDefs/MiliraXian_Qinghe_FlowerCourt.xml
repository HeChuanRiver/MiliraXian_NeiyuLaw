<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>MX_QH_LotusPond</defName>
    <thingClass>MiliraXian.Characters.QingHe.Things.Buildings.Building_LotusPond</thingClass>
    <label>荷池</label>
    <description>清荷的修行场所。她会在这里进行冥想，最好为她准备一个安静、漂亮的环境。</description>
    <category>Building</category>
    <forceDebugSpawnable>true</forceDebugSpawnable>
    <selectable>true</selectable>
    <drawerType>RealtimeOnly</drawerType>
    <drawGUIOverlay>true</drawGUIOverlay>
    <graphicData>
      <texPath>MiliraXianQinghe/Buildings/lotus_pond</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <designationCategory>Misc</designationCategory>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>20</pathCost>
    <fillPercent>0.2</fillPercent>
    <rotatable>false</rotatable>
    <size>(3,3)</size>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <useHitPoints>true</useHitPoints>
    <isAltar>true</isAltar>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <ritualFocus>
      <spectateDistance>2</spectateDistance>
      <allowedSpectateSides>Down</allowedSpectateSides>
    </ritualFocus>
    <placeWorkers>
      <li>MiliraXian.Characters.QingHe.Things.Buildings.PlaceWorker_QingheLotusPondDesign</li>
      <li>PlaceWorker_RitualFocusNoArrow</li>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>900</WorkToBuild>
      <Flammability>0.2</Flammability>
      <Beauty>8</Beauty>
    </statBases>
    <costList>
      <WoodLog>60</WoodLog>
      <Steel>40</Steel>
    </costList>
    <building>
      <isInert>true</isInert>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
      <buildingTags>
        <li>RitualFocus</li>
      </buildingTags>
    </building>
    <comps>
      <li Class="CompProperties_UsesMeditationFocus" />
      <li Class="CompProperties_AssignableToPawn">
        <drawUnownedAssignmentOverlay>false</drawUnownedAssignmentOverlay>
        <noAssignablePawnsDesc>荷池只可分配给清荷。</noAssignablePawnsDesc>
        <compClass>MiliraXian.Characters.QingHe.Things.Buildings.CompAssignableToPawn_QingheMeditationSpot</compClass>
      </li>
      <li Class="MiliraXian.Characters.QingHe.Things.Buildings.CompProperties_LotusPondOverlay" />
    </comps>
  </ThingDef>
</Defs>