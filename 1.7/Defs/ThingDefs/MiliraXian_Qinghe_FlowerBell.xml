<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BaseWeapon">
    <defName>MX_QH_Weapon_FlowerBell</defName>
    <label>花信风铃</label>
    <description>自幼时一直陪伴清荷的乐器。能敲出穿透心灵的声音，注入花语后还可附加特殊的魔力。\n\n只可由清荷使用。带有特殊的追踪效果，无视射击精度和掩体效果。</description>
    <recipeMaker Inherit="False">
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <recipeUsers>
        <li>ElectricSmithy</li>
        <li>FueledSmithy</li>
      </recipeUsers>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
      <skillRequirements>
        <Crafting>16</Crafting>
        <Artistic>16</Artistic>
      </skillRequirements>
    </recipeMaker>
    <techLevel>Archotech</techLevel>
    <smeltable>false</smeltable>
    <graphicData>
      <texPath>MiliraXianNeiyu/Items/FlowerStick</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.6,1.6)</drawSize>
    </graphicData>
    <uiIconPath>MiliraXianNeiyu/Items/FlowerStick</uiIconPath>
    <!-- 必须为正值：PawnWeaponGenerator.Reset 按 generateCommonality 归一化武器选取权重，
         0 会把本武器权重乘成 0，原版生成永远选不中它。独占性由 weaponTags 闸门保证
         （MX_QH_StartUpWeapon 仅清荷的 PawnKindDef 声明），不依赖此值归零。 -->
    <generateCommonality>0.001</generateCommonality>
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <tradeability>Sellable</tradeability>
    <weaponTags>
      <li>MX_QH_StartUpWeapon</li>
    </weaponTags>
    <weaponClasses>
      <li>Ranged</li>
    </weaponClasses>
    <costList>
      <WoodLog>40</WoodLog>
      <Steel>40</Steel>
    </costList>
    <statBases>
      <WorkToMake>120000</WorkToMake>
      <MarketValue>260</MarketValue>
      <Mass>1.0</Mass>
      <AccuracyTouch>1.0</AccuracyTouch>
      <AccuracyShort>1.0</AccuracyShort>
      <AccuracyMedium>1.0</AccuracyMedium>
      <AccuracyLong>1.0</AccuracyLong>
      <!-- 主人 11-11：去掉射击后摇（原 5.5 秒）。属性下限 0.01 秒，换算后约 1 tick -->
      <RangedWeapon_Cooldown>0.01</RangedWeapon_Cooldown>
    </statBases>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable" />
      <li Class="MiliraXian.Characters.QingHe.Things.Weapons.CompProperties_QingheResonantWeaponLabel">
        <resonanceLabels>
          <li>MX_QH_FlowerBellResonanceSpring</li>
          <li>MX_QH_FlowerBellResonanceSummer</li>
          <li>MX_QH_FlowerBellResonanceAutumn</li>
          <li>MX_QH_FlowerBellResonanceWinter</li>
        </resonanceLabels>
        <resonanceDescriptions>
          <li>MX_QH_FlowerBellResonanceDescriptionSpring</li>
          <li>MX_QH_FlowerBellResonanceDescriptionSummer</li>
          <li>MX_QH_FlowerBellResonanceDescriptionAutumn</li>
          <li>MX_QH_FlowerBellResonanceDescriptionWinter</li>
        </resonanceDescriptions>
      </li>
      <!-- 五档蓄力（Documents/RangedRework.md 第 2.9 节）：取代原版 CompEquippable，蓄力、阈值、调式存在这里 -->
      <li Class="MiliraXian.Characters.QingHe.Things.Weapons.CompProperties_FlowerBellCharge">
        <tierSeconds>2</tierSeconds>
        <tiers>5</tiers>
        <decayR0>0.5</decayR0>
        <decayA>1</decayA>
      </li>
      <li Class="CompProperties_Styleable" />
      <li Class="MiliraXian.Characters.QingHe.Things.Weapons.CompProperties_FlowerBellResonance">
        <settings>
          <li>
            <resonance>Spring</resonance>
            <projectile>MX_Bullet_Qinghe_FlowerBell_Spring</projectile>
          </li>
          <li>
            <resonance>Summer</resonance>
            <projectile>MX_Bullet_Qinghe_FlowerBell_Summer</projectile>
          </li>
          <li>
            <resonance>Autumn</resonance>
            <projectile>MX_Bullet_Qinghe_FlowerBell_Autumn</projectile>
          </li>
          <li>
            <resonance>Winter</resonance>
            <projectile>MX_Bullet_Qinghe_FlowerBell_Winter</projectile>
          </li>
        </settings>
      </li>
      <li Class="MiliraXian.Characters.Common.CompProperties_UnbreakableEquipment" />
      <li Class="MiliraXian.Characters.Common.CompProperties_WeaponDropProtection" />
      <li Class="MiliraXian.Characters.Common.CompProperties_PawnKindRestrictedWeapon">
        <allowedPawnKinds>
          <li>MiliraXian_Qinghe</li>
        </allowedPawnKinds>
      </li>
      <!-- 快速切换：与背包里的散华互换（两件都是原物，不新建也不销毁），冷却 1 秒 -->
      <li Class="MiliraXian.Characters.Common.CompProperties_WeaponQuickSwap">
        <partnerDefs>
          <li>MX_QH_Weapon_Sword</li>
        </partnerDefs>
        <cooldownTicks>60</cooldownTicks>
      </li>
    </comps>
    <verbs>
      <li>
        <verbClass>MiliraXian.Characters.QingHe.Verbs.Verb_ShootFlowerBell</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>MX_Bullet_Qinghe_FlowerBell_None</defaultProjectile>
        <!-- warmupTime 只为让原版走起手检查并建预热姿态（> 0 即可），随即换成蓄力姿态；
             发数由蓄力档位决定，一次连发里一起射出，burstShotCount 必须是 1 -->
        <warmupTime>0.5</warmupTime>
        <drawAimPie>false</drawAimPie>
        <!-- 原版 AI 贴身有近战威胁时远程武器不可用；铃不受此限（贴身时够一档就放出，第 2.9 节） -->
        <ai_ProjectileLaunchingIgnoresMeleeThreats>true</ai_ProjectileLaunchingIgnoresMeleeThreats>
        <!-- 主人 11-11：突出远距离攻城和控场，射程 16 → 26（初值，实机再调） -->
        <range>26</range>
        <burstShotCount>1</burstShotCount>
        <defaultCooldownTime>0.01</defaultCooldownTime>
      </li>
    </verbs>
  </ThingDef>

  <ThingDef ParentName="BaseBullet" Name="MX_QH_BaseFlowerBellBullet" Abstract="True">
    <thingClass>MiliraXian.Characters.QingHe.Things.Projectiles.Projectile_FlowerBell</thingClass>
    <graphicData>
      <texPath>MiliraXianNeiyu/Projectile/Shard</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.36,1.05)</drawSize>
      <shaderType>TransparentPostLight</shaderType>
    </graphicData>
    <!-- 铃音不画自己的图形（graphicData 只为满足弹丸 Def 的要求）：弹体、声纹、花瓣、冲击波和扭曲都由
         FlowerBellVfx 合批绘制，规格见 Documents/RangedRework.md 第 2.11 节。
         速度 30 → 15（主人 11-09）；速度减半后飞行时间翻倍，摆动频率跟着减半（0.12 → 0.06，主人 11-10），
         一次飞行里的摆动周数和原来一样。命中后的扩张环出伤见 MX_QH_FlowerBellWave。 -->
    <projectile>
      <damageDef>MX_QH_NoteImpact</damageDef>
      <damageAmountBase>6</damageAmountBase>
      <armorPenetrationBase>2.00</armorPenetrationBase>
      <speed>15</speed>
      <arcHeightFactor>0.10</arcHeightFactor>
    </projectile>
    <comps>
      <li Class="MiliraXian.Characters.Common.CompProperties_ProjectileHomingCurve">
        <homingStartDelayTicks>5</homingStartDelayTicks>
        <!-- 主人 11-11：弹速减半后逃跑的敌人容易追不上。寿命 = 射程 / 弹速 × 系数，1.2 → 2.5（26 格约 4.3 秒）；
             目标丢失后改追附近敌人的次数 2 → 4 -->
        <homingLifetimeFactor>2.5</homingLifetimeFactor>
        <retargetMaxCount>4</retargetMaxCount>
        <minHomingTicksToImpact>10</minHomingTicksToImpact>
        <homingTurnLerp>0.13</homingTurnLerp>
        <curveAmplitudeMin>0.60</curveAmplitudeMin>
        <curveAmplitudeMax>0.80</curveAmplitudeMax>
        <curveFrequency>0.06</curveFrequency>
      </li>
    </comps>
    <modExtensions>
      <li Class="MiliraXian.Characters.QingHe.Things.Projectiles.FlowerBellNoteExtension">
        <color>(0.95, 0.92, 0.95, 1)</color>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- 铃音冲击波：扩张环扫到才出伤，只打敌对，从落点看视线；命中后叠该季的异常（第 2.11 节、第 3.3 节） -->
  <MiliraXian.Characters.Common.SweepDamage.SweepDamageDef>
    <defName>MX_QH_FlowerBellWave</defName>
    <damageDef>MX_QH_NoteImpact</damageDef>
    <!-- 建筑和地形吃共振（×3），挡视线的目标穿透一格（主人 11-11） -->
    <damageDefBuilding>MX_QH_NoteResonance</damageDefBuilding>
    <damageDefTerrain>MX_QH_NoteResonance</damageDefTerrain>
    <pierceCells>1</pierceCells>
    <targetFaction>Hostile</targetFaction>
    <hitPawns>true</hitPawns>
    <hitBuildings>true</hitBuildings>
    <requireLineOfSight>true</requireLineOfSight>
    <skipDowned>true</skipDowned>
    <damageDelayTicks>0</damageDelayTicks>
    <workerClass>MiliraXian.Characters.QingHe.Things.Projectiles.SweepDamageWorker_FlowerBell</workerClass>
  </MiliraXian.Characters.Common.SweepDamage.SweepDamageDef>

  <ThingDef ParentName="MX_QH_BaseFlowerBellBullet">
    <defName>MX_Bullet_Qinghe_FlowerBell_None</defName>
    <label>铃音</label>
    <projectile>
      <damageAmountBase>6</damageAmountBase>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="MX_QH_BaseFlowerBellBullet" Name="MX_Bullet_Qinghe_FlowerBell_Spring_Base">
    <defName>MX_Bullet_Qinghe_FlowerBell_Spring</defName>
    <label>铃音·春</label>
    <graphicData>
      <color>(255,130,150)</color>
    </graphicData>
    <projectile>
      <damageAmountBase>6</damageAmountBase>
    </projectile>
    <modExtensions Inherit="False">
      <li Class="MiliraXian.Characters.QingHe.Things.Projectiles.FlowerBellNoteExtension">
        <color>(1.0, 0.62, 0.80, 1)</color>
      </li>
    </modExtensions>
    <comps>
      <li Class="MiliraXian.Characters.QingHe.Things.Weapons.CompProperties_FlowerBellStatusOnHit">
        <abnormals>
          <li>MX_AbnormalBleed</li>
          <li>MX_AbnormalElectricLeak</li>
        </abnormals>
        <accumulationAmount>24</accumulationAmount>
        <requireHostileTarget>false</requireHostileTarget>
        <scaleWithQingheSpellEffect>true</scaleWithQingheSpellEffect>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="MX_QH_BaseFlowerBellBullet" Name="MX_Bullet_Qinghe_FlowerBell_Summer_Base">
    <defName>MX_Bullet_Qinghe_FlowerBell_Summer</defName>
    <label>铃音·夏</label>
    <graphicData>
      <color>(160,245,110)</color>
    </graphicData>
    <projectile>
      <damageAmountBase>6</damageAmountBase>
    </projectile>
    <modExtensions Inherit="False">
      <li Class="MiliraXian.Characters.QingHe.Things.Projectiles.FlowerBellNoteExtension">
        <color>(0.60, 0.95, 0.50, 1)</color>
      </li>
    </modExtensions>
    <comps>
      <li Class="MiliraXian.Characters.QingHe.Things.Weapons.CompProperties_FlowerBellStatusOnHit">
        <abnormals>
          <li>MX_AbnormalToxin</li>
          <li>MX_AbnormalCorrosion</li>
        </abnormals>
        <accumulationAmount>16</accumulationAmount>
        <requireHostileTarget>false</requireHostileTarget>
        <scaleWithQingheSpellEffect>true</scaleWithQingheSpellEffect>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="MX_QH_BaseFlowerBellBullet" Name="MX_Bullet_Qinghe_FlowerBell_Autumn_Base">
    <defName>MX_Bullet_Qinghe_FlowerBell_Autumn</defName>
    <label>铃音·秋</label>
    <graphicData>
      <color>(230,185,255)</color>
    </graphicData>
    <projectile>
      <damageAmountBase>6</damageAmountBase>
    </projectile>
    <modExtensions Inherit="False">
      <li Class="MiliraXian.Characters.QingHe.Things.Projectiles.FlowerBellNoteExtension">
        <color>(0.78, 0.60, 1.00, 1)</color>
      </li>
    </modExtensions>
    <comps>
      <li Class="MiliraXian.Characters.QingHe.Things.Weapons.CompProperties_FlowerBellStatusOnHit">
        <abnormals>
          <li>MX_AbnormalFear</li>
          <li>MX_AbnormalOverload</li>
        </abnormals>
        <accumulationAmount>8</accumulationAmount>
        <requireHostileTarget>false</requireHostileTarget>
        <scaleWithQingheSpellEffect>true</scaleWithQingheSpellEffect>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="MX_QH_BaseFlowerBellBullet" Name="MX_Bullet_Qinghe_FlowerBell_Winter_Base">
    <defName>MX_Bullet_Qinghe_FlowerBell_Winter</defName>
    <label>铃音·冬</label>
    <graphicData>
      <color>(170,225,255)</color>
    </graphicData>
    <projectile>
      <damageAmountBase>6</damageAmountBase>
    </projectile>
    <modExtensions Inherit="False">
      <li Class="MiliraXian.Characters.QingHe.Things.Projectiles.FlowerBellNoteExtension">
        <color>(0.60, 0.85, 1.00, 1)</color>
      </li>
    </modExtensions>
    <comps>
      <li Class="MiliraXian.Characters.QingHe.Things.Weapons.CompProperties_FlowerBellStatusOnHit">
        <abnormals>
          <li>MX_AbnormalCold</li>
        </abnormals>
        <accumulationAmount>12</accumulationAmount>
        <requireHostileTarget>false</requireHostileTarget>
        <scaleWithQingheSpellEffect>true</scaleWithQingheSpellEffect>
      </li>
    </comps>
  </ThingDef>
</Defs>
