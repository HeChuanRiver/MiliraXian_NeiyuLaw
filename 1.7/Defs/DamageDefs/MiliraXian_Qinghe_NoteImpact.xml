<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <DamageDef Name="MX_QH_NoteImpactBase">
    <defName>MX_QH_NoteImpact</defName>
    <label>音击</label>
    <externalViolence>true</externalViolence>
    <armorCategory>Sharp</armorCategory>
    <isRanged>true</isRanged>
    <workerClass>MiliraXian.Characters.QingHe.Things.Projectiles.DamageWorker_FlowerBellExplosion</workerClass>
    <deathMessage>{0}被花信铃带有灵力的声音击倒了。</deathMessage>
    <hediff>PsychicInjury</hediff>
    <explosionCellFleck>BlastEMP</explosionCellFleck>
    <explosionColorCenter>(0.95, 0.78, 1.00, 0.85)</explosionColorCenter>
    <explosionColorEdge>(0.85, 0.30, 0.50, 0.15)</explosionColorEdge>
  </DamageDef>
  <DamageDef Name="MX_QH_SlashBase" Abstract="True">
    <workerClass>MiliraXian.Characters.QingHe.Things.Weapons.DamageWorker_QingheSlash</workerClass>
    <externalViolence>true</externalViolence>
    <armorCategory>Sharp</armorCategory>
    <hediff>Cut</hediff>
    <deathMessage>{0}被清荷的剑势斩倒了。</deathMessage>
  </DamageDef>
  <DamageDef ParentName="MX_QH_SlashBase">
    <defName>MX_QH_Slash</defName>
    <label>散华斩击</label>
    <deathMessage>{0}死于散华的刀刃之下。</deathMessage>
    <modExtensions>
      <li Class="MiliraXian.Characters.QingHe.Things.Weapons.QingheSlashExtension">
        <canGainSwordPressure>true</canGainSwordPressure>
        <swordPressureGain>0.25</swordPressureGain>
        <resonanceAccumulationMultiplier>1</resonanceAccumulationMultiplier>
      </li>
    </modExtensions>
  </DamageDef>
  <!--
    清荷剑舞的招式伤害：label 是招式名，会作为"武器 招式"显示在伤口来源里，并按 TechniqueDamageExtension 的规则写入战斗日志
    （日志沿用原版斩击的句式，招式名填在工具位置）。剑压、四时共鸣与原来对应的伤害类型一致。
  -->
  <DamageDef Name="MX_QH_TechniqueSlashBase" ParentName="MX_QH_SlashBase" Abstract="True">
    <modExtensions>
      <li Class="MiliraXian.Characters.Common.Combat.TechniqueDamageExtension">
        <logRulesHit>Maneuver_Slash_MeleeHit</logRulesHit>
        <logRulesDeflect>Maneuver_Slash_MeleeDeflect</logRulesDeflect>
        <logRulesMiss>Maneuver_Slash_MeleeMiss</logRulesMiss>
        <logRulesDodge>Maneuver_Slash_MeleeDodge</logRulesDodge>
      </li>
    </modExtensions>
  </DamageDef>
  <!-- 普攻：拔刀十字斩（同散华斩击，每斩按片段的 resourceFactor 给剑压） -->
  <DamageDef ParentName="MX_QH_TechniqueSlashBase">
    <defName>MX_QH_CrossSlash</defName>
    <label>拔刀十字斩</label>
    <deathMessage>{0}倒在了清荷的拔刀十字斩之下。</deathMessage>
    <modExtensions Inherit="True">
      <li Class="MiliraXian.Characters.QingHe.Things.Weapons.QingheSlashExtension">
        <canGainSwordPressure>true</canGainSwordPressure>
        <swordPressureGain>0.25</swordPressureGain>
        <resonanceAccumulationMultiplier>1</resonanceAccumulationMultiplier>
      </li>
    </modExtensions>
  </DamageDef>
  <!-- 收刀途中化解后的反击 -->
  <DamageDef ParentName="MX_QH_TechniqueSlashBase">
    <defName>MX_QH_CounterSlash</defName>
    <label>拔刀斩化解</label>
    <deathMessage>{0}的攻势被化解，随即倒在清荷的反击之下。</deathMessage>
    <modExtensions Inherit="True">
      <li Class="MiliraXian.Characters.QingHe.Things.Weapons.QingheSlashExtension">
        <canGainSwordPressure>true</canGainSwordPressure>
        <swordPressureGain>0.25</swordPressureGain>
        <resonanceAccumulationMultiplier>1</resonanceAccumulationMultiplier>
      </li>
    </modExtensions>
  </DamageDef>
  <!-- 樱舞（同散华剑技：建筑伤害 ×2，不按命中积累剑压） -->
  <DamageDef ParentName="MX_QH_TechniqueSlashBase">
    <defName>MX_QH_SakuraDanceSlash</defName>
    <label>樱舞</label>
    <deathMessage>{0}倒在了清荷樱舞的刀光之中。</deathMessage>
    <buildingDamageFactor>2</buildingDamageFactor>
    <modExtensions Inherit="True">
      <li Class="MiliraXian.Characters.QingHe.Things.Weapons.QingheSlashExtension">
        <canGainSwordPressure>false</canGainSwordPressure>
        <resonanceAccumulationMultiplier>1.75</resonanceAccumulationMultiplier>
      </li>
    </modExtensions>
  </DamageDef>
  <!-- 樱舞接雷之后的刀（雷返，含第三刀雷电奉还） -->
  <DamageDef ParentName="MX_QH_TechniqueSlashBase">
    <defName>MX_QH_SakuraThunderSlash</defName>
    <label>樱舞·雷返</label>
    <deathMessage>{0}被清荷击出的落雷击倒了。</deathMessage>
    <buildingDamageFactor>2</buildingDamageFactor>
    <modExtensions Inherit="True">
      <li Class="MiliraXian.Characters.QingHe.Things.Weapons.QingheSlashExtension">
        <canGainSwordPressure>false</canGainSwordPressure>
        <resonanceAccumulationMultiplier>1.75</resonanceAccumulationMultiplier>
      </li>
    </modExtensions>
  </DamageDef>
  <!-- 剑舞处决（过身斩，收刀那一刻对核心部位的一击）。剑压由处决固定给 1 档，这里不再按命中积累 -->
  <DamageDef ParentName="MX_QH_TechniqueSlashBase">
    <defName>MX_QH_ExecutionSlash</defName>
    <label>残心</label>
    <deathMessage>{0}在清荷收刀的一声轻响中被洞穿了弱点。</deathMessage>
    <modExtensions Inherit="True">
      <li Class="MiliraXian.Characters.QingHe.Things.Weapons.QingheSlashExtension">
        <canGainSwordPressure>false</canGainSwordPressure>
        <resonanceAccumulationMultiplier>1</resonanceAccumulationMultiplier>
      </li>
    </modExtensions>
  </DamageDef>
  <DamageDef ParentName="MX_QH_SlashBase">
    <defName>MX_QH_SlashSkill</defName>
    <label>散华剑技</label>
    <deathMessage>{0}被清荷华丽的剑技击倒了。</deathMessage>
    <buildingDamageFactor>2</buildingDamageFactor>
    <modExtensions>
      <li Class="MiliraXian.Characters.QingHe.Things.Weapons.QingheSlashExtension">
        <canGainSwordPressure>false</canGainSwordPressure>
        <resonanceAccumulationMultiplier>1.75</resonanceAccumulationMultiplier>
      </li>
    </modExtensions>
  </DamageDef>
</Defs>
