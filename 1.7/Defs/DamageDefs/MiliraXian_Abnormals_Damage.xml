<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <DamageDef>
        <defName>MX_AbnormalVenomDamage</defName>
        <label>花毒腐蚀</label>
        <description>花信铃夏之共鸣造成的毒素腐蚀伤害。</description>
        <workerClass>DamageWorker_AddInjury</workerClass>
        <hasForcefulImpact>false</hasForcefulImpact>
        <makesBlood>false</makesBlood>
        <canInterruptJobs>false</canInterruptJobs>
        <externalViolence>true</externalViolence>
        <armorCategory>Sharp</armorCategory>
        <isRanged>true</isRanged>
        <ignoreShields>true</ignoreShields>
        <hediff>AcidBurn</hediff>
        <impactSoundType>Toxic</impactSoundType>
        <damageEffecter>Impact_Toxic</damageEffecter>
        <defaultDamage>8</defaultDamage>
        <defaultArmorPenetration>2</defaultArmorPenetration>
        <deathMessage>{0}死于花信铃的剧毒。</deathMessage>
    </DamageDef>
    <!-- 冻结恶化（碎冰）：冻结期间再叠满寒冷时一次大伤害并解冻（RangedRework.md 第 3.4 节） -->
    <DamageDef>
        <defName>MX_AbnormalShatterDamage</defName>
        <label>碎冰</label>
        <description>冻结中的目标再次受寒，连同冰壳一起碎裂。</description>
        <workerClass>DamageWorker_AddInjury</workerClass>
        <hasForcefulImpact>true</hasForcefulImpact>
        <makesBlood>true</makesBlood>
        <externalViolence>true</externalViolence>
        <armorCategory>Blunt</armorCategory>
        <isRanged>true</isRanged>
        <hediff>Crush</hediff>
        <defaultArmorPenetration>1</defaultArmorPenetration>
        <deathMessage>{0}连同冰壳一起碎裂了。</deathMessage>
    </DamageDef>
    <DamageDef>
        <defName>MX_AbnormalShortCircuitDamage</defName>
        <label>短路放电</label>
        <description>机械体短路时，内部放电造成的损伤。</description>
        <workerClass>DamageWorker_AddInjury</workerClass>
        <hasForcefulImpact>false</hasForcefulImpact>
        <makesBlood>false</makesBlood>
        <canInterruptJobs>false</canInterruptJobs>
        <externalViolence>true</externalViolence>
        <armorCategory>Heat</armorCategory>
        <isRanged>true</isRanged>
        <ignoreShields>true</ignoreShields>
        <hediff>Burn</hediff>
        <defaultArmorPenetration>2</defaultArmorPenetration>
        <deathMessage>{0}死于短路放电。</deathMessage>
    </DamageDef>
</Defs>
