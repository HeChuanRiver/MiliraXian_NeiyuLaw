    <AbilityDef>
        <defName>MX_Neiyu_WarpFeather</defName>
        <label>折跃引羽</label>
        <description>使用【物质法则】的能力，经过一段时间的吟唱后，在身旁生成12~24根米莉拉羽毛。&#10;当然也有可能是空间法则或其他什么类似的能力从其他米那里薅下来的毛。&#10;冷却时间：300秒。</description>
        <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_WarpFeather</iconPath>

        <category>MX_NeiyuSkill</category>
        <displayOrder>100</displayOrder>
        <cooldownTicksRange>18000</cooldownTicksRange>
        <warmupSound>MX_Neiyu_WarpFeather_Wind</warmupSound>
        <warmupPreEndSound>MX_Neiyu_WarpFeather_Chime</warmupPreEndSound>
        <warmupPreEndSoundSeconds>0.9</warmupPreEndSoundSeconds>

        <targetRequired>false</targetRequired>
        <hostile>false</hostile>
        <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
        <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>

        <verbProperties>
            <verbClass>MiliraXian.Characters.Neiyu.Verb_CastAbilityNeiyuWarpFeather</verbClass>
            <targetable>false</targetable>
            <range>0</range>
            <warmupTime>3</warmupTime>
            <drawAimPie>false</drawAimPie>
            <targetParams>
                <canTargetSelf>true</canTargetSelf>
                <canTargetPawns>false</canTargetPawns>
                <canTargetLocations>false</canTargetLocations>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetItems>false</canTargetItems>
            </targetParams>
        </verbProperties>

        <comps>
            <li Class="MiliraXian.Characters.Neiyu.CompProperties_AbilityNeiyuWarpFeather">
                <warmupMoteDef>MX_Mote_NeiyuWarpFeather</warmupMoteDef>
                <placementSound>MX_Neiyu_WarpFeather_Rustle</placementSound>
                <featherThingDef>Milira_Feather</featherThingDef>
                <featherCountRange>12~24</featherCountRange>
                <noPlacementMessage>【霓羽找不到一个合适的空间来生成白羽，也许需要找到一处合适的区域来释放这招】</noPlacementMessage>
            </li>
        </comps>
    </AbilityDef>

    <AbilityDef>
        <defName>MX_Neiyu_ThunderMarkedStorm</defName>
        <label>雷锁印域</label>
        <description>使用【灵能法则】的能力，经过一段时间的吟唱后，无视视野可在30格半径内选定一定范围的非同派系单位。对其增加标记。&#10;对于拥有标记的目标，将会受到雷击。雷击总量固定，标记越多则对单个目标的雷击次数越少。&#10;雷击间隔0.75~1.25秒。雷击单次会造成25点无视护甲的伤害与造成EMP效果。对于可点燃目标则会点燃目标。&#10;&#10;雷霆是大自然的伟力，也可净化邪祟。霓羽小时候最畏惧打雷，现在则对于此招格外钟爱。</description>
        <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_ThunderMarkedStorm</iconPath>

        <category>MX_NeiyuSkill</category>
        <displayOrder>120</displayOrder>
        <cooldownTicksRange>3600</cooldownTicksRange>

        <targetRequired>true</targetRequired>
        <hostile>true</hostile>
        <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>

        <verbProperties>
            <verbClass>MiliraXian.Characters.Neiyu.Verb_CastAbilityNeiyuThunderSigil</verbClass>
            <targetable>true</targetable>
            <range>30</range>
            <warmupTime>1.2</warmupTime>
            <requireLineOfSight>false</requireLineOfSight>
            <drawAimPie>false</drawAimPie>
            <targetParams>
                <canTargetSelf>false</canTargetSelf>
                <canTargetPawns>false</canTargetPawns>
                <canTargetLocations>true</canTargetLocations>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetItems>false</canTargetItems>
            </targetParams>
        </verbProperties>

        <comps>
            <li Class="MiliraXian.Characters.Neiyu.CompProperties_AbilityNeiyuThunderSigil">
                <radius>3</radius>
                <strikeBudget>72</strikeBudget>
                <warmupMote>MX_Mote_NeiyuThunderWarmup</warmupMote>
                <firstDelayTicksRange>120~180</firstDelayTicksRange>
                <strikeIntervalTicksRange>45~75</strikeIntervalTicksRange>
                <damageAmount>25</damageAmount>
                <empDamageAmount>15</empDamageAmount>
                <markerHediff>MX_Neiyu_ThunderMark</markerHediff>
            </li>
            <li Class="MiliraXian.Characters.Neiyu.Cultivation.CompProperties_AbilityNeiyuCultivationInfo" />
        </comps>
        <modExtensions><li Class="MiliraXian.Characters.Common.Abilities.AbilityRequirementExtension"><requirements><li Class="MiliraXian.Characters.Common.PerkSystem.AbilityRequirement_Perk"><perk>MX_Neiyu_Cultivation_Thunder1</perk></li></requirements></li></modExtensions>
    </AbilityDef>

    <AbilityDef>
        <defName>MX_Neiyu_Bow_ArrowBarrage</defName>
        <label>流羽裂界</label>
        <description>【必须持有弓形态】蓄力一段时间，向指定方向连续释放箭矢弹幕。箭矢的单支伤害为30点。&#10;&#10;初学弓箭的时候便十分笨拙，尝试将霁的力量注入其中后阴差阳错造成了一些失控。但是这招本身也可以作为霓羽倾斜火力的方式。她是这么说的，根本不会是她其实当时失控了根本停不住箭矢的释放。</description>
        <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_Bow_ArrowBarrage</iconPath>

        <category>MX_NeiyuSkill</category>
        <displayOrder>130</displayOrder>
        <cooldownTicksRange>7200</cooldownTicksRange>

        <targetRequired>true</targetRequired>
        <hostile>true</hostile>
        <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>

        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <targetable>true</targetable>
            <range>55</range>
            <warmupTime>5.0</warmupTime>
            <targetParams>
                <canTargetSelf>false</canTargetSelf>
                <canTargetPawns>false</canTargetPawns>
                <canTargetLocations>true</canTargetLocations>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetItems>false</canTargetItems>
            </targetParams>
        </verbProperties>

        <comps>
            <li Class="MiliraXian.Characters.Neiyu.CompProperties_AbilityNeiyuArrowBarrage">
                <requiredWeapon>MX_Neiyu_Form_Bow</requiredWeapon>
                <projectileDef>MX_Bullet_BarrageArrow</projectileDef>
