  <AbilityDef>
    <defName>MX_QH_SakuraDance</defName>
    <modExtensions>
      <li Class="MiliraXian.Characters.Common.Abilities.AbilityRequirementExtension">
        <requirements>
          <li Class="MiliraXian.Characters.QingHe.CombatStance.AbilityRequirement_Stance">
            <stance>MX_QH_Stance_Sword</stance>
          </li>
        </requirements>
      </li>
    </modExtensions>
    <label>樱舞</label>
    <description>源自遥远东国的华丽舞蹈。以旋转之势跃入空中并发动三次连续斩击，并可借机调整架势。\n\n传说记载，雨天在空中起舞，似乎容易引下雷电。“此乃神之怒号，若以此舞跃起，可令刀身承之，是曰：足不沾地、雷电奉还”。</description>
    <iconPath>MiliraXianQinghe/UI/Icons/ascend_slash</iconPath>
    <category>MX_QingheSkill</category>
    <displayOrder>230</displayOrder>
    <cooldownTicksRange>1800</cooldownTicksRange>
    <targetRequired>true</targetRequired>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <targetable>true</targetable>
      <!-- 略大于第三刀半径 4，原版施法圈套在出伤圈外面 -->
      <range>5</range>
      <warmupTime>0.5</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <drawHighlightWithLineOfSight>false</drawHighlightWithLineOfSight>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>true</canTargetLocations>
        <canTargetBuildings>true</canTargetBuildings>
        <canTargetItems>false</canTargetItems>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MiliraXian.Characters.QingHe.Abilities.SakuraDance.CompProperties_AbilitySakuraDance">
        <sweepDamage>MX_QH_SakuraDanceSweep</sweepDamage>
        <!-- 代价：瞄准（前摇）开始时消耗 1 点剑压并清空自己的架势；不足 1 点不能施放。接住敌人雷返的反击不消耗。
             前摇到樱舞结束全程无敌（伤害、架势、处决、雷返眩晕都免疫，没有例外）。 -->
        <swordPressureCost>1</swordPressureCost>
        <clearOwnPosture>true</clearOwnPosture>
        <!-- 伤口和战斗日志里的招式名：普通三刀为樱舞，接雷之后的刀为雷返 -->
        <cutDamageDef>MX_QH_SakuraDanceSlash</cutDamageDef>
        <thunderCutDamageDef>MX_QH_SakuraThunderSlash</thunderCutDamageDef>
        <!-- 动作曲线用单调三次插值：关键帧是姿势，之间缓入缓出、不过冲。
             高度单位米（负数是下蹲），转身单位度（朝东时顺时针）。
             转身不是每刀转一圈：第一刀约转 210°，
             第一、二刀之间约 130°，第二刀约 130°，第二、三刀之间约 270°（空中借旋转蓄势），第三刀只转约 45°。
             第三刀和前摇起点都正对目标。 -->
        <!-- 瞄准前摇、地面/空中动作都是 JSON-backed 的 clip def（见 MiscDefs/MiliraXian_Qinghe_BladeMotionClips.xml，
             注释写在 def 上），游戏内可用 debug 动作 "Reload JSON assets" 热重载。
             动作曲线用单调三次插值：关键帧是姿势，之间缓入缓出、不过冲。
             高度单位米（负数是下蹲），转身单位度（朝东时顺时针）。
             转身不是每刀转一圈：第一刀约转 210°，
             第一、二刀之间约 130°，第二刀约 130°，第二、三刀之间约 270°（空中借旋转蓄势），第三刀只转约 45°。
             第三刀和前摇起点都正对目标。 -->
        <!-- 瞄准前摇（原版施法预热：旋身下蹲、把刀横架到脑后），结束姿势就是樱舞动作的第一帧 -->
        <warmup>MX_QH_SakuraClip_Warmup</warmup>
        <!-- 地面施放：蹲身蓄力，第一刀贴地撩起并起跳，第二刀在上升中，第三刀再蓄一次力飞到最高 -->
        <groundMotion>MX_QH_SakuraClip_Ground</groundMotion>
        <!-- 空中施放：保持飞行高度出前两刀，向下一沉蓄力，第三刀飞得更高，最后回到飞行高度、不结束飞行 -->
        <airMotion>MX_QH_SakuraClip_Air</airMotion>
        <!--
          投影和散华的十字斩一致：高度压到 0.35，动作原点（骨骼的骨盆）放到小人中心下 0.2 米的腰部，
          握着的刀南北方向缩到 0.55（刀环不缩，刀环在地上的范围就是出伤范围）。
          刀环中心比原点（腰部）高 ringHeightOffset 米。
        -->
        <heightToScreen>0.35</heightToScreen>
        <heightOrigin>-0.2</heightOrigin>
        <depthToScreen>0.55</depthToScreen>
        <ringHeightOffset>0.3</ringHeightOffset>
        <petalKeepFraction>0.3</petalKeepFraction>
        <petalSpeedScale>0.25</petalSpeedScale>
        <petalSpreadDegrees>12</petalSpreadDegrees>
        <!-- 花瓣大小 0.063 × 1.5 × 3.5，颜色 = 贴图 × 樱粉 (1, 0.8, 0.86) × 1.25 -->
        <petalTexPath>MiliraXianQinghe/Effect/SakuraDance/SakuraPetals</petalTexPath>
        <petalSize>0.33</petalSize>
        <!-- 顶点色是 8 位，各通道不能超过 1；亮度在着色器里乘 -->
        <petalColor>(1, 0.8, 0.86, 1)</petalColor>
        <petalBrightness>1.25</petalBrightness>
        <!-- 扭曲强度 1 对应的最大折射偏移（米），预览 K_DIST = 0.04 -->
        <distortionMetresPerUnit>0.04</distortionMetresPerUnit>
        <shadeOpacity>0</shadeOpacity>
        <bloom>
          <group>MX_ScreenBloom_Glow</group>
          <tint>(1, 0.95, 0.97, 1)</tint>
          <intensity>1</intensity>
        </bloom>
        <cutSound>MX_QH_AscentSlash_Slash</cutSound>
        <!-- 雷返（雨天、头顶无屋顶）：外层用漏电异常的颜色，中心白色。
             亮度大于 1 进泛光；顶点色各通道不能超过 1。 -->
        <thunderSweepDamage>MX_QH_SakuraThunderSweep</thunderSweepDamage>
        <!-- 接雷条件（头顶都必须没有屋顶，施放时判一次）：
             ① 降雨量达到 thunderMinRainRate。原版下雨、下雪天气都是 1，换天气时在 4000 tick（约 1.1 游戏小时）内渐变，1 = 天气完全转变后才算；
             ② 天气带闪电事件（原版雷雨、旱雷暴，模组天气同理）且已完全转变，不下雨也算；
             ③ 其他露天天气按 thunderClearSkyChance 的概率遭遇旱天雷。 -->
        <thunderMinRainRate>1</thunderMinRainRate>
        <thunderInStorms>true</thunderInStorms>
        <thunderClearSkyChance>0.1</thunderClearSkyChance>
        <thunderCatchSound>Thunder_OnMap</thunderCatchSound>
        <thunderReleaseSound>Thunder_OnMap</thunderReleaseSound>
        <!-- 闪电泛光和樱花刀光同一组（MX_ScreenBloom_Glow），只用 tint / intensity 区分颜色和亮度 -->
        <thunderBloom>
          <group>MX_ScreenBloom_Glow</group>
          <tint>(1, 0.9, 0.6, 1)</tint>
          <intensity>1.5</intensity>
        </thunderBloom>
        <thunderColor>(1, 0.86, 0.28, 1)</thunderColor>
        <thunderCoreColor>(1, 0.97, 0.88, 1)</thunderCoreColor>
        <thunderBrightness>3</thunderBrightness>
        <!-- 闪电 = 细的近白芯（带泛光）+ 宽 4 倍的淡黄光晕；天空闪光与落雷同长 -->
        <thunderCoreBrightness>1.6</thunderCoreBrightness>
        <thunderHaloWidth>4</thunderHaloWidth>
        <thunderHaloBrightness>0.35</thunderHaloBrightness>
        <thunderBoltSeconds>0.25</thunderBoltSeconds>
        <thunderBoltWidth>0.18</thunderBoltWidth>
        <thunderGlowSize>1.4</thunderGlowSize>
        <thunderGlowBrightness>0.8</thunderGlowBrightness>
        <thunderSparkInterval>0.05</thunderSparkInterval>
        <thunderSparksPerBurst>3</thunderSparksPerBurst>
        <thunderSparkSize>0.35</thunderSparkSize>
        <thunderSparkAfterRelease>0.5</thunderSparkAfterRelease>
        <cuts>
          <!-- 第一刀：倾斜最大，从左侧最低处贴地撩起，经身前斩向右上 -->
          <li>
            <time>0.033</time>
            <offset>(0, 0, 0.2)</offset>
            <tiltX>22.5</tiltX>
            <tiltZ>45</tiltZ>
            <startAngle>180</startAngle>
            <angularSpeed>1800</angularSpeed>
            <spinSeconds>0.1667</spinSeconds>
            <radius>2.5</radius>
            <damage>40</damage>
            <armorPenetration>0.5</armorPenetration>
            <!-- 每次命中给敌人的架势；带雷时再加 -->
            <posture>5</posture>
            <thunderPosture>5</thunderPosture>
            <petalStartAngle>157.5</petalStartAngle>
            <petalRadius>2.75</petalRadius>
            <layers>
              <!-- 扭曲带：遮罩取 alpha，强度 5 → 0.4 -->
              <li>
                <texPath>MiliraXianQinghe/Effect/SakuraDance/SakuraBand</texPath>
                <normalTexPath>MiliraXianQinghe/Effect/SakuraDance/SakuraNormal</normalTexPath>
                <distortion>true</distortion>
                <liveFade>true</liveFade>
                <radialOffset>-0.345</radialOffset>
                <width>0.9</width>
                <segmentDuration>2</segmentDuration>
                <startFade>40</startFade>
                <endFade>40</endFade>
                <alphaCurve><points><li>(0, 1)</li><li>(0.375, 0.844)</li><li>(0.75, 0.5)</li><li>(1.125, 0.156)</li><li>(1.5, 0)</li></points></alphaCurve>
                <shadeDarkness>1</shadeDarkness>
                <textureFraction>0.01</textureFraction>
                <attachedUV>true</attachedUV>
                <flipV>true</flipV>
                <speedUCurve><points><li>(0, 8)</li><li>(0.183, 6.77)</li><li>(0.367, 4.05)</li><li>(0.55, 1.33)</li><li>(0.733, 0.1)</li></points></speedUCurve>
                <distortionIntensityCurve><points><li>(0, 5)</li><li>(1.5, 0.4)</li></points></distortionIntensityCurve>
              </li>
              <!-- 暗带：扭曲带的黑色本体，不透明度乘 0.22。 -->
              <li>
                <texPath>MiliraXianQinghe/Effect/SakuraDance/SakuraBand</texPath>
                <color>(0, 0, 0, 1)</color>
                <liveFade>true</liveFade>
                <clampAlpha>true</clampAlpha>
                <radialOffset>-0.345</radialOffset>
                <width>0.9</width>
                <segmentDuration>2</segmentDuration>
                <startFade>40</startFade>
                <endFade>40</endFade>
                <alphaCurve><points><li>(0, 0.22)</li><li>(0.375, 0.186)</li><li>(0.75, 0.11)</li><li>(1.125, 0.034)</li><li>(1.5, 0)</li></points></alphaCurve>
                <textureFraction>0.01</textureFraction>
                <attachedUV>true</attachedUV>
                <flipV>true</flipV>
              </li>
              <!-- 灰带 GRAY_BAND：颜色 0.835 × (2 → 1)，透明度 (1 → 0) × (1 → 0) -->
              <li>
                <texPath>MiliraXianQinghe/Effect/SakuraDance/SakuraBand</texPath>
                <liveFade>true</liveFade>
                <clampAlpha>true</clampAlpha>
                <radialOffset>-0.05</radialOffset>
                <width>0.45</width>
                <segmentDuration>1.333</segmentDuration>
                <startFade>25</startFade>
                <endFade>75</endFade>
                <alphaCurve><points><li>(0, 1)</li><li>(0.25, 0.5625)</li><li>(0.5, 0.25)</li><li>(0.75, 0.0625)</li><li>(1, 0)</li></points></alphaCurve>
                <brightnessCurve><points><li>(0, 1.67)</li><li>(1, 0.835)</li></points></brightnessCurve>
                <textureFraction>0.01</textureFraction>
              </li>
              <!-- 亮丝 strands([2, 1.667, 1.333, 1])：透明度 = (1 → 0，0.75d 内) × 0.5 × (6, 3, 3 → 0)；亮度 4, 4 → 1 -->
              <li>
                <texPath>MiliraXianQinghe/Effect/SakuraDance/SakuraFilament</texPath>
                <additive>true</additive>
                <bloom>true</bloom>
                <liveFade>true</liveFade>
                <clampAlpha>true</clampAlpha>
                <radialOffset>0.39</radialOffset>
                <widthCurve><points><li>(0, 0.45)</li><li>(0.033, 0.423)</li><li>(0.067, 0.23)</li><li>(0.1, 0.037)</li><li>(0.133, 0.01)</li></points></widthCurve>
                <segmentDuration>2</segmentDuration>
                <startFadeCurve><points><li>(0, 0)</li><li>(0.375, 15.6)</li><li>(0.75, 50)</li><li>(1.125, 84.4)</li><li>(1.5, 100)</li></points></startFadeCurve>
                <endFadeCurve><points><li>(0, 100)</li><li>(0.375, 84.4)</li><li>(0.75, 50)</li><li>(1.125, 15.6)</li><li>(1.5, 0)</li></points></endFadeCurve>
                <alphaCurve><points><li>(0, 3)</li><li>(0.1, 2.1)</li><li>(0.2, 1.3)</li><li>(0.5, 1)</li><li>(0.75, 0.5625)</li><li>(1, 0.25)</li><li>(1.25, 0.0625)</li><li>(1.5, 0)</li></points></alphaCurve>
                <brightnessCurve><points><li>(0, 4)</li><li>(0.5, 4)</li><li>(1.5, 1)</li></points></brightnessCurve>
                <textureFraction>0.1</textureFraction>
                <speedU>0.02</speedU>
              </li>
              <li>
                <texPath>MiliraXianQinghe/Effect/SakuraDance/SakuraFilament</texPath>
                <additive>true</additive>
                <bloom>true</bloom>
                <liveFade>true</liveFade>
                <clampAlpha>true</clampAlpha>
                <radialOffset>0.39</radialOffset>
                <widthCurve><points><li>(0, 0.45)</li><li>(0.033, 0.423)</li><li>(0.067, 0.23)</li><li>(0.1, 0.037)</li><li>(0.133, 0.01)</li></points></widthCurve>
                <segmentDuration>1.667</segmentDuration>
                <startFadeCurve><points><li>(0, 0)</li><li>(0.3125, 15.6)</li><li>(0.625, 50)</li><li>(0.9375, 84.4)</li><li>(1.25, 100)</li></points></startFadeCurve>
                <endFadeCurve><points><li>(0, 100)</li><li>(0.3125, 84.4)</li><li>(0.625, 50)</li><li>(0.9375, 15.6)</li><li>(1.25, 0)</li></points></endFadeCurve>
                <alphaCurve><points><li>(0, 3)</li><li>(0.1, 2.07)</li><li>(0.2, 1.26)</li><li>(0.5, 0.9)</li><li>(0.625, 0.625)</li><li>(0.75, 0.4)</li><li>(1, 0.1)</li><li>(1.25, 0)</li></points></alphaCurve>
                <brightnessCurve><points><li>(0, 4)</li><li>(0.5, 4)</li><li>(1.25, 1)</li></points></brightnessCurve>
                <textureFraction>0.1</textureFraction>
                <speedU>0.02</speedU>
              </li>
              <li>
                <texPath>MiliraXianQinghe/Effect/SakuraDance/SakuraFilament</texPath>
                <additive>true</additive>
                <bloom>true</bloom>
                <liveFade>true</liveFade>
                <clampAlpha>true</clampAlpha>
                <radialOffset>0.39</radialOffset>
                <widthCurve><points><li>(0, 0.45)</li><li>(0.033, 0.423)</li><li>(0.067, 0.23)</li><li>(0.1, 0.037)</li><li>(0.133, 0.01)</li></points></widthCurve>
                <segmentDuration>1.333</segmentDuration>
                <startFadeCurve><points><li>(0, 0)</li><li>(0.25, 15.6)</li><li>(0.5, 50)</li><li>(0.75, 84.4)</li><li>(1, 100)</li></points></startFadeCurve>
                <endFadeCurve><points><li>(0, 100)</li><li>(0.25, 84.4)</li><li>(0.5, 50)</li><li>(0.75, 15.6)</li><li>(1, 0)</li></points></endFadeCurve>
                <alphaCurve><points><li>(0, 3)</li><li>(0.1, 2.025)</li><li>(0.2, 1.2)</li><li>(0.5, 0.75)</li><li>(0.625, 0.42)</li><li>(0.75, 0.1875)</li><li>(0.875, 0.047)</li><li>(1, 0)</li></points></alphaCurve>
                <brightnessCurve><points><li>(0, 4)</li><li>(0.5, 4)</li><li>(1, 1)</li></points></brightnessCurve>
                <textureFraction>0.1</textureFraction>
                <speedU>0.02</speedU>
              </li>
              <li>
                <texPath>MiliraXianQinghe/Effect/SakuraDance/SakuraFilament</texPath>
                <additive>true</additive>
                <bloom>true</bloom>
                <liveFade>true</liveFade>
                <clampAlpha>true</clampAlpha>
                <radialOffset>0.39</radialOffset>
                <widthCurve><points><li>(0, 0.45)</li><li>(0.033, 0.423)</li><li>(0.067, 0.23)</li><li>(0.1, 0.037)</li><li>(0.133, 0.01)</li></points></widthCurve>
                <segmentDuration>1</segmentDuration>
                <startFadeCurve><points><li>(0, 0)</li><li>(0.1875, 15.6)</li><li>(0.375, 50)</li><li>(0.5625, 84.4)</li><li>(0.75, 100)</li></points></startFadeCurve>
                <endFadeCurve><points><li>(0, 100)</li><li>(0.1875, 84.4)</li><li>(0.375, 50)</li><li>(0.5625, 15.6)</li><li>(0.75, 0)</li></points></endFadeCurve>
                <alphaCurve><points><li>(0, 3)</li><li>(0.1, 1.95)</li><li>(0.2, 1.1)</li><li>(0.5, 0.5)</li><li>(0.625, 0.125)</li><li>(0.75, 0)</li></points></alphaCurve>
                <brightnessCurve><points><li>(0, 4)</li><li>(0.5, 4)</li><li>(0.75, 1)</li></points></brightnessCurve>
                <textureFraction>0.1</textureFraction>
                <speedU>0.02</speedU>
              </li>
            </layers>
            <petals>
              <li><lifetime>0.5</lifetime><spacing>0.112</spacing><speed>15.6</speed><turnDegrees>5.6</turnDegrees></li>
              <li><lifetime>0.767</lifetime><spacing>0.225</spacing><speed>15.6</speed><turnDegrees>22.5</turnDegrees></li>
              <li><lifetime>1.0</lifetime><spacing>0.45</spacing><speed>15.6</speed><turnDegrees>45</turnDegrees></li>
              <li><lifetime>0.267</lifetime><spacing>0.45</spacing><speed>46.9</speed><turnDegrees>5.6</turnDegrees></li>
            </petals>
            <!-- 雷返（第一刀前接雷时）：三刀都带雷，伤害逐刀增加。第一刀放电最短最细，刀光上叠闪电色光带，外圈一道细电弧。 -->
            <thunderDamageFactor>1.2</thunderDamageFactor>
            <thunderDischarge>
              <duration>0.14</duration>
              <falloff>1.5</falloff>
              <interval>0.05</interval>
              <perBurst>1</perBurst>
              <length>0.5~1</length>
              <width>0.03</width>
              <life>0.08</life>
              <spreadDegrees>60</spreadDegrees>
              <outward>0.4</outward>
              <branches>0</branches>
              <jitter>0.3</jitter>
            </thunderDischarge>
            <thunderLayers>
              <!-- 闪电色光带：带雷时叠在刀光上 -->
              <li>
                <texPath>MiliraXianQinghe/Effect/SakuraDance/Veil</texPath>
                <additive>true</additive>
                <bloom>true</bloom>
                <color>(1, 0.86, 0.35, 1)</color>
                <radialOffset>0.3</radialOffset>
                <width>0.55</width>
                <tailWidth>0.45</tailWidth>
                <tailAlpha>0.45</tailAlpha>
                <segmentDuration>0.35</segmentDuration>
                <startFade>15</startFade>
                <endFade>60</endFade>
                <alpha>0.8</alpha>
                <brightness>1.4</brightness>
                <textureFraction>0.01</textureFraction>
