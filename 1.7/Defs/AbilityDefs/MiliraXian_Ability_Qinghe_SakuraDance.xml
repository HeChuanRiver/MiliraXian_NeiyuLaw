                <segmentDuration>1.333</segmentDuration>
                <startFade>10</startFade>
                <endFade>90</endFade>
                <alphaCurve><points><li>(0, 3)</li><li>(0.1, 2.1)</li><li>(0.167, 1.42)</li><li>(0.5, 1.01)</li><li>(1, 0.41)</li><li>(1.333, 0)</li></points></alphaCurve>
                <brightnessCurve><points><li>(0, 1000)</li><li>(0.333, 20)</li><li>(1.333, 0)</li></points></brightnessCurve>
                <textureFraction>0.1</textureFraction>
                <speedUCurve><points><li>(0, 0.2)</li><li>(0.333, 0.184)</li><li>(0.667, 0.15)</li><li>(1, 0.116)</li><li>(1.333, 0.1)</li></points></speedUCurve>
              </li>
            </layers>
            <petals>
              <li><lifetime>1.0</lifetime><spacing>0.112</spacing><speed>15.6</speed><turnDegrees>5.6</turnDegrees></li>
              <li><lifetime>1.5</lifetime><spacing>0.225</spacing><speed>15.6</speed><turnDegrees>22.5</turnDegrees></li>
              <li><lifetime>2.0</lifetime><spacing>0.45</spacing><speed>15.6</speed><turnDegrees>45</turnDegrees></li>
              <li><lifetime>0.5</lifetime><spacing>0.45</spacing><speed>46.9</speed><turnDegrees>5.6</turnDegrees></li>
            </petals>
            <!-- 雷电奉还：带雷时伤害最高（×1.6），并且只有这一刀眩晕（MX_QH_SakuraThunderSweep）。
                 范围保持原样；带雷时刀光上叠闪电色光带、外圈加电弧。刀身从发力起向外放出长电弧（对应 440683），
                 出刀一刻最猛烈，之后逐渐变少变短，在刀光转完前停止。 -->
            <thunderRelease>true</thunderRelease>
            <thunderDamageFactor>1.6</thunderDamageFactor>
            <thunderDischarge>
              <delay>0</delay>
              <duration>0.15</duration>
              <falloff>1.5</falloff>
              <interval>0.017</interval>
              <perBurst>3</perBurst>
              <length>2~4.5</length>
              <width>0.06</width>
              <life>0.12</life>
              <spreadDegrees>40</spreadDegrees>
              <outward>0.7</outward>
              <branches>2</branches>
              <jitter>0.3</jitter>
            </thunderDischarge>
            <thunderLayers>
              <!-- 闪电色光带：带雷时叠在刀光上 -->
              <li>
                <texPath>MiliraXianQinghe/Effect/SakuraDance/Veil</texPath>
                <additive>true</additive>
                <bloom>true</bloom>
                <color>(1, 0.86, 0.35, 1)</color>
                <radialOffset>0.2</radialOffset>
                <width>0.9</width>
                <tailWidth>0.45</tailWidth>
                <tailAlpha>0.45</tailAlpha>
                <segmentDuration>0.5</segmentDuration>
