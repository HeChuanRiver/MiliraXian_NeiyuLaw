<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <MiliraXian.Characters.Common.SweepDamage.SweepDamageDef>
    <defName>MX_QH_SakuraDanceSweep</defName>
    <damageDef>MX_QH_SlashSkill</damageDef>
    <targetFaction>Hostile</targetFaction>
    <hitPawns>true</hitPawns>
    <hitBuildings>true</hitBuildings>
    <requireLineOfSight>true</requireLineOfSight>
    <skipDowned>true</skipDowned>
    <damageDelayTicks>0</damageDelayTicks>
  </MiliraXian.Characters.Common.SweepDamage.SweepDamageDef>

  <!-- 雷返：带雷时第三刀改用这个出伤定义，命中后眩晕 -->
  <MiliraXian.Characters.Common.SweepDamage.SweepDamageDef>
    <defName>MX_QH_SakuraThunderSweep</defName>
    <damageDef>MX_QH_SlashSkill</damageDef>
    <targetFaction>Hostile</targetFaction>
    <hitPawns>true</hitPawns>
    <hitBuildings>true</hitBuildings>
    <requireLineOfSight>true</requireLineOfSight>
    <skipDowned>true</skipDowned>
    <damageDelayTicks>0</damageDelayTicks>
    <workerClass>MiliraXian.Characters.QingHe.Abilities.SakuraDance.SakuraThunderSweepWorker</workerClass>
    <modExtensions>
      <li Class="MiliraXian.Characters.QingHe.Abilities.SakuraDance.SakuraThunderSweepExtension">
        <stunTicks>150</stunTicks>
      </li>
    </modExtensions>
  </MiliraXian.Characters.Common.SweepDamage.SweepDamageDef>

  <AbilityDef>
    <defName>MX_QH_SakuraDance</defName>
    <modExtensions>
      <li Class="MiliraXian.Characters.Common.Abilities.AbilityRequirementExtension">
        <requirements>
          <li Class="MiliraXian.Characters.QingHe.CombatStance.AbilityRequirement_Stance">
            <stance>MX_QH_Stance_Sword</stance>
          </li>
        </requirements>
      </li>
    </modExtensions>
    <label>樱舞</label>
    <description>源自遥远东国的华丽舞蹈。以旋转之势跃入空中并发动三次连续斩击，并可借机调整架势。\n\n传说记载，雨天在空中起舞，似乎容易引下雷电。“此乃神之怒号，若以此舞跃起，可令刀身承之，是曰：足不沾地、雷电奉还”。</description>
    <iconPath>MiliraXianQinghe/UI/Icons/ascend_slash</iconPath>
    <category>MX_QH_Category_QingheSkill</category>
    <displayOrder>230</displayOrder>
    <cooldownTicksRange>1800</cooldownTicksRange>
    <targetRequired>true</targetRequired>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <targetable>true</targetable>
      <!-- 略大于第三刀半径 4，原版施法圈套在出伤圈外面 -->
      <range>5</range>
      <warmupTime>0.5</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <drawHighlightWithLineOfSight>false</drawHighlightWithLineOfSight>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>true</canTargetLocations>
        <canTargetBuildings>true</canTargetBuildings>
        <canTargetItems>false</canTargetItems>
      </targetParams>
    </verbProperties>
    <comps>
      <!-- 剑压代价：够 1 层才能施放，本 comp 不扣——瞄准（前摇）开始时由 SakuraDanceCastCost 扣掉并清空自己的架势。
           接住敌人雷返的反击不消耗；前摇到樱舞结束全程无敌（伤害、架势、处决、雷返眩晕都免疫，没有例外）。 -->
      <li Class="MiliraXian.Characters.Common.CompProperties_CastResource">
        <requirements>
          <li>
            <resourceDef>MX_QH_SwordPressure</resourceDef>
            <minAmount>1</minAmount>
          </li>
        </requirements>
        <onCast>
          <li>
            <resourceDef>MX_QH_SwordPressure</resourceDef>
            <amount>0</amount>
          </li>
        </onCast>
      </li>
      <li Class="MiliraXian.Characters.QingHe.Abilities.SakuraDance.CompProperties_AbilitySakuraDance">
        <sweepDamage>MX_QH_SakuraDanceSweep</sweepDamage>
        <clearOwnPosture>true</clearOwnPosture>
        <!-- 伤口和战斗日志里的招式名：普通三刀为樱舞，接雷之后的刀为雷返 -->
        <cutDamageDef>MX_QH_SakuraDanceSlash</cutDamageDef>
        <thunderCutDamageDef>MX_QH_SakuraThunderSlash</thunderCutDamageDef>
        <!-- 动作曲线用单调三次插值：关键帧是姿势，之间缓入缓出、不过冲。
             高度单位米（负数是下蹲），转身单位度（朝东时顺时针）。
             转身不是每刀转一圈：第一刀约转 210°，
             第一、二刀之间约 130°，第二刀约 130°，第二、三刀之间约 270°（空中借旋转蓄势），第三刀只转约 45°。
             第三刀和前摇起点都正对目标。 -->
        <!-- 瞄准前摇、地面/空中动作都是 JSON-backed 的 clip def（见 MiscDefs/MiliraXian_Qinghe_BladeMotionClips.xml，
             注释写在 def 上），游戏内可用 debug 动作 "Reload JSON assets" 热重载。
             动作曲线用单调三次插值：关键帧是姿势，之间缓入缓出、不过冲。
             高度单位米（负数是下蹲），转身单位度（朝东时顺时针）。
             转身不是每刀转一圈：第一刀约转 210°，
             第一、二刀之间约 130°，第二刀约 130°，第二、三刀之间约 270°（空中借旋转蓄势），第三刀只转约 45°。
             第三刀和前摇起点都正对目标。 -->
        <!-- 瞄准前摇（原版施法预热：旋身下蹲、把刀横架到脑后），结束姿势就是樱舞动作的第一帧 -->
        <warmup>MX_QH_SakuraClip_Warmup</warmup>
        <!-- 地面施放：蹲身蓄力，第一刀贴地撩起并起跳，第二刀在上升中，第三刀再蓄一次力飞到最高 -->
        <groundMotion>MX_QH_SakuraClip_Ground</groundMotion>
        <!-- 空中施放：保持飞行高度出前两刀，向下一沉蓄力，第三刀飞得更高，最后回到飞行高度、不结束飞行 -->
        <airMotion>MX_QH_SakuraClip_Air</airMotion>
        <!--
          投影和散华的十字斩一致：高度压到 0.35，动作原点（骨骼的骨盆）放到小人中心下 0.2 米的腰部，
          握着的刀南北方向缩到 0.55（刀环不缩，刀环在地上的范围就是出伤范围）。
          刀环中心比原点（腰部）高 ringHeightOffset 米。
        -->
        <heightToScreen>0.35</heightToScreen>
        <heightOrigin>-0.2</heightOrigin>
        <depthToScreen>0.55</depthToScreen>
        <ringHeightOffset>0.3</ringHeightOffset>
        <petalKeepFraction>0.3</petalKeepFraction>
        <petalSpeedScale>0.25</petalSpeedScale>
        <petalSpreadDegrees>12</petalSpreadDegrees>
        <!-- 花瓣大小 0.063 × 1.5 × 3.5，颜色 = 贴图 × 樱粉 (1, 0.8, 0.86) × 1.25 -->
        <petalTexPath>MiliraXianQinghe/Effect/SakuraDance/SakuraPetals</petalTexPath>
        <petalSize>0.33</petalSize>
        <!-- 顶点色是 8 位，各通道不能超过 1；亮度在着色器里乘 -->
        <petalColor>(1, 0.8, 0.86, 1)</petalColor>
        <petalBrightness>1.25</petalBrightness>
        <!-- 扭曲强度 1 对应的最大折射偏移（米），预览 K_DIST = 0.04 -->
        <distortionMetresPerUnit>0.04</distortionMetresPerUnit>
        <shadeOpacity>0</shadeOpacity>
        <bloom>
          <group>MX_ScreenBloom_Glow</group>
          <tint>(1, 0.95, 0.97, 1)</tint>
          <intensity>1</intensity>
        </bloom>
        <cutSound>MX_QH_AscentSlash_Slash</cutSound>
        <!-- 雷返（雨天、头顶无屋顶）：外层用漏电异常的颜色，中心白色。
             亮度大于 1 进泛光；顶点色各通道不能超过 1。 -->
        <thunderSweepDamage>MX_QH_SakuraThunderSweep</thunderSweepDamage>
        <!-- 接雷条件（头顶都必须没有屋顶，施放时判一次）：
             ① 降雨量达到 thunderMinRainRate。原版下雨、下雪天气都是 1，换天气时在 4000 tick（约 1.1 游戏小时）内渐变，1 = 天气完全转变后才算；
             ② 天气带闪电事件（原版雷雨、旱雷暴，模组天气同理）且已完全转变，不下雨也算；
             ③ 其他露天天气按 thunderClearSkyChance 的概率遭遇旱天雷。 -->
        <thunderMinRainRate>1</thunderMinRainRate>
        <thunderInStorms>true</thunderInStorms>
        <thunderClearSkyChance>0.1</thunderClearSkyChance>
        <thunderCatchSound>Thunder_OnMap</thunderCatchSound>
        <thunderReleaseSound>Thunder_OnMap</thunderReleaseSound>
        <!-- 闪电泛光和樱花刀光同一组（MX_ScreenBloom_Glow），只用 tint / intensity 区分颜色和亮度 -->
        <thunderBloom>
          <group>MX_ScreenBloom_Glow</group>
          <tint>(1, 0.9, 0.6, 1)</tint>
          <intensity>1.5</intensity>
        </thunderBloom>
        <thunderColor>(1, 0.86, 0.28, 1)</thunderColor>
        <thunderCoreColor>(1, 0.97, 0.88, 1)</thunderCoreColor>
        <thunderBrightness>3</thunderBrightness>
        <!-- 闪电 = 细的近白芯（带泛光）+ 宽 4 倍的淡黄光晕；天空闪光与落雷同长 -->
        <thunderCoreBrightness>1.6</thunderCoreBrightness>
        <thunderHaloWidth>4</thunderHaloWidth>
        <thunderHaloBrightness>0.35</thunderHaloBrightness>
        <thunderBoltSeconds>0.25</thunderBoltSeconds>
        <thunderBoltWidth>0.18</thunderBoltWidth>
        <thunderGlowSize>1.4</thunderGlowSize>
        <thunderGlowBrightness>0.8</thunderGlowBrightness>
        <thunderSparkInterval>0.05</thunderSparkInterval>
        <thunderSparksPerBurst>3</thunderSparksPerBurst>
        <thunderSparkSize>0.35</thunderSparkSize>
        <thunderSparkAfterRelease>0.5</thunderSparkAfterRelease>
        <!-- 三刀的刀光/花瓣/雷返参数是纯美术数据，在 1.7/Assets/QingHe/Clips/BladeMotion/MX_QH_SakuraDanceCuts.json，
             游戏内可用 debug 动作 "Reload JSON assets" 热重载。
             三刀：第一刀倾斜最大、从左侧最低处贴地撩起经身前斩向右上；第二刀稍平紧接第一刀；第三刀最平最大、在最高处、
             带雷时伤害最高且只有它眩晕（thunderRelease）。第三刀带起跳气旋 updraft。 -->
        <cutsDataPath>1.7/Assets/QingHe/Clips/BladeMotion/MX_QH_SakuraDanceCuts.json</cutsDataPath>
      </li>
    </comps>
  </AbilityDef>
</Defs>
