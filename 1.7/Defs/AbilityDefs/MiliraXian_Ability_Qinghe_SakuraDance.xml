                <speedUCurve><points><li>(0, 8.4)</li><li>(0.333, 7.11)</li><li>(0.667, 4.25)</li><li>(1, 1.4)</li><li>(1.333, 0.1)</li></points></speedUCurve>
              </li>
              <!-- 外圈芯线（加法）：透明度 (1, 1 → 0) × (3 → 1.5)，亮度 2 × color3 (500 → 10 → 0) -->
              <li>
                <texPath>MiliraXianQinghe/Effect/SakuraDance/SakuraFilament</texPath>
                <additive>true</additive>
                <bloom>true</bloom>
