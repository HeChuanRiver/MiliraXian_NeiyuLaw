                <endFade>60</endFade>
                <alpha>0.8</alpha>
                <brightness>1.4</brightness>
                <textureFraction>0.01</textureFraction>
              </li>
              <!-- 外圈电弧（对应 440683 的电丝 Tracer）：贴着刀光外缘稍靠里，
                   三道宽度、位置、寿命、换帧速度各不相同，互相错开显得有变化 -->
              <li>
                <texPath>MiliraXianQinghe/Effect/SakuraDance/Arc</texPath>
                <additive>true</additive>
                <bloom>true</bloom>
                <color>(1, 0.9, 0.55, 1)</color>
                <frames>16</frames>
                <frameRate>30</frameRate>
                <radialOffset>0.15</radialOffset>
                <width>0.4</width>
                <tailWidth>0.5</tailWidth>
                <headBoost>1.5</headBoost>
                <headLength>0.2</headLength>
                <widthNoise>0.2</widthNoise>
                <segmentDuration>0.6</segmentDuration>
                <startFade>10</startFade>
                <endFade>40</endFade>
                <alphaCurve><points><li>(0, 1.8)</li><li>(0.3, 1.3)</li><li>(0.8, 0)</li></points></alphaCurve>
                <brightnessCurve><points><li>(0, 3)</li><li>(0.8, 1.5)</li></points></brightnessCurve>
                <textureFraction>6</textureFraction>
                <attachedUV>true</attachedUV>
              </li>
              <li>
                <texPath>MiliraXianQinghe/Effect/SakuraDance/Arc</texPath>
                <additive>true</additive>
                <bloom>true</bloom>
                <color>(1, 0.88, 0.5, 1)</color>
                <frames>16</frames>
                <frameRate>22</frameRate>
                <radialOffset>-0.25</radialOffset>
                <width>0.3</width>
                <tailWidth>0.6</tailWidth>
                <headBoost>1</headBoost>
                <headLength>0.2</headLength>
                <widthNoise>0.3</widthNoise>
                <alphaNoise>0.3</alphaNoise>
                <segmentDuration>0.5</segmentDuration>
                <startFade>15</startFade>
                <endFade>45</endFade>
                <alphaCurve><points><li>(0, 1.5)</li><li>(0.25, 1.1)</li><li>(0.7, 0)</li></points></alphaCurve>
                <brightnessCurve><points><li>(0, 2.5)</li><li>(0.7, 1.2)</li></points></brightnessCurve>
                <textureFraction>4.5</textureFraction>
                <attachedUV>true</attachedUV>
              </li>
              <li>
                <texPath>MiliraXianQinghe/Effect/SakuraDance/Arc</texPath>
                <additive>true</additive>
                <color>(1, 0.98, 0.92, 1)</color>
                <frames>16</frames>
                <frameRate>30</frameRate>
                <radialOffset>0.15</radialOffset>
                <width>0.12</width>
                <segmentDuration>0.5</segmentDuration>
                <startFade>10</startFade>
                <endFade>40</endFade>
                <alphaCurve><points><li>(0, 1.8)</li><li>(0.7, 0)</li></points></alphaCurve>
                <brightness>2</brightness>
                <textureFraction>6</textureFraction>
                <attachedUV>true</attachedUV>
              </li>
            </thunderLayers>
            <!-- 起跳气旋：第二刀转完、第三刀起跳下蹲时（出刀前 0.35 秒）从角色脚下的地面生成（不论人此时有多高），原地不跟人走。
                 两股气流每秒转 900°，转心 0.6 秒内从地面竖直升 2.6 米（和人的起跳方向一致，不再往前斜），
                 拖尾放出 0.5 秒、每段留 0.6–0.9 秒，大约在人跳到最高点时散开。
                 脚下一圈烟尘 0.7 秒内从 0.4 米扩到 1.4 米，竖向压扁一半，和 heightToScreen 一致。 -->
            <updraft>
              <delay>-0.35</delay>
              <startOffset>(0, -0.6, 0)</startOffset>
              <endOffset>(0, 2, 0)</endOffset>
              <riseSeconds>0.6</riseSeconds>
              <angularSpeed>900</angularSpeed>
              <spiralRadius>0.6</spiralRadius>
              <strands>2</strands>
              <emitSeconds>0.5</emitSeconds>
              <layers>
                <li>
                  <texPath>MiliraXianQinghe/Effect/SakuraDance/Veil</texPath>
                  <distortion>true</distortion>
                  <width>0.313</width>
                  <segmentDuration>0.9</segmentDuration>
                  <startFade>75</startFade>
                  <endFade>25</endFade>
                  <alphaCurve><points><li>(0, 0)</li><li>(0.05, 1)</li><li>(0.6, 0.8)</li><li>(1.2, 0)</li></points></alphaCurve>
                  <shadeDarkness>1</shadeDarkness>
                  <textureFraction>0.075</textureFraction>
                  <speedUCurve><points><li>(0, 4)</li><li>(0.6, 0.1)</li></points></speedUCurve>
                  <distortionIntensity>2.5</distortionIntensity>
                </li>
                <li>
                  <texPath>MiliraXianQinghe/Effect/SakuraDance/Strand</texPath>
                  <width>0.313</width>
                  <segmentDuration>0.6</segmentDuration>
                  <startFade>25</startFade>
                  <endFade>75</endFade>
                  <alphaCurve><points><li>(0, 0)</li><li>(0.05, 0.5)</li><li>(0.6, 0.4)</li><li>(1.05, 0)</li></points></alphaCurve>
                  <brightnessCurve><points><li>(0, 1.5)</li><li>(1.05, 1)</li></points></brightnessCurve>
                  <textureFraction>0.075</textureFraction>
                  <speedUCurve><points><li>(0, 4)</li><li>(0.6, 0.1)</li></points></speedUCurve>
                </li>
                <li>
                  <texPath>MiliraXianQinghe/Effect/SakuraDance/Strand</texPath>
                  <width>0.313</width>
                  <segmentDuration>0.6</segmentDuration>
                  <startFade>75</startFade>
                  <endFade>25</endFade>
                  <alphaCurve><points><li>(0, 0)</li><li>(0.05, 0.25)</li><li>(0.6, 0.2)</li><li>(1.05, 0)</li></points></alphaCurve>
                  <brightnessCurve><points><li>(0, 1.5)</li><li>(1.05, 1)</li></points></brightnessCurve>
                  <textureFraction>0.038</textureFraction>
                  <speedUCurve><points><li>(0, 4)</li><li>(0.6, 0.1)</li></points></speedUCurve>
                </li>
              </layers>
              <dustTexPath>MiliraXianQinghe/Effect/SakuraDance/Dust</dustTexPath>
              <dustOffset>(0, -0.6, 0)</dustOffset>
              <dustCount>10</dustCount>
              <dustInterval>0.011</dustInterval>
              <dustLife>0.7</dustLife>
              <dustStartSize>0.4</dustStartSize>
              <dustEndSize>1.4</dustEndSize>
              <dustAlpha>0.18</dustAlpha>
              <dustSquash>0.5</dustSquash>
              <dustColor>(0.9, 0.9, 0.9, 1)</dustColor>
            </updraft>
          </li>
        </cuts>
      </li>
    </comps>
  </AbilityDef>
