    <!-- 三项冷却暂沿用旧版配置。 -->
    <AbilityDef>
        <defName>MX_Mingyuan_AscendantFlameDash</defName>
        <label>&lt;color=#FFB25C&gt;升焰疾行&lt;/color&gt;</label>
        <description>原地升空，随后沿3格宽的路径俯冲，最远35格，可越过障碍。命中敌人时分别造成30点基础燃烧和钝击伤害，眩晕1秒，并使已有生命燃烧翻倍，最多叠至其引爆阈值的15%。
沿途地面燃烧15秒。敌人每秒受到10点基础燃烧伤害，附加引爆阈值15%的生命燃烧，并有30%概率着火。冷却8秒。</description>
        <iconPath>MiliraXianMingyuan/UI/Ability_AscendantFlameDash</iconPath>
        <category>MX_MingyuanSkill</category>
        <displayOrder>100</displayOrder>
        <cooldownTicksRange>480</cooldownTicksRange>
        <targetRequired>true</targetRequired>
        <hostile>true</hostile>
        <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <targetable>true</targetable>
            <range>35</range>
            <requireLineOfSight>false</requireLineOfSight>
            <warmupTime>0</warmupTime>
            <soundLanding>Longjump_Land</soundLanding>
            <targetParams>
                <canTargetSelf>false</canTargetSelf>
                <canTargetPawns>false</canTargetPawns>
                <canTargetLocations>true</canTargetLocations>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetItems>false</canTargetItems>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="MiliraXian.Characters.Mingyuan.CompProperties_AbilityMingyuanAscendantFlameDash">
                <pathWidth>3</pathWidth>
                <directBurnDamage>30</directBurnDamage>
                <directBluntDamage>30</directBluntDamage>
                <directStunTicks>60</directStunTicks>
                <directLifeBurnDoubleCapFraction>0.15</directLifeBurnDoubleCapFraction>
                <flyerDef>MX_Mingyuan_AscendantFlameDashFlyer</flyerDef>
                <gatherTicks>9</gatherTicks>
                <ascentTicks>27</ascentTicks>
                <hiddenTicks>7</hiddenTicks>
                <nearDiveTicks>15</nearDiveTicks>
                <farDiveTicks>42</farDiveTicks>
                <landingVisualTicks>18</landingVisualTicks>
                <featherLimit>20</featherLimit>
                <ascentSound>FireSpew_Warmup</ascentSound>
                <diveSound>MX_Mingyuan_PhoenixDive</diveSound>
            </li>
        </comps>
    </AbilityDef>

    <AbilityDef>
        <defName>MX_Mingyuan_InstantCombustion</defName>
        <label>&lt;color=#FFD37A&gt;瞬时燃烧&lt;/color&gt;</label>
        <description>跃起后绘制法阵3秒，使半径12格内敌人已有的生命燃烧翻倍，最多叠至其引爆阈值的50%。
有眼睛的敌人眩晕3秒。施放完成时，正朝明渊行走的敌人会失去现存眼睛。冷却120秒。</description>
        <iconPath>MiliraXianMingyuan/UI/Ability_InstantCombustion</iconPath>
        <category>MX_MingyuanSkill</category>
        <displayOrder>110</displayOrder>
        <cooldownTicksRange>7200</cooldownTicksRange>
        <targetRequired>false</targetRequired>
        <hostile>true</hostile>
        <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
        <jobDef>MX_Mingyuan_CastInstantCombustion</jobDef>
        <verbProperties>
            <verbClass>MiliraXian.Characters.Mingyuan.Verb_MingyuanFireCast</verbClass>
            <targetable>false</targetable>
            <range>30</range>
            <warmupTime>3</warmupTime>
            <targetParams>
                <canTargetSelf>true</canTargetSelf>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="MiliraXian.Characters.Mingyuan.CompProperties_AbilityMingyuanInstantCombustion">
                <radius>12</radius>
                <jumpTicks>12</jumpTicks>
                <lifeBurnDoubleCapFraction>0.50</lifeBurnDoubleCapFraction>
                <eyeRequiredStunTicks>180</eyeRequiredStunTicks>
                <destroyEyesWhenMovingTowardCaster>true</destroyEyesWhenMovingTowardCaster>
                <movementConeDegrees>90</movementConeDegrees>
                <visualFadeTicks>30</visualFadeTicks>
                <maxTargetMotes>16</maxTargetMotes>
                <targetMoteDef>MX_Mingyuan_Mote_InstantCombustionMark</targetMoteDef>
                <warmupLoop>MX_Mingyuan_FireCastHum</warmupLoop>
                <etchSound>MX_ArcaneCircle_Etch</etchSound>
                <sealSound>MX_ArcaneCircle_Seal</sealSound>
                <resolveSound>MX_ArcaneStrike_Impact</resolveSound>
                <hitSound>FireSpew_Resolve</hitSound>
            </li>
        </comps>
    </AbilityDef>

    <AbilityDef>
        <defName>MX_Mingyuan_BurningPillar</defName>
        <label>&lt;color=#FF7A45&gt;燃烧之柱&lt;/color&gt;</label>
        <description>持长虹瞄准3秒，向40格内视线和弹道畅通的地点射出火晶。火晶落地后形成持续40秒的旋风，前10秒扩张至半径10格，成形后可指挥它沿直线移动。
每秒对敌人造成相当于其致命伤害阈值15%的基础燃烧伤害，并附加其引爆阈值5%的生命燃烧。体型小于1.2的敌人会被卷入。旋风损耗皮革装备，对非玩家建筑每秒造成其最大生命值30%的伤害，烧毁的木制建筑不留残料。旋风直接击杀会引爆生命燃烧，并延长5秒。冷却240秒。</description>
        <iconPath>MiliraXianMingyuan/UI/Ability_BurningPillar</iconPath>
        <category>MX_MingyuanSkill</category>
        <displayOrder>120</displayOrder>
        <cooldownTicksRange>14400</cooldownTicksRange>
        <targetRequired>true</targetRequired>
        <hostile>true</hostile>
        <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
        <verbProperties>
            <verbClass>MiliraXian.Characters.Mingyuan.Verb_MingyuanFireCast</verbClass>
            <targetable>true</targetable>
            <range>40</range>
            <warmupTime>3</warmupTime>
            <requireLineOfSight>true</requireLineOfSight>
            <targetParams>
                <canTargetSelf>false</canTargetSelf>
                <canTargetPawns>false</canTargetPawns>
                <canTargetLocations>true</canTargetLocations>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetItems>false</canTargetItems>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="MiliraXian.Characters.Mingyuan.CompProperties_AbilityMingyuanBurningPillar">
                <projectileDef>MX_Mingyuan_PillarCrystal</projectileDef>
                <bowDef>MX_Mingyuan_RainbowBow</bowDef>
                <warmupLoop>MX_Mingyuan_FireCastHum</warmupLoop>
                <launchSound>Bow_Large</launchSound>
            </li>
        </comps>
    </AbilityDef>

    <AbilityDef>
        <defName>MX_Mingyuan_TimeBurn</defName>
        <label>&lt;color=#C95CFF&gt;时间燃烧&lt;/color&gt;</label>
        <description>以紫焰附魔尘烬，挥出紫色弧形剑气。剑气命中指定目标、击中 3 名敌人或遇到阻挡时消散。命中的敌人逐渐衰老，单次最多增加 500 年生物年龄，达到种族理论寿命时老死。机械体免疫。</description>
        <iconPath>MiliraXianMingyuan/UI/Ability_TimeBurn</iconPath>
        <category>MX_MingyuanSkill</category>
        <displayOrder>130</displayOrder>
        <cooldownTicksRange>18000</cooldownTicksRange>
        <targetRequired>true</targetRequired>
        <hostile>true</hostile>
        <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
        <verbProperties>
            <verbClass>MiliraXian.Characters.Mingyuan.Verb_MingyuanTimeBurn</verbClass>
            <soundCast>Psycast_Skip_Entry</soundCast>
            <targetable>true</targetable>
            <range>40</range>
            <targetParams>
                <canTargetSelf>false</canTargetSelf>
                <canTargetPawns>true</canTargetPawns>
                <canTargetLocations>false</canTargetLocations>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetItems>false</canTargetItems>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="MiliraXian.Characters.Mingyuan.CompProperties_AbilityMingyuanTimeBurn">
                <!-- 演出时长与老化时长为暂定参数。 -->
                <openingTicks>10</openingTicks>
                <enchantTicks>32</enchantTicks>
                <chargeTicks>21</chargeTicks>
                <swingTicks>12</swingTicks>
                <durationTicks>1200</durationTicks>
                <tickIntervalTicks>6</tickIntervalTicks>
                <projectileDef>MX_Mingyuan_TimeBurnWave</projectileDef>
                <startMoteDef>MX_Mingyuan_Mote_TimeBurnStart</startMoteDef>
                <collapseMoteDef>MX_Mingyuan_Mote_TimeBurnCollapse</collapseMoteDef>
                <effectSoundDef>Psycast_Skip_Entry</effectSoundDef>
                <startMoteScale>2.2</startMoteScale>
                <collapseMoteScale>2.4</collapseMoteScale>
            </li>
        </comps>
    </AbilityDef>

    <AbilityDef>
        <defName>MX_Mingyuan_AshesOfSelf</defName>
        <label>&lt;color=#FF5C3A&gt;焚我余烬&lt;/color&gt;</label>
        <description>增加 15% 失血，获得 150 层自燃。展开半径 4 格、持续 30 秒的随身火场。每次灼伤敌人附加 150 层生命燃烧，并治愈明渊一处伤势、恢复 3% 失血。</description>
        <iconPath>MiliraXianMingyuan/UI/Ability_AshesOfSelf</iconPath>
        <category>MX_MingyuanSkill</category>
        <displayOrder>140</displayOrder>
        <!-- 冷却暂沿用旧配置。 -->
        <cooldownTicksRange>1800</cooldownTicksRange>
        <targetRequired>false</targetRequired>
        <hostile>false</hostile>
        <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
        <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
        <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <targetable>false</targetable>
            <range>0</range>
            <warmupTime>0.5</warmupTime>
            <targetParams>
                <canTargetSelf>true</canTargetSelf>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="MiliraXian.Characters.Mingyuan.CompProperties_AbilityMingyuanAshesOfSelf">
                <fieldDef>MX_Mingyuan_AshesField</fieldDef>
                <selfBurnLayers>150</selfBurnLayers>
                <bloodLossCost>0.15</bloodLossCost>
                <castMoteDef>MX_Mingyuan_Mote_AshesCast</castMoteDef>
                <castMoteScale>1.35</castMoteScale>
                <effectSoundDef>FireSpew_Resolve</effectSoundDef>
            </li>
        </comps>
    </AbilityDef>

