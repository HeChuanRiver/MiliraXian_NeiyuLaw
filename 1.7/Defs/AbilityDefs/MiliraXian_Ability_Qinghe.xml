    <label>镜花水月</label>
    <description>令地面变为水镜幻象，自身隐入其中。幻影最多可以维持5秒，期间受到任何攻击后，清荷的真身会立即发动一次反击。反击击中任意敌对目标时，可以获得一层剑压。\n\n——镜花水月，如梦似幻。触之即碎，可望而不可即。</description>
    <iconPath>MiliraXianNeiyu/UI/MX_Neiyu_ThunderMarkedStorm</iconPath>
    <category>MX_QingheSkill</category>
    <displayOrder>225</displayOrder>
    <cooldownTicksRange>1800</cooldownTicksRange>
    <targetRequired>true</targetRequired>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
    <jobDef>MX_QH_IllusoryReflection</jobDef>
    <waitForJobEnd>true</waitForJobEnd>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <targetable>true</targetable>
      <!-- 略大于圆斩半径 4.5，原版施法圈套在出伤圈外面 -->
      <range>5.5</range>
      <warmupTime>0</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <drawHighlightWithLineOfSight>false</drawHighlightWithLineOfSight>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetLocations>true</canTargetLocations>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetItems>false</canTargetItems>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MiliraXian.Characters.QingHe.Abilities.CompProperties_AbilityIllusoryReflection">
        <!-- 时间单位 tick（60 = 1 秒）。
             前摇 0.5 秒 → 架势（连前摇最长 5 秒）→ 受击：碎镜 0.5 → 隐身 0.2 → 斩击 0.4 → 隐身 0.5 → 后摇 0.5（最后 0.15 秒武器淡入）。
             没有受击：0.5 秒淡出。前摇到收势全程无敌；冷却在收势时开始。 -->
        <durationTicks>300</durationTicks>
        <windupTicks>30</windupTicks>
        <shatterTicks>30</shatterTicks>
        <cutDelayTicks>12</cutDelayTicks>
        <cutTicks>24</cutTicks>
        <reformDelayTicks>30</reformDelayTicks>
        <recoverTicks>30</recoverTicks>
        <weaponBackTicks>9</weaponBackTicks>
        <exitTicks>30</exitTicks>
        <!-- 斩击：360° 整圆，半径内（包括贴身的）敌人在刀光转到它的方位时各挨一下。
             刀光从架势方向左后方（-135°）起，0.4 秒缓出转满一圈；刀光只画成外圈的光带，出伤范围是整个圆。 -->
        <sweepDamage>MX_QH_MirrorSweep</sweepDamage>
        <cutDamageDef>MX_QH_MirrorSlash</cutDamageDef>
        <damage>96</damage>
        <armorPenetration>1.25</armorPenetration>
        <cutRadius>4.5</cutRadius>
        <cutStartYaw>-135</cutStartYaw>
        <posture>15</posture>
        <swordPressureGain>1</swordPressureGain>
        <stanceSound>MX_QH_MirrorSlash_Stance</stanceSound>
        <shatterSound>MX_QH_MirrorSlash_Shatter</shatterSound>
        <slashSound>MX_QH_MirrorSlash_Slash</slashSound>
        <!-- 画面：水面、人物快照、倒影、碎镜、刀光。其余数值见 MirrorVisualProps 的默认值；
             刀光的泛光与樱舞同一组。 -->
        <visuals>
          <bloom>
            <group>MX_ScreenBloom_Glow</group>
            <tint>(1, 0.9, 0.95, 1)</tint>
            <intensity>1</intensity>
          </bloom>
        </visuals>
      </li>
    </comps>
  </AbilityDef>
