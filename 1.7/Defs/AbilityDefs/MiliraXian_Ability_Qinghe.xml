    <label>斩铁剑【红莲】</label>
    <description>清荷的剑舞绝招。向目标位置高速冲刺，对沿途的敌人造成钝击伤害；随后眩晕目标点附近的所有敌人并借势跃入空中，消耗全部剑压向下发动凌厉的连续斩击，对范围内所有敌人造成多次伤害。发动时需要至少一层剑压，消耗的剑压越多伤害越高。\n\n该技能具有可习得的连段：\n\n燕回返【月华】\n习得后，在下落斩击结束后，将追加一段回返斩击，对范围内的敌人造成一次追加高额伤害。会略微延长震击造成的眩晕时长。\n\n——与霓羽交手无数次后领悟的绝技。等等……你是说……这招很虾头？</description>
    <iconPath>MiliraXianQinghe/UI/Icons/ascend_slash</iconPath>
    <category>MX_QingheSkill</category>
    <displayOrder>235</displayOrder>
    <cooldownTicksRange>1800</cooldownTicksRange>
    <targetRequired>true</targetRequired>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>true</disableGizmoWhileUndrafted>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <targetable>true</targetable>
      <range>26</range>
      <warmupTime>0.3</warmupTime>
      <requireLineOfSight>true</requireLineOfSight>
      <drawHighlightWithLineOfSight>true</drawHighlightWithLineOfSight>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>true</canTargetLocations>
        <canTargetBuildings>true</canTargetBuildings>
        <canTargetItems>false</canTargetItems>
      </targetParams>
    </verbProperties>
    <comps>
      <!-- 时间单位秒，从冲到终点（击晕）算起。
           冲刺 → 到达（击晕）→ 0.1 起跳 → 0.6 最高点 → 0.75 下坠 → 0.88 落地 → 落地 0.3 秒后每 0.08 秒一次判定共 5 次 → 保持到 2.58。
           没学燕回返：0.3 秒地上收刀结束。学会：0.5 秒上捞跃回 2.2 米 → 1 秒空中居合 → 合鞘判定 → 0.3 秒落地。 -->
      <li Class="MiliraXian.Characters.QingHe.Abilities.Zantetsuken.CompProperties_AbilityZantetsuken">
        <dashSpeedCellsPerSecond>40</dashSpeedCellsPerSecond>
        <dashMinTicks>8</dashMinTicks>
        <!-- 冲刺不被敌人挡住，沿途 1.35 格内的敌人各受一次 5 点钝击；墙和关着的门会让冲刺停下。
             对目标施放时冲到目标 3 格内离它最近、看得见的空位，对空地施放时冲到那一格 -->
        <dashBurst>MX_QH_ZantetsukenDash</dashBurst>
        <dashCollisionRadius>1.35</dashCollisionRadius>
        <dashDamage>5</dashDamage>
        <approachRadius>3</approachRadius>
        <takeoffSeconds>0.10</takeoffSeconds>
        <apexSeconds>0.60</apexSeconds>
        <fallSeconds>0.75</fallSeconds>
        <landSeconds>0.88</landSeconds>
        <holdSeconds>1.7</holdSeconds>
        <firstHitDelay>0.3</firstHitDelay>
        <hitInterval>0.08</hitInterval>
        <landHits>5</landHits>
        <plainSheatheSeconds>0.3</plainSheatheSeconds>
        <plainFadeSeconds>0.6</plainFadeSeconds>
        <scoopRiseSeconds>0.5</scoopRiseSeconds>
        <scoopSwingSeconds>0.3</scoopSwingSeconds>
        <turnBackSeconds>0.1</turnBackSeconds>
        <turnSouthSeconds>0.1</turnSouthSeconds>
        <sheatheSeconds>1.0</sheatheSeconds>
        <sheatheAlignShare>0.25</sheatheAlignShare>
        <gaeshiHoldSeconds>0.4</gaeshiHoldSeconds>
        <dropSeconds>0.3</dropSeconds>
        <burstSeconds>0.6</burstSeconds>
        <apexHeight>16</apexHeight>
        <gaeshiHeight>2.2</gaeshiHeight>
        <roofedHeight>1.2</roofedHeight>
        <!-- 出伤：落地每次 40（共 5 次），回返合鞘一次 150；伤害乘近战伤害系数和法术效果系数。建筑倍率在伤害定义里（×1.5） -->
        <burstDamage>MX_QH_ZantetsukenBurst</burstDamage>
        <landDamageDef>MX_QH_Zantetsuken_Guren</landDamageDef>
        <gaeshiDamageDef>MX_QH_Gaeshi_Gekka</gaeshiDamageDef>
        <lotusRadius>6</lotusRadius>
        <landDamage>40</landDamage>
        <gaeshiDamage>150</gaeshiDamage>
        <armorPenetration>1.35</armorPenetration>
        <!-- 每一击 10 架势，燕回返那一击另加 30。动作中途不处决：打崩的敌人一直崩到动作结束后再持续原本的时长 -->
        <hitPosture>10</hitPosture>
        <gaeshiExtraPosture>30</gaeshiExtraPosture>
        <stunTicks>300</stunTicks>
        <gaeshiStunTicks>480</gaeshiStunTicks>
        <minSwordPressure>1</minSwordPressure>
        <gaeshiNode>MX_QH_Node_Gaeshi_Gekka</gaeshiNode>
        <!-- 投影和散华的十字斩一致 -->
        <heightToScreen>0.35</heightToScreen>
        <depthToScreen>0.55</depthToScreen>
        <heightOrigin>-0.63</heightOrigin>
        <!-- 音效：落下用原落樱的落下斩，每次判定和合鞘用原落樱的连续斩击（放大音量的版本）；冲刺撞到敌人借格挡声 -->
        <dashHitSound>MX_QH_SwordBlock</dashHitSound>
        <landSound>MX_QH_Zantetsuken_Drop</landSound>
        <hitSound>MX_QH_Zantetsuken_Slash</hitSound>
        <burstSound>MX_QH_Zantetsuken_Slash</burstSound>
        <clickSound>MX_QH_Gaeshi_Shatter</clickSound>
        <!-- 震屏（原版 CameraShaker，上限 0.2，每秒衰减 0.5）：落地弱、每次斩击很弱、合鞘略强 -->
        <landShake>0.1</landShake>
        <hitShake>0.035</hitShake>
        <gaeshiShake>0.15</gaeshiShake>
        <visuals>
          <rimWidth>0.07</rimWidth>
          <rimStrength>1.3</rimStrength>
          <bloom>
            <group>MX_ScreenBloom_Glow</group>
            <tint>(1, 0.8, 0.9, 1)</tint>
            <intensity>1.6</intensity>
          </bloom>
          <markLengthShare>0.75</markLengthShare>
          <markVfx>
            <cutGrowSeconds>0.05</cutGrowSeconds>
            <cutWaitShare>1</cutWaitShare>
            <cutFadeSeconds>0.55</cutFadeSeconds>
            <cutWidth>0.12</cutWidth>
            <cutAlpha>4</cutAlpha>
            <cutColor>(1, 0.55, 0.72, 1)</cutColor>
            <cutCoreColor>(1, 0.92, 0.96, 1)</cutCoreColor>
            <cutBurstStretch>1.5</cutBurstStretch>
            <cutStretchSeconds>0.1</cutStretchSeconds>
            <burstDelay>0.05</burstDelay>
            <cutBloom>
              <group>MX_ScreenBloom_Glow</group>
              <tint>(1, 0.6, 0.78, 1)</tint>
