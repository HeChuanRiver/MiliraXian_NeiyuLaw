<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    清荷剑舞防御和处决的音效。先借用霓羽的刀剑碰撞声和清荷的挥刀声，按音高和音量区分档位；
    之后换素材只改 clipPath。
  -->
  <SoundDef ParentName="MX_NeiyuSwordCollisionBase">
    <defName>MX_QH_SwordBlock</defName>
    <subSounds Inherit="False"><li>
      <grains>
        <li Class="AudioGrain_Clip"><clipPath>MiliraXianNeiyu/SwordFight/MXNY_SwordFight1</clipPath></li>
        <li Class="AudioGrain_Clip"><clipPath>MiliraXianNeiyu/SwordFight/MXNY_SwordFight2</clipPath></li>
        <li Class="AudioGrain_Clip"><clipPath>MiliraXianNeiyu/SwordFight/MXNY_SwordFight3</clipPath></li>
      </grains>
      <volumeRange>22~26</volumeRange><pitchRange>0.86~0.94</pitchRange><distRange>3~26</distRange>
      <muteWhenPaused>true</muteWhenPaused><tempoAffectedByGameSpeed>true</tempoAffectedByGameSpeed>
    </li></subSounds>
  </SoundDef>
  <SoundDef ParentName="MX_NeiyuSwordCollisionBase">
    <defName>MX_QH_SwordParry</defName>
    <subSounds Inherit="False"><li>
      <grains>
        <li Class="AudioGrain_Clip"><clipPath>MiliraXianNeiyu/SwordFight/MXNY_SwordFight1</clipPath></li>
        <li Class="AudioGrain_Clip"><clipPath>MiliraXianNeiyu/SwordFight/MXNY_SwordFight2</clipPath></li>
        <li Class="AudioGrain_Clip"><clipPath>MiliraXianNeiyu/SwordFight/MXNY_SwordFight3</clipPath></li>
      </grains>
      <volumeRange>34~38</volumeRange><pitchRange>1.12~1.22</pitchRange><distRange>3~30</distRange>
      <muteWhenPaused>true</muteWhenPaused><tempoAffectedByGameSpeed>true</tempoAffectedByGameSpeed>
    </li></subSounds>
  </SoundDef>
  <!-- 化解：弹开声更高更亮，叠一声收刀的轻响 -->
  <SoundDef ParentName="MX_NeiyuSwordCollisionBase">
    <defName>MX_QH_SwordCounter</defName>
    <subSounds Inherit="False">
      <li>
        <grains>
          <li Class="AudioGrain_Clip"><clipPath>MiliraXianNeiyu/SwordFight/MXNY_SwordFight1</clipPath></li>
          <li Class="AudioGrain_Clip"><clipPath>MiliraXianNeiyu/SwordFight/MXNY_SwordFight3</clipPath></li>
        </grains>
        <volumeRange>40~44</volumeRange><pitchRange>1.26~1.34</pitchRange><distRange>3~32</distRange>
        <muteWhenPaused>true</muteWhenPaused><tempoAffectedByGameSpeed>true</tempoAffectedByGameSpeed>
      </li>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>MiliraXianNeiyu/WarpFeather/FeatherChime</clipPath></li></grains>
        <volumeRange>14~16</volumeRange><pitchRange>1.2~1.3</pitchRange><distRange>3~24</distRange>
        <muteWhenPaused>true</muteWhenPaused><tempoAffectedByGameSpeed>true</tempoAffectedByGameSpeed>
      </li>
    </subSounds>
  </SoundDef>
  <SoundDef ParentName="MX_NeiyuSwordCollisionBase">
    <defName>MX_QH_SwordPostureBreak</defName>
    <subSounds Inherit="False"><li>
      <grains>
        <li Class="AudioGrain_Clip"><clipPath>MiliraXianNeiyu/SwordFight/MXNY_SwordFight1</clipPath></li>
        <li Class="AudioGrain_Clip"><clipPath>MiliraXianNeiyu/SwordFight/MXNY_SwordFight2</clipPath></li>
      </grains>
      <volumeRange>32~36</volumeRange><pitchRange>0.62~0.72</pitchRange><distRange>3~30</distRange>
      <muteWhenPaused>true</muteWhenPaused><tempoAffectedByGameSpeed>true</tempoAffectedByGameSpeed>
    </li></subSounds>
  </SoundDef>
  <SoundDef>
    <defName>MX_QH_SwordExecutionDraw</defName>
    <context>MapOnly</context>
    <subSounds><li>
      <grains><li Class="AudioGrain_Clip"><clipPath>MiliraXianQinghe/AscentSlash/ascendslash_slash</clipPath></li></grains>
      <volumeRange>36~40</volumeRange><pitchRange>0.92~1.0</pitchRange><distRange>3~30</distRange>
      <muteWhenPaused>true</muteWhenPaused><tempoAffectedByGameSpeed>true</tempoAffectedByGameSpeed>
    </li></subSounds>
  </SoundDef>
  <!--
    收刀"咔"的一声和斩中同时响，三层都用本体素材（不依赖 DLC）：
    刀镡碰鞘口的金属脆响（原版弹丸偏斜·金属，升调）、刀剑碰撞的余音（霓羽刀剑碰撞，低沉）；
    原版处决的斩切声 Execute_Cut 由处决代码同时播放。
  -->
  <SoundDef>
    <defName>MX_QH_SwordExecutionHit</defName>
    <context>MapOnly</context>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Folder"><clipFolderPath>Impact/Deflect/Deflect_Metal</clipFolderPath></li></grains>
        <volumeRange>40~44</volumeRange><pitchRange>1.35~1.45</pitchRange><distRange>3~34</distRange>
        <muteWhenPaused>true</muteWhenPaused><tempoAffectedByGameSpeed>true</tempoAffectedByGameSpeed>
      </li>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>MiliraXianNeiyu/SwordFight/MXNY_SwordFight3</clipPath></li></grains>
        <volumeRange>22~26</volumeRange><pitchRange>0.7~0.76</pitchRange><distRange>3~30</distRange>
        <muteWhenPaused>true</muteWhenPaused><tempoAffectedByGameSpeed>true</tempoAffectedByGameSpeed>
      </li>
    </subSounds>
  </SoundDef>
</Defs>
