<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <SoundDef>
        <defName>MX_QH_MirrorSlash_Stance</defName>
        <context>MapOnly</context>
        <subSounds>
            <li>
                <grains>
                    <li Class="AudioGrain_Clip">
                        <clipPath>MiliraXianQinghe/MirrorSlash/mirrorslash_stance</clipPath>
                    </li>
                </grains>
                <volumeRange>35~35</volumeRange>
                <pitchRange>1~1</pitchRange>
            </li>
        </subSounds>
    </SoundDef>

    <!-- 镜花水月受击碎镜：Freesound #784151 "Glass break hammer"（loganzsound，CC0） -->
    <SoundDef>
        <defName>MX_QH_MirrorSlash_Shatter</defName>
        <context>MapOnly</context>
        <subSounds>
            <li>
                <grains>
                    <li Class="AudioGrain_Clip">
                        <clipPath>MiliraXianQinghe/MirrorSlash/mirrorslash_shatter</clipPath>
                    </li>
                </grains>
                <volumeRange>60~60</volumeRange>
                <pitchRange>1~1</pitchRange>
            </li>
        </subSounds>
    </SoundDef>

    <SoundDef>
        <defName>MX_QH_MirrorSlash_Slash</defName>
        <context>MapOnly</context>
        <subSounds>
            <li>
                <grains>
                    <li Class="AudioGrain_Clip">
                        <clipPath>MiliraXianQinghe/MirrorSlash/mirrorslash_slash</clipPath>
                    </li>
                </grains>
                <volumeRange>35~35</volumeRange>
                <pitchRange>1~1</pitchRange>
            </li>
        </subSounds>
    </SoundDef>

    <!-- 斩铁剑【红莲】：原落樱的落下斩和连续斩击，音量放大（落樱原值 35） -->
    <SoundDef>
        <defName>MX_QH_Zantetsuken_Drop</defName>
        <context>MapOnly</context>
        <maxSimultaneous>2</maxSimultaneous>
        <subSounds>
            <li>
                <grains>
                    <li Class="AudioGrain_Clip">
                        <clipPath>MiliraXianQinghe/AscentSlash/ascendslash_drop</clipPath>
                    </li>
                </grains>
                <volumeRange>70~70</volumeRange>
                <pitchRange>1~1</pitchRange>
            </li>
        </subSounds>
    </SoundDef>

    <SoundDef>
        <defName>MX_QH_Zantetsuken_Slash</defName>
        <context>MapOnly</context>
        <maxSimultaneous>4</maxSimultaneous>
        <subSounds>
            <li>
                <grains>
                    <li Class="AudioGrain_Clip">
                        <clipPath>MiliraXianQinghe/AscentSlash/ascendslash_slash</clipPath>
                    </li>
                </grains>
                <volumeRange>60~60</volumeRange>
                <pitchRange>0.96~1.04</pitchRange>
            </li>
        </subSounds>
    </SoundDef>

    <!-- 燕回返合鞘：Freesound #861044 "Hard Glass Break 3"（ElevatorFan2020，CC0），mp3 转 ogg -->
    <SoundDef>
        <defName>MX_QH_Gaeshi_Shatter</defName>
        <context>MapOnly</context>
        <subSounds>
            <li>
                <grains>
                    <li Class="AudioGrain_Clip"><clipPath>MiliraXianQinghe/MirrorSlash/zantetsuken_glass</clipPath></li>
                </grains>
                <volumeRange>85~85</volumeRange>
                <pitchRange>1~1</pitchRange>
                <distRange>3~34</distRange>
            </li>
        </subSounds>
    </SoundDef>

    <!-- 花信风铃（RangedRework.md 第 2.9 节）：VCSL 铃树单颗铃（BellTree_Hit_E5_rr1_Mid，CC0，
         github.com/sgossner/VCSL），实测 1317 Hz。代码按 pitchFactor 换到五声音阶各音（宫 = 1047 Hz），
         所以这里不随机音高。 -->
    <SoundDef>
        <defName>MX_QH_BellNote</defName>
        <context>MapOnly</context>
        <maxSimultaneous>10</maxSimultaneous>
        <subSounds>
            <li>
                <grains>
                    <li Class="AudioGrain_Clip"><clipPath>MiliraXianQinghe/FlowerBell/bell_note</clipPath></li>
                </grains>
                <volumeRange>40~40</volumeRange>
                <pitchRange>1~1</pitchRange>
            </li>
        </subSounds>
    </SoundDef>

    <!-- 发射时的敲击：同一颗铃的起音段 -->
    <SoundDef>
        <defName>MX_QH_BellKnock</defName>
        <context>MapOnly</context>
        <subSounds>
            <li>
                <grains>
                    <li Class="AudioGrain_Clip"><clipPath>MiliraXianQinghe/FlowerBell/bell_knock</clipPath></li>
                </grains>
                <volumeRange>35~35</volumeRange>
                <pitchRange>1~1</pitchRange>
            </li>
        </subSounds>
    </SoundDef>

    <!-- 衰减掉档：同一颗铃低通、缩短 -->
    <SoundDef>
        <defName>MX_QH_BellDull</defName>
        <context>MapOnly</context>
        <subSounds>
            <li>
                <grains>
                    <li Class="AudioGrain_Clip"><clipPath>MiliraXianQinghe/FlowerBell/bell_dull</clipPath></li>
                </grains>
                <volumeRange>30~30</volumeRange>
                <pitchRange>1~1</pitchRange>
            </li>
        </subSounds>
    </SoundDef>

    <SoundDef>
        <defName>MX_QH_AscentSlash_Drop</defName>
        <context>MapOnly</context>
        <subSounds>
            <li>
                <grains>
                    <li Class="AudioGrain_Clip">
                        <clipPath>MiliraXianQinghe/AscentSlash/ascendslash_drop</clipPath>
                    </li>
                </grains>
                <volumeRange>35~35</volumeRange>
                <pitchRange>1~1</pitchRange>
            </li>
        </subSounds>
    </SoundDef>

    <SoundDef>
        <defName>MX_QH_AscentSlash_Slash</defName>
        <context>MapOnly</context>
        <subSounds>
            <li>
                <grains>
                    <li Class="AudioGrain_Clip">
                        <clipPath>MiliraXianQinghe/AscentSlash/ascendslash_slash</clipPath>
                    </li>
                </grains>
                <volumeRange>35~35</volumeRange>
                <pitchRange>1~1</pitchRange>
            </li>
        </subSounds>
    </SoundDef>
</Defs>
