<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <SoundDef Name="MX_NeiyuSwordCollisionBase" Abstract="True">
    <context>MapOnly</context>
    <maxSimultaneous>6</maxSimultaneous>
    <subSounds>
      <li>
        <!-- 同一 subSound 的 grains 随机选一个；不同时叠播三份素材。 -->
        <grains>
          <li Class="AudioGrain_Clip"><clipPath>MiliraXianNeiyu/SwordFight/MXNY_SwordFight1</clipPath></li>
          <li Class="AudioGrain_Clip"><clipPath>MiliraXianNeiyu/SwordFight/MXNY_SwordFight2</clipPath></li>
          <li Class="AudioGrain_Clip"><clipPath>MiliraXianNeiyu/SwordFight/MXNY_SwordFight3</clipPath></li>
        </grains>
        <volumeRange>28~32</volumeRange>
        <pitchRange>0.94~1.04</pitchRange>
        <distRange>3~28</distRange>
        <muteWhenPaused>true</muteWhenPaused>
        <tempoAffectedByGameSpeed>true</tempoAffectedByGameSpeed>
      </li>
    </subSounds>
  </SoundDef>
  <SoundDef ParentName="MX_NeiyuSwordCollisionBase">
    <defName>MX_NeiyuSwordDeflect</defName>
  </SoundDef>
