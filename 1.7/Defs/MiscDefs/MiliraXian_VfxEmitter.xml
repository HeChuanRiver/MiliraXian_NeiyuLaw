<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 发射器系统的特效定义。一个特效 = 若干「笔（pass）」，每笔自带渲染器种类、材质、层与参数。
       层与泛光写在每笔上，而不是整个特效上：地面压暗不该进泛光，光幕该进。 -->

  <MiliraXian.Characters.Common.Vfx.Emitter.VfxDef>
    <defName>MX_Vfx_SpringFlow</defName>
    <fadeOutSeconds>0.35</fadeOutSeconds>

    <!-- 春泉：目前只有一笔 —— 边界光幕。以后加地面水痕、涟漪、水滴，各加一个 <li> 即可，
         宿主与渲染器都不用改。 -->
    <passes>
      <li>
        <name>boundary</name>
        <renderer>Field</renderer>
        <texture>White</texture>
        <shaderDef>MX_QH_SpringFlowInstanced</shaderDef>
        <layer>0</layer>
        <bloomGroup>MX_ScreenBloom_Glow</bloomGroup>
        <bloomIntensity>0.8</bloomIntensity>
        <!-- 实例化：一块共享四边形，逐实例数据带中心/尺寸/半径/强度，N 个春泉一次提交。 -->
        <instanceMesh>quad</instanceMesh>
        <instanceVectors>2</instanceVectors>
        <field>
          <!-- 四边形跟着半径走：边长 = ceil(R) * 2 + 3 -->
          <sizeFromRadius>true</sizeFromRadius>
          <radiusPadding>3</radiusPadding>
          <radiusChannel>radius</radiusChannel>
          <strengthChannel>strength</strengthChannel>
          <!-- 光幕向北溢出的那一截；shader 也按同一公式重建几何 -->
          <extraHeight>0.4</extraHeight>
          <useAltitude>true</useAltitude>
          <altitude>MoteLow</altitude>
          <bindings>
            <!-- 春粉；幕高/线宽/增益等全实例共享的常量 -->
            <li>
              <uniform>_Glow</uniform>
              <value>(1, 0.62, 0.80, 1)</value>
            </li>
            <li>
              <uniform>_Params</uniform>
              <value>(0.4, 1, 0.024, 4.23)</value>
            </li>
          </bindings>
        </field>
      </li>
    </passes>
  </MiliraXian.Characters.Common.Vfx.Emitter.VfxDef>

  <MiliraXian.Characters.Common.Vfx.Emitter.VfxDef>
    <defName>MX_Vfx_RainWallStrands</defName>
    <!-- 每面墙约 500 根雨丝 + 同样数量的落点水花 + 4 朵荷花及倒影。 -->
    <capacity>1040</capacity>
    <emitterClass>MiliraXian.Characters.QingHe.Things.RainWallEmitter</emitterClass>

    <!-- 荷雨全部视觉层：地面水痕、水面折射、落点水花、荷花与倒影、雨幕、雨丝。 -->
    <passes>
      <li>
        <name>ground</name>
        <renderer>Field</renderer>
        <texture>White</texture>
        <shaderDef>MX_QH_RainWallGround</shaderDef>
        <layer>0</layer>
        <bloomGroup>MX_ScreenBloom_Glow</bloomGroup>
        <bloomIntensity>0.35</bloomIntensity>
        <field>
          <sizeChannel>rainWallQuad</sizeChannel>
          <sizeUniform>_FieldSize</sizeUniform>
          <useAltitude>true</useAltitude>
          <altitude>MoteLow</altitude>
          <bindings>
            <li><uniform>_Glow</uniform><value>(0.60, 0.95, 0.50, 1)</value></li>
            <li><uniform>_Axis</uniform><vecChannel>rainWallAxis</vecChannel></li>
            <li><uniform>_Band</uniform><vecChannel>rainWallBand</vecChannel></li>
            <li><uniform>_LotusA</uniform><vecChannel>rainWallLotusA</vecChannel></li>
            <li><uniform>_LotusB</uniform><vecChannel>rainWallLotusB</vecChannel></li>
            <li><uniform>_LotusC</uniform><vecChannel>rainWallLotusC</vecChannel></li>
            <li><uniform>_LotusD</uniform><vecChannel>rainWallLotusD</vecChannel></li>
          </bindings>
        </field>
      </li>

      <li>
        <name>water</name>
        <renderer>Field</renderer>
        <texture>White</texture>
        <shaderDef>MX_QH_RainWallWater</shaderDef>
        <layer>0</layer>
        <field>
          <sizeChannel>rainWallQuad</sizeChannel>
          <sizeUniform>_FieldSize</sizeUniform>
          <useAltitude>true</useAltitude>
          <altitude>MoteLow</altitude>
          <altitudeOffset>0.01</altitudeOffset>
          <bindings>
            <li><uniform>_Axis</uniform><vecChannel>rainWallAxis</vecChannel></li>
            <li><uniform>_Band</uniform><vecChannel>rainWallBand</vecChannel></li>
            <li><uniform>_WindA</uniform><vecChannel>rainWallWindA</vecChannel></li>
            <li><uniform>_WindB</uniform><vecChannel>rainWallWindB</vecChannel></li>
            <li><uniform>_WindC</uniform><vecChannel>rainWallWindC</vecChannel></li>
            <li><uniform>_WindD</uniform><vecChannel>rainWallWindD</vecChannel></li>
            <li><uniform>_WindE</uniform><vecChannel>rainWallWindE</vecChannel></li>
            <li><uniform>_DistortScale</uniform><frame>screenPerCell</frame></li>
          </bindings>
        </field>
      </li>

      <li>
        <name>splashes</name>
        <renderer>Sprite</renderer>
        <texture>White</texture>
        <shaderDef>MX_QH_RainWallSplash</shaderDef>
        <layer>0</layer>
        <particleGroup>1</particleGroup>
        <sprite>
          <!-- 每颗水花一个四边形，边长 2 × 0.45；uv 就是到落点的格偏移，不用图集。 -->
          <quadSize>(0.9, 0.9)</quadSize>
          <useParticleSize>false</useParticleSize>
          <useParticleRotation>false</useParticleRotation>
          <useParticleColor>true</useParticleColor>
          <useUvRect>true</useUvRect>
          <uvMin>(-0.45, -0.45)</uvMin>
          <uvMax>(0.45, 0.45)</uvMax>
          <bindings>
            <li><uniform>_Band</uniform><vecChannel>rainWallBand</vecChannel></li>
            <li><uniform>_DistortScale</uniform><frame>screenPerCell</frame></li>
          </bindings>
        </sprite>
      </li>

      <li>
        <name>lotus_bloom_reflection</name>
        <renderer>Sprite</renderer>
        <texture>MiliraXianQinghe/Effect/lotus_bloom</texture>
        <shaderDef>MX_QH_RainWallLotus</shaderDef>
        <layer>0</layer>
        <particleGroup>2</particleGroup>
        <sprite>
          <quadSize>(2, 1.2242647)</quadSize>
          <useParticleSize>true</useParticleSize>
          <useParticleRotation>false</useParticleRotation>
          <useParticleColor>true</useParticleColor>
          <flipV>false</flipV>
          <useAltitude>true</useAltitude>
          <altitude>MoteLow</altitude>
          <altitudeOffset>0.01</altitudeOffset>
          <bindings>
            <li><uniform>_Color</uniform><value>(0.94, 1, 1.02, 1)</value></li>
            <li><uniform>_Brightness</uniform><floatValue>0.80</floatValue></li>
            <li><uniform>_AlphaScale</uniform><floatValue>1</floatValue></li>
            <li><uniform>_Additive</uniform><floatValue>0</floatValue></li>
          </bindings>
        </sprite>
      </li>

      <li>
        <name>lotus_bloom</name>
        <renderer>Sprite</renderer>
        <texture>MiliraXianQinghe/Effect/lotus_bloom</texture>
        <shaderDef>MX_QH_RainWallLotus</shaderDef>
        <layer>0</layer>
        <particleGroup>3</particleGroup>
        <sprite>
          <quadSize>(2, 1.2242647)</quadSize>
          <useParticleSize>true</useParticleSize>
          <useParticleRotation>false</useParticleRotation>
          <useParticleColor>true</useParticleColor>
          <flipV>true</flipV>
          <useAltitude>true</useAltitude>
          <altitude>MoteLow</altitude>
          <altitudeOffset>0.02</altitudeOffset>
          <bindings>
            <li><uniform>_Color</uniform><value>(0.94, 1, 1.02, 1)</value></li>
            <li><uniform>_Brightness</uniform><floatValue>0.80</floatValue></li>
            <li><uniform>_AlphaScale</uniform><floatValue>1</floatValue></li>
            <li><uniform>_Additive</uniform><floatValue>0</floatValue></li>
          </bindings>
        </sprite>
      </li>

      <li>
        <name>lotus_pad_reflection</name>
        <renderer>Sprite</renderer>
        <texture>MiliraXianQinghe/Effect/lotus_pad</texture>
        <shaderDef>MX_QH_RainWallLotus</shaderDef>
        <layer>0</layer>
        <particleGroup>4</particleGroup>
        <sprite>
          <quadSize>(2, 1.2386059)</quadSize>
          <useParticleSize>true</useParticleSize>
          <useParticleRotation>false</useParticleRotation>
          <useParticleColor>true</useParticleColor>
          <flipV>false</flipV>
          <useAltitude>true</useAltitude>
          <altitude>MoteLow</altitude>
          <altitudeOffset>0.01</altitudeOffset>
          <bindings>
            <li><uniform>_Color</uniform><value>(0.94, 1, 1.02, 1)</value></li>
            <li><uniform>_Brightness</uniform><floatValue>0.80</floatValue></li>
            <li><uniform>_AlphaScale</uniform><floatValue>1</floatValue></li>
            <li><uniform>_Additive</uniform><floatValue>0</floatValue></li>
          </bindings>
        </sprite>
      </li>

      <li>
        <name>lotus_pad</name>
        <renderer>Sprite</renderer>
        <texture>MiliraXianQinghe/Effect/lotus_pad</texture>
        <shaderDef>MX_QH_RainWallLotus</shaderDef>
        <layer>0</layer>
        <particleGroup>5</particleGroup>
        <sprite>
          <quadSize>(2, 1.2386059)</quadSize>
          <useParticleSize>true</useParticleSize>
          <useParticleRotation>false</useParticleRotation>
          <useParticleColor>true</useParticleColor>
          <flipV>true</flipV>
          <useAltitude>true</useAltitude>
          <altitude>MoteLow</altitude>
          <altitudeOffset>0.02</altitudeOffset>
          <bindings>
            <li><uniform>_Color</uniform><value>(0.94, 1, 1.02, 1)</value></li>
            <li><uniform>_Brightness</uniform><floatValue>0.80</floatValue></li>
            <li><uniform>_AlphaScale</uniform><floatValue>1</floatValue></li>
            <li><uniform>_Additive</uniform><floatValue>0</floatValue></li>
          </bindings>
        </sprite>
      </li>

      <li>
        <name>mist</name>
        <renderer>Field</renderer>
        <texture>White</texture>
        <shaderDef>MX_QH_RainWall</shaderDef>
        <layer>0</layer>
        <bloomGroup>MX_ScreenBloom_Glow</bloomGroup>
        <bloomIntensity>1.1</bloomIntensity>
        <field>
          <!-- 四边形覆盖整条带子；半宽随墙的朝向变化，所以由发射器写进通道，渲染器再写进 _FieldSize -->
          <sizeChannel>rainWallQuad</sizeChannel>
          <sizeUniform>_FieldSize</sizeUniform>
          <extraHeight>3.05</extraHeight>
          <useAltitude>true</useAltitude>
          <altitude>MoteOverhead</altitude>
          <bindings>
            <li><uniform>_Axis</uniform><vecChannel>rainWallAxis</vecChannel></li>
            <li><uniform>_Band</uniform><vecChannel>rainWallBand</vecChannel></li>
          </bindings>
        </field>
      </li>

      <li>
        <name>strands</name>
        <renderer>Streak</renderer>
        <texture>MiliraXianQinghe/Effect/rain_strand</texture>
        <shaderDef>MX_QH_SakuraTrailAdd</shaderDef>
        <layer>0</layer>
        <bloomGroup>MX_ScreenBloom_Glow</bloomGroup>
        <bloomIntensity>0.45</bloomIntensity>
        <particleGroup>0</particleGroup>
        <streak>
          <width>0.018</width>
          <!-- 尾端 = 头端的 1 - 0.75 -->
          <tailAlpha>0.25</tailAlpha>
          <useAltitude>false</useAltitude>
          <bindings>
            <li><uniform>_Brightness</uniform><floatValue>1</floatValue></li>
            <li><uniform>_AlphaScale</uniform><floatValue>1</floatValue></li>
            <li><uniform>_Additive</uniform><floatValue>1</floatValue></li>
          </bindings>
        </streak>
      </li>
    </passes>
  </MiliraXian.Characters.Common.Vfx.Emitter.VfxDef>

  <MiliraXian.Characters.Common.Vfx.Emitter.VfxDef>
    <defName>MX_Vfx_Luohua</defName>
    <lifetimeSeconds>2.7</lifetimeSeconds>
    <fadeOutSeconds>0</fadeOutSeconds>
    <requireMaintain>false</requireMaintain>
    <capacity>1</capacity>
    <emitterClass>MiliraXian.Characters.QingHe.Things.Weapons.LuohuaEmitter</emitterClass>
    <modExtensions>
      <li Class="MiliraXian.Characters.QingHe.Things.Weapons.LuohuaVfxExtension">
        <offset>(0, 0.2)</offset>
        <!-- 淡入 0.7 秒，盖过振刀甩血（抽刀后约 1.1 秒回到待机） -->
        <fadeInSeconds>0.7</fadeInSeconds>
        <holdSeconds>1.2</holdSeconds>
        <dissolveSeconds>0.8</dissolveSeconds>
        <darkenAlpha>0.65</darkenAlpha>
      </li>
    </modExtensions>

    <!-- 落华处决击杀特效：周围软边压暗黑圆 + 竖排白字噪声溶解与粉色泛光 -->
    <passes>
      <li>
        <name>darken</name>
        <renderer>Field</renderer>
        <texture>MiliraXianQinghe/Effect/SakuraDance/Glow</texture>
        <shaderDef>MX_QH_SakuraTrailAlpha</shaderDef>
        <layer>0</layer>
        <field>
          <!-- 半径 4 格的软边黑圆（直径 8）；_AlphaScale = 3 扩大全暗核心区，只留外圈渐变 -->
          <quadSize>(8, 8)</quadSize>
          <useAltitude>true</useAltitude>
          <altitude>MetaOverlays</altitude>
          <bindings>
            <li><uniform>_Color</uniform><value>(0, 0, 0, 1)</value></li>
            <li><uniform>_Brightness</uniform><floatValue>1</floatValue></li>
            <li><uniform>_AlphaScale</uniform><floatValue>3</floatValue></li>
            <li><uniform>_Additive</uniform><floatValue>0</floatValue></li>
            <li><uniform>_AlphaMax</uniform><channel>alpha</channel></li>
          </bindings>
        </field>
      </li>

      <li>
        <name>text</name>
        <renderer>Sprite</renderer>
        <texture>MiliraXianQinghe/Effect/Luohua/Luohua</texture>
        <shaderDef>MX_QH_LuohuaText</shaderDef>
        <layer>0</layer>
        <bloomGroup>MX_ScreenBloom_Glow</bloomGroup>
        <bloomTint>(1, 0.55, 0.75, 1)</bloomTint>
        <bloomIntensity>1.6</bloomIntensity>
        <particleGroup>0</particleGroup>
        <sprite>
          <!-- 高度固定 1.2 格，宽填 0 由渲染器按主贴图宽高比自动算出 -->
          <quadSize>(0, 1.2)</quadSize>
          <useParticleSize>false</useParticleSize>
          <useParticleRotation>false</useParticleRotation>
          <useParticleColor>true</useParticleColor>
          <flipV>true</flipV>
          <useAltitude>true</useAltitude>
          <altitude>MetaOverlays</altitude>
          <altitudeOffset>0.01</altitudeOffset>
          <bindings>
            <li><uniform>_Color</uniform><value>(1, 1, 1, 1)</value></li>
            <li><uniform>_Brightness</uniform><floatValue>1</floatValue></li>
            <li><uniform>_Dissolve</uniform><channel>progress</channel></li>
            <li><uniform>_NoiseScale</uniform><floatValue>1</floatValue></li>
            <li><uniform>_EdgeWidth</uniform><floatValue>0.08</floatValue></li>
            <li><uniform>_EdgeColor</uniform><value>(1, 0.6, 0.7, 1)</value></li>
            <li><uniform>_NoiseTex</uniform><texture>MiliraXianQinghe/Effect/lotus_shield_dissolve_noise</texture></li>
          </bindings>
        </sprite>
      </li>
    </passes>
  </MiliraXian.Characters.Common.Vfx.Emitter.VfxDef>

  <MiliraXian.Characters.Common.Vfx.Emitter.VfxDef>
    <defName>MX_Vfx_BellWave</defName>
    <lifetimeSeconds>1.08</lifetimeSeconds>
    <fadeOutSeconds>0</fadeOutSeconds>
    <requireMaintain>false</requireMaintain>
    <capacity>0</capacity>
    <emitterClass>MiliraXian.Characters.QingHe.Things.Projectiles.BellWaveEmitter</emitterClass>
    <modExtensions>
      <li Class="MiliraXian.Characters.QingHe.Things.Projectiles.BellWaveVfxExtension">
        <ringSeconds>0.9</ringSeconds>
        <emitFlash>false</emitFlash>
      </li>
    </modExtensions>

    <!-- 花铃音符冲击波：穹顶光幕与地面环 + 空气折射透镜 -->
    <passes>
      <li>
        <name>wave</name>
        <renderer>Field</renderer>
        <texture>White</texture>
        <shaderDef>MX_QH_BellWave</shaderDef>
        <layer>0</layer>
        <bloomGroup>MX_ScreenBloom_Glow</bloomGroup>
        <bloomIntensity>1.35</bloomIntensity>
        <field>
          <sizeChannel>bellWaveQuad</sizeChannel>
          <sizeUniform>_FieldSize</sizeUniform>
          <useAltitude>true</useAltitude>
          <altitude>MoteOverhead</altitude>
          <altitudeOffset>-0.01</altitudeOffset>
          <bindings>
            <li><uniform>_Wave</uniform><vecChannel>bellWaveWave</vecChannel></li>
            <li><uniform>_Shell</uniform><value>(0.05, 4, 0.5, 0.56)</value></li>
            <li><uniform>_Foot</uniform><value>(0.02, 0.53, 0.058, 0.164)</value></li>
            <li><uniform>_Glow</uniform><vecChannel>bellWaveGlow</vecChannel></li>
            <li><uniform>_Core</uniform><vecChannel>bellWaveCore</vecChannel></li>
            <li><uniform>_FadePow</uniform><floatValue>1</floatValue></li>
          </bindings>
        </field>
      </li>

      <li>
        <name>distort</name>
        <renderer>Field</renderer>
        <texture>White</texture>
        <shaderDef>MX_QH_BellWaveDistort</shaderDef>
        <layer>0</layer>
        <field>
          <sizeChannel>bellWaveQuad</sizeChannel>
          <sizeUniform>_FieldSize</sizeUniform>
          <useAltitude>true</useAltitude>
          <altitude>MoteOverhead</altitude>
          <altitudeOffset>-0.01</altitudeOffset>
          <bindings>
            <li><uniform>_Wave</uniform><vecChannel>bellWaveDistortWave</vecChannel></li>
            <li><uniform>_DistortScale</uniform><frame>screenPerCell</frame></li>
            <li><uniform>_DistortParams</uniform><value>(1.5, 0.05, 0, 0)</value></li>
          </bindings>
        </field>
      </li>
    </passes>
  </MiliraXian.Characters.Common.Vfx.Emitter.VfxDef>

