<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <MiliraXian.Characters.Neiyu.NeiyuSwordCombatDef>
    <defName>MX_NeiyuSwordCombat</defName>
    <sword>MX_Neiyu_Form_Weapon</sword>
    <executionJob>MX_NeiyuPostureExecution</executionJob>
    <!-- 架势上限、恢复、破绽和崩溃窗口改由通用的 MX_CombatPosture（MiliraXian_CombatPosture.xml）配置 -->
    <!-- 近战先判弹刀，失败后判闪避。完美概率为绝对概率，不作第二次抽签。 -->
    <successChance>0.60</successChance>
    <perfectChance>0.15</perfectChance>
    <reflectProjectiles>true</reflectProjectiles>
    <projectileReturnSpreadDegrees>4</projectileReturnSpreadDegrees>
    <normalPosture>25</normalPosture>
    <perfectPosture>45</perfectPosture>
    <perfectStunTicks>45</perfectStunTicks>
    <executionTicks>84</executionTicks>
    <dashFraction>0.18</dashFraction>
    <strikeFraction>0.40</strikeFraction>
    <recoverFraction>0.61</recoverFraction>
    <executionRange>2</executionRange>
    <visualIntensity>1</visualIntensity>
    <maxVisuals>96</maxVisuals>
    <sparksPerDeflection>12</sparksPerDeflection>
    <normalSound>MX_NeiyuSwordDeflect</normalSound>
    <perfectSound>MX_NeiyuSwordPerfect</perfectSound>
    <breakSound>MX_NeiyuSwordBreak</breakSound>
    <prepareSound>MX_NeiyuSwordPrepare</prepareSound>
    <strikeSound>MX_NeiyuSwordStrike</strikeSound>
    <endSound>MX_NeiyuSwordEnd</endSound>
  </MiliraXian.Characters.Neiyu.NeiyuSwordCombatDef>

  <JobDef>
    <defName>MX_NeiyuPostureExecution</defName>
    <driverClass>MiliraXian.Characters.Neiyu.JobDriver_NeiyuPostureExecution</driverClass>
    <reportString>正在斩断TargetA的架势。</reportString>
    <allowOpportunisticPrefix>false</allowOpportunisticPrefix>
    <casualInterruptible>false</casualInterruptible>
    <playerInterruptible>true</playerInterruptible>
    <suspendable>false</suspendable>
    <alwaysShowWeapon>true</alwaysShowWeapon>
  </JobDef>
</Defs>
