<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 樱舞刀光：顶点已在地图坐标，顶点色带沿刀光的淡出；亮丝加法、灰带普通混合。
       队列都排在扭曲带（3151）之后：扭曲带把抓屏前的背景画回屏幕，排在刀光后面会把刀光盖掉。
       深度测试打开、不写深度：刀环顶点按前后给了不同高度，身后那半段会被角色身体挡住。 -->
  <ShaderDef>
    <defName>MX_QH_SakuraTrailAdd</defName>
    <shaderProgram>
      <vertexShaderFileName>MX_QH_SakuraTrail.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>MX_QH_SakuraTrail.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <blendMode>Additive</blendMode>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3153</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_MainTex</key>
          <value>Repeat</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>
  <ShaderDef>
    <defName>MX_QH_SakuraTrailAlpha</defName>
    <shaderProgram>
      <vertexShaderFileName>MX_QH_SakuraTrail.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>MX_QH_SakuraTrail.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <!-- 预乘透明：片元输出 颜色×alpha，亮度大于 1 的灰带不会在写入 8 位颜色缓冲前被截成 1 -->
      <blendMode>Custom</blendMode>
      <blendSrcFactor>One</blendSrcFactor>
      <blendDstFactor>OneMinusSrcAlpha</blendDstFactor>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3152</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_MainTex</key>
          <value>Repeat</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>
  <!-- 花瓣：图集按帧取 UV，不平铺。 -->
  <ShaderDef>
    <defName>MX_QH_SakuraPetal</defName>
    <shaderProgram>
      <vertexShaderFileName>MX_QH_SakuraTrail.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>MX_QH_SakuraTrail.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <blendMode>Custom</blendMode>
      <blendSrcFactor>One</blendSrcFactor>
      <blendDstFactor>OneMinusSrcAlpha</blendDstFactor>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3154</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_MainTex</key>
          <value>Clamp</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>
  <!-- 处决击杀后的「落华」文字：预乘透明，按噪声溶解、溶解边缘发光；排在压暗（3152）之后。
       画在原版平面网格上，保留 flipTextureST 默认值（同 3D 刀身），贴图才不会上下颠倒。 -->
  <ShaderDef>
    <defName>MX_QH_ExecutionText</defName>
    <shaderProgram>
      <vertexShaderFileName>MX_QH_SakuraTrail.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>MX_QH_ExecutionText.frag.glsl</fragmentShaderFileName>
      <!-- 原版平面网格的 UV 已是正向，不再翻转（翻转后字上下颠倒） -->
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <blendMode>Custom</blendMode>
      <blendSrcFactor>One</blendSrcFactor>
      <blendDstFactor>OneMinusSrcAlpha</blendDstFactor>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3155</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_MainTex</key>
          <value>Clamp</value>
        </li>
        <li>
          <key>_NoiseTex</key>
          <value>Repeat</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>
  <!-- 扭曲带：沿用原版的 DistortionBackground 抓屏点（队列必须同为 3151，否则引擎会警告并保留原队列）。 -->
  <ShaderDef>
    <defName>MX_QH_SakuraDistort</defName>
    <shaderProgram>
      <vertexShaderFileName>MX_QH_SakuraTrail.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>MX_QH_SakuraDistort.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3151</renderQueue>
      <sceneGrab>
        <name>DistortionBackground</name>
        <queue>3151</queue>
      </sceneGrab>
      <textureWrapOverrides>
        <li>
          <key>_MainTex</key>
          <value>Repeat</value>
        </li>
        <li>
          <key>_NormalTex</key>
          <value>Repeat</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>
  <!-- 荷雨的水面：微波扭曲 + 落点法线涟漪，不贴图。沿用原版抓屏点（queue 3151）。
       荷花在 3152 之后画，不会被水下扭曲扭到。 -->
  <ShaderDef>
    <defName>MX_QH_RainWallWater</defName>
    <shaderProgram>
      <vertexShaderFileName>MX_QH_SakuraTrail.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>MX_QH_RainWallWater.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3151</renderQueue>
      <sceneGrab>
        <name>DistortionBackground</name>
        <queue>3151</queue>
      </sceneGrab>
    </shaderProgram>
  </ShaderDef>
  <!-- 荷雨的水花：离散元素走几何合批——每个雨丝落点一个小 quad，顶点色带（相位、落速、
       出环标志），片元里解析地算单环折射 + 泡沫闪光。沿用同一抓屏点（queue 3151），
       画在基础水面之上、荷花之下。 -->
  <ShaderDef>
    <defName>MX_QH_RainWallSplash</defName>
    <shaderProgram>
      <vertexShaderFileName>MX_QH_SakuraTrail.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>MX_QH_RainWallSplash.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3151</renderQueue>
      <sceneGrab>
        <name>DistortionBackground</name>
        <queue>3151</queue>
      </sceneGrab>
    </shaderProgram>
  </ShaderDef>
  <!-- 荷雨的雨幕：一个 quad，uv 是相对墙心的格偏移，水雾在片元里逐像素积分。
       雨丝不在 shader 里——雨丝是离散元素，由 RainWallVfx 在 CPU 上模拟、AddStreak 合批画出。
       和铃音冲击波同构；加法混合、不写深度、双面。 -->
  <ShaderDef>
    <defName>MX_QH_RainWall</defName>
    <shaderProgram>
      <vertexShaderFileName>MX_QH_SakuraTrail.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>MX_QH_RainWall.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <blendMode>Additive</blendMode>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3153</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_MainTex</key>
          <value>Repeat</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>
  <!-- 荷雨地面：水痕压暗 + 涟漪 + 边界。预乘透明是必须的：输出的 alpha 就是压暗量，
       rgb 是叠在上面的光，一次混合同时做到「乘法压暗」和「加法提亮」。
       加法混合做不到压暗，这就是之前地面一片空白的原因。 -->
  <ShaderDef>
    <defName>MX_QH_RainWallGround</defName>
    <shaderProgram>
      <vertexShaderFileName>MX_QH_SakuraTrail.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>MX_QH_RainWallGround.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <blendMode>Custom</blendMode>
      <blendSrcFactor>One</blendSrcFactor>
      <blendDstFactor>OneMinusSrcAlpha</blendDstFactor>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <!-- 排在地面高度，但要让原版地块先画完：3100 早于本 Mod 的其他特效，仍晚于地形。 -->
      <renderQueue>3100</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_MainTex</key>
          <value>Repeat</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>
  <!-- 荷雨的荷花：贴图裁切后按 alpha 混合，不做加法（花是要有实体的）。
      和花瓣（MX_QH_SakuraPetal）同参数：SrcAlpha / OneMinusSrcAlpha，不是预乘——
      预乘会把半透明边缘的黑底带出来，看起来像 Cutout。
      排在雨幕之前（3152 < 3153）：预览里是先落花、再蒙一层薄雨纱。 -->
  <ShaderDef>
    <defName>MX_QH_RainWallLotus</defName>
    <shaderProgram>
      <vertexShaderFileName>MX_QH_SakuraTrail.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>MX_QH_SakuraTrail.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <blendMode>Custom</blendMode>
      <blendSrcFactor>SrcAlpha</blendSrcFactor>
      <blendDstFactor>OneMinusSrcAlpha</blendDstFactor>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3152</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_MainTex</key>
          <value>Clamp</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>
</Defs>
