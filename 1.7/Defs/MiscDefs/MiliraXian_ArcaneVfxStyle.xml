<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <MiliraXian.Characters.Common.Vfx.ArcaneVfxStyleDef>
    <defName>MX_ArcaneVfxStyle</defName>
    <!-- Distance field values use source texels; they never change the geometry. -->
    <strokeExpansion>1.35</strokeExpansion>
    <coreWidth>0.58</coreWidth>
    <glowRadius>5.5</glowRadius>
    <glowIntensity>0.32</glowIntensity>
    <flowIntensity>0.28</flowIntensity>
    <circleOpacity>0.88</circleOpacity>
    <pulseIntensity>0.48</pulseIntensity>
    <beamIntensity>0.82</beamIntensity>
    <trailWidth>1</trailWidth>
    <particleDensity>1</particleDensity>
    <particleSizeMin>0.075</particleSizeMin>
    <particleSizeMax>0.21</particleSizeMax>
    <dustLifetime>1.6</dustLifetime>
    <explosionParticleDensity>1</explosionParticleDensity>
    <!-- Visual timing within the existing chant. Five stages grow by this ratio. -->
    <chantStageLengthening>1.3</chantStageLengthening>
    <chantBeatInterval>0.75</chantBeatInterval>
    <chantBeatLengthening>2.4</chantBeatLengthening>
    <chantSealFraction>0.05</chantSealFraction>
    <chantConvergeFraction>0.08</chantConvergeFraction>
    <chantAfterglowFraction>0.04</chantAfterglowFraction>
  </MiliraXian.Characters.Common.Vfx.ArcaneVfxStyleDef>

  <ShaderDef>
    <defName>MX_ArcaneStroke</defName>
    <shaderProgram>
      <vertexShaderFileName>WorldArcaneStrike/Arcane.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>WorldArcaneStrike/ArcaneStroke.frag.glsl</fragmentShaderFileName>
      <blendMode>Custom</blendMode>
      <blendSrcFactor>One</blendSrcFactor>
      <blendDstFactor>OneMinusSrcAlpha</blendDstFactor>
      <transparent>true</transparent>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3150</renderQueue>
      <textureWrapOverrides><li><key>_MainTex</key><value>Clamp</value></li></textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>
