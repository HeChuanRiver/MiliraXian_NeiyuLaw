<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ShaderDef>
        <defName>MX_QH_AuraShieldPetal</defName>
        <shaderProgram>
            <vertexShaderFileName>MX_QH_AuraShield.vert.glsl</vertexShaderFileName>
            <fragmentShaderFileName>MX_QH_AuraShield.frag.glsl</fragmentShaderFileName>
            <blendMode>Additive</blendMode>
            <depthWrite>false</depthWrite>
            <cullMode>None</cullMode>
            <!-- 护盾是伪发光体，须画在原版阴影之上：SunShadow 3170、SunShadowFade/FogOfWar 3175、
                 Darkness 3180（队列大的后画），并低于 GlowOverlay/雨 3201。光晕用 3190，在盾体之下。 -->
            <renderQueue>3191</renderQueue>
        </shaderProgram>
    </ShaderDef>
</Defs>
