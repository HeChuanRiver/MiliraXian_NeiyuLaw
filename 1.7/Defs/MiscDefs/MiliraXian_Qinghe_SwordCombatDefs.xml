<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ToolCapacityDef>
        <defName>MX_QH_SwordCut</defName>
        <label>散华斩击</label>
    </ToolCapacityDef>

    <!-- 剑舞架势普攻的扫掠出伤：每次接触交回散华斩击自己判定命中、闪避、格挡和战斗日志 -->
    <MiliraXian.Characters.Common.SweepDamage.SweepDamageDef>
        <defName>MX_QH_SwordSweep</defName>
        <targetFaction>Hostile</targetFaction>
        <hitPawns>true</hitPawns>
        <hitBuildings>true</hitBuildings>
        <requireLineOfSight>true</requireLineOfSight>
        <damageDelayTicks>0</damageDelayTicks>
        <workerClass>MiliraXian.Characters.Common.SweepDamage.SweepDamageWorker_Verb</workerClass>
    </MiliraXian.Characters.Common.SweepDamage.SweepDamageDef>

    <!--
      剑舞架势的防御（初值，实机再调）。防御在敌人命中判定之前：
      空闲或最后一斩之后：停下举刀防御，按「化解几率」弹开，否则普通格挡；
      防御中再受击：必定弹开，防御延长（逐次递减）；
      收刀和蓄势（举刀）中受近战攻击：必定弹开并立即反击追斩；
      拔刀到最后一斩结束：不防御，被近战打中时自身额外受架势伤害。
    -->
    <MiliraXian.Characters.QingHe.Things.Weapons.QingheSwordGuardDef>
        <defName>MX_QH_SwordGuard</defName>
        <!-- 处决固定是散华的居合：播放散华动作集里的十字斩片段，手上也画散华（伤害固定，与手持武器无关） -->
        <executionWeapon>MX_QH_Weapon_Sword</executionWeapon>
        <!--
          剑舞的防御动作，任何近战武器都一样（动作是剑舞的，刀长什么样是武器的事）。
          投影和清荷的身体对齐（同散华动作集）。化解动作接十字斩反击，留在散华上。
        -->
        <guardMotion>
            <heightToScreen>0.35</heightToScreen>
            <heightOrigin>-0.63</heightOrigin>
            <depthToScreen>0.55</depthToScreen>
            <blendSeconds>0.08</blendSeconds>
            <!-- 防御（手写初值）：右手持刀横架在身前，刀尖朝左略上挑，刃口朝外；举到位后保持 -->
            <guard>
                <durationSeconds>0.12</durationSeconds>
                <blade>
                    <keys>
                        <li><time>0</time><yaw>-80.0</yaw><pitch>20.0</pitch><roll>0</roll><reach>0</reach><offset>(0.140, 0.240, 0.330)</offset></li>
                        <li><time>0.12</time><yaw>-90.0</yaw><pitch>14.0</pitch><roll>0</roll><reach>0</reach><offset>(0.160, 0.250, 0.360)</offset></li>
                    </keys>
                </blade>
            </guard>
            <!-- 防御受击：刀被压回半寸、身体后仰一下，0.15 秒回到防御姿势 -->
            <guardHit>
                <durationSeconds>0.15</durationSeconds>
                <blade>
                    <keys>
                        <li><time>0</time><yaw>-96.0</yaw><pitch>22.0</pitch><roll>-6.0</roll><reach>0</reach><offset>(0.150, 0.270, 0.240)</offset></li>
                        <li><time>0.15</time><yaw>-90.0</yaw><pitch>14.0</pitch><roll>0</roll><reach>0</reach><offset>(0.160, 0.250, 0.360)</offset></li>
                    </keys>
                </blade>
                <bodyForward><points><li>(0, -0.07)</li><li>(0.15, 0)</li></points></bodyForward>
                <tilt><points><li>(0, -4)</li><li>(0.15, 0)</li></points></tilt>
            </guardHit>
        </guardMotion>
        <guardTicks>30</guardTicks>
        <extendTicks>
            <li>12</li>
            <li>8</li>
            <li>5</li>
            <li>3</li>
        </extendTicks>
        <!-- 格挡、弹开给攻击者的架势 -->
        <blockAttackerPosture>5</blockAttackerPosture>
        <parryAttackerPosture>20</parryAttackerPosture>
        <!-- 化解（收刀途中弹开）给攻击者的架势 -->
        <counterAttackerPosture>30</counterAttackerPosture>
        <!-- 普攻十字斩每斩、化解反击每次命中给敌人的架势（被对方格挡时不给） -->
        <attackPosture>5</attackPosture>
        <counterCutPosture>10</counterCutPosture>
        <!--
          弹开近战后攻击者硬直（原版眩晕，期间它的冷却暂停），清荷先手出招。
          2 秒：反击（约 1.53 秒）+ 下一次起手（1.45 秒）+ 两斩（约 0.35 秒）共约 3.33 秒，
          冷却 1.5–2.6 秒的常见敌人在此之后才出下一招，落在清荷收势可防御的时段
        -->
        <parryStaggerTicks>120</parryStaggerTicks>
        <!--
          收刀途中化解（弹开并反击）时攻击者的硬直，3.5 秒。
          化解后清荷：反击出刀 0.4、反击结束 1.93、冷却后起手 2.93、闪光 3.71、两斩结束 4.73 秒；
          被化解的敌人下一招在 3.5 + 自身冷却（1.5–2.6 秒）= 5.0–6.1 秒，都落在收势可防御的时段。
          面对多个敌人时只对被化解的那一个有效。
        -->
        <counterStaggerTicks>210</counterStaggerTicks>
        <!-- 化解动作（弹开到反击出刀之间）0.4 秒；期间再受攻击只弹开，不再反击 -->
        <parryTicks>24</parryTicks>
        <!-- 反击斩完、回正之后再等 1 秒才能重新起手；期间只能普通防御和弹开，不能化解 -->
        <counterRecoveryTicks>60</counterRecoveryTicks>
        <!--
          十字斩举刀追击（格）：举刀 1.45 秒里目标走开时，只要清荷能在这个距离内落到它身旁（有视线、可站、能直线过去），
          举刀就不取消，拔刀那一刻落到它身旁出刀（真实移动，身体沿途画过去）。起手仍要贴身。
        -->
        <chaseRange>4</chaseRange>
        <projectileBlockSelfPosture>8</projectileBlockSelfPosture>
        <!--
          清荷受到近战攻击时自己的架势。攻击带架势伤害（十字斩、化解反击）时按它算：普通格挡给 blockCarriedPostureShare（一半），
          弹开、化解为 0，没挡住为全额；不带时普通格挡 blockSelfPosture、弹开化解 0、没挡住 struckSelfPosture。
          伤害被护盾等吸收、没有造成伤口时，只给 25%。
        -->
        <blockSelfPosture>5</blockSelfPosture>
        <blockCarriedPostureShare>0.5</blockCarriedPostureShare>
        <struckSelfPosture>10</struckSelfPosture>

        <!--
          特效（照只狼 201001 格挡、252001/253001 弹刀、261001 尘环的结构重做，贴图用樱舞的 Glow）。
          位置在清荷刀身上（contactShare：从握把起算的刀长比例），火花朝攻击者方向喷出、减速后下坠。
          单位：地图格、秒；加法部分的 alpha 可以大于 1（更亮）。
        -->
        <contactShare>0.7</contactShare>
        <vfxTexPath>MiliraXianQinghe/Effect/SakuraDance/Glow</vfxTexPath>
        <bloom>
            <group>MX_ScreenBloom_Glow</group>
            <tint>(1, 0.85, 0.7, 1)</tint>
            <intensity>1</intensity>
        </bloom>
        <!-- 普通格挡：小火花、小闪光、灰色尘环 -->
        <blockVfx>
            <flashSize>0.6</flashSize>
            <flashSeconds>0.12</flashSeconds>
            <flashAlpha>1.6</flashAlpha>
            <flashColor>(1, 0.72, 0.45, 1)</flashColor>
            <sparks>12</sparks>
            <sparkSpeed>1.5~3.5</sparkSpeed>
            <sparkLife>0.12~0.28</sparkLife>
            <sparkSpread>120</sparkSpread>
            <sparkWidth>0.022</sparkWidth>
            <sparkAlpha>2.5</sparkAlpha>
            <dustStart>0.15</dustStart>
            <dustEnd>0.75</dustEnd>
            <dustWidth>0.22</dustWidth>
            <dustSeconds>0.5</dustSeconds>
            <dustAlpha>0.3</dustAlpha>
            <sound>MX_QH_SwordBlock</sound>
        </blockVfx>
        <!-- 弹开：橙色闪光 + 星芒、30 多道火花、白色扩散冲击环 -->
        <parryVfx>
            <flashSize>1.2</flashSize>
            <flashSeconds>0.2</flashSeconds>
            <flashAlpha>2.5</flashAlpha>
            <flashColor>(1, 0.6, 0.3, 1)</flashColor>
            <needleLength>1.0</needleLength>
            <needleWidth>0.035</needleWidth>
            <needleSeconds>0.07</needleSeconds>
            <needleAlpha>3</needleAlpha>
            <sparks>34</sparks>
            <sparkSpeed>2.5~5.5</sparkSpeed>
            <sparkLife>0.15~0.4</sparkLife>
            <sparkSpread>135</sparkSpread>
            <sparkAlpha>3</sparkAlpha>
            <ringStart>0.1</ringStart>
            <ringEnd>0.9</ringEnd>
            <ringWidth>0.08</ringWidth>
            <ringSeconds>0.22</ringSeconds>
            <ringAlpha>1.6</ringAlpha>
            <sound>MX_QH_SwordParry</sound>
        </parryVfx>
        <!-- 化解：弹开再放大一档，闪光和冲击环更大，加一层尘环 -->
        <counterVfx>
            <flashSize>1.7</flashSize>
            <flashSeconds>0.26</flashSeconds>
            <flashAlpha>3.2</flashAlpha>
            <flashColor>(1, 0.82, 0.55, 1)</flashColor>
            <needleLength>1.6</needleLength>
            <needleWidth>0.045</needleWidth>
            <needleSeconds>0.09</needleSeconds>
            <needleAlpha>4</needleAlpha>
            <needleAngle>22</needleAngle>
            <sparks>40</sparks>
            <sparkSpeed>3~6.5</sparkSpeed>
            <sparkLife>0.18~0.45</sparkLife>
            <sparkSpread>150</sparkSpread>
            <sparkAlpha>3.5</sparkAlpha>
            <ringStart>0.1</ringStart>
            <ringEnd>1.4</ringEnd>
            <ringWidth>0.1</ringWidth>
            <ringSeconds>0.3</ringSeconds>
            <ringAlpha>2.2</ringAlpha>
            <dustStart>0.2</dustStart>
            <dustEnd>1.1</dustEnd>
            <dustWidth>0.3</dustWidth>
            <dustSeconds>0.6</dustSeconds>
            <dustAlpha>0.35</dustAlpha>
            <sound>MX_QH_SwordCounter</sound>
        </counterVfx>
        <!-- 敌人架势崩溃：金红色的环向内收紧，加一圈火花 -->
        <breakVfx>
            <flashSize>1.0</flashSize>
            <flashSeconds>0.2</flashSeconds>
            <flashAlpha>2</flashAlpha>
            <flashColor>(1, 0.35, 0.2, 1)</flashColor>
            <sparks>18</sparks>
            <sparkSpeed>1.5~3</sparkSpeed>
            <sparkLife>0.2~0.4</sparkLife>
            <sparkSpread>360</sparkSpread>
            <sparkCool>(1, 0.2, 0.1, 1)</sparkCool>
            <ringStart>1.1</ringStart>
            <ringEnd>0.25</ringEnd>
            <ringWidth>0.07</ringWidth>
            <ringSeconds>0.35</ringSeconds>
            <ringAlpha>2</ringAlpha>
            <ringColor>(1, 0.55, 0.25, 1)</ringColor>
            <sound>MX_QH_SwordPostureBreak</sound>
        </breakVfx>
        <!--
          处决命中（收刀"咔"的一声）：转身收刀时敌人身上依次浮现三道交错的细斩痕（一刀里藏了几刀），
          刀完全入鞘的一刻斩痕一起爆开（迅速延长、变宽泛粉光，周围空气扭曲，再收成一线消失），同时白红闪光、针光、红火花、樱花瓣四散。
          burstDelay：斩痕比爆开早出现的秒数（效果提前这么多秒加入，爆开对准中刀；音效在中刀时播）。
          斩痕角度相对"清荷→敌人"方向，offset 为侧移，delay 为相对效果加入的出现时间。
        -->
        <executionVfx>
            <burstDelay>0.45</burstDelay>
            <cuts>
                <li><angle>-12</angle><length>2.0</length><offset>0</offset><delay>0</delay><width>1.2</width></li>
                <li><angle>58</angle><length>1.6</length><offset>0.08</offset><delay>0.12</delay></li>
                <li><angle>-74</angle><length>1.5</length><offset>-0.1</offset><delay>0.24</delay><width>0.9</width></li>
            </cuts>
            <cutGrowSeconds>0.07</cutGrowSeconds>
            <cutWaitShare>0.35</cutWaitShare>
            <cutFadeSeconds>0.4</cutFadeSeconds>
            <cutWidth>0.08</cutWidth>
            <cutAlpha>3.5</cutAlpha>
            <!-- 斩痕外层粉色、内芯淡粉白；爆开时 0.08 秒内向两端延长到 1.5 倍 -->
            <cutColor>(1, 0.55, 0.72, 1)</cutColor>
            <cutCoreColor>(1, 0.9, 0.95, 1)</cutCoreColor>
            <cutBurstStretch>1.5</cutBurstStretch>
            <cutStretchSeconds>0.08</cutStretchSeconds>
            <!-- 斩痕自己的泛光（粉） -->
            <cutBloom>
                <group>MX_ScreenBloom_Glow</group>
                <tint>(1, 0.6, 0.78, 1)</tint>
                <intensity>1.4</intensity>
            </cutBloom>
            <!-- 爆开后沿斩痕的扭曲带（同普通刀光的扭曲带），宽 0.5，0.5 秒内减弱消失 -->
            <cutDistortWidth>0.5</cutDistortWidth>
            <cutDistortSeconds>0.5</cutDistortSeconds>
            <cutDistortIntensity>5</cutDistortIntensity>
            <petals>22</petals>
            <petalSpeed>1.5~4</petalSpeed>
            <petalLife>0.9~1.7</petalLife>
            <petalSpread>360</petalSpread>
            <petalDrag>4</petalDrag>
            <petalFall>0.35</petalFall>
            <petalSway>0.12</petalSway>
            <petalSize>0.22~0.34</petalSize>
            <flashSize>1.8</flashSize>
            <flashSeconds>0.3</flashSeconds>
            <flashAlpha>3</flashAlpha>
            <flashColor>(1, 0.5, 0.45, 1)</flashColor>
            <needleLength>1.8</needleLength>
            <needleWidth>0.05</needleWidth>
            <needleSeconds>0.1</needleSeconds>
            <needleAlpha>4</needleAlpha>
            <needleAngle>10</needleAngle>
            <sparks>28</sparks>
            <sparkSpeed>2~5</sparkSpeed>
            <sparkLife>0.2~0.5</sparkLife>
            <sparkSpread>360</sparkSpread>
            <sparkHot>(1, 0.85, 0.8, 1)</sparkHot>
            <sparkCool>(0.9, 0.12, 0.1, 1)</sparkCool>
            <sound>MX_QH_SwordExecutionHit</sound>
        </executionVfx>

        <!--
          处决（居合·过身斩）：清荷打满敌人架势后，敌人原地破绽（等她出刀、反击结束），她到能出手的时机就处决。
          动作用十字斩片段分段重放（执行秒 start–end 播片段秒 clipFrom→clipTo，clipTo 小于 clipFrom 时倒放）：
          0–0.6 面向敌人收刀入鞘（片段 0.15→0.783，鞘口闪光）；0.6–0.85 蓄势（0.783→1.45，压缩）；
          0.85–1.05 拔刀冲刺（dash）：第一斩斜撩（1.45→1.633），穿过敌人落到它身后一格，留残影，敌人身上一道斩痕；
          1.05–1.5 背对敌人停刀、慢速回挥（1.8→2.4）；
          1.5–2.1 转身面向敌人收刀（aimBack，0.15→0.783）；刀完全入鞘（2.1 秒，鞘口闪光）时敌人中刀；
          2.1–2.4 残心；2.4–2.7 刀出鞘回到待机（倒放 0.783→0.15）。
          冲刺是真实移动：格子在拔刀那一刻换到敌人身后，身体沿途画过去。冲刺也是吸附：敌人在 executionRange 内（视线可达）就能处决，
          不必贴身（樱舞等范围技能常打崩远处的敌人）。身后没有空格时：已贴身就原地拔刀；不贴身就落到敌人旁边任一空格；
          旁边一个空格都没有则放弃处决、解除破绽。
          伤害：对核心部位（人类为躯干）一击 100 点、穿甲 2，按原版伤害结算；没死则接致命一击（见 killMotion）。中刀时清荷自己的架势清空（被拦截也一样）。固定给 1 档剑压（不受夏共鸣加成）。处决全程无敌（同樱舞：不受伤害、不加架势、不能被处决、不被眩晕，敌人的雷返也一样），不再弹开攻击。
        -->
        <!-- 居合收刀中刀那一刻的鞘口闪光：与十字斩开头的收刀闪光同款，粉色（处决开头收刀仍用武器的白色闪光） -->
        <executionHitFlash>
            <texPath>MiliraXianQinghe/Effect/SakuraDance/Glow</texPath>
            <color>(1, 0.55, 0.75, 1)</color>
            <needleLength>0.9</needleLength>
            <needleWidth>0.04</needleWidth>
            <needleSeconds>0.067</needleSeconds>
            <needleBrightness>4</needleBrightness>
            <needleAngle>55</needleAngle>
            <barLength>1.4</barLength>
            <barWidth>0.08</barWidth>
            <barSeconds>0.2</barSeconds>
            <barBrightness>2.5</barBrightness>
            <haloSize>0.9</haloSize>
            <haloEndSize>0.5</haloEndSize>
            <haloSeconds>0.2</haloSeconds>
            <haloBrightness>1.5</haloBrightness>
        </executionHitFlash>
        <executionJob>MX_QH_SwordExecution</executionJob>
        <executionAttack>0</executionAttack>
        <executionSeconds>2.7</executionSeconds>
        <executionCutSeconds>0.85</executionCutSeconds>
        <executionHitSeconds>2.1</executionHitSeconds>
        <executionMotion>
            <li><start>0</start><end>0.6</end><clipFrom>0.15</clipFrom><clipTo>0.783</clipTo><blend>0.12</blend></li>
            <li><start>0.6</start><end>0.85</end><clipFrom>0.783</clipFrom><clipTo>1.45</clipTo><blend>0.02</blend></li>
            <li><start>0.85</start><end>1.05</end><clipFrom>1.45</clipFrom><clipTo>1.633</clipTo><blend>0.02</blend><dash>true</dash></li>
            <li><start>1.05</start><end>1.5</end><clipFrom>1.8</clipFrom><clipTo>2.4</clipTo><blend>0.06</blend></li>
            <li><start>1.5</start><end>2.1</end><clipFrom>0.15</clipFrom><clipTo>0.783</clipTo><blend>0.15</blend><aimBack>true</aimBack></li>
            <li><start>2.1</start><end>2.4</end><clipFrom>0.783</clipFrom><clipTo>0.783</clipTo><blend>0.02</blend><aimBack>true</aimBack></li>
            <li><start>2.4</start><end>2.7</end><clipFrom>0.783</clipFrom><clipTo>0.15</clipTo><blend>0.02</blend><aimBack>true</aimBack></li>
        </executionMotion>
        <executionAfterimages>4</executionAfterimages>
        <!-- 冲刺穿过时敌人身上的斩痕：沿冲刺方向一道亮线 + 火花 -->
        <executionDashVfx>
            <slashLength>2.2</slashLength>
            <slashWidth>0.09</slashWidth>
            <slashSeconds>0.35</slashSeconds>
            <slashAlpha>3.5</slashAlpha>
            <slashAngle>-12</slashAngle>
            <flashSize>0.9</flashSize>
            <flashSeconds>0.12</flashSeconds>
            <flashAlpha>2</flashAlpha>
            <flashColor>(1, 0.85, 0.75, 1)</flashColor>
            <sparks>14</sparks>
            <sparkSpeed>2~4.5</sparkSpeed>
            <sparkLife>0.12~0.3</sparkLife>
            <sparkSpread>60</sparkSpread>
            <sparkAlpha>2.5</sparkAlpha>
        </executionDashVfx>
        <!-- 处决距离（格）：大约是樱舞的范围，超出则敌人只原地破绽、恢复，不处决 -->
        <executionRange>12</executionRange>
        <executionDamageDef>MX_QH_ExecutionSlash</executionDamageDef>
        <!-- 居合中刀（判定伤害或被流水之形等拦截）时，清荷自己的架势清空 -->
        <executionDamage>100</executionDamage>
        <!--
          致命一击（手写初值，实机再调）：居合中刀且没被拦截（流水之形等）、敌人仍活着且没有免死保护时，
          不再残心收势，而是从 killStartSeconds（执行秒，即中刀那一刻）起播放这段：
          中刀后先残心 0.3 秒（2.1–2.4，刀在鞘里静止），再接：
          0–0.25 拔刀，刀尖朝前收到腰侧；0.25–0.7 前摇：后坐蓄力、刀往后拉；0.7–0.82 踏前平刺贯穿；
          0.82–1.62 刺入后停顿 0.8 秒（身体前压、刀不动）；1.62–1.74 猛地抽刀（1.68 秒刀出体外的瞬间敌人死亡，
          伤口处爆出花瓣，压暗、显示「落华」）；1.74–2.07 振刀甩血；2.82 秒回到待机。
          朝向是冲刺落点面向敌人。免死的目标（不死基因、免死 Hediff）照样接这一段，但抽刀时不击杀，
          改为对核心部位造成 killWoundDamage 点伤害，只爆花瓣，不显示「落华」和压暗。
          killStartSeconds 最晚 2.4：再往后会先播普通处决的刀出鞘回待机。
        -->
        <killStartSeconds>2.4</killStartSeconds>
        <killAtSeconds>1.68</killAtSeconds>
        <killWoundDamage>200</killWoundDamage>
        <killBlendSeconds>0.1</killBlendSeconds>
        <!-- 插刀声在片段 0.78 秒（平刺贯穿），抽刀声在击杀那一刻（killAtSeconds） -->
        <killThrustSeconds>0.78</killThrustSeconds>
        <killThrustSound>MX_QH_SwordExecutionThrust</killThrustSound>
        <killDrawSound>MX_QH_SwordExecutionKillDraw</killDrawSound>
        <!-- 插刀闪光：贯穿那一刻在刀身 90% 处（刀尖附近）一闪，与收刀闪光同款，粉色 -->
        <killThrustFlashShare>0.9</killThrustFlashShare>
        <killThrustFlash>
            <texPath>MiliraXianQinghe/Effect/SakuraDance/Glow</texPath>
            <color>(1, 0.55, 0.75, 1)</color>
            <needleLength>0.9</needleLength>
            <needleWidth>0.04</needleWidth>
            <needleSeconds>0.067</needleSeconds>
            <needleBrightness>4</needleBrightness>
            <needleAngle>55</needleAngle>
            <barLength>1.4</barLength>
            <barWidth>0.08</barWidth>
            <barSeconds>0.2</barSeconds>
            <barBrightness>2.5</barBrightness>
            <haloSize>0.9</haloSize>
            <haloEndSize>0.5</haloEndSize>
            <haloSeconds>0.2</haloSeconds>
            <haloBrightness>1.5</haloBrightness>
        </killThrustFlash>
        <killMotion>
            <durationSeconds>2.82</durationSeconds>
            <turnCarriesBlade>false</turnCarriesBlade>
            <!-- 全程面向敌人（转向 0 = 朝瞄准方向）；没有这条时小人保持冲刺后的朝向 -->
            <turn><points><li>(0, 0)</li><li>(2.82, 0)</li></points></turn>
            <blade>
                <keys>
                    <li><time>0</time><yaw>-30.0</yaw><pitch>10.0</pitch><roll>-90.0</roll><reach>0.2</reach><offset>(0.000, 0.100, 0.100)</offset></li>
                    <!-- 刀尖朝前收到腰侧 -->
                    <li><time>0.25</time><yaw>-5.0</yaw><pitch>0.0</pitch><roll>-90.0</roll><reach>0</reach><offset>(0.050, 0.050, -0.150)</offset></li>
                    <!-- 前摇：刀往后再拉半尺蓄力 -->
                    <li><time>0.7</time><yaw>-3.0</yaw><pitch>2.0</pitch><roll>-90.0</roll><reach>0</reach><offset>(0.060, 0.060, -0.260)</offset></li>
                    <!-- 平刺贯穿 -->
                    <li><time>0.82</time><yaw>0.0</yaw><pitch>-5.0</pitch><roll>-90.0</roll><reach>1</reach><offset>(0.000, 0.000, 0.100)</offset></li>
                    <!-- 刺入后停顿：只再往里压一点 -->
                    <li><time>1.62</time><yaw>0.0</yaw><pitch>-5.0</pitch><roll>-90.0</roll><reach>1</reach><offset>(0.000, 0.000, 0.130)</offset></li>
                    <!-- 猛地抽出 -->
                    <li><time>1.74</time><yaw>0.0</yaw><pitch>0.0</pitch><roll>-90.0</roll><reach>0.2</reach><offset>(0.000, 0.050, -0.150)</offset></li>
                    <!-- 振刀甩血 -->
                    <li><time>2.07</time><yaw>60.0</yaw><pitch>-30.0</pitch><roll>-60.0</roll><reach>0.8</reach><offset>(0.000, 0.000, 0.000)</offset></li>
                    <li><time>2.82</time><yaw>-12.0</yaw><pitch>65.0</pitch><roll>-90.0</roll><reach>0</reach><offset>(-0.020, 0.130, 0.380)</offset></li>
                </keys>
            </blade>
            <!-- 刀从鞘里拔出：开头还有一截在鞘内 -->
            <sheathed><points><li>(0, 0.75)</li><li>(0.12, 0)</li></points></sheathed>
            <!-- 前摇后坐，刺出前冲，停顿时再压半步，抽刀时退回 -->
            <bodyForward><points><li>(0, 0)</li><li>(0.25, -0.05)</li><li>(0.7, -0.12)</li><li>(0.82, 0.3)</li><li>(1.62, 0.34)</li><li>(1.74, 0.2)</li><li>(2.07, 0.1)</li><li>(2.82, 0)</li></points></bodyForward>
            <height><points><li>(0, 0)</li><li>(0.7, -0.04)</li><li>(0.82, -0.08)</li><li>(1.62, -0.09)</li><li>(1.74, -0.05)</li><li>(2.82, 0)</li></points></height>
            <tilt><points><li>(0, 0)</li><li>(0.7, -3)</li><li>(0.82, 6)</li><li>(1.62, 7)</li><li>(1.74, 1)</li><li>(2.07, -3)</li><li>(2.82, 0)</li></points></tilt>
        </killMotion>
        <!--
          抽刀那一刻从伤口爆出的花瓣：刀身 60% 处（刺穿敌人的那一段），随抽刀方向（朝清荷）散开，
          迅速减速后摇曳飘落。只用花瓣，没有闪光、火花和声音。
        -->
        <killPetalShare>0.6</killPetalShare>
        <killPetalVfx>
            <petals>16</petals>
            <petalSpeed>1.5~3.5</petalSpeed>
            <petalLife>1.8~3</petalLife>
            <petalSpread>140</petalSpread>
            <petalDrag>3.5</petalDrag>
            <petalFall>0.3</petalFall>
            <petalSway>0.18</petalSway>
            <petalSize>0.2~0.32</petalSize>
        </killPetalVfx>
        <!-- 击杀时（抽刀那一刻）起：被杀单位位置的竖排白字「落华」和周围压暗一起缓缓淡入，
             停留后文字按噪声溶解、压暗同步淡出；文字带粉色泛光 -->
        <killVfx>
            <texPath>MiliraXianQinghe/Effect/Execution/Luohua</texPath>
            <!-- 贴图高度（格），固定大小，不随敌人体型变化。贴图上下各留 48 像素边距（共 1144 像素），
                 1.2 格时两个字连同字距正好约 1.1 格 -->
            <height>1.2</height>
            <offset>(0, 0.2)</offset>
            <color>(1, 1, 1, 1)</color>
            <brightness>1</brightness>
            <bloom>
                <group>MX_ScreenBloom_Glow</group>
                <tint>(1, 0.55, 0.75, 1)</tint>
                <intensity>1.6</intensity>
            </bloom>
            <!-- 淡入 0.7 秒，盖过振刀甩血（抽刀后约 1.1 秒回到待机） -->
            <fadeInSeconds>0.7</fadeInSeconds>
            <holdSeconds>1.2</holdSeconds>
            <dissolveSeconds>0.8</dissolveSeconds>
            <noiseTexPath>MiliraXianQinghe/Effect/lotus_shield_dissolve_noise</noiseTexPath>
            <noiseScale>1</noiseScale>
            <edgeWidth>0.08</edgeWidth>
            <edgeColor>(1, 0.6, 0.7, 1)</edgeColor>
            <!-- 压暗：半径 4 格的软边黑圆，中心最暗 65%；flatness 把全暗的中心区扩大，只留外圈渐变 -->
            <darkenRadius>4</darkenRadius>
            <darkenAlpha>0.65</darkenAlpha>
            <darkenFlatness>3</darkenFlatness>
        </killVfx>
        <executionSwordPressure>1</executionSwordPressure>
        <executionArmorPenetration>2</executionArmorPenetration>
        <executionDrawSound>MX_QH_SwordExecutionDraw</executionDrawSound>
        <!-- 清荷打崩、但破绽结束时没被处决的敌人（她忙着处决别人、够不着等）：架势只回落到上限的这个比例，
             再照常等恢复延迟后自然下降，很快能再次打崩。被处决的敌人照旧清空。 -->
        <unexecutedPostureKept>0.8</unexecutedPostureKept>
    </MiliraXian.Characters.QingHe.Things.Weapons.QingheSwordGuardDef>

    <JobDef>
        <defName>MX_QH_SwordExecution</defName>
        <driverClass>MiliraXian.Characters.QingHe.Things.Weapons.JobDriver_QingheSwordExecution</driverClass>
        <reportString>正在以居合处决TargetA。</reportString>
        <checkOverrideOnDamage>Never</checkOverrideOnDamage>
        <allowOpportunisticPrefix>false</allowOpportunisticPrefix>
        <casualInterruptible>false</casualInterruptible>
        <playerInterruptible>true</playerInterruptible>
        <suspendable>false</suspendable>
        <alwaysShowWeapon>true</alwaysShowWeapon>
    </JobDef>

    <ManeuverDef>
        <defName>MX_QH_SwordSlash</defName>
        <label>散华斩击</label>
        <requiredCapacity>MX_QH_SwordCut</requiredCapacity>
        <verb>
            <verbClass>MiliraXian.Characters.QingHe.Verbs.Verb_QingheSwordSweep</verbClass>
            <range>2.2</range>
            <meleeDamageDef>MX_QH_Slash</meleeDamageDef>
            <!-- 剑舞架势的举刀走原版施法预热，不画瞄准饼 -->
            <drawAimPie>false</drawAimPie>
        </verb>
        <logEntryDef>MeleeAttack</logEntryDef>
        <combatLogRulesHit>Maneuver_Slash_MeleeHit</combatLogRulesHit>
        <combatLogRulesDeflect>Maneuver_Slash_MeleeDeflect</combatLogRulesDeflect>
        <combatLogRulesMiss>Maneuver_Slash_MeleeMiss</combatLogRulesMiss>
        <combatLogRulesDodge>Maneuver_Slash_MeleeDodge</combatLogRulesDodge>
    </ManeuverDef>
</Defs>
