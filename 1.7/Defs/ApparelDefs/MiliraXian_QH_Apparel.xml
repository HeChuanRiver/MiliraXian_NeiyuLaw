        <apparel>
            <wearPerDay>0.4</wearPerDay>
            <useWornGraphicMask>true</useWornGraphicMask>
            <developmentalStageFilter>Adult</developmentalStageFilter>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Legs</li>
                <li>Arms</li>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Feet</li>
                <li>Hands</li>
                <li>Milira_Wings</li>
            </bodyPartGroups>
            <wornGraphicPath>MiliraXianQinghe/Apparel/apparel_qinghe_normal</wornGraphicPath>
            <tags>
                <li>MX_QingheNormal</li>
            </tags>
            <layers>
                <li>Shell</li>
            </layers>
            <shellRenderedBehindHead>true</shellRenderedBehindHead>
        </apparel>
        <tickerType>Normal</tickerType>
        <comps>
            <li Class="MiliraXian.Characters.Common.CompProperties_PawnKindEquipmentDurability">
                <protectedPawnKinds>
                    <li>MiliraXian_Qinghe</li>
                </protectedPawnKinds>
            </li>
        </comps>
        <equippedStatOffsets>
            <CarryingCapacity>+5</CarryingCapacity>
        </equippedStatOffsets>
    </ThingDef>

