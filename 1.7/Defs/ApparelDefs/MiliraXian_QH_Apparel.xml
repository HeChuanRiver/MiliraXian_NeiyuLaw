<Defs>
    <!-- 清荷：常服 -->
    <ThingDef ParentName="Milira_OnSkinBase_Neiyu">
        <defName>MX_QingheNormal</defName>
        <label>花仙子襦裙</label>
        <description>清荷日常穿着的常服。印有荷花图案，散发着淡淡的花香，材质和工艺都经过本人的精心设计，不过不太适合用于战斗。</description>
        <useHitPoints>true</useHitPoints>
        <costList>
            <Milira_Feather>200</Milira_Feather>
            <Cloth>200</Cloth>
            <Dye>100</Dye>
        </costList>
        <recipeMaker Inherit="False">
            <skillRequirements>
                <Crafting>16</Crafting>
                <Artistic>16</Artistic>
            </skillRequirements>
            <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
            <workSkill>Crafting</workSkill>
            <effectWorking>Tailor</effectWorking>
            <soundWorking>Recipe_Tailor</soundWorking>
            <unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
            <recipeUsers>
                <li>ElectricTailoringBench</li>
                <li>HandTailoringBench</li>
                <li>Milira_TailoringBench</li>
            </recipeUsers>
        </recipeMaker>

        <graphicData>
            <texPath>MiliraXianQinghe/Apparel/apparel_qinghe_normal_Female_south</texPath>
        </graphicData>
        <statBases>
            <DeteriorationRate>1</DeteriorationRate>
            <Mass>1.2</Mass>
            <WorkToMake>300000</WorkToMake>
            <ArmorRating_Sharp>0.2</ArmorRating_Sharp>
