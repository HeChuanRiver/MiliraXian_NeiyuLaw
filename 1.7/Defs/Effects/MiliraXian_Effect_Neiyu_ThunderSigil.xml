<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <MiliraXian.Characters.Neiyu.NeiyuThunderVfxDef>
    <defName>MX_NeiyuThunderVfx</defName>
    <maxStrikeVisuals>48</maxStrikeVisuals>
    <particlesPerStrike>22</particlesPerStrike>
  </MiliraXian.Characters.Neiyu.NeiyuThunderVfxDef>

  <ShaderDef>
    <defName>MX_NeiyuThunderSigil</defName>
    <shaderProgram>
      <vertexShaderFileName>WorldArcaneStrike/Arcane.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>NeiyuThunder/ThunderSigil.frag.glsl</fragmentShaderFileName>
      <blendMode>Custom</blendMode>
      <blendSrcFactor>One</blendSrcFactor>
      <blendDstFactor>OneMinusSrcAlpha</blendDstFactor>
      <transparent>true</transparent>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3160</renderQueue>
    </shaderProgram>
  </ShaderDef>
  <ShaderDef>
    <defName>MX_NeiyuThunderEnergy</defName>
    <shaderProgram>
      <vertexShaderFileName>WorldArcaneStrike/Arcane.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>NeiyuThunder/ThunderEnergy.frag.glsl</fragmentShaderFileName>
      <blendMode>Custom</blendMode>
      <blendSrcFactor>One</blendSrcFactor>
      <blendDstFactor>One</blendDstFactor>
      <transparent>true</transparent>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>3161</renderQueue>
    </shaderProgram>
  </ShaderDef>
  <MaterialDef>
    <defName>MX_NeiyuThunderSigil</defName>
    <shader>MX_NeiyuThunderSigil</shader>
  </MaterialDef>
  <MaterialDef>
    <defName>MX_NeiyuThunderRibbon</defName>
    <shader>MX_NeiyuThunderEnergy</shader>
    <floats><li><name>_Kind</name><value>0</value></li></floats>
  </MaterialDef>
  <MaterialDef>
    <defName>MX_NeiyuThunderParticle</defName>
    <shader>MX_NeiyuThunderEnergy</shader>
    <floats><li><name>_Kind</name><value>1</value></li></floats>
  </MaterialDef>

  <ThingDef ParentName="MoteBase">
    <defName>MX_Mote_NeiyuThunderWarmup</defName>
    <label>聚雷术式</label>
    <thingClass>MiliraXian.Characters.Neiyu.Mote_NeiyuThunderWarmup</thingClass>
    <altitudeLayer>MoteOverheadLow</altitudeLayer>
    <tickerType>Normal</tickerType>
    <isSaveable>false</isSaveable>
    <graphicData>
      <texPath>Common/WorldArcaneStrike/neiyu_halo_vfx/SoftGlow</texPath>
      <shaderType>MoteGlow</shaderType>
    </graphicData>
    <mote><realTime>false</realTime><needsMaintenance>false</needsMaintenance></mote>
  </ThingDef>
</Defs>
